[Desktop Entry]
Version=1.0
Type=Application
Name=HexStrike AI
Comment=Autonomous AI Cybersecurity & Red Teaming Platform
Exec=xfce4-terminal -T "HexStrike AI Platform" -e "bash -c 'hexstrike_server & sleep 2; python3 /usr/share/hexstrike-ai/hexstrike_mcp.py --help; read -p \"Press enter to exit\"'"
Icon=security-high
Terminal=false
Categories=Security;Development;AI;
StartupNotify=true
