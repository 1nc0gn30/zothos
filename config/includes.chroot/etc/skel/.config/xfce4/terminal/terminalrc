[Configuration]
# ZOTHOS Apex Terminal — Premium Dark Void Configuration

# Font
FontName=JetBrains Mono 11
FontUseSystem=FALSE

# Colors - ZOTHOS Void Palette
BackgroundColor=#06090E
ForegroundColor=#F1F5F9
CursorColor=#00FF9D
TabActivityColor=#FFD700

# 16-color ANSI palette (Obsidian Void theme)
ColorPalette=#1A2030;#FF3355;#00FF9D;#FFD700;#00E5FF;#9B59B6;#00C8E8;#C8D4E0;#2D3A50;#FF6688;#33FFBB;#FFE040;#40F0FF;#BB88FF;#44DDFF;#FFFFFF

# Geometry
DefaultGeometry=120x35

# Appearance
BackgroundDarken=20
BackgroundStyle=TERMINAL_BACKGROUND_SOLID
ScrollingBar=TERMINAL_SCROLLBAR_NONE
ScrollingOnOutput=FALSE
ScrollingOnKeystroke=TRUE
ScrollingLines=10000
TabBarStyle=TERMINAL_TAB_STYLE_DEFAULT
ThemeName=ZOTHOS-Void
MiscSlimTabs=TRUE

# Behavior
MiscCopyOnSelect=FALSE
MiscDefaultGeometry=120x35
MiscMenubarDefault=FALSE
MiscMouseAutohide=FALSE
MiscToolbarDefault=FALSE
MiscConfirmClose=FALSE
MiscCycleTabs=FALSE
MiscTabCloseButtons=TRUE
MiscTabCloseMiddleClick=TRUE
MiscTabPosition=GTK_POS_TOP
MiscHighlightUrls=TRUE
MiscBoldIsBright=TRUE
MiscCursorBlinks=TRUE
MiscCursorShape=TERMINAL_CURSOR_SHAPE_BLOCK
MiscRewrapOnResize=TRUE
MiscShowRelaunchDialog=FALSE
MiscSearchDialogOpacity=100
MiscShowUnsafePasteDialog=FALSE

# Title
TitleMode=TERMINAL_TITLE_REPLACE
TitleInitial=ZOTHOS Terminal
