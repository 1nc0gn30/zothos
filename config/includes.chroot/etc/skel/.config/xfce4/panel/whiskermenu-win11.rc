# ==============================================================================
#  ZOTHOS WHISKER MENU CONFIGURATION - WINDOWS 11 CHAMELEON PROFILE
#  Mimics Windows 11 Start Menu hierarchy, styling, and category navigation.
#  Categories: 'Pinned Applications', 'Microsoft Edge', 'Windows Tools', 'Settings', and 'File Explorer'
# ==============================================================================

favorites=zoth-os.desktop,firefox-esr.desktop,xfce4-terminal.desktop,thunar.desktop,zoth-studio.desktop,zoth-sec.desktop
button-title=Zoth
button-icon=zoth-studio
button-single-row=false
show-button-title=false
show-button-icon=true
launcher-show-name=true
launcher-show-description=false
launcher-show-tooltip=true
item-icon-size=3
hover-switch-category=false
category-show-name=true
category-icon-size=1
load-hierarchy=true
view-as-icons=true
default-category=0
recent-items-max=12
favorites-in-recent=true
position-search-alternate=true
position-commands-alternate=false
position-categories-alternate=true
stay-on-focus-out=false
confirm-session-command=true
menu-width=520
menu-height=600
menu-opacity=95

# Command buttons
command-settings=xfce4-settings-manager
show-command-settings=true
command-lockscreen=xflock4
show-command-lockscreen=true
command-switchuser=dm-tool switch-to-greeter
show-command-switchuser=false
command-logoutuser=xfce4-session-logout --logout --fast
show-command-logoutuser=false
command-restart=xfce4-session-logout --reboot --fast
show-command-restart=false
command-shutdown=xfce4-session-logout --halt --fast
show-command-shutdown=false
command-suspend=xfce4-session-logout --suspend
show-command-suspend=false
command-hibernate=xfce4-session-logout --hibernate
show-command-hibernate=false
command-logout=xfce4-session-logout
show-command-logout=true
command-menueditor=menulibre
show-command-menueditor=false
command-profile=mugshot
show-command-profile=true

# Windows 11 Navigation Categories
category-pinned-applications=Pinned Applications
category-microsoft-edge=Microsoft Edge
category-windows-tools=Windows Tools
category-settings=Settings
category-file-explorer=File Explorer

# Windows 11 Search Actions and Category Handlers
search-actions=5

[action0]
name=Pinned Applications
pattern=*
command=exo-open %s
regex=false

[action1]
name=Microsoft Edge
pattern=?
command=x-www-browser https://www.bing.com/search?q=%u
regex=false

[action2]
name=Windows Tools
pattern=!
command=zoth-powershell -Command %s
regex=false

[action3]
name=Settings
pattern=ms-settings:
command=xfce4-settings-manager
regex=false

[action4]
name=File Explorer
pattern=file:
command=thunar %s
regex=false
