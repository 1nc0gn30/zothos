{
  "version": "1.0.0",
  "sentinel_name": "ZOTH-SENTINEL-APEX",
  "enabled": true,
  "provider": "ollama",
  "model": "llama3.2:latest",
  "base_url": "http://127.0.0.1:11434/v1",
  "api_key_env": "OPENAI_API_KEY",
  "custom_api_key": "",
  "safety_ring": "ring-1",
  "auto_execute": true,
  "autonomous_remediation": true,
  "telemetry": {
    "enabled": true,
    "interval_seconds": 10,
    "cpu_threshold_percent": 90,
    "ram_threshold_percent": 90,
    "disk_threshold_percent": 92,
    "monitor_failed_logins": true,
    "monitor_network_anomalies": true,
    "monitor_service_crashes": true
  },
  "providers_catalog": {
    "ollama": {
      "base_url": "http://127.0.0.1:11434/v1",
      "default_model": "llama3.2:latest",
      "api_key_required": false
    },
    "openai": {
      "base_url": "https://api.openai.com/v1",
      "default_model": "gpt-4o",
      "api_key_env": "OPENAI_API_KEY"
    },
    "anthropic": {
      "base_url": "https://api.anthropic.com/v1",
      "default_model": "claude-3-5-sonnet-20241022",
      "api_key_env": "ANTHROPIC_API_KEY"
    },
    "deepseek": {
      "base_url": "https://api.deepseek.com/v1",
      "default_model": "deepseek-chat",
      "api_key_env": "DEEPSEEK_API_KEY"
    },
    "groq": {
      "base_url": "https://api.groq.com/openai/v1",
      "default_model": "llama-3.3-70b-versatile",
      "api_key_env": "GROQ_API_KEY"
    },
    "grok": {
      "base_url": "https://api.x.ai/v1",
      "default_model": "grok-2-latest",
      "api_key_env": "XAI_API_KEY"
    },
    "openrouter": {
      "base_url": "https://openrouter.ai/api/v1",
      "default_model": "anthropic/claude-3.5-sonnet",
      "api_key_env": "OPENROUTER_API_KEY"
    },
    "gemini": {
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
      "default_model": "gemini-1.5-flash",
      "api_key_env": "GEMINI_API_KEY"
    },
    "vllm": {
      "base_url": "http://127.0.0.1:8000/v1",
      "default_model": "local-model",
      "api_key_required": false
    }
  },
  "log_file": "/var/log/zoth-sentinel.log",
  "ipc_socket": "/run/zoth-sentinel.sock"
}
