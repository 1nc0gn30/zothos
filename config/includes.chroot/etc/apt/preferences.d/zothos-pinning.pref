# ==============================================================================
#  ZOTHOS APT PINNING POLICY
#  Harmonizes Debian Base, Parrot Security, and Kali Linux toolchains
# ==============================================================================

# Priority 950: ZOTHOS Local & Custom Packages
Package: *
Pin: origin "repo.zothos.org"
Pin-Priority: 950

# Priority 900: Debian Base (Core system stability)
Package: *
Pin: release o=Debian
Pin-Priority: 900

# Priority 800: Parrot Security Tools
Package: *
Pin: release o=Parrot
Pin-Priority: 800

# Priority 500: Kali Linux Security Tools (Installable on demand without clobbering systemd/glibc)
Package: *
Pin: release o=Kali
Pin-Priority: 500
