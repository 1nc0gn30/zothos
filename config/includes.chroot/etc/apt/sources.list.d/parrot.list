# Parrot Security OS Rolling Repository
# PGP Key: Parrot OS Archive Key
deb [arch=amd64 signed-by=/etc/apt/keyrings/parrot-archive-keyring.gpg] https://deb.parrot.sh/parrot/ lory main contrib non-free non-free-firmware
deb [arch=amd64 signed-by=/etc/apt/keyrings/parrot-archive-keyring.gpg] https://deb.parrot.sh/parrot/ lory-security main contrib non-free non-free-firmware
deb [arch=amd64 signed-by=/etc/apt/keyrings/parrot-archive-keyring.gpg] https://deb.parrot.sh/parrot/ lory-backports main contrib non-free non-free-firmware
