<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xfwmbundlespec>
<!-- ═══════════════════════════════════════════════════════════════════════════
     ZOTH-HERMETIC-MATRIX XFWM4 THEME — Window Manager Configuration
     Emerald border glow, window animations, O|HMC button layout
     ═══════════════════════════════════════════════════════════════════════════ -->
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="Zoth-Hermetic-Matrix"/>
    <property name="easy_click" type="string" value="Alt"/>
    <property name="button_layout" type="string" value="O|HMC"/>
    <property name="title_font" type="string" value="JetBrains Mono Bold 9"/>
    <property name="title_style" type="int" value="0"/>
    <property name="title_shadow" type="bool" value="true"/>
    <property name="title_alignment" type="int" value="0"/>
    <property name="title_spacing" type="int" value="4"/>
    <property name="title_subtitle_size" type="int" value="1"/>
    <property name="title_subtitle_style" type="int" value="0"/>
    <property name="title_subtitle_color" type="string" value="#ffffff"/>
    <property name="show_frame_shadow" type="bool" value="true"/>
    <property name="frame_resistance" type="int" value="10"/>
    <property name="move_distance" type="int" value="10"/>
    <property name="resize_distance" type="int" value="10"/>
    <property name="resize_horizontally" type="bool" value="true"/>
    <property name="resize_vertically" type="bool" value="true"/>
    <property name="placement_strategy" type="int" value="2"/>
    <property name="auto_raise" type="bool" value="false"/>
    <property name="auto_raise_delay" type="int" value="100"/>
    <property name="focus_delay" type="int" value="150"/>
    <property name="activate_action" type="int" value="2"/>
    <property name="border_shade_active" type="bool" value="true"/>
    <property name="border_shade_inactive" type="bool" value="true"/>
    <property name="close_on_alt_f4" type="bool" value="true"/>
    <property name="workspace_switch_mode" type="int" value="2"/>
    <property name="workspace_after_switch" type="int" value="0"/>
  </property>

  <!-- ═══════════════════════════════════════════════════════════════════════
       ANIMATIONS — Zoth-Hermetic Matrix Window Effects
       ═══════════════════════════════════════════════════════════════════════ -->
  <property name="animations" type="empty">
    <!-- Minimize: collapse to titlebar — 200ms -->
    <property name="mini_mode" type="int" value="2"/>
    <property name="mini_duration" type="int" value="200"/>
    <property name="mini_easing" type="string" value="ease-out"/>

    <!-- Maximize: scale from center — 250ms -->
    <property name="maxi_mode" type="int" value="4"/>
    <property name="maxi_duration" type="int" value="250"/>
    <property name="maxi_easing" type="string" value="ease-out"/>

    <!-- Close: fade out — 150ms -->
    <property name="close_mode" type="int" value="1"/>
    <property name="close_duration" type="int" value="150"/>
    <property name="close_easing" type="string" value="ease-in"/>

    <!-- Open: fade in — 200ms -->
    <property name="open_mode" type="int" value="1"/>
    <property name="open_duration" type="int" value="200"/>
    <property name="open_easing" type="string" value="ease-out"/>

    <!-- Roll: minimize dramatic roll — 250ms -->
    <property name="roll_mode" type="int" value="2"/>
    <property name="roll_duration" type="int" value="250"/>
    <property name="roll_easing" type="string" value="ease-out"/>

    <!-- Shade: slide down — 200ms -->
    <property name="shade_mode" type="int" value="2"/>
    <property name="shade_duration" type="int" value="200"/>
    <property name="shade_easing" type="string" value="ease-out"/>

    <!-- Hide: fade out — 200ms -->
    <property name="hide_mode" type="int" value="1"/>
    <property name="hide_duration" type="int" value="200"/>
    <property name="hide_easing" type="string" value="ease-in"/>

    <!-- Focus: smooth border glow transition — 150ms -->
    <property name="focus_mode" type="int" value="1"/>
    <property name="focus_duration" type="int" value="150"/>
    <property name="focus_easing" type="string" value="ease-out"/>

    <!-- Desktop: zoom transition — 300ms -->
    <property name="desktop_mode" type="int" value="5"/>
    <property name="desktop_duration" type="int" value="300"/>
    <property name="desktop_easing" type="string" value="ease-out"/>
  </property>

  <!-- ═══════════════════════════════════════════════════════════════════════
       STYLING — Emerald Borders & Glow
       ═══════════════════════════════════════════════════════════════════════ -->
  <property name="style" type="empty">
    <!-- Active border: Emerald 2px glow -->
    <property name="border_active_color" type="string" value="#00ff9d"/>
    <property name="border_active_width" type="int" value="2"/>
    <property name="border_active_glow_radius" type="int" value="8"/>
    <property name="border_active_opacity" type="int" value="255"/>

    <!-- Inactive border: Deep forest green #1a3a2a -->
    <property name="border_inactive_color" type="string" value="#1a3a2a"/>
    <property name="border_inactive_width" type="int" value="1"/>
    <property name="border_inactive_opacity" type="int" value="200"/>

    <!-- Button styling -->
    <property name="button_active_color" type="string" value="#00ff88"/>
    <property name="button_inactive_color" type="string" value="#2a5a3a"/>
    <property name="button_borders_color" type="string" value="#003d2a"/>
    <property name="button_borders_width" type="int" value="1"/>
    <property name="button_hover_border_color" type="string" value="#00ff9d"/>

    <!-- Pressed button inset shadow -->
    <property name="button_pressed_shadow_color" type="string" value="#001a10"/>
    <property name="button_pressed_shadow_x" type="int" value="1"/>
    <property name="button_pressed_shadow_y" type="int" value="1"/>
    <property name="button_pressed_shadow_blur" type="int" value="4"/>
    <property name="button_pressed_inset" type="bool" value="true"/>

    <!-- Label colors -->
    <property name="label_active_color" type="string" value="#ffffff"/>
    <property name="label_inactive_color" type="string" value="#888888"/>
    <property name="label_font" type="string" value="JetBrains Mono Bold 9"/>
    <property name="label_shadow_color" type="string" value="#000000"/>
    <property name="label_shadow_x" type="int" value="1"/>
    <property name="label_shadow_y" type="int" value="1"/>
    <property name="label_shadow_opacity" type="int" value="100"/>

    <!-- Transparency -->
    <property name="frame_opacity" type="int" value="255"/>
    <property name="frame_active_opacity" type="int" value="255"/>
    <property name="frame_inactive_opacity" type="int" value="240"/>
  </property>

  <!-- ═══════════════════════════════════════════════════════════════════════
       APPEARANCE — Theme Assets
       ═══════════════════════════════════════════════════════════════════════ -->
  <property name="appearance" type="empty">
    <property name="theme_path" type="string"
              value="/usr/share/themes/Zoth-Hermetic-Matrix/xfwm4"/>

    <!-- Button images -->
    <property name="close_button" type="string" value="close.png"/>
    <property name="maximize_button" type="string" value="maximize.png"/>
    <property name="minimize_button" type="string" value="minimize.png"/>
    <property name="menu_button" type="string" value="menu.png"/>

    <!-- Title bar images -->
    <property name="title_bar" type="string" value="titlebar.png"/>
    <property name="title_bar_bottom" type="string" value="titlebar_bottom.png"/>

    <!-- Border images -->
    <property name="border_top" type="string" value="border_top.png"/>
    <property name="border_bottom" type="string" value="border_bottom.png"/>
    <property name="border_left" type="string" value="border_left.png"/>
    <property name="border_right" type="string" value="border_right.png"/>
    <property name="border_topleft" type="string" value="border_topleft.png"/>
    <property name="border_topright" type="string" value="border_topright.png"/>
    <property name="border_bottomleft" type="string" value="border_bottomleft.png"/>
    <property name="border_bottomright" type="string" value="border_bottomright.png"/>

    <!-- Handle images -->
    <property name="handle_top" type="string" value="handle_top.png"/>
    <property name="handle_bottom" type="string" value="handle_bottom.png"/>
    <property name="handle_left" type="string" value="handle_left.png"/>
    <property name="handle_right" type="string" value="handle_right.png"/>
  </property>

  <!-- ═══════════════════════════════════════════════════════════════════════
       WORKSPACE SWITCH — 200ms Cross-Fade
       ═══════════════════════════════════════════════════════════════════════ -->
  <property name="workspace_switch" type="empty">
    <property name="animation_mode" type="int" value="2"/>
    <property name="animation_duration" type="int" value="200"/>
    <property name="animation_easing" type="string" value="ease-out"/>
    <property name="show_previews" type="bool" value="false"/>
    <property name="preview_size" type="int" value="0"/>
    <property name="grid_size" type="int" value="0"/>
  </property>
</channel>
