<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xfwmlabele speci>
<!-- ═══════════════════════════════════════════════════════════════════════════
     ZOTH-HERMETIC-MATRIX XFWM4 — Window Label Configuration
     Emerald phosphor title styling with inset shadow
     ═══════════════════════════════════════════════════════════════════════════ -->
<channel name="xfwm4" version="1.0">
  <property name="labels" type="empty">

    <!-- ═══════════════════════════════════════════════════════════════════════
         TITLE BAR LABEL — Active Window
         ═══════════════════════════════════════════════════════════════════════ -->
    <property name="title_active" type="empty">
      <property name="label" type="string" value="title"/>
      <property name="mode" type="int" value="0"/>

      <!-- Text styling -->
      <property name="font_desc" type="string" value="JetBrains Mono Bold 9"/>
      <property name="color" type="string" value="#ffffff"/>
      <property name="shadow_color" type="string" value="#000000"/>
      <property name="shadow_x" type="int" value="1"/>
      <property name="shadow_y" type="int" value="1"/>
      <property name="shadow_opacity" type="int" value="120"/>
      <property name="use_markup" type="bool" value="false"/>

      <!-- Alignment -->
      <property name="alignment" type="int" value="0"/>
      <property name="ellipsize" type="string" value="end"/>

      <!-- Spacing -->
      <property name="x_padding" type="int" value="8"/>
      <property name="y_padding" type="int" value="2"/>

      <!-- Background -->
      <property name="bg_color" type="string" value="#0a2d20"/>
      <property name="bg_style" type="int" value="0"/>
      <property name="bg_gradient" type="bool" value="true"/>
      <property name="bg_gradient_dir" type="int" value="0"/>
      <property name="bg_gradient_color1" type="string" value="#0a2d20"/>
      <property name="bg_gradient_color2" type="string" value="#051a12"/>
    </property>

    <!-- ═══════════════════════════════════════════════════════════════════════
         TITLE BAR LABEL — Inactive Window
         ═══════════════════════════════════════════════════════════════════════ -->
    <property name="title_inactive" type="empty">
      <property name="label" type="string" value="title"/>
      <property name="mode" type="int" value="1"/>

      <!-- Dimmed text -->
      <property name="font_desc" type="string" value="JetBrains Mono 9"/>
      <property name="color" type="string" value="#888888"/>
      <property name="shadow_color" type="string" value="#000000"/>
      <property name="shadow_x" type="int" value="1"/>
      <property name="shadow_y" type="int" value="1"/>
      <property name="shadow_opacity" type="int" value="80"/>

      <!-- Alignment -->
      <property name="alignment" type="int" value="0"/>
      <property name="ellipsize" type="string" value="end"/>

      <!-- Spacing -->
      <property name="x_padding" type="int" value="8"/>
      <property name="y_padding" type="int" value="2"/>

      <!-- Background — darkened -->
      <property name="bg_color" type="string" value="#081a12"/>
      <property name="bg_style" type="int" value="0"/>
      <property name="bg_gradient" type="bool" value="true"/>
      <property name="bg_gradient_dir" type="int" value="0"/>
      <property name="bg_gradient_color1" type="string" value="#081a12"/>
      <property name="bg_gradient_color2" type="string" value="#040f0a"/>
    </property>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SUBTITLE / TRANSIENT LABEL — Child windows
         ═══════════════════════════════════════════════════════════════════════ -->
    <property name="title_transient" type="empty">
      <property name="label" type="string" value="title"/>
      <property name="mode" type="int" value="2"/>

      <property name="font_desc" type="string" value="JetBrains Mono 8"/>
      <property name="color" type="string" value="#aabbcc"/>
      <property name="shadow_color" type="string" value="#000000"/>
      <property name="shadow_x" type="int" value="1"/>
      <property name="shadow_y" type="int" value="1"/>
      <property name="shadow_opacity" type="int" value="60"/>

      <property name="x_padding" type="int" value="6"/>
      <property name="y_padding" type="int" value="1"/>
    </property>

    <!-- ═══════════════════════════════════════════════════════════════════════
         BUTTON LABELS — Close/Maximize/Minimize text
         ═══════════════════════════════════════════════════════════════════════ -->
    <property name="button_label" type="empty">
      <property name="font_desc" type="string" value="Monospace 7"/>
      <property name="color" type="string" value="#00ff9d"/>
      <property name="use_markup" type="bool" value="false"/>
      <property name="show_label" type="bool" value="false"/>
    </property>

  </property>
</channel>
