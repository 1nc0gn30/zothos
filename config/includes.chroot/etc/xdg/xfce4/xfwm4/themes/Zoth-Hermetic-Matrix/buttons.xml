<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xfwmbutton speci>
<!-- ═══════════════════════════════════════════════════════════════════════════
     ZOTH-HERMETIC-MATRIX XFWM4 — Window Button Configuration
     Emerald glow on hover, pressed inset shadow, O|HMC layout
     ═══════════════════════════════════════════════════════════════════════════ -->
<channel name="xfwm4" version="1.0">
  <property name="buttons" type="empty">

    <!-- ═══════════════════════════════════════════════════════════════════════
         BUTTON LAYOUT — O|HMC (Overlay left, Help/Maximize/Close right)
         ═══════════════════════════════════════════════════════════════════════ -->
    <property name="layout" type="empty">
      <!-- Button layout string: O|HMC -->
      <!-- O = overlay (left side, transparent) -->
      <!-- | = separator -->
      <!-- HMC = Help | Maximize | Close (right side) -->
      <property name="button_layout" type="string" value="O|HMC"/>

      <!-- Side margins -->
      <property name="left_margin" type="int" value="4"/>
      <property name="right_margin" type="int" value="4"/>
      <property name="top_margin" type="int" value="2"/>
      <property name="bottom_margin" type="int" value="2"/>

      <!-- Button spacing -->
      <property name="button_spacing" type="int" value="2"/>
      <property name="separator_width" type="int" value="4"/>

      <!-- Overlay button (O) — transparent, clickable area -->
      <property name="overlay_width" type="int" value="32"/>
      <property name="overlay_hover_color" type="string" value="#00ff9d"/>
      <property name="overlay_hover_opacity" type="int" value="50"/>
    </property>

    <!-- ═══════════════════════════════════════════════════════════════════════
         CLOSE BUTTON — Emerald on hover, inset shadow when pressed
         ═══════════════════════════════════════════════════════════════════════ -->
    <property name="close" type="empty">
      <property name="btn" type="string" value="close"/>

      <!-- Normal state -->
      <property name="normal_color" type="string" value="#cc3333"/>
      <property name="normal_style" type="int" value="0"/>

      <!-- Hover state — bright emerald glow -->
      <property name="hover_color" type="string" value="#00ff9d"/>
      <property name="hover_style" type="int" value="1"/>
      <property name="hover_border_color" type="string" value="#00ff9d"/>
      <property name="hover_border_width" type="int" value="2"/>
      <property name="hover_glow_radius" type="int" value="6"/>
      <property name="hover_opacity" type="int" value="220"/>

      <!-- Pressed state — inset shadow -->
      <property name="pressed_color" type="string" value="#991111"/>
      <property name="pressed_style" type="int" value="2"/>
      <property name="pressed_inset" type="bool" value="true"/>
      <property name="pressed_inset_color" type="string" value="#001a10"/>
      <property name="pressed_inset_x" type="int" value="2"/>
      <property name="pressed_inset_y" type="int" value="2"/>
      <property name="pressed_inset_blur" type="int" value="6"/>
      <property name="pressed_opacity" type="int" value="180"/>

      <!-- Disarmed (mouse up, still hovering) -->
      <property name="disarmed_color" type="string" value="#ff4444"/>
      <property name="disarmed_opacity" type="int" value="200"/>

      <!-- Disabled -->
      <property name="disabled_color" type="string" value="#333333"/>
      <property name="disabled_opacity" type="int" value="100"/>

      <!-- Icon (if using image buttons) -->
      <property name="icon_file" type="string" value=""/>
      <property name="icon_size" type="int" value="14"/>
    </property>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MAXIMIZE BUTTON — Emerald glow on hover
         ═══════════════════════════════════════════════════════════════════════ -->
    <property name="maximize" type="empty">
      <property name="btn" type="string" value="maximize"/>

      <!-- Normal -->
      <property name="normal_color" type="string" value="#2a5a3a"/>
      <property name="normal_style" type="int" value="0"/>

      <!-- Hover — emerald glow -->
      <property name="hover_color" type="string" value="#00ff9d"/>
      <property name="hover_style" type="int" value="1"/>
      <property name="hover_border_color" type="string" value="#00ff9d"/>
      <property name="hover_border_width" type="int" value="2"/>
      <property name="hover_glow_radius" type="int" value="5"/>
      <property name="hover_opacity" type="int" value="220"/>

      <!-- Pressed — inset shadow -->
      <property name="pressed_color" type="string" value="#0a3a2a"/>
      <property name="pressed_style" type="int" value="2"/>
      <property name="pressed_inset" type="bool" value="true"/>
      <property name="pressed_inset_color" type="string" value="#001a10"/>
      <property name="pressed_inset_x" type="int" value="2"/>
      <property name="pressed_inset_y" type="int" value="2"/>
      <property name="pressed_inset_blur" type="int" value="5"/>
      <property name="pressed_opacity" type="int" value="180"/>

      <!-- Toggle state (maximized) -->
      <property name="toggle_color" type="string" value="#00cc77"/>
      <property name="toggle_opacity" type="int" value="200"/>

      <!-- Disabled -->
      <property name="disabled_color" type="string" value="#222222"/>
      <property name="disabled_opacity" type="int" value="100"/>

      <property name="icon_file" type="string" value=""/>
      <property name="icon_size" type="int" value="14"/>
    </property>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MINIMIZE BUTTON — Emerald glow on hover
         ═══════════════════════════════════════════════════════════════════════ -->
    <property name="minimize" type="empty">
      <property name="btn" type="string" value="minimize"/>

      <!-- Normal -->
      <property name="normal_color" type="string" value="#2a5a3a"/>
      <property name="normal_style" type="int" value="0"/>

      <!-- Hover — emerald glow -->
      <property name="hover_color" type="string" value="#00ff9d"/>
      <property name="hover_style" type="int" value="1"/>
      <property name="hover_border_color" type="string" value="#00ff9d"/>
      <property name="hover_border_width" type="int" value="2"/>
      <property name="hover_glow_radius" type="int" value="5"/>
      <property name="hover_opacity" type="int" value="220"/>

      <!-- Pressed — inset shadow -->
      <property name="pressed_color" type="string" value="#0a3a2a"/>
      <property name="pressed_style" type="int" value="2"/>
      <property name="pressed_inset" type="bool" value="true"/>
      <property name="pressed_inset_color" type="string" value="#001a10"/>
      <property name="pressed_inset_x" type="int" value="2"/>
      <property name="pressed_inset_y" type="int" value="2"/>
      <property name="pressed_inset_blur" type="int" value="5"/>
      <property name="pressed_opacity" type="int" value="180"/>

      <!-- Disabled -->
      <property name="disabled_color" type="string" value="#222222"/>
      <property name="disabled_opacity" type="int" value="100"/>

      <property name="icon_file" type="string" value=""/>
      <property name="icon_size" type="int" value="14"/>
    </property>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MENU / HELP BUTTON — Emerald glow on hover (H in O|HMC)
         ═══════════════════════════════════════════════════════════════════════ -->
    <property name="menu" type="empty">
      <property name="btn" type="string" value="menu"/>

      <!-- Normal -->
      <property name="normal_color" type="string" value="#2a5a3a"/>
      <property name="normal_style" type="int" value="0"/>

      <!-- Hover — emerald glow -->
      <property name="hover_color" type="string" value="#00ff9d"/>
      <property name="hover_style" type="int" value="1"/>
      <property name="hover_border_color" type="string" value="#00ff9d"/>
      <property name="hover_border_width" type="int" value="2"/>
      <property name="hover_glow_radius" type="int" value="5"/>
      <property name="hover_opacity" type="int" value="220"/>

      <!-- Pressed — inset shadow -->
      <property name="pressed_color" type="string" value="#0a3a2a"/>
      <property name="pressed_style" type="int" value="2"/>
      <property name="pressed_inset" type="bool" value="true"/>
      <property name="pressed_inset_color" type="string" value="#001a10"/>
      <property name="pressed_inset_x" type="int" value="2"/>
      <property name="pressed_inset_y" type="int" value="2"/>
      <property name="pressed_inset_blur" type="int" value="5"/>
      <property name="pressed_opacity" type="int" value="180"/>

      <!-- Disabled -->
      <property name="disabled_color" type="string" value="#222222"/>
      <property name="disabled_opacity" type="int" value="100"/>

      <property name="icon_file" type="string" value=""/>
      <property name="icon_size" type="int" value="14"/>
    </property>

  </property>
</channel>
