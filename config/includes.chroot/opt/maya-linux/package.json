{
  "name": "maya-video-editor",
  "version": "1.1.0",
  "description": "Wrap screen recordings in beautiful device frames and export ready-to-share videos on Linux",
  "main": "electron-main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app:dev": "NODE_ENV=development electron .",
    "dist": "npm run build && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.maya.videoeditor",
    "productName": "Maya",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "preload.js",
      "public/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Video;AudioVideo;AudioVideoEditing;",
      "icon": "public/app/icon_512.png"
    }
  },
  "dependencies": {
    "@types/howler": "^2.2.13",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "howler": "^2.2.4",
    "lucide-react": "^1.34.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
