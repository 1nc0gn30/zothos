{
  "name": "nexia-astro-netlify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-webflow-astro.mjs",
    "generate:config": "node scripts/generate-aplus-config.mjs",
    "generate:aplus": "APLUS=1 node scripts/generate-webflow-astro.mjs",
    "generate:clone": "CLONE=1 node scripts/generate-webflow-astro.mjs",
    "dev": "astro dev --host 0.0.0.0",
    "build": "npm run generate:config && npm run generate:aplus && astro build",
    "build:clone": "npm run generate:clone && astro build",
    "build:aplus": "npm run generate:config && npm run generate:aplus && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "verify:aplus": "node scripts/verify-aplus.mjs",
    "verify:aplus:source": "node scripts/verify-aplus-source.mjs",
    "verify:aplus:browser": "node scripts/verify-aplus-browser.mjs",
    "verify:screen-inventory": "node scripts/verify-screen-inventory.mjs",
    "verify:clone:fidelity": "node scripts/verify-clone-fidelity.mjs",
    "verify:routes": "node scripts/verify-routes.mjs"
  },
  "dependencies": {
    "@astrojs/svelte": "^7.0.0",
    "astro": "^5.12.0",
    "svelte": "^5.38.0"
  },
  "devDependencies": {
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0"
  }
}
