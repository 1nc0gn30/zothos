# =============================================================================
# C&C Land Services — .gitignore
# Vite + React SPA with heavy media assets
# =============================================================================

# ───────────────────────────────
# Build Output
# ───────────────────────────────
dist
dist-ssr
*.local

# ───────────────────────────────
# Dependencies
# ───────────────────────────────
node_modules
.pnp
.pnp.js
.yarn/install-state.gz
package-lock.json
yarn.lock
pnpm-lock.yaml

# ───────────────────────────────
# Environment & Secrets
# ───────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# ───────────────────────────────
# Large Media Assets (not for Git)
# ───────────────────────────────
# Raw video files and generated source media should live in
# object storage (Netlify Large Media, S3, etc.) — never in git.
*.mp4
*.mov
*.avi
*.mkv
*.wmv
*.m4v
*.3gp
*.raw
*.psd
*.ai
*.eps
*.tiff
*.tif

# Original uncompressed images before WebP conversion
*.jpg.original
*.jpeg.original
*.png.original

# ───────────────────────────────
# Logs
# ───────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ───────────────────────────────
# Editor / IDE
# ───────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
.~lock.*

# ───────────────────────────────
# OS Generated
# ───────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.lnk

# ───────────────────────────────
# Testing & Coverage
# ───────────────────────────────
coverage
.nyc_output
*.lcov

# ───────────────────────────────
# Cache & Temp
# ───────────────────────────────
.cache
.temp
.tmp
*.tmp
*.temp
.parcel-cache
.eslintcache
.stylelintcache
.prettiercache
*.tsbuildinfo

# ───────────────────────────────
# Netlify / Deployment
# ───────────────────────────────
.netlify
# Keep netlify.toml in version control — do NOT ignore it

# ───────────────────────────────
# Framework Specific
# ───────────────────────────────
# Vite
.vite

# React
*.pem

# TypeScript (if ever added)
*.tsbuildinfo

# Storybook (if ever added)
storybook-static

# Playwright / E2E (if ever added)
test-results
playwright-report
playwright/.cache
