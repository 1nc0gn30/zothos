import React from 'react';

export const Logo = ({ className = "h-8 w-8", ...props }: React.SVGProps<SVGSVGElement>) => (
  <svg 
    viewBox="0 0 120 130" 
    fill="none" 
    xmlns="http://www.w3.org/2000/svg"
    className={className}
    {...props}
  >
    <defs>
      <linearGradient id="gold-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stopColor="#E5C05C" />
        <stop offset="25%" stopColor="#FDF2A6" />
        <stop offset="50%" stopColor="#C4963B" />
        <stop offset="75%" stopColor="#FDF2A6" />
        <stop offset="100%" stopColor="#9A6B22" />
      </linearGradient>
      <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="2" stdDeviation="3" floodOpacity="0.4" />
      </filter>
    </defs>
    <g filter="url(#shadow)" fill="url(#gold-gradient)">
      {/* Center Petal */}
      <path d="M 60 5 L 75 45 L 60 80 L 45 45 Z" />
      
      {/* Top Right Petal */}
      <path d="M 78 40 L 110 35 L 95 70 L 65 82 Z" />
      
      {/* Top Left Petal */}
      <path d="M 42 40 L 10 35 L 25 70 L 55 82 Z" />
      
      {/* Middle Right Petal */}
      <path d="M 98 75 L 118 85 L 90 100 L 70 92 Z" />
      
      {/* Middle Left Petal */}
      <path d="M 22 75 L 2 85 L 30 100 L 50 92 Z" />
      
      {/* Bottom Right Petal */}
      <path d="M 68 102 L 90 110 L 80 125 L 65 115 Z" />
      
      {/* Bottom Left Petal */}
      <path d="M 52 102 L 30 110 L 40 125 L 55 115 Z" />
    </g>
  </svg>
);
