@import "tailwindcss";

@theme {
  --color-gold-50: #fbf8e8;
  --color-gold-100: #f5ecc5;
  --color-gold-200: #eed88f;
  --color-gold-300: #e5bf50;
  --color-gold-400: #dfa826;
  --color-gold-500: #d48f1c;
  --color-gold-600: #b56d14;
  --color-gold-700: #904e14;
  --color-gold-800: #773f16;
  --color-gold-900: #653416;
  --color-gold-950: #3a1a09;
  
  --color-primary: var(--color-gold-500);
  --color-primary-foreground: #ffffff;
}

@layer base {
  :root {
    --background: #ffffff;
    --foreground: #0a0a0a;
    --card: #ffffff;
    --card-foreground: #0a0a0a;
    --popover: #ffffff;
    --popover-foreground: #0a0a0a;
    --primary: #d48f1c;
    --primary-foreground: #ffffff;
    --secondary: #f4f4f5;
    --secondary-foreground: #18181b;
    --muted: #f4f4f5;
    --muted-foreground: #71717a;
    --accent: #f4f4f5;
    --accent-foreground: #18181b;
    --destructive: #ef4444;
    --destructive-foreground: #fafafa;
    --border: #e4e4e7;
    --input: #e4e4e7;
    --ring: #d48f1c;
    --radius: 0.5rem;
  }

  .dark {
    --background: #0a0a0a;
    --foreground: #fafafa;
    --card: #111111;
    --card-foreground: #fafafa;
    --popover: #111111;
    --popover-foreground: #fafafa;
    --primary: #d48f1c;
    --primary-foreground: #ffffff;
    --secondary: #27272a;
    --secondary-foreground: #fafafa;
    --muted: #27272a;
    --muted-foreground: #a1a1aa;
    --accent: #27272a;
    --accent-foreground: #fafafa;
    --destructive: #7f1d1d;
    --destructive-foreground: #fafafa;
    --border: #27272a;
    --input: #27272a;
    --ring: #d48f1c;
  }
}

@layer base {
  * {
    border-color: var(--border);
  }
  body {
    background-color: var(--background);
    color: var(--foreground);
    font-family: 'Inter', system-ui, sans-serif;
  }
}
/* Enhanced design system */
@layer components {
  .card-hover {
    @apply transition-all duration-300 hover:shadow-xl hover:-translate-y-1 hover:border-primary/30;
  }
  
  .btn-primary {
    @apply bg-primary text-primary-foreground px-6 py-3 rounded-xl font-bold hover:bg-primary/90 transition-all duration-200 transform hover:scale-105 active:scale-95 shadow-lg hover:shadow-primary/20;
  }
  
  .btn-secondary {
    @apply bg-secondary text-secondary-foreground px-6 py-3 rounded-xl font-bold hover:bg-secondary/80 transition-all duration-200 border border-input shadow-sm;
  }
  
  .input-field {
    @apply w-full px-4 py-3 rounded-xl border border-input bg-background focus:outline-none focus:ring-2 focus:ring-primary/50 transition-all duration-200 shadow-sm;
  }
  
  .tag {
    @apply px-3 py-1 text-xs font-bold rounded-full bg-muted text-muted-foreground border border-border transition-colors hover:bg-primary/20 hover:text-primary hover:border-primary/30;
  }
  
  .gradient-bg {
    background: radial-gradient(ellipse at 50% 50%, rgba(212, 143, 28, 0.15) 0%, transparent 70%);
  }
  
  .glass-effect {
    @apply bg-background/80 backdrop-blur-md border border-white/10 shadow-xl;
  }
}

/* Custom animations */
@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.animate-float {
  animation: float 6s ease-in-out infinite;
}

.animate-shimmer {
  background: linear-gradient(90deg, transparent, rgba(212, 143, 28, 0.1), transparent);
  background-size: 200% 100%;
  animation: shimmer 2s infinite;
}

/* Custom scrollbar */
::-webkit-scrollbar {
  width: 6px;
}

::-webkit-scrollbar-track {
  background: var(--muted);
}

::-webkit-scrollbar-thumb {
  background: var(--primary);
  border-radius: 3px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--primary)/90;
}
