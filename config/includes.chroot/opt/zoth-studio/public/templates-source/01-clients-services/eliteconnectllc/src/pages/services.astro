---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import ServiceGrid from "../components/ServiceGrid.astro";

const title = "Services | Elite Connect Virginia Beach";
const description = "CCTV, alarms, access control, structured cabling, AV, MSP, and VoIP services for homes and businesses in Virginia Beach and Hampton Roads.";
---

<BaseLayout title={title} description={description} canonical="/services/" loaderLabel="Loading services...">
  <HeroSection
    variant="page"
    eyebrow="Services"
    title="Seven services. One team."
    lead="Every system is designed to work with the others. Cameras talk to the network. Access control shares cable with VoIP. The same team that installs it supports it."
    imageDesc="Hero image showcasing multiple Elite Connect services: professional technician, security equipment, or commercial installation"
  />

  <section class="section band">
    <div class="section-heading section-heading--center">
      <p class="eyebrow">What we do</p>
      <h2>Services for every property type.</h2>
    </div>
    <ServiceGrid />
  </section>
</BaseLayout>
