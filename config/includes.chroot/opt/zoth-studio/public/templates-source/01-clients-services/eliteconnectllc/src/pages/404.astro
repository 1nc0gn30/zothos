---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Page Not Found | Elite Connect";
const description = "The page you are looking for does not exist.";
---

<BaseLayout title={title} description={description} loaderLabel="Loading page...">
  <section class="section" style="text-align: center; padding: 8rem 1rem;">
    <h1 style="font-size: 6rem; color: var(--brand-blue); opacity: 0.3; margin-bottom: 1rem;">404</h1>
    <h2>Page not found.</h2>
    <p style="color: var(--muted); margin: 1rem 0 2rem;">The page you are looking for does not exist or has been moved.</p>
    <a class="button primary" href="/">Back to home</a>
  </section>
</BaseLayout>
