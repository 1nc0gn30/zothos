---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import MediaPlaceholder from "../components/MediaPlaceholder.astro";

const title = "Commercial Security And Low-Voltage Services In Virginia Beach | Elite Connect";
const description = "Commercial security cameras, access control, alarms, structured cabling, MSP, AV, and VoIP planning for businesses in Virginia Beach and Hampton Roads.";
---

<BaseLayout title={title} description={description} canonical="/commercial/">
    <HeroSection
    variant="page"
    align="left"
    bgImage="/assets/gallery/commercial-cabling-ceiling.jpg"
    eyebrow="Commercial technology systems"
    title="Security and infrastructure for businesses that cannot afford loose ends."
    lead="Elite Connect supports offices, retail spaces, warehouses, restaurants, property managers, and buildout teams with practical low-voltage systems."
    ctas={[{ label: "Request Business Consultation", href: "/contact/", variant: "primary" }]}
  />

  <section class="section band reveal">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Commercial priorities</p>
        <h2>Know who entered, what happened, and whether the network can keep up.</h2>
      </div>
      <p>Business systems need to protect assets, support daily operations, and stay serviceable after the installer leaves.</p>
    </div>
    <div class="path-grid reveal-stagger">
      <article class="path-card"><h3>Cameras + Access</h3><p>See critical areas and control doors for employees, vendors, and visitors.</p><a href="/services/#cctv-video-monitoring">Camera services</a></article>
      <article class="path-card"><h3>Cabling + Communications</h3><p>Support data, voice, cameras, phones, and the next system before walls close up.</p><a href="/services/#structured-cabling">Cabling services</a></article>
      <article class="path-card"><h3>Alarms + Managed Support</h3><p>Discuss intrusion, monitoring options, MSP support, and recurring service needs.</p><a href="/services/#alarm-systems">Alarm services</a></article>
    </div>
  </section>

  <section class="section reveal">
    <div class="photo-feature">
      <div class="content-block">
        <p class="eyebrow">On site</p>
        <h2>Commercial installs done right the first time.</h2>
        <p>From server racks to security cameras, Elite Connect treats commercial work with the precision it demands. Clean runs, labeled panels, and documentation that keeps the property manager informed.</p>
      </div>
      <div class="photo-feature-img">
        <img src="/assets/gallery/commercial-server-racks.jpg" alt="Commercial server rack and network infrastructure installed by Elite Connect" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="two-column">
      <div class="content-block">
        <p class="eyebrow">Industries</p>
        <h2>Built for local workspaces and public-facing properties.</h2>
        <p>Every layout has different risks. A retail counter, warehouse, office suite, and restaurant all need different camera angles, cable paths, and access decisions.</p>
      </div>
      <div class="content-block">
        <ul class="check-list">
          <li>Offices and professional suites</li>
          <li>Retail and convenience spaces</li>
          <li>Warehouses and light industrial properties</li>
          <li>Restaurants and hospitality spaces</li>
          <li>Property management and tenant improvements</li>
          <li>Contractor-supported buildouts</li>
        </ul>
      </div>
    </div>
    <div style="margin-top: 2rem;">
      <MediaPlaceholder
        description="Photo collage or wide shot: diverse commercial interiors — office lobby, retail counter, warehouse aisle, restaurant dining room — showing the range of properties Elite Connect serves."
        aspect="21/9"
      />
    </div>
  </section>
</BaseLayout>
