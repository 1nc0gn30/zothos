---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import { site } from "../data/site";

const title = "Client Portal | Elite Connect";
const description = "Elite Connect client portal for project updates, documentation, and support.";
---

<BaseLayout title={title} description={description} canonical="/client-portal/" loaderLabel="Loading client portal...">
  <HeroSection
    variant="page"
    eyebrow="Client portal"
    title="Project updates and documentation."
    lead="The client portal is currently being set up. For immediate project updates, contact Elite Connect directly."

    imageDesc="Digital dashboard or project documentation interface concept"
  />

  <section class="section band">
    <div class="section-heading section-heading--center">
      <p class="eyebrow">Coming soon</p>
      <h2>Client portal under construction.</h2>
    </div>
    <p style="text-align: center; color: var(--muted); max-width: 500px; margin: 0 auto;">
      The client portal will provide project tracking, documentation access, and direct messaging. 
      For now, call or email for updates.
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 2rem;">
      <a class="button primary" href={site.phoneHref}>Call {site.phone}</a>
      <a class="button secondary" href={site.emailHref}>Email</a>
    </div>
  </section>
</BaseLayout>
