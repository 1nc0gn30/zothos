---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import MediaPlaceholder from "../components/MediaPlaceholder.astro";

const title = "Residential Security & Smart Home | Elite Connect Virginia Beach";
const description = "Home cameras, alarms, smart security, AV, and low-voltage wiring for homeowners in Virginia Beach and Hampton Roads.";
---

<BaseLayout title={title} description={description} canonical="/residential/" loaderLabel="Loading residential solutions...">
  <HeroSection
    variant="page"
    eyebrow="Residential"
    title="Home security and technology that fits your property."
    lead="Elite Connect installs cameras, alarms, smart security, AV, and low-voltage wiring for homeowners in Virginia Beach and Hampton Roads."
    imageDesc="Hero image of a completed residential security installation: doorbell camera, smart panel, or home exterior"
  />

  <section class="section">
    <div class="photo-feature">
      <div class="photo-feature-img"><MediaPlaceholder description="Residential project photo: clean cable work, mounted TV, or smart home device installation" aspect="4/3" /></div>
      <div class="content-block">
        <p class="eyebrow">Home security</p>
        <h2>Cameras, alarms, and smart security for your home.</h2>
        <p>Elite Connect helps homeowners protect their property with professional camera systems, intrusion alarms, doorbell cameras, and smart security solutions.</p>
        <a class="button secondary" href="/contact/">Request a home quote</a>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="section-heading section-heading--center">
      <p class="eyebrow">Residential services</p>
      <h2>What Elite Connect handles for homeowners.</h2>
    </div>
    <div class="value-grid">
      <div><h3>Home Cameras</h3><p>Outdoor and indoor cameras, doorbell cameras, remote viewing, and motion alerts.</p></div>
      <div><h3>Alarm Systems</h3><p>Intrusion detection, smart panels, and monitoring options for peace of mind.</p></div>
      <div><h3>Home AV</h3><p>TV mounting, sound systems, home theater, and integrated audio solutions.</p></div>
      <div><h3>Low-Voltage Wiring</h3><p>Clean cable runs, network drops, and structured wiring for smart homes.</p></div>
    </div>
  </section>
</BaseLayout>
