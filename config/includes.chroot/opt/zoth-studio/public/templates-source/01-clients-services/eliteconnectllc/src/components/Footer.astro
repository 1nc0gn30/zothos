---
import { nav, services, site } from "../data/site";
---

<footer class="site-footer">
  <div class="footer-watermark" aria-hidden="true"></div>

  <div class="footer-cta-band">
    <div class="footer-cta-inner">
      <div class="footer-cta-content">
        <p class="eyebrow">Ready for a cleaner system?</p>
        <h2>Talk through the property, the risks, and the right technology plan.</h2>
        <p class="footer-cta-lead">Free consultation. Local team. No pressure.</p>
      </div>
      <div class="footer-cta-actions">
        <a class="button primary" href="/contact/">Request Consultation</a>
        <a class="button secondary" href={site.phoneHref}>Call {site.phone}</a>
      </div>
    </div>
  </div>

  <div class="footer-main">
    <div class="footer-grid">
      <div class="footer-col footer-col--brand">
        <p>Security, cabling, and managed technology built clean.</p>
        <div class="footer-badges">
          <span class="footer-badge">{site.license}</span>
          <span class="footer-badge">{site.dcjs}</span>
        </div>
        <p>{site.serviceArea}</p>
      </div>

      <div class="footer-col">
        <h3>Company</h3>
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="/client-portal/">Client Portal</a>
      </div>

      <div class="footer-col">
        <h3>Services</h3>
        {services.map((s) => <a href={`/services/#${s.slug}`}>{s.title}</a>)}
      </div>

      <div class="footer-col footer-col--contact">
        <h3>Contact</h3>
        <a href={site.phoneHref}>{site.phone}</a>
        <a href={site.emailHref}>{site.email}</a>
        <p>{site.location}</p>
        <p>Mon–Fri: 8am – 6pm</p>
        <a href={site.facebook} target="_blank" rel="noopener">Facebook</a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <p>© {new Date().getFullYear()} Elite Connect LLC. All rights reserved.</p>
      <div class="footer-bottom-links">
        <a href="/privacy-policy/">Privacy</a>
        <a href="/terms-of-service/">Terms</a>
      </div>
    </div>
  </div>
</footer>
