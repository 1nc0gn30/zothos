---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import MediaPlaceholder from "../components/MediaPlaceholder.astro";
import { site } from "../data/site";

const title = "Client Portal | Elite Connect";
const description = "Elite Connect client portal entry point for existing customers, subscription support, and future account resources.";
---

<BaseLayout title={title} description={description} canonical="/client-portal/">
    <HeroSection
    variant="page"
    align="left"
    bgImage="/assets/gallery/commercial-server-racks.jpg"
    eyebrow="Client portal"
    title="Existing client support starts here."
    lead="This page replaces the old hidden client portal URL with a clear entry point. Subscription payments, alarm account tools, MSP support, and portal login can be connected here when the operational stack is confirmed."
    ctas={[]}
    placeholderDesc="Hero image: dashboard mockup on a monitor or tablet showing system health/status, or a technician reviewing documentation on-site."
  />

  <section class="section band reveal">
    <div class="path-grid reveal-stagger">
      <article class="portal-card">
        <h2>Need support?</h2>
        <p class="lead">Contact Elite Connect with the system type, property, and issue details.</p>
        <div class="hero-actions">
          <a class="button secondary" href="/contact/">Contact support</a>
        </div>
        <div style="margin-top: 1.5rem;">
          <MediaPlaceholder
            description="Icon or small photo: headset/support symbol or technician answering a service call."
            aspect="16/9"
          />
        </div>
      </article>
      <article class="portal-card">
        <h2>Subscription questions?</h2>
        <p class="lead">Alarm and MSP subscription/payment workflows should be connected after provider and Stripe details are approved.</p>
        <div class="hero-actions">
          <a class="button secondary" href={site.phoneHref}>Call {site.phone}</a>
        </div>
        <div style="margin-top: 1.5rem;">
          <MediaPlaceholder
            description="Icon or small photo: subscription/billing dashboard snippet or credit-card-free illustration."
            aspect="16/9"
          />
        </div>
      </article>
      <article class="portal-card">
        <h2>New project?</h2>
        <p class="lead">Use the consultation form for expansions, new installs, or service upgrades.</p>
        <div class="hero-actions">
          <a class="button secondary" href="/services/">View services</a>
        </div>
        <div style="margin-top: 1.5rem;">
          <MediaPlaceholder
            description="Icon or small photo: new project checklist, clipboard on site, or equipment ready for install."
            aspect="16/9"
          />
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
