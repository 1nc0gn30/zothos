---
import { faqs } from "../data/site";
---

<div class="faq-list">
  {faqs.map((faq, i) => (
    <details class="faq-item">
      <summary>
        <span class="faq-number">{String(i + 1).padStart(2, '0')}</span>
        <span class="faq-question">{faq.question}</span>
        <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
      </summary>
      <div class="faq-answer">
        <p>{faq.answer}</p>
      </div>
    </details>
  ))}
</div>

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: var(--ink);
    transition: background 0.2s ease;
  }

  .faq-item summary::-webkit-details-marker { display: none; }

  .faq-item summary:hover {
    background: var(--panel);
  }

  .faq-number {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--brand-blue);
    flex-shrink: 0;
    min-width: 24px;
  }

  .faq-question {
    flex: 1;
    font-size: 0.95rem;
  }

  .faq-chevron {
    width: 18px;
    height: 18px;
    color: var(--soft);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 1.25rem 1.25rem 3.25rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 560px) {
    .faq-item summary { padding: 1rem; gap: 0.75rem; }
    .faq-answer { padding: 0 1rem 1rem 2.75rem; }
  }
</style>
