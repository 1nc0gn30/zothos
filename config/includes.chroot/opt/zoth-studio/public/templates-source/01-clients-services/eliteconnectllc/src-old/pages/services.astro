---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import { services, site } from "../data/site";
import MediaPlaceholder from "../components/MediaPlaceholder.astro";

const title = "Security, Cabling, AV And Low-Voltage Services | Elite Connect Virginia Beach";
const description = "Full service list: CCTV, alarms, access control, structured cabling, audio visual, MSP, and VoIP for homes and businesses in Virginia Beach and Hampton Roads.";
---

<BaseLayout title={title} description={description} canonical="/services/">
  <HeroSection
    variant="page"
    align="left"
    bgImage="/assets/unsplash/hero-bg.jpg"
    eyebrow="What we do"
    title="Seven disciplines. One install standard."
    lead="Every service follows the same rule: plan first, label everything, and leave the property cleaner than you found it."
    ctas={[
      { label: "Request a consultation", href: "/contact/", variant: "primary" },
      { label: `Call ${site.phone}`, href: site.phoneHref, variant: "secondary" }
    ]}
    showCount={true}
    countNum="07"
    countLabel="Services"
    placeholderDesc="Hero image: wide shot of a commercial installation in progress — cameras, cable runs, and clean equipment staging."
  />

  <!-- Services list -->
  <section class="services-list" aria-label="Services">
    {services.map((service, i) => {
      const num = String(i + 1).padStart(2, "0");
      const isEven = i % 2 === 0;
      return (
        <article class={`service-showcase ${isEven ? "" : "service-showcase--reversed"}`} id={service.slug}>
          <div class="service-showcase-visual">
            <div class="service-showcase-num">{num}</div>
            <img src={service.image} alt={service.alt} loading="lazy" />
          </div>
          <div class="service-showcase-content">
            <p class="service-showcase-eyebrow">{service.title.split(" / ")[0]}</p>
            <h2>{service.title}</h2>
            <p class="service-showcase-summary">{service.summary}</p>
            <ul class="service-showcase-points">
              {service.points.map((point) => (
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6L9 17l-5-5" />
                  </svg>
                  {point}
                </li>
              ))}
            </ul>
            <a class="service-showcase-cta" href="/contact/">
              Request {service.title.split(" / ")[0].toLowerCase()} service
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </article>
      );
    })}
  </section>

  <!-- Process band -->
  <section class="section band reveal">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Process</p>
        <h2>How every project works.</h2>
      </div>
      <p>No package deals. No upsell pressure. Just a clear path from conversation to completion.</p>
    </div>
    <div class="process-timeline reveal-stagger">
      <div class="process-step">
        <span class="process-step-num">01</span>
        <h3>Consult</h3>
        <p>Walk the property. Identify risks. Define the scope and budget.</p>
        <MediaPlaceholder
          description="Photo: Elite Connect consultant walking a commercial property with a client, pointing at potential camera locations."
          aspect="16/9"
        />
      </div>
      <div class="process-step">
        <span class="process-step-num">02</span>
        <h3>Design</h3>
        <p>Map cameras, cable runs, hardware, and access points with precision.</p>
        <MediaPlaceholder
          description="Photo: Overhead floor plan or tablet showing camera placement layout during a design session."
          aspect="16/9"
        />
      </div>
      <div class="process-step">
        <span class="process-step-num">03</span>
        <h3>Install</h3>
        <p>Clean, labeled, professional work. Documented for future support.</p>
        <MediaPlaceholder
          description="Photo: Technician mounting a dome camera with clean cable management visible."
          aspect="16/9"
        />
      </div>
      <div class="process-step">
        <span class="process-step-num">04</span>
        <h3>Support</h3>
        <p>Guidance, service options, and expansion planning as you grow.</p>
        <MediaPlaceholder
          description="Photo: Remote support dashboard on a laptop or technician on a follow-up service call."
          aspect="16/9"
        />
      </div>
    </div>
  </section>

  <!-- Trust band -->
  <section class="section section-tight reveal">
    <div class="trust-strip reveal-stagger">
      <div><strong>20+</strong><span>Years combined experience</span></div>
      <div><strong>VA</strong><span>Class A Contractor</span></div>
      <div><strong>DCJS</strong><span># 11-20830</span></div>
      <div><strong>VB</strong><span>Hampton Roads local</span></div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="services-final-cta reveal">
    <div class="services-final-cta-inner">
      <p class="eyebrow">Ready to start</p>
      <h2>Not sure which service you need?</h2>
      <p class="lead">Most projects use more than one. Tell us what the property looks like and we will recommend the right combination.</p>
      <div class="hero-actions">
        <a class="button" href="/contact/">Free Consultation</a>
        <a class="button secondary" href={site.phoneHref}>{site.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>
