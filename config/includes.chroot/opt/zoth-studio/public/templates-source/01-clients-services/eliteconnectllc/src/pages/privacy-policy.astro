---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";

const title = "Privacy Policy | Elite Connect";
const description = "Elite Connect privacy policy.";
---

<BaseLayout title={title} description={description} canonical="/privacy-policy/" loaderLabel="Loading privacy policy...">
  <HeroSection
    variant="page"
    eyebrow="Legal"
    title="Privacy Policy"

    imageDesc="Professional office or consultation setting representing trust and compliance"
  />

  <section class="section">
    <div style="max-width: 720px; margin: 0 auto;">
      <h2>Information We Collect</h2>
      <p>Elite Connect collects information you provide through contact forms, including name, phone number, email, project details, and service preferences. This information is used solely to respond to your inquiry and provide requested services.</p>

      <h2>How We Use Information</h2>
      <p>We use collected information to respond to inquiries, schedule consultations, provide quotes, and deliver services. We do not sell or share personal information with third parties for marketing purposes.</p>

      <h2>Data Storage</h2>
      <p>Form submissions are processed through Netlify. Elite Connect retains contact information for business records and follow-up communications.</p>

      <h2>Contact</h2>
      <p>For privacy questions, contact Elite Connect at eliteconnectva@gmail.com.</p>
    </div>
  </section>
</BaseLayout>
