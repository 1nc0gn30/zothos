---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";

const title = "Residential Security Cameras, Alarms And Smart Home Low-Voltage | Elite Connect";
const description = "Home security cameras, alarm options, smart security, AV, and home cabling support from Elite Connect in Virginia Beach and Hampton Roads.";
---

<BaseLayout title={title} description={description} canonical="/residential/">
    <HeroSection
    variant="page"
    align="left"
    bgImage="/assets/gallery/residential-outdoor-work.jpg"
    eyebrow="Residential security systems"
    title="Protect the home without overcomplicating it."
    lead="Elite Connect helps homeowners choose, install, and support cameras, alarms, smart security, AV, and cabling with clear communication and clean workmanship."
    ctas={[{ label: "Request Home Consultation", href: "/contact/", variant: "primary" }]}
  />

  <section class="section band reveal">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Residential priorities</p>
        <h2>See the driveway, know the alarm works, and keep the tech simple.</h2>
      </div>
      <p>Home systems should be reliable, explainable, and expandable without a full replacement.</p>
    </div>
    <div class="path-grid reveal-stagger">
      <article class="path-card"><h3>Cameras + Doorbells</h3><p>Front door, driveway, backyard, and remote viewing with motion alerts.</p><a href="/services/#cctv-video-monitoring">Camera services</a></article>
      <article class="path-card"><h3>Alarms + Smart Panels</h3><p>Intrusion detection, smart panels, and monitoring options built around the home layout.</p><a href="/services/#alarm-systems">Alarm services</a></article>
      <article class="path-card"><h3>AV + Connectivity</h3><p>Displays, sound, WiFi coverage, and smart home controls that actually work together.</p><a href="/services/#audio-visual">AV services</a></article>
    </div>
  </section>

  <section class="section reveal">
    <div class="photo-feature">
      <div class="photo-feature-img">
        <img src="/assets/gallery/residential-outdoor-work.jpg" alt="Elite Connect technician working on low-voltage wiring outside a residential home" loading="lazy" />
      </div>
      <div class="content-block">
        <p class="eyebrow">Residential service</p>
        <h2>Home security and wiring without the hassle.</h2>
        <p>Elite Connect works cleanly on residential properties: no drywall damage, no mystery cables, and clear explanations of how everything works before leaving.</p>
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="two-column">
      <div class="content-block">
        <p class="eyebrow">Why Elite Connect</p>
        <h2>Local service with direct accountability.</h2>
        <p>No offshore call centers, no generic packages, no disappearing after the invoice. Elite Connect is built around the idea that a security company should actually answer the phone.</p>
      </div>
      <div class="content-block">
        <ul class="check-list">
          <li>Camera placement planning, not just mounting</li>
          <li>Alarm systems matched to the home layout</li>
          <li>Clean cable paths and hidden wiring</li>
          <li>Doorbell and smart device integration</li>
          <li>Support and expansion without system replacement</li>
          <li>Local Virginia Beach and Hampton Roads service</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
