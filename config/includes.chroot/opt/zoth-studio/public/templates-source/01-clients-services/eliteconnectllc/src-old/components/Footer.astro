---
import { nav, services, site } from "../data/site";
---

<footer class="site-footer">
  <section class="footer-cta">
    <div>
      <p class="eyebrow">Ready for a cleaner system?</p>
      <h2>Talk through the property, the risks, and the right technology plan.</h2>
    </div>
    <a class="button" href="/contact/">Request Consultation</a>
  </section>
  <div class="footer-grid">
    <div>
      <img class="footer-logo" src={site.logo} data-logo-light={site.logo} data-logo-dark={site.logoDark} alt="Elite Connect LLC logo" width="260" height="217" />
      <p>{site.license}<br />{site.dcjs}</p>
      <p>{site.serviceArea}</p>
    </div>
    <div>
      <h3>Company</h3>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/client-portal/">Client Portal</a>
    </div>
    <div>
      <h3>Services</h3>
      {services.slice(0, 7).map((service) => <a href={`/services/#${service.slug}`}>{service.title}</a>)}
    </div>
    <div>
      <h3>Contact</h3>
      <a href={site.phoneHref}>{site.phone}</a>
      <a href={site.emailHref}>{site.email}</a>
      <p>{site.location}</p>
      <a href={site.facebook}>Facebook</a>
      <a href="/privacy-policy/">Privacy Policy</a>
      <a href="/terms-of-service/">Terms of Service</a>
    </div>
  </div>
  <p class="copyright">© 2026 Elite Connect LLC. All rights reserved.</p>
</footer>


