---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";

const title = "Page Not Found | Elite Connect";
const description = "The requested Elite Connect page could not be found.";
---

<BaseLayout title={title} description={description} canonical="/404/">
    <HeroSection
    variant="page"
    align="left"
    eyebrow="404"
    title="That page is not connected." lead="Use the navigation to find services, contact details, or consultation options."
    ctas={[{ label: "View services", href: "/services/", variant: "primary" }]}
  />
</BaseLayout>
