#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
AGENT_DIR="$ROOT/.agents"

agents=(
  "design|frontend-designer|CSS, animations, responsive design, dark mode"
  "seo|content-seo|Copy, meta tags, schema, keywords, content"
  "astro|astro-developer|Components, routing, data layer, build config"
  "forms|forms-integrations|Netlify forms, lead modal, form submissions"
  "qa|qa-performance|Testing, Lighthouse, accessibility, build validation"
)

show_help() {
  echo ""
  echo "  ███████╗██╗     ██╗████████╗███████╗     ██████╗ ██████╗ ███╗   ██╗███╗   ██╗███████╗ ██████╗████████╗"
  echo "  ██╔════╝██║     ██║╚══██╔══╝██╔════╝    ██╔════╝██╔═══██╗████╗  ██║████╗  ██║██╔════╝██╔════╝╚══██╔══╝"
  echo "  █████╗  ██║     ██║   ██║   █████╗      ██║     ██║   ██║██╔██╗ ██║██╔██╗ ██║█████╗  ██║        ██║"
  echo "  ██╔══╝  ██║     ██║   ██║   ██╔══╝      ██║     ██║   ██║██║╚██╗██║██║╚██╗██║██╔══╝  ██║        ██║"
  echo "  ███████╗███████╗██║   ██║   ███████╗    ╚██████╗╚██████╔╝██║ ╚████║██║ ╚████║███████╗╚██████╗   ██║"
  echo "  ╚══════╝╚══════╝╚═╝   ╚═╝   ╚══════╝     ╚═════╝ ╚═════╝ ╚═╝  ╚═══╝╚═╝  ╚═══╝╚══════╝ ╚═════╝   ╚═╝"
  echo ""
  echo "  Elite Connect — AI Agent Dispatcher"
  echo ""
  echo "  USAGE:"
  echo "    ./scripts/agent <name> [prompt]"
  echo "    npm run agent:<name> -- [prompt]"
  echo ""
  echo "  AGENTS:"
  for a in "${agents[@]}"; do
    IFS='|' read -r key folder desc <<< "$a"
    printf "    %-8s %-22s %s\n" "$key:" "($folder)" "$desc"
  done
  echo ""
  echo "  EXAMPLES:"
  echo "    ./scripts/agent design 'Make the service cards pop more on hover'"
  echo "    npm run agent:seo -- 'Add FAQ schema markup for each question'"
  echo "    ./scripts/agent forms 'Add a subject field to the contact form'"
  echo "    npm run agent:qa -- 'Run Lighthouse and fix any score under 90'"
  echo ""
}

# Parse agent name
AGENT_KEY="${1:-}"
if [[ -z "$AGENT_KEY" ]]; then
  show_help
  exit 0
fi

# Shift prompt args
shift || true
USER_PROMPT="${*:-}"

# Resolve agent
SKILL_FILE=""
AGENT_NAME=""
for a in "${agents[@]}"; do
  IFS='|' read -r key folder desc <<< "$a"
  if [[ "$key" == "$AGENT_KEY" ]]; then
    SKILL_FILE="$AGENT_DIR/$folder/SKILL.md"
    AGENT_NAME="$folder"
    break
  fi
done

if [[ -z "$SKILL_FILE" ]]; then
  echo "❌ Unknown agent: $AGENT_KEY"
  show_help
  exit 1
fi

if [[ ! -f "$SKILL_FILE" ]]; then
  echo "❌ Skill file not found: $SKILL_FILE"
  exit 1
fi

SKILL_CONTENT="$(cat "$SKILL_FILE")"

PROMPT="You are working on the Elite Connect Astro website (eliteconnect-astro/).

=== AGENT SKILL ===
$SKILL_CONTENT

=== PROJECT CONTEXT ===
- Framework: Astro v5.x static site
- Styling: Single CSS file (src/styles/global.css)
- Data: src/data/site.ts
- Components: src/components/*.astro
- Pages: src/pages/*.astro
- Scripts: public/scripts/site.js
- Deployed on Netlify
- Domain: eliteconnectva.com

=== INSTRUCTIONS ===
1. Read the relevant files before making changes.
2. Make minimal, focused edits.
3. Update docs/ if the change affects documented behavior.
4. Respect the design system in global.css.
5. Test your change conceptually (build, responsive check).
"

if [[ -n "$USER_PROMPT" ]]; then
  PROMPT="$PROMPT

=== USER REQUEST ===
$USER_PROMPT"
fi

# Detect if we can use codex CLI
CODEX_CMD=""
if command -v codex >/dev/null 2>&1; then
  CODEX_CMD="codex"
elif command -v npx >/dev/null 2>&1; then
  CODEX_CMD="npx codex"
fi

# Try codex with --system flag
if [[ -n "$CODEX_CMD" ]]; then
  # Check if codex supports --system
  if $CODEX_CMD --help 2>&1 | grep -q -- '--system'; then
    echo "🚀 Launching Codex with $AGENT_NAME agent..."
    echo "$PROMPT" | $CODEX_CMD --system "You are the $AGENT_NAME agent for Elite Connect."
    exit 0
  fi
fi

# Fallback: output prompt for copy-paste
echo ""
echo "🤖 Elite Connect — $AGENT_NAME Agent"
echo "═══════════════════════════════════════════════════════════════════════════════"
echo ""
echo "Copy the prompt below and paste it into your AI assistant (Codex, ChatGPT, Claude, etc.):"
echo ""
echo "─────────────────────────────────────────────────────────────────────────────"
echo "$PROMPT"
echo "─────────────────────────────────────────────────────────────────────────────"
echo ""

if [[ -z "$CODEX_CMD" ]]; then
  echo "💡 Tip: Install the Codex CLI to run this automatically:"
  echo "   npm install -g @openai/codex"
  echo ""
fi
