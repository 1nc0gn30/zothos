---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";

const title = "Terms Of Service | Elite Connect LLC";
const description = "Website terms of service for Elite Connect LLC, including informational use, estimates, service availability, and limitation language.";
---

<BaseLayout title={title} description={description} canonical="/terms-of-service/">
    <HeroSection
    variant="page"
    align="left"
    eyebrow="Legal"
    title="Terms of Service"
    ctas={[]}
  />

  <section class="section band reveal">
    <div class="legal-grid">
      <article class="legal-card">
        <h2>Informational Use</h2>
        <p>This website provides general information about Elite Connect services. It does not constitute a binding contract or guarantee of service availability.</p>
      </article>
      <article class="legal-card">
        <h2>Estimates and Quotes</h2>
        <p>Any pricing or estimate information shared through this site is preliminary. Final project costs require an on-site or remote consultation and written agreement.</p>
      </article>
      <article class="legal-card">
        <h2>Service Area</h2>
        <p>Elite Connect primarily serves Virginia Beach and Hampton Roads. Projects outside this service area are evaluated on a case-by-case basis.</p>
      </article>
      <article class="legal-card">
        <h2>Limitations</h2>
        <p>Elite Connect is not liable for decisions made based solely on website content. Always confirm project details, licensing, and terms directly before work begins.</p>
      </article>
    </div>
  </section>
</BaseLayout>
