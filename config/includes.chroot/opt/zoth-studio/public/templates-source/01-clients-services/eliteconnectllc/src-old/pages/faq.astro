---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import FaqList from "../components/FaqList.astro";

const title = "Frequently Asked Questions | Elite Connect Virginia Beach";
const description = "Common questions about Elite Connect services, project types, licensing, consultation preparation, and commercial and residential security in Virginia Beach.";
---

<BaseLayout title={title} description={description} canonical="/faq/">
    <HeroSection
    variant="page"
    align="left"
    bgImage="/assets/unsplash/hero-bg.jpg"
    eyebrow="FAQ"
    title="Answers before the first call."
    lead="These questions help visitors understand what Elite Connect handles, how projects start, and what to expect during consultation and installation."
    ctas={[{ label: "Read all FAQs", href: "/faq/", variant: "ghost" }]}
    placeholderDesc="Hero image: close-up of technician hands working on a clean cable termination or camera mount."
  />

  <section class="section band reveal">
    <FaqList />
  </section>
</BaseLayout>
