---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const title = "Thank You | Elite Connect";
const description = "Thank you for contacting Elite Connect. Your consultation request has been received.";
---

<BaseLayout title={title} description={description} canonical="/thank-you/" loaderLabel="Loading confirmation...">
  <section class="thank-you-hero">
    <div class="thank-you-content">
      <div class="thank-you-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <p class="eyebrow">Thank you</p>
      <h1>Your request is received.</h1>
      <p class="thank-you-lead">Elite Connect will review your project details and follow up within one business day. For urgent security concerns, call directly.</p>
      <div class="thank-you-actions">
        <a class="button primary" href="/">Back to home</a>
        <a class="button secondary" href={site.phoneHref}>Call {site.phone}</a>
      </div>
      <div class="thank-you-meta">
        <div class="thank-you-meta-item"><strong>Phone</strong><span>{site.phone}</span></div>
        <div class="thank-you-meta-item"><strong>Email</strong><span>{site.email}</span></div>
        <div class="thank-you-meta-item"><strong>Hours</strong><span>Mon–Fri 8am–6pm</span></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .thank-you-hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 1.5rem 4rem;
  }
  .thank-you-content {
    max-width: 640px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .thank-you-icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
    color: #0f172a;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 12px 32px rgba(245, 158, 11, 0.35);
    margin-bottom: 0.5rem;
  }
  .thank-you-icon svg { width: 36px; height: 36px; }
  .thank-you-content h1 { font-size: clamp(2rem, 5vw, 3rem); }
  .thank-you-lead {
    font-size: 1.1rem;
    color: var(--muted);
    max-width: 480px;
    line-height: 1.6;
  }
  .thank-you-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.5rem;
  }
  .thank-you-meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    width: 100%;
  }
  .thank-you-meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .thank-you-meta-item strong {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--soft);
    font-family: var(--font-display);
  }
  .thank-you-meta-item span {
    font-size: 0.95rem;
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .thank-you-meta { grid-template-columns: 1fr; gap: 1rem; }
    .thank-you-actions { flex-direction: column; width: 100%; max-width: 280px; }
  }
</style>
