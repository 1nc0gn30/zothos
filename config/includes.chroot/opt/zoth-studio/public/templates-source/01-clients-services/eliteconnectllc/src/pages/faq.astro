---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import FaqList from "../components/FaqList.astro";

const title = "FAQ | Elite Connect Virginia Beach";
const description = "Common questions about Elite Connect services: CCTV, alarms, access control, structured cabling, AV, MSP, and VoIP in Virginia Beach and Hampton Roads.";
---

<BaseLayout title={title} description={description} canonical="/faq/" loaderLabel="Loading FAQ...">
  <HeroSection
    variant="page"
    eyebrow="FAQ"
    title="Quick answers before the first call."
    lead="Common questions about Elite Connect services, process, and what to expect during a consultation."

    imageDesc="Elite Connect technician consulting with a client at their property"
  />

  <section class="section">
    <FaqList />
  </section>
</BaseLayout>
