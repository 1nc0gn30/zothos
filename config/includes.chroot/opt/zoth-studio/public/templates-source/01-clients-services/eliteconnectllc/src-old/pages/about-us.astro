---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import MediaPlaceholder from "../components/MediaPlaceholder.astro";
import { site } from "../data/site";

const title = "About Elite Connect | Virginia Beach Low-Voltage And Security Company";
const description = "Learn about Elite Connect LLC, a Virginia Beach low-voltage and security company serving commercial and residential clients with professional installation and support.";
---

<BaseLayout title={title} description={description} canonical="/about-us/">
    <HeroSection
    variant="page"
    align="left"
    bgImage="/assets/gallery/client-consultation.jpg"
    eyebrow="About Elite Connect"
    title="Local, technical, and accountable after the install."
    lead="Elite Connect is a Virginia Beach low-voltage company with more than 20 years of combined experience across commercial and residential cabling, AV, automation, CCTV, alarms, and connected systems."
    ctas={[{ label: "Talk Through A Project", href: "/contact/", variant: "primary" }]}
    placeholderDesc="Hero image: team photo or company vehicle/branded van at a job site in Virginia Beach."
  />

  <section class="section band reveal">
    <div class="two-column">
      <div class="content-block">
        <p class="eyebrow">Company promise</p>
        <h2>Clean workmanship, clear communication, and systems that fit the actual property.</h2>
        <p>Elite Connect focuses on personalized service, competitive project planning, and high-quality workmanship. The goal is simple: understand the need, design the right solution, install it cleanly, and keep the client informed.</p>
      </div>
      <div class="content-block">
        <h2>Compliance</h2>
        <p>{site.license}</p>
        <p>{site.dcjs}</p>
        <p>This licensing information is intentionally visible across the site because it is required for advertising material.</p>
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="photo-feature">
      <div class="photo-feature-img">
        <img src="/assets/gallery/client-consultation.jpg" alt="Elite Connect consultant meeting with residential clients in person" loading="lazy" />
      </div>
      <div class="content-block">
        <p class="eyebrow">How we work</p>
        <h2>Consultation first, installation second.</h2>
        <p>Every project starts with a conversation. Elite Connect walks the property, asks the right questions, and designs a system that fits the space instead of forcing a package.</p>
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="proof-grid reveal-stagger">
      <article class="proof-card"><h3>Consultation First</h3><p>Start with the building, usage, pain points, and desired outcomes before choosing gear.</p></article>
      <article class="proof-card"><h3>Professional Installs</h3><p>Prioritize clean cable paths, good placement, careful setup, and serviceable documentation.</p></article>
      <article class="proof-card"><h3>Residential + Commercial</h3><p>Support homeowners and commercial clients without forcing both into the same package.</p></article>
      <article class="proof-card"><h3>Support Mindset</h3><p>Plan systems that can be maintained, expanded, and explained after the first install.</p></article>
    </div>
    <div style="margin-top: 2rem;">
      <MediaPlaceholder
        description="Photo: wide team shot of Elite Connect technicians and consultants at the office or on-site, showing the people behind the work."
        aspect="21/9"
      />
    </div>
  </section>
</BaseLayout>
