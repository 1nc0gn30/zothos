---
const googleReviewLink = "https://share.google/asn8fyqABF9aaYoAa";
---

<section class="section google-reviews-section" aria-labelledby="google-reviews-heading">
  <div class="google-reviews-inner">
    <div class="google-reviews-header">
      <div class="google-reviews-brand">
        <svg class="google-g-logo" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-label="Google">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        <div class="google-reviews-score">
          <div class="google-reviews-stars" aria-label="5 out of 5 stars">
            {Array.from({ length: 5 }).map(() => (
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            ))}
          </div>
          <span class="google-reviews-rating">5.0</span>
          <span class="google-reviews-count">· 1 review</span>
        </div>
      </div>
    </div>

    <blockquote class="google-review-card" cite={googleReviewLink}>
      <div class="google-review-quote-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 17h3l2-4V7H5v6h3l-2 4zm8 0h3l2-4V7h-6v6h3l-2 4z"/></svg>
      </div>
      <p class="google-review-text">Elite Connect installed cameras and alarms at my office in Virginia Beach. Clean install, labeled everything, and the app works perfectly. Highly recommend for any business owner.</p>
      <footer class="google-review-author">
        <div class="google-review-avatar" aria-hidden="true">J</div>
        <div class="google-review-meta">
          <cite>James R.</cite>
          <span class="google-review-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            Verified on Google
          </span>
        </div>
      </footer>
    </blockquote>

    <div class="google-reviews-cta">
      <a href={googleReviewLink} target="_blank" rel="noopener noreferrer" class="google-review-btn">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        Leave a Google Review
      </a>
      <a href={googleReviewLink} target="_blank" rel="noopener noreferrer" class="google-read-btn">
        Read on Google
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .google-reviews-section {
    background: linear-gradient(180deg, var(--paper) 0%, var(--surface-2) 100%);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 5rem 0;
  }

  .google-reviews-inner {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    text-align: center;
  }

  .google-reviews-header {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .google-reviews-brand {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    border-radius: 100px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: 0 4px 16px var(--shadow);
  }

  .google-g-logo {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }

  .google-reviews-score {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .google-reviews-stars {
    display: flex;
    gap: 2px;
    color: #fbbf24;
  }

  .google-reviews-stars svg {
    width: 18px;
    height: 18px;
  }

  .google-reviews-rating {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--ink);
  }

  .google-reviews-count {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted);
  }

  .google-review-card {
    position: relative;
    width: 100%;
    max-width: 640px;
    margin: 0;
    padding: 2.5rem 2rem 2rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: 0 8px 32px var(--shadow);
    text-align: left;
  }

  .google-review-quote-icon {
    position: absolute;
    top: -0.5rem;
    left: 1.5rem;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--brand-blue), var(--brand-blue-deep));
    color: #fff;
    box-shadow: 0 4px 12px rgba(118, 168, 205, 0.35);
  }

  .google-review-quote-icon svg {
    width: 18px;
    height: 18px;
  }

  .google-review-text {
    margin: 0 0 1.5rem;
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--ink);
    font-style: normal;
  }

  .google-review-author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }

  .google-review-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: #fff;
    background: linear-gradient(135deg, var(--brand-blue), var(--brand-blue-deep));
    flex-shrink: 0;
  }

  .google-review-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .google-review-meta cite {
    font-style: normal;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }

  .google-review-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--brand-blue);
  }

  .google-reviews-cta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .google-review-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.5rem;
    background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 50%, #d97706 100%);
    color: #0f172a;
    border-radius: var(--radius-md);
    font-weight: 700;
    font-size: 0.9rem;
    font-family: var(--font-display);
    box-shadow: 0 4px 14px rgba(245, 158, 11, 0.3);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .google-review-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(245, 158, 11, 0.4);
  }

  .google-read-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.85rem 1.25rem;
    border: 1.5px solid var(--line-strong);
    color: var(--muted);
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.9rem;
    font-family: var(--font-display);
    background: var(--surface);
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .google-read-btn:hover {
    border-color: var(--brand-blue);
    color: var(--brand-blue);
    transform: translateY(-2px);
  }

  @media (max-width: 560px) {
    .google-reviews-brand {
      padding: 0.75rem 1.25rem;
      gap: 0.75rem;
    }
    .google-review-card {
      padding: 2rem 1.25rem 1.5rem;
    }
    .google-review-quote-icon {
      width: 32px;
      height: 32px;
      left: 1.25rem;
    }
    .google-reviews-cta {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
    .google-review-btn,
    .google-read-btn {
      justify-content: center;
    }
  }
</style>
