---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";

const title = "Terms of Service | Elite Connect";
const description = "Elite Connect terms of service.";
---

<BaseLayout title={title} description={description} canonical="/terms-of-service/" loaderLabel="Loading terms of service...">
  <HeroSection
    variant="page"
    eyebrow="Legal"
    title="Terms of Service"

    imageDesc="Professional office or consultation setting representing business standards"
  />

  <section class="section">
    <div style="max-width: 720px; margin: 0 auto;">
      <h2>Service Agreement</h2>
      <p>Elite Connect provides security, low-voltage, and technology services based on written quotes and signed agreements. All work is performed by licensed technicians in accordance with Virginia state regulations.</p>

      <h2>Warranty</h2>
      <p>Elite Connect stands behind its workmanship. Equipment warranties are provided by manufacturers. Installation warranty terms are detailed in individual project agreements.</p>

      <h2>Liability</h2>
      <p>Elite Connect is fully licensed and insured. We maintain appropriate coverage for commercial and residential projects in Virginia.</p>

      <h2>Changes to Terms</h2>
      <p>These terms may be updated periodically. The current version is always available on this page.</p>
    </div>
  </section>
</BaseLayout>
