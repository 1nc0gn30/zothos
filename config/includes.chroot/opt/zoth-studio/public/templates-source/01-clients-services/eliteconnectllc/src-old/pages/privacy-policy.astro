---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";

const title = "Privacy Policy | Elite Connect LLC";
const description = "Privacy policy for Elite Connect LLC, covering contact form submissions, newsletter requests, analytics, and customer communications.";
---

<BaseLayout title={title} description={description} canonical="/privacy-policy/">
    <HeroSection
    variant="page"
    align="left"
    eyebrow="Legal"
    title="Privacy Policy"
    ctas={[]}
  />

  <section class="section band reveal">
    <div class="legal-grid">
      <article class="legal-card">
        <h2>Contact Form Data</h2>
        <p>Information submitted through the consultation form is used to respond to service inquiries. It is not sold or shared with third parties for marketing.</p>
      </article>
      <article class="legal-card">
        <h2>Analytics</h2>
        <p>This site may use privacy-focused analytics to understand traffic patterns. No personal identifiers are collected for advertising or retargeting.</p>
      </article>
      <article class="legal-card">
        <h2>Communications</h2>
        <p>By submitting a form or contacting Elite Connect, you consent to follow-up communication about your project or service request.</p>
      </article>
      <article class="legal-card">
        <h2>Updates</h2>
        <p>This policy may be updated as services and tools change. The current version is always available on this page.</p>
      </article>
    </div>
  </section>
</BaseLayout>
