---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import MediaPlaceholder from "../components/MediaPlaceholder.astro";
import { site } from "../data/site";

const title = "About Elite Connect | Virginia Beach Security & Low-Voltage";
const description = "Elite Connect is a Virginia Class A Contractor and DCJS-registered security company providing CCTV, alarms, access control, and low-voltage services in Hampton Roads.";
---

<BaseLayout title={title} description={description} canonical="/about-us/" loaderLabel="Loading about Elite Connect...">
  <HeroSection
    variant="page"
    eyebrow="About"
    title="Local team. Professional results."
    lead="Elite Connect is a Virginia Class A Contractor and DCJS-registered security company serving homes and businesses across Virginia Beach and Hampton Roads."
    imageDesc="Hero image: Elite Connect team, branded vehicle, or technician on a residential job site"
  />

  <section class="section">
    <div class="photo-feature">
      <div class="photo-feature-img"><MediaPlaceholder description="Team photo: technicians collaborating on a low-voltage or security installation project" aspect="4/3" /></div>
      <div class="content-block">
        <p class="eyebrow">The team</p>
        <h2>Built on experience, not shortcuts.</h2>
        <p>Elite Connect brings together licensed technicians, project managers, and security consultants who understand both the technical side and the business reality of every installation.</p>
        <p>{site.license}. {site.dcjs}. Serving {site.serviceArea}.</p>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="section-heading section-heading--center">
      <p class="eyebrow">Credentials</p>
      <h2>Licensed, registered, and accountable.</h2>
    </div>
    <div class="value-grid">
      <div><h3>Virginia Class A Contractor</h3><p>Licensed and insured in Virginia with the credentials to work on commercial and residential properties.</p></div>
      <div><h3>DCJS Registered</h3><p>DCJS # 11-20830. Security work handled by a registered team with proper background checks.</p></div>
      <div><h3>20+ Years Experience</h3><p>Decades of combined experience in security systems, low-voltage wiring, and technology infrastructure.</p></div>
      <div><h3>Local Accountability</h3><p>Based in Virginia Beach. Direct communication. No call centers or out-of-state contractors.</p></div>
    </div>
  </section>
</BaseLayout>
