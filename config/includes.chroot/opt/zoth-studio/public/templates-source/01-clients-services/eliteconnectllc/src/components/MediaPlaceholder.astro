---
interface Props {
  description?: string;
  aspect?: string;
  label?: string;
}

const { description = "Image placeholder", aspect = "4/3", label = "IMAGE" } = Astro.props;
---

<div class="media-placeholder" style={`aspect-ratio: ${aspect}`}>
  <div class="media-placeholder-inner">
    <svg class="media-placeholder-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
      <circle cx="8.5" cy="8.5" r="1.5"/>
      <polyline points="21 15 16 10 5 21"/>
    </svg>
    <span class="media-placeholder-label">{label}</span>
    <span class="media-placeholder-desc">{description}</span>
  </div>
</div>
