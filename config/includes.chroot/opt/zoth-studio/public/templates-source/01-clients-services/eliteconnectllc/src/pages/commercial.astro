---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import MediaPlaceholder from "../components/MediaPlaceholder.astro";

const title = "Commercial Security & Low-Voltage | Elite Connect Virginia Beach";
const description = "Commercial CCTV, access control, structured cabling, alarms, AV, MSP, and VoIP for offices, retail, warehouses, and industrial properties in Hampton Roads.";
---

<BaseLayout title={title} description={description} canonical="/commercial/" loaderLabel="Loading commercial solutions...">
  <HeroSection
    variant="page"
    eyebrow="Commercial"
    title="Security and infrastructure for working properties."
    lead="Elite Connect designs, installs, and supports camera systems, access control, alarms, cabling, AV, MSP, and communications for offices, retail spaces, warehouses, and industrial sites across Virginia Beach and Hampton Roads."
    imageDesc="Hero image of commercial security infrastructure: server rack, access control panel, or office building exterior"
  />

  <section class="section">
    <div class="photo-feature">
      <div class="photo-feature-img"><MediaPlaceholder description="Commercial project photo: organized cable runs, security camera coverage, or building infrastructure" aspect="4/3" /></div>
      <div class="content-block">
        <p class="eyebrow">Commercial security</p>
        <h2>Cameras, alarms, and access control that actually work together.</h2>
        <p>Elite Connect plans commercial security as one system instead of separate vendor visits. Cameras feed the network. Access control shares the same cable as VoIP. One team handles it all.</p>
        <a class="button secondary" href="/contact/">Request a commercial quote</a>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="section-heading section-heading--center">
      <p class="eyebrow">Commercial services</p>
      <h2>What Elite Connect handles for businesses.</h2>
    </div>
    <div class="value-grid">
      <div><h3>CCTV & Monitoring</h3><p>IP cameras, NVRs, remote access, motion alerts, and coverage planning for offices, retail, warehouses, and parking.</p></div>
      <div><h3>Access Control</h3><p>Card readers, fob systems, keypads, and door hardware for employee and vendor entry management.</p></div>
      <div><h3>Structured Cabling</h3><p>Data, voice, fiber, copper, racks, drops, and clean labeling for new buildouts and retrofits.</p></div>
      <div><h3>MSP & Managed IT</h3><p>Network support, security monitoring, recurring service, and business continuity planning.</p></div>
    </div>
  </section>
</BaseLayout>
