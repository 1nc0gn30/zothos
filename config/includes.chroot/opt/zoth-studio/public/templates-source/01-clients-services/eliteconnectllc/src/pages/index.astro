---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import FaqList from "../components/FaqList.astro";
import GoogleReviews from "../components/GoogleReviews.astro";
import LeadModal from "../components/LeadModal.astro";
import MediaPlaceholder from "../components/MediaPlaceholder.astro";
import { site, locations } from "../data/site";

const title = "Virginia Beach Security, Cabling And Low-Voltage Services | Elite Connect";
const description = "Elite Connect provides CCTV, alarms, access control, structured cabling, AV, MSP, and low-voltage services for homes and businesses in Virginia Beach and Hampton Roads.";

const heroImages = [
  "/assets/hero/hero-1.jpg",
  "/assets/hero/hero-2.jpg",
  "/assets/hero/hero-3.jpg",
  "/assets/hero/hero-4.jpg",
  "/assets/hero/hero-5.jpg",
  "/assets/hero/hero-6.jpg",
];
---

<BaseLayout title={title} description={description} canonical="/" loaderLabel="Loading Elite Connect...">
  <HeroSection
    variant="home"
    eyebrow="Virginia Beach low-voltage & security"
    title="Security, cabling, and managed technology built clean."
    lead="Elite Connect helps homeowners and businesses plan, install, and support cameras, alarms, access control, cabling, AV, MSP, and communications systems with local accountability."
    ctas={[
      { label: "Get a Free Quote", href: "/contact/", variant: "primary" },
      { label: `Call ${site.phone}`, href: site.phoneHref, variant: "secondary" },
    ]}
    stats={[
      { value: "20+", label: "Years experience" },
      { value: "VA", label: "Class A Contractor" },
      { value: "DCJS", label: "# 11-20830" },
    ]}
    showImage={true}
    imageDesc="High-resolution photo: security cameras, cabling, or completed installation representing Elite Connect work"
    heroImages={heroImages}
  />

  <LeadModal />

  <section class="section band">
    <div class="cta-band">
      <div class="cta-band-content">
        <p class="eyebrow">Ready when you are</p>
        <h2>Get on the contact list for priority scheduling.</h2>
        <p>Whether it is a single camera, a full buildout, or a system that needs support, Elite Connect follows up fast. Share what the property needs and we will call or email within one business day.</p>
        <div class="cta-band-actions">
          <a class="button primary" href="/contact/">Start a consultation</a>
          <a class="button secondary" href={site.phoneHref}>Call {site.phone}</a>
        </div>
      </div>
      <div class="hero-visual">
        <MediaPlaceholder description="CTA visual: professional consultation scene or technician preparing for a project" aspect="1/1" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="photo-feature">
      <div class="photo-feature-img">
        <MediaPlaceholder description="Photo feature: pristine cable management, labeled rack, or completed commercial installation" aspect="4/3" />
      </div>
      <div class="content-block">
        <p class="eyebrow">Real work</p>
        <h2>Installations that look as good as they function.</h2>
        <p>Elite Connect does not leave cable spaghetti behind. Every run is planned, labeled, and photographed so the next technician can work with it instead of around it.</p>
        <a class="button secondary" href="/gallery/">View project gallery</a>
      </div>
    </div>
  </section>

  <section class="section section-tight">
    <div class="trust-strip">
      <div><strong>Commercial</strong><span>Security, cabling, access, MSP, and communications for working properties.</span></div>
      <div><strong>Residential</strong><span>Cameras, alarms, smart security, AV, and home connectivity support.</span></div>
      <div><strong>Local</strong><span>{site.serviceArea} service with direct communication.</span></div>
      <div><strong>Compliant</strong><span>{site.license}. {site.dcjs}.</span></div>
    </div>
  </section>

  <section class="section band">
    <div class="section-heading section-heading--center">
      <div>
        <p class="eyebrow">What we do</p>
        <h2>Nine services. One team. No finger-pointing.</h2>
      </div>
      <p>Every system is designed to work with the others. Cameras talk to the network. Access control shares cable with VoIP. The same team that installs it supports it.</p>
    </div>
    <ServiceGrid />
  </section>

  <section class="section">
    <div class="section-heading section-heading--center">
      <p class="eyebrow">Why work with Elite Connect</p>
      <h2>Local accountability, professional results.</h2>
    </div>
    <div class="value-grid">
      <div><h3>Class A Contractor</h3><p>Licensed and insured in Virginia with the credentials to work on commercial and residential properties without shortcuts.</p></div>
      <div><h3>DCJS Registered</h3><p>DCJS # 11-20830. Security work is handled by a registered team with proper background checks and compliance.</p></div>
      <div><h3>Full-Property Planning</h3><p>Cameras, alarms, access, cabling, AV, MSP, and VoIP planned as one system instead of disconnected vendor visits.</p></div>
      <div><h3>Post-Install Support</h3><p>Systems are documented, labeled, and supported after install. Remote help, on-site service, and honest troubleshooting.</p></div>
    </div>
  </section>

  <section class="section band">
    <div class="section-heading section-heading--center">
      <p class="eyebrow">Service area</p>
      <h2>Virginia Beach and Hampton Roads</h2>
    </div>
    <div class="locations-grid">
      {locations.map((city) => <span>{city}</span>)}
    </div>
    <p class="locations-note">Not sure if the property is in range? <a href="/contact/">Ask during consultation</a> and Elite Connect will confirm.</p>
  </section>

  <GoogleReviews />

  <section class="section band">
    <div class="section-heading section-heading--center">
      <p class="eyebrow">Questions</p>
      <h2>Quick answers before the first call.</h2>
    </div>
    <div class="faq-intro" style="text-align: center; color: var(--muted); margin-bottom: 1.5rem;">
      <p>These questions support SEO and help commercial and residential visitors understand what Elite Connect can handle.</p>
      <a class="button secondary" href="/faq/">Read all FAQs</a>
    </div>
    <FaqList />
  </section>
</BaseLayout>
