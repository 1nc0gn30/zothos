---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import GoogleReviews from "../components/GoogleReviews.astro";
import MediaPlaceholder from "../components/MediaPlaceholder.astro";
import { site } from "../data/site";

const title = "Request A Consultation | Contact Elite Connect Virginia Beach";
const description = "Contact Elite Connect for CCTV, alarms, access control, structured cabling, AV, MSP, VoIP, and low-voltage project consultations in Virginia Beach and Hampton Roads.";
---

<BaseLayout title={title} description={description} canonical="/contact/" loaderLabel="Loading contact...">
  <HeroSection
    variant="page"
    eyebrow="Request consultation"
    title="Tell us what the property needs."
    lead="Share the service, location, urgency, and any existing system details. Elite Connect will follow up to talk through the right next step."
    imageDesc="Hero image: friendly technician consultation or branded Elite Connect vehicle at a job site"
  />

  <section class="section band">
    <div class="contact-layout">
      <div class="contact-form-wrapper">
        <form name="consultation" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you/" class="contact-form">
          <input type="hidden" name="form-name" value="consultation" />
          <p hidden><label>Do not fill this out: <input name="bot-field" /></label></p>

          <div class="form-grid">
            <label>Name<input name="name" type="text" autocomplete="name" placeholder="Your full name" required /></label>
            <label>Email<input type="email" name="email" autocomplete="email" placeholder="you@email.com" required /></label>
          </div>
          <div class="form-grid">
            <label>Phone<input name="phone" type="tel" autocomplete="tel" placeholder="804-000-0000" required /></label>
            <label>Project city<input name="city" type="text" autocomplete="address-level2" placeholder="Virginia Beach" /></label>
          </div>
          <div class="form-grid">
            <label>Customer type
              <select name="customer-type" required>
                <option value="" disabled selected>Select one</option>
                <option>Homeowner</option><option>Business</option><option>Contractor / partner</option>
              </select>
            </label>
            <label>Service interest
              <select name="service" required>
                <option value="" disabled selected>Select one</option>
                <option>CCTV / Video Monitoring</option><option>Alarm Systems</option><option>Access Control</option><option>Structured Cabling</option><option>Audio / Visual</option><option>MSP / Managed IT</option><option>VoIP / Communications</option><option>Other / Not Sure</option>
              </select>
            </label>
          </div>
          <label>Urgency
            <select name="urgency">
              <option>Planning ahead</option><option>Need quote soon</option><option>Active issue</option><option>New buildout / remodel</option>
            </select>
          </label>
          <label>Project details<textarea name="message" rows="5" placeholder="Describe the project..." required></textarea></label>
          <button type="submit" class="button primary">Send Consultation Request</button>
        </form>
      </div>

      <aside class="contact-card">
        <h2>Direct contact</h2>
        <p><strong>Phone:</strong> <a href={site.phoneHref}>{site.phone}</a></p>
        <p><strong>Email:</strong> <a href={site.emailHref}>{site.email}</a></p>
        <p><strong>Service area:</strong> {site.serviceArea}</p>
        <p><strong>License:</strong> {site.license}<br />{site.dcjs}</p>
        <p>For active security concerns, call instead of waiting on a form response.</p>
        <div style="margin-top: 1.5rem;">
          <MediaPlaceholder description="Contact card image: technician in conversation with client or on-site work inspection" aspect="4/3" />
        </div>
      </aside>
    </div>
  </section>

  <GoogleReviews />
</BaseLayout>
