# Example environment variables for create_payment_links.sh
#
# Copy this file and fill in your existing live (or test) Price IDs
# if you do NOT want the script to create new products/prices every run.
#
# Usage:
#   cp .env.payment-links.example .env.payment-links
#   # edit .env.payment-links with your price IDs
#   source .env.payment-links
#   ./create_payment_links.sh --live
#
# When the script succeeds, it also overwrites payment-links.js so the site
# starts using the generated Stripe Payment Link URLs automatically.
#
# Leave a value empty to have the script create a new product + price for that tier.

WORKSHOP_PRICE_ID=
PRIVATE_PRICE_ID=
PRIVATE_MONTHLY_PRICE_ID=
PRIVATE_ANNUAL_PRICE_ID=
STARTER_PRICE_ID=
AUTOPILOT_PRICE_ID=
SOCIAL_PRICE_ID=
