# Optional local defaults for provider setup.
# The app stores active provider keys in browser localStorage via the UI.
# Keep real secrets in local-only files and never commit them.

# OpenAI (if using OpenAI provider in app settings)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Ollama Cloud (if using Ollama Cloud provider)
OLLAMA_CLOUD_API_KEY=""
OLLAMA_CLOUD_BASE_URL="https://ollama.com"
OLLAMA_CLOUD_MODEL="llama3.1:8b"

# Ollama Local (if using local Ollama provider)
OLLAMA_LOCAL_BASE_URL="http://localhost:11434"
OLLAMA_LOCAL_MODEL="llama3.1:8b"
