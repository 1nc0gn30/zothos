---
import BaseLayout from "../layouts/BaseLayout.astro";
import { businessSchema } from "../data/schema.js";
import { site } from "../data/site.js";
---

<BaseLayout
  title="Privacy Policy | Poole Fencing LLC"
  description="Privacy policy for Poole Fencing LLC. How we handle your personal information, quote requests, and website data."
  path="/privacy-policy"
  schema={businessSchema()}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Legal</span>
      <h1>Privacy Policy</h1>
      <p>Effective date: May 3, 2026. Poole Fencing LLC (&ldquo;we,&rdquo; &ldquo;us,&rdquo; or &ldquo;our&rdquo;) operates the website {site.url}.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="article">
        <h2>Information we collect</h2>
        <p>When you submit a quote request form on our website, we collect the information you provide: name, email address, phone number, ZIP code, project type, approximate fence footage, and project description. We also collect standard web server log data (IP address, browser type, pages visited) through our hosting platform.</p>

        <h2>How we use your information</h2>
        <p>We use the information you provide solely to respond to your quote request, schedule estimates, communicate about your fence project, and follow up as needed. We do not sell, rent, or share your personal information with third parties for their marketing purposes.</p>

        <h2>Meta Pixel</h2>
        <p>Our website uses the Meta Pixel to measure the effectiveness of our advertising. The pixel collects anonymized page view data. You can opt out of Meta's interest-based advertising through your Facebook ad preferences.</p>

        <h2>Data retention</h2>
        <p>We retain quote request information for as long as needed to service your project and maintain business records. Web server logs are retained for a standard period by our hosting provider (Netlify).</p>

        <h2>Your rights</h2>
        <p>You may request that we delete your personal information by contacting us at {site.email}. We will respond within a reasonable timeframe.</p>

        <h2>Contact</h2>
        <p>For questions about this privacy policy, contact us at:<br />
        <a href={`mailto:${site.email}`}>{site.email}</a><br />
        <a href={site.phoneHref}>{site.phoneDisplay}</a></p>
      </article>
    </div>
  </section>
</BaseLayout>
