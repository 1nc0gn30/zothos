---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site.js";
---

<BaseLayout
  title="Page Not Found | Poole Fencing LLC"
  description="We can't seem to find the page you're looking for. Contact Poole Fencing LLC for fence installation quotes in North Florida and South Georgia."
  path="/404"
>
  <section class="not-found-section">
    <div class="container not-found-inner">
      <div class="not-found-visual" aria-hidden="true">
        <div class="fence-pickets">
          {Array.from({ length: 7 }).map(() => (
            <div class="picket" />
          ))}
        </div>
        <span class="not-found-code">404</span>
      </div>

      <span class="eyebrow">Lost in the weeds</span>
      <h1 class="not-found-title">We can't seem to find that page.</h1>
      <p class="not-found-lead">
        It might have moved, or the URL could be off. No worries — we can still get you where you need to go.
      </p>

      <div class="not-found-actions">
        <a class="button button-primary" href="/services">Explore Our Services</a>
        <a class="button button-ghost" href="/contact-us">Contact Us</a>
      </div>

      <div class="not-found-alternatives">
        <p class="not-found-or">Or maybe you were looking to…</p>
        <ul class="not-found-links">
          <li>
            <a href="/contact-us">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              Get a free quote
            </a>
          </li>
          <li>
            <a href={site.phoneHref}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              Call {site.phoneDisplay}
            </a>
          </li>
          <li>
            <a href="/projects">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              See past projects
            </a>
          </li>
          <li>
            <a href="/">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              Go back home
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found-section {
    padding: 96px 0 120px;
    background: var(--paper);
    text-align: center;
  }

  .not-found-inner {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .not-found-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 28px;
    user-select: none;
  }

  .fence-pickets {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    height: 84px;
    opacity: 0.18;
  }

  .picket {
    width: 10px;
    background: var(--green);
    border-radius: 2px 2px 0 0;
  }
  .picket:nth-child(1) { height: 64px; }
  .picket:nth-child(2) { height: 84px; }
  .picket:nth-child(3) { height: 72px; }
  .picket:nth-child(4) { height: 84px; }
  .picket:nth-child(5) { height: 72px; }
  .picket:nth-child(6) { height: 84px; }
  .picket:nth-child(7) { height: 64px; }

  .not-found-code {
    position: absolute;
    font-size: clamp(4.5rem, 10vw, 7.5rem);
    font-weight: 900;
    color: var(--green-900);
    letter-spacing: -0.03em;
    line-height: 1;
    text-shadow: 0 2px 0 var(--line);
  }

  .not-found-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: var(--green-900);
    line-height: 1.2;
    margin: 12px 0 16px;
  }

  .not-found-lead {
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    color: var(--muted);
    line-height: 1.6;
    max-width: 520px;
    margin: 0 0 32px;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-bottom: 40px;
  }

  .not-found-actions .button {
    min-height: 52px;
    padding: 0 28px;
    font-size: 1rem;
  }

  .not-found-or {
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 14px;
  }

  .not-found-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 24px;
    text-align: left;
  }

  .not-found-links li a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--green-800);
    font-weight: 650;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .not-found-links li a:hover {
    color: var(--green);
    text-decoration: underline;
  }

  .not-found-links li a svg {
    flex-shrink: 0;
    color: var(--green);
    stroke: var(--green);
  }

  @media (max-width: 560px) {
    .not-found-section {
      padding: 72px 0 96px;
    }
    .not-found-actions {
      width: 100%;
    }
    .not-found-actions .button {
      width: 100%;
    }
    .not-found-links {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>
