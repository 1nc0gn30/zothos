---
import { site } from "../data/site.js";
---

<div class="popup-overlay" id="popup-overlay" aria-hidden="true">
  <div class="popup-panel" role="dialog" aria-modal="true" aria-labelledby="popup-title">
    <button class="popup-close" id="popup-close" aria-label="Close popup">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <div class="popup-body">
      <div class="popup-image">
        <img
          src="/images/fences/vinyl-showcase.webp"
          alt="Vinyl privacy fence showcase by Poole Fencing in North Florida"
          width="600"
          height="400"
          loading="eager"
        />
      </div>
      <div class="popup-content">
        <span class="popup-eyebrow">Spring Special — Ends Soon</span>
        <h2 id="popup-title" class="popup-title">
          <span class="popup-nowrap"><span class="popup-gift" aria-hidden="true">🎁</span> Every</span> 200 Ft of Fence = <span class="popup-highlight">FREE Gate</span>
        </h2>
        <p class="popup-text">
          Three crews serving Lake City, Live Oak, Valdosta &amp; North Florida.
          No deposit required. We respond within 24 hours.
        </p>
        <ul class="popup-checklist">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Free on-site estimate</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> No deposit to schedule</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> 5-star rated local crews</li>
        </ul>

        <a class="button button-primary popup-cta" href="/contact-us#contact-form">
          Claim My Free Estimate &rarr;
        </a>

        <p class="popup-phone">
          Or call now: <a href={site.phoneHref}>{site.phoneDisplay}</a>
        </p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var overlay = document.getElementById("popup-overlay");
    var closeBtn = document.getElementById("popup-close");
    if (!overlay) return;

    function openPopup() {
      overlay.setAttribute("aria-hidden", "false");
      overlay.classList.add("is-open");
      document.body.style.overflow = "hidden";
      if (closeBtn) closeBtn.focus();
    }

    function closePopup() {
      overlay.setAttribute("aria-hidden", "true");
      overlay.classList.remove("is-open");
      document.body.style.overflow = "";
    }

    function scheduleOpen() {
      setTimeout(openPopup, 5000);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", scheduleOpen);
    } else {
      scheduleOpen();
    }

    if (closeBtn) {
      closeBtn.addEventListener("click", closePopup);
    }

    overlay.addEventListener("click", function (e) {
      if (e.target === overlay) closePopup();
    });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && overlay.classList.contains("is-open")) {
        closePopup();
      }
    });
  })();
</script>

<style>
  .popup-nowrap { white-space: nowrap; }
  .popup-gift {
    display: inline-block;
    animation: giftBounce 1.6s ease-in-out infinite;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.25));
    font-size: 0.95em;
    margin-left: 2px;
    transform-origin: center bottom;
  }
  .popup-highlight {
    display: inline-block;
    background: linear-gradient(135deg, rgba(244,196,48,0.18), rgba(244,196,48,0.08));
    color: var(--green-900);
    padding: 2px 10px;
    border-radius: 6px;
    border: 1.5px solid var(--gold);
    box-shadow: 0 2px 10px rgba(244,196,48,0.18);
    animation: highlightPulse 2.2s ease-in-out infinite;
  }
  @keyframes highlightPulse {
    0%, 100% { box-shadow: 0 2px 10px rgba(244,196,48,0.18); transform: translateY(0); }
    50% { box-shadow: 0 4px 18px rgba(244,196,48,0.32); transform: translateY(-1px); }
  }
  @keyframes giftBounce {
    0%, 100% { transform: translateY(0) rotate(-6deg) scale(1); }
    25% { transform: translateY(-6px) rotate(6deg) scale(1.12); }
    50% { transform: translateY(0) rotate(-4deg) scale(1.05); }
    75% { transform: translateY(-3px) rotate(4deg) scale(1.08); }
  }
</style>
