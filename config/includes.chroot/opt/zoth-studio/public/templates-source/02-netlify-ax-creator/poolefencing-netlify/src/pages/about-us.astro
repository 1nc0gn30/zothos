---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import { businessSchema } from "../data/schema.js";
---

<BaseLayout
  title="About Waylon Poole | Poole Fencing LLC Live Oak"
  description="Born and raised in Suwannee County. Waylon Poole started Poole Fencing with one truck and a pair of post diggers. Read his story."
  path="/about-us"
  schema={businessSchema()}
>
  <section class="about-page">
    <div class="container">

      <!-- Identity block -->
      <div class="about-identity">
        <div class="about-avatar">
          <img
            src="/images/brand/waylon-no-bg.webp"
            alt="Waylon Poole, owner of Poole Fencing LLC"
            width="940"
            height="940"
          />
        </div>
        <div class="about-identity-text">
          <span class="eyebrow">Owner & Operator</span>
          <h1>Waylon Poole</h1>
          <p class="about-standfirst">
            Born, raised, and still working in Suwannee County, FL.
            Three crews. Nine counties. Zero subcontractors.
          </p>
          <div class="about-stats-row">
            <div class="about-stat">
              <strong>3</strong>
              <span>install crews</span>
            </div>
            <div class="about-stat">
              <strong>9</strong>
              <span>counties served</span>
            </div>
            <div class="about-stat">
              <strong>0</strong>
              <span>subcontractors</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Story + Aside -->
      <div class="about-body">
        <article class="about-story">
          <h2>It started with one truck and a pair of post diggers.</h2>
          <p>
            I was born and raised here in Suwannee County, with a family that has a
            long history of doing business in this area. Generations of Pooles before
            me built things, sold things, and made a living working hard right here
            in North Florida.
          </p>
          <p>
            When I graduated from Suwannee High, I did some fence work as a side job.
            After a while, I figured: <span class="italic-accent">I'm going to try to
            make a business out of this.</span> When I first started, it was just me,
            a 1998 truck, and a pair of post diggers.
          </p>
          <p>
            I still remember the very first job I had as a real business. That truck
            has been replaced. The post diggers have been replaced a few times over.
            The work hasn't.
          </p>
          <p>
            Today, Poole Fencing has 3 install crews running across Suwannee,
            Columbia, Madison, Hamilton, Lafayette, Alachua, Leon, Duval, and Clay
            counties. The way we work hasn't changed: show up when we say we will,
            do the work right, charge a fair price, and
            <span class="bold-callout">stand behind it</span>.
          </p>
          <p class="about-signature">
            &mdash; Waylon Poole
          </p>
        </article>

        <aside class="about-aside">
          <div class="about-aside-card">
            <h3>Why we're different</h3>
            <ul>
              <li><strong>Owner-operated</strong> &mdash; Waylon is on most jobs, not just the sales calls.</li>
              <li><strong>Local crews</strong> &mdash; we live where we work, across Suwannee and surrounding counties.</li>
              <li><strong>No subcontractors</strong> &mdash; every crew is a Poole Fencing crew.</li>
              <li><strong>Straight answers</strong> &mdash; we tell you what the property actually needs, not what has the highest margin.</li>
            </ul>
          </div>
        </aside>
      </div>

    </div>
  </section>

  <CtaBand />
</BaseLayout>
