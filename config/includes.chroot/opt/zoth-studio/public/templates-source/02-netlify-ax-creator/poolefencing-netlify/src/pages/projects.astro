---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import { businessSchema } from "../data/schema.js";

const projectTypes = [
  { title: "Vinyl privacy", desc: "6ft and 8ft privacy systems for backyards, pools, and subdivisions.", alt: "White vinyl privacy fence installed around a Lake City backyard with closed gate", img: "/images/fences/vinyl-privacy.webp" },
  { title: "Wood privacy", desc: "Cedar, pine and board-on-board wood fences built to last. Privacy, picket and ranch styles.", alt: "Cedar board-on-board wood privacy fence with custom walk gate in Live Oak", img: "/images/fences/wood-fence-waylon.webp" },
  { title: "Chain link", desc: "Pet yards, commercial yards, storage lots, and privacy slat upgrades.", alt: "Black vinyl-coated chain link fence enclosing a residential yard in Gainesville", img: "/images/fences/chain-link.webp" },
  { title: "Ornamental aluminum", desc: "Pool-code and estate-style black aluminum fence systems.", alt: "Black ornamental aluminum fence surrounding a pool deck in Jacksonville area", img: "/images/fences/aluminum-pool-fence.webp" },
  { title: "Farm and field", desc: "Page wire, hi-tensile, barbed wire, cross-fencing, and gates.", alt: "Barbed wire farm field fence installed by Poole Fencing across a North Florida pasture", img: "/images/fences/farm-barbwire.webp" },
  { title: "Custom gates", desc: "Walk gates, drive gates, cantilever gates, and automated access.", alt: "Custom steel drive gate with automated opener on a rural property near Tallahassee", img: "/images/fences/gate-waylon-black.webp" },
];
---

<BaseLayout
  title="Fence Project Gallery | Poole Fencing LLC Live Oak FL"
  description="See recent fence projects across North Florida - vinyl, wood, chain link, ornamental, and farm fencing installations. Real local work."
  path="/projects"
  schema={businessSchema()}
>
  <section class="page-hero">
    <div class="container page-hero-grid">
      <div>
        <span class="eyebrow">Project gallery</span>
        <h1>Recent fence projects across North Florida.</h1>
        <p>Real install photos from Lake City, Live Oak, Gainesville, Tallahassee, Madison, Jacksonville, and nearby counties.</p>
      </div>
      <figure class="page-hero-media">
        <img
          src="/images/fences/transformation.webp"
          alt="Wood to vinyl fence transformation by Poole Fencing in North Florida"
          width="1024"
          height="1024"
        />
        <figcaption>Real materials, real yards, real local installs</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="project-grid">
        {projectTypes.map(({ title, desc, alt, img }) => (
          <div class="tile">
            <img
              src={img}
              alt={alt}
              width="600"
              height="400"
              style="min-height:180px;margin-bottom:16px;border-radius:3px;object-fit:cover;width:100%;"
              loading="lazy"
            />
            <h3>{title}</h3>
            <p>{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand heading="See a fence style you like? We can usually match or improve it." />
</BaseLayout>
