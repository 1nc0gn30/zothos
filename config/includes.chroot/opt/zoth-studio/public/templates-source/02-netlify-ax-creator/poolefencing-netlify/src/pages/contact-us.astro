---
import BaseLayout from "../layouts/BaseLayout.astro";
import GhlForm from "../components/GhlForm.astro";
import { businessSchema } from "../data/schema.js";
import { site } from "../data/site.js";
---

<BaseLayout
  title="Contact Poole Fencing | Free Quotes (386) 688-1293"
  description="Get a free fence quote. Call (386) 688-1293 or fill out the form. We respond within 24 hours, Mon-Sat 8am-6pm. Lake City and Live Oak, FL."
  path="/contact-us"
  schema={businessSchema()}
>
  <section class="page-hero">
    <div class="container page-hero-grid">
      <div>
        <span class="eyebrow">Free quote</span>
        <h1>Get your free fence quote.</h1>
        <p>
          Tell us about your project. We typically respond within 24 hours and
          schedule a free on-site estimate within 48 hours.
        </p>
        <p class="button-row">
          <a class="button button-primary" href={site.phoneHref}>
            📞 {site.phoneDisplay}
          </a>
        </p>
      </div>
      <GhlForm
        formId="QFFPj4gAUExW0PGozOoj"
        formName="Poole Fencing Form contact page"
        height={700}
      />
    </div>
  </section>

  <section class="section" id="contact-details">
    <div class="container split">
      <div class="text-stack">
        <h2>Call or send the project details.</h2>
        <p class="lead">
          No deposit required to schedule the estimate. We service the 60-mile
          region around Live Oak, including Suwannee, Columbia, Madison, Hamilton,
          Lafayette, Alachua, Leon, Duval, and surrounding counties.
        </p>
        <ul class="feature-list">
          <li><a href={site.phoneHref}><strong>{site.phoneDisplay}</strong></a></li>
          <li>{site.email}</li>
          <li>{site.hours}</li>
        </ul>
      </div>
      <figure class="page-hero-media">
        <img
          src="/images/fences/backyard-privacy.webp"
          alt="Backyard privacy fence installed by Poole Fencing for a North Florida homeowner"
          width="680"
          height="510"
        />
        <figcaption>Free on-site estimates across the 60-mile region</figcaption>
      </figure>
    </div>
  </section>
</BaseLayout>
