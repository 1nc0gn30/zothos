---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import ServiceRows from "../../components/ServiceRows.astro";
import { businessSchema } from "../../data/schema.js";
---

<BaseLayout
  title="Fence Installation Services | Poole Fencing LLC"
  description="Vinyl, wood, chain link, ornamental aluminum, farm fencing and custom gate installation across Lake City, Live Oak and North Florida."
  path="/services"
  schema={businessSchema()}
>
  <section class="page-hero">
    <div class="container page-hero-grid">
      <div>
        <span class="eyebrow">Services</span>
        <h1>Fence services built around North Florida property.</h1>
        <p>
          Residential, commercial, rural, pool-code, and custom gate work &mdash;
          from crews that install these systems every week.
        </p>
      </div>
      <figure class="page-hero-media">
        <img
          src="/images/fences/wood-front-yard.webp"
          alt="Custom wood privacy fence installed by Poole Fencing in North Florida"
          width="2048"
          height="1536"
        />
        <figcaption>Privacy, security, pool-code, farm, and gate work</figcaption>
      </figure>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <ServiceRows />
    </div>
  </section>
  <CtaBand />
</BaseLayout>
