---
import { nav, serviceAreas, services, site } from "../data/site.js";

const googleMapsUrl = "https://maps.app.goo.gl/nsWXpYHb4c196pgJ7";
const facebookUrl = site.socials.find((s) => s.includes("facebook")) || "";
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand + Contact -->
      <div class="footer-company">
        <a class="footer-brand" href="/" aria-label="Poole Fencing LLC — Homepage">
          <img
            src="/images/brand/logo.webp"
            alt="Poole Fencing LLC"
            width="180"
            height="52"
          />
        </a>
        <p class="footer-description">{site.description}</p>
        <div class="footer-contact-card">
          <a href={site.phoneHref}>{site.phoneDisplay}</a>
          <span>{site.email}</span>
          <span>{site.hours}</span>
        </div>
        <div class="footer-social-row">
          {facebookUrl && (
            <a class="footer-social-link" href={facebookUrl} target="_blank" rel="noopener noreferrer" aria-label="Poole Fencing on Facebook">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              <span>Facebook</span>
            </a>
          )}
          <a class="footer-social-link" href={googleMapsUrl} target="_blank" rel="noopener noreferrer" aria-label="Poole Fencing on Google Maps">
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z" fill="#4285F4"/><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z" fill="none" stroke="#1a1a1a" stroke-width="0.5" opacity="0.1"/><circle cx="12" cy="9" r="2.5" fill="white" opacity="0.3"/></svg>
            <span>Google Maps</span>
          </a>
        </div>
      </div>
      <!-- Services -->
      <div class="footer-link-group">
        <strong>Fence Services</strong>
        <ul class="footer-links">
          {services.slice(0, 7).map((service) => (
            <li><a href={`/services/${service.slug}`}>{service.h1.replace(" - ", " ")}</a></li>
          ))}
          <li><a href="/services">All Services &rarr;</a></li>
        </ul>
      </div>
      <!-- Company -->
      <div class="footer-link-group">
        <strong>Company</strong>
        <ul class="footer-links">
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/privacy-policy">Privacy Policy</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Poole Fencing LLC. Licensed and insured fence installation.</p>
      <p>Serving {serviceAreas.map((a) => a.h1.replace("Fence Installation in ", "").replace("Fence Installation Serving the ", "")).join(", ")} and surrounding North Florida communities.</p>
    </div>
  </div>
</footer>
