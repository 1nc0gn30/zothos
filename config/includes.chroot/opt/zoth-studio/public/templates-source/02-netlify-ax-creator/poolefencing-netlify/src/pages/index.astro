---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import ProofStrip from "../components/ProofStrip.astro";
import Popup from "../components/Popup.astro";
import GhlForm from "../components/GhlForm.astro";
import { businessSchema } from "../data/schema.js";
import { serviceAreas, site } from "../data/site.js";
const serviceAreaMap = serviceAreas.map((area, index) => {
  const cityName = area.h1.replace("Fence Installation in ", "").replace("Fence Installation Serving the ", "");
  const positions = {
    "lake-city-fl": { lat: 30.1897, lng: -82.6393, label: "Lake City" },
    "live-oak-fl": { lat: 30.2949, lng: -82.9840, label: "Live Oak" },
    "gainesville-fl": { lat: 29.6516, lng: -82.3248, label: "Gainesville" },
    "jacksonville-fl": { lat: 30.3322, lng: -81.6557, label: "Jacksonville" },
    "tallahassee-fl": { lat: 30.4383, lng: -84.2807, label: "Tallahassee" },
    "madison-fl": { lat: 30.4694, lng: -83.4129, label: "Madison" },
    "valdosta-ga": { lat: 30.8327, lng: -83.2785, label: "Valdosta" },
  };
  return {
    ...area,
    cityName,
    mapLabel: positions[area.slug]?.label || cityName.replace(", FL", ""),
    lat: positions[area.slug]?.lat || 30.2949,
    lng: positions[area.slug]?.lng || -82.9840,
    active: index === 0,
  };
});
const liveOakBase = serviceAreaMap.find((area) => area.slug === "live-oak-fl") || {
  lat: 30.2949,
  lng: -82.9840,
};
---
<BaseLayout
  title="Poole Fencing | Lake City & Live Oak FL Fence Company"
  description="Family-owned fence installation across North Florida. Vinyl, wood, chain link, ornamental and farm. 5-star rated. Free quote - call (386) 688-1293."
  path="/"
  schema={businessSchema()}
>
  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <span class="hero-eyebrow">Lake City &bull; Live Oak &bull; Valdosta &bull; North Florida</span>
        <h1>Fences that<br><span class="hero-last">last.</span></h1>
        <p class="hero-sub">
          Family-owned fence installation for privacy yards, pool enclosures,
          rural acreage, commercial lots, and custom gates across the 60-mile
          North Florida and South Georgia region.
        </p>
        <div class="hero-cta-row">
          <a class="button button-primary" href="/contact-us#contact-form">Get a Free Quote &rarr;</a>
          <a class="button button-secondary" href={site.phoneHref}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call {site.phoneDisplay}
          </a>
        </div>
      </div>
      <div class="hero-showcase" aria-label="Poole Fencing project examples">
        <figure class="hero-showcase-main">
          <div class="hero-carousel" data-carousel="hero" role="region" aria-roledescription="carousel" aria-label="Fence project photos">
            <div class="hero-carousel-track">
              <div class="hero-carousel-slide is-active" aria-label="Slide 1 of 4">
                <img src="/images/fences/gate-driveway.webp" alt="White vinyl driveway gate installed by Poole Fencing" width="2048" height="1536" />
              </div>
              <div class="hero-carousel-slide" aria-label="Slide 2 of 4">
                <img src="/images/fences/wood-fence-waylon.webp" alt="Wood privacy fence built by Poole Fencing crews" width="2048" height="1536" />
              </div>
              <div class="hero-carousel-slide" aria-label="Slide 3 of 4">
                <img src="/images/fences/vinyl-privacy.webp" alt="Vinyl privacy fence installed in North Florida" width="2048" height="1536" />
              </div>
              <div class="hero-carousel-slide" aria-label="Slide 4 of 4">
                <img src="/images/fences/farm-field.webp" alt="Farm field fence along a North Florida pasture" width="2048" height="1536" />
              </div>
            </div>
            <div class="hero-carousel-dots" aria-hidden="true"></div>
            <button class="carousel-arrow carousel-arrow-prev" aria-label="Previous slide">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button class="carousel-arrow carousel-arrow-next" aria-label="Next slide">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </figure>
        <div class="hero-service-card">
          <span>Popular fence projects</span>
          <strong>Privacy fencing, custom gates, and farm field fence</strong>
        </div>
      </div>
    </div>
  </section>
  <!-- ===== FREE QUOTE FORM ===== -->
  <section class="section" id="contact-form">
    <div class="container split">
      <div class="text-stack">
        <span class="eyebrow">Free quote</span>
        <h2>Get your free fence quote today.</h2>
        <p class="lead">
          Tell us about your project. We typically respond within 24 hours and
          schedule a free on-site estimate within 48 hours.
        </p>
        <ul class="feature-list">
          <li><a href={site.phoneHref}><strong>{site.phoneDisplay}</strong></a></li>
          <li>{site.email}</li>
          <li>{site.hours}</li>
        </ul>
      </div>
      <GhlForm
        formId="QFFPj4gAUExW0PGozOoj"
        formName="Poole Fencing Form homepage"
        height={694}
      />
    </div>
  </section>
  <!-- ===== WHY POOLE ===== -->
  <section class="section why-poole-section">
    <div class="container">
      <div class="why-poole-header">
