          </ul>
          <div class="button-row" style="margin-top:8px">
            <a class="button button-primary" href="/services">See All Services &rarr;</a>
            <a class="button button-ghost" href="/contact-us">Get a Quote</a>
          </div>
        </div>
        <div class="services-cta-visual">
          <div class="image-carousel" data-carousel="services" role="region" aria-roledescription="carousel" aria-label="Fence service photos">
            <div class="image-carousel-track">
              <div class="image-carousel-slide is-active" aria-label="Slide 1 of 5">
                <img src="/images/fences/aluminum-pool.webp" alt="Ornamental aluminum pool fence by Poole Fencing" width="2048" height="1536" loading="lazy" />
              </div>
              <div class="image-carousel-slide" aria-label="Slide 2 of 5">
                <img src="/images/fences/wood-custom.webp" alt="Custom wood fence design built by Poole Fencing" width="2048" height="1536" loading="lazy" />
              </div>
              <div class="image-carousel-slide" aria-label="Slide 3 of 5">
                <img src="/images/fences/wood-privacy.webp" alt="Wood privacy fence installation in North Florida" width="2048" height="1536" loading="lazy" />
              </div>
              <div class="image-carousel-slide" aria-label="Slide 4 of 5">
                <img src="/images/fences/chain-link.webp" alt="Chain link fence for residential property" width="2048" height="1536" loading="lazy" />
              </div>
              <div class="image-carousel-slide" aria-label="Slide 5 of 5">
                <img src="/images/fences/backyard-privacy.webp" alt="Backyard privacy fence by Poole Fencing" width="2048" height="1536" loading="lazy" />
              </div>
            </div>
            <div class="image-carousel-dots" aria-hidden="true"></div>
            <button class="carousel-arrow carousel-arrow-prev" aria-label="Previous slide">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button class="carousel-arrow carousel-arrow-next" aria-label="Next slide">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
