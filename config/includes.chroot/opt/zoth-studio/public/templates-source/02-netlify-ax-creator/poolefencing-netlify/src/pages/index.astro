  </section>
  <section id="service-areas" class="section service-map-section">
    <div class="container">
      <div class="service-map-header">
        <div>
          <span class="eyebrow">Service area</span>
          <h2>
            Based in Live Oak. Built around the 60-mile North Florida and South Georgia region.
          </h2>
        </div>
      </div>
      <div class="service-map-layout" data-service-map>
        <div class="service-map-panel" aria-label="Interactive North Florida service area map">
          <div
            id="service-leaflet-map"
            class="service-leaflet-map"
            data-areas={JSON.stringify(serviceAreaMap)}
            data-base-lat={liveOakBase.lat}
            data-base-lng={liveOakBase.lng}
          >
          </div>
          <div class="map-fallback">
            <strong>North Florida service map</strong>
            <span>Map tiles load from OpenStreetMap when JavaScript is available.</span>
          </div>
        </div>
        <div class="service-area-list" aria-label="Service area details">
          {serviceAreaMap.map((area) => (
            <article class={`service-area-card ${area.active ? "is-active" : ""}`} data-area-card={area.slug}>
              <button type="button" data-area-target={area.slug}>
                <span>{area.cityName}</span>
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <p>{area.summary}</p>
              <a href={`/service-areas/${area.slug}`}>See services provided in this area</a>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container split">
      <div>
        <span class="eyebrow">Recent work</span>
        <h2>See what a Poole fence actually looks like.</h2>
        <a class="button button-outline" href="/projects" style="margin-top:24px">Browse Project Gallery &rarr;</a>
      </div>
      <div class="project-gallery-preview">
        <div class="image-carousel" data-carousel="recent" role="region" aria-roledescription="carousel" aria-label="Recent Poole Fencing project photos">
          <div class="image-carousel-track">
            <div class="image-carousel-slide is-active" aria-label="Slide 1 of 5">
              <img src="/images/fences/transformation.webp" alt="Fence transformation before and after" width="2048" height="1536" loading="lazy" />
            </div>
            <div class="image-carousel-slide" aria-label="Slide 2 of 5">
              <img src="/images/fences/vinyl-showcase.webp" alt="Vinyl fence showcase by Poole Fencing" width="2048" height="1536" loading="lazy" />
            </div>
            <div class="image-carousel-slide" aria-label="Slide 3 of 5">
              <img src="/images/fences/aluminum-pool-fence.webp" alt="Aluminum pool fence installation" width="2048" height="1536" loading="lazy" />
            </div>
            <div class="image-carousel-slide" aria-label="Slide 4 of 5">
              <img src="/images/fences/farm-barbwire.webp" alt="Farm barbwire fencing in North Florida" width="2048" height="1536" loading="lazy" />
            </div>
            <div class="image-carousel-slide" aria-label="Slide 5 of 5">
              <img src="/images/fences/gate-waylon-black.webp" alt="Custom gate installation by Poole Fencing" width="2048" height="1536" loading="lazy" />
            </div>
          </div>
          <div class="image-carousel-dots" aria-hidden="true"></div>
          <button class="carousel-arrow carousel-arrow-prev" aria-label="Previous slide">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button class="carousel-arrow carousel-arrow-next" aria-label="Next slide">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </div>
    </div>
  </section>
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline>
    (function () {
      const root = document.querySelector("[data-service-map]");
      if (!root) return;
      const mapEl = root.querySelector("#service-leaflet-map");
      const cards = Array.from(root.querySelectorAll("[data-area-card]"));
      const triggers = Array.from(root.querySelectorAll("[data-area-target]"));
      const areas = JSON.parse(mapEl?.dataset.areas || "[]");
      const baseLat = Number(mapEl?.dataset.baseLat || 30.2949);
      const baseLng = Number(mapEl?.dataset.baseLng || -82.9840);
      let map;
      function setActive(slug) {
        cards.forEach((card) => card.classList.toggle("is-active", card.dataset.areaCard === slug));
      }
      function initMap() {
        if (!window.L || !mapEl || !areas.length) return;
        map = L.map(mapEl, {
          center: [baseLat, baseLng],
          zoom: 7,
          minZoom: 7,
          maxZoom: 10,
          maxBounds: [[29.05, -84.95], [30.95, -81.2]],
          maxBoundsViscosity: 0.92,
          scrollWheelZoom: false,
          attributionControl: true,
        });
        L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
          maxZoom: 19,
          attribution: "&copy; OpenStreetMap contributors",
        }).addTo(map);
        const bounds = [];
        areas.forEach((area) => bounds.push([area.lat, area.lng]));
        const routeOrder = [
          "tallahassee-fl",
          "madison-fl",
          "valdosta-ga",
          "live-oak-fl",
          "lake-city-fl",
          "gainesville-fl",
          "jacksonville-fl",
          "lake-city-fl",
          "live-oak-fl",
        ];
        const routePoints = routeOrder
          .map((slug) => areas.find((area) => area.slug === slug))
          .filter(Boolean)
          .map((area) => [area.lat, area.lng]);
        const coverageBlob = [
          [30.90, -84.48],
          [30.85, -83.30],
          [30.74, -84.48],
          [30.63, -83.82],
          [30.55, -83.31],
          [30.49, -82.78],
          [30.56, -82.16],
          [30.48, -81.50],
          [30.14, -81.33],
          [29.82, -81.70],
          [29.50, -82.11],
          [29.36, -82.61],
          [29.57, -83.02],
          [29.82, -83.42],
          [29.97, -84.02],
          [30.25, -84.49],
        ];
        const coverageCore = [
          [30.80, -83.30],
          [30.52, -83.86],
          [30.45, -83.34],
          [30.39, -82.91],
          [30.41, -82.48],
          [30.38, -81.91],
          [30.18, -81.62],
          [29.83, -81.91],
          [29.68, -82.32],
          [29.76, -82.78],
          [30.02, -83.24],
          [30.13, -83.76],
        ];
        L.polygon(coverageBlob, {
          color: "#f4c430",
          weight: 1,
          opacity: 0.28,
          fillColor: "#f4c430",
          fillOpacity: 0.12,
          className: "service-heat-outer",
        }).addTo(map);
        L.polygon(coverageCore, {
          color: "#f4c430",
          weight: 0,
          opacity: 0,
          fillColor: "#f4c430",
          fillOpacity: 0.18,
          className: "service-heat-core",
        }).addTo(map);
        L.polyline(routePoints, {
          color: "#f4c430",
          weight: 12,
          opacity: 0.18,
          lineCap: "round",
          lineJoin: "round",
          className: "service-snake-glow",
        }).addTo(map);
        L.polyline(routePoints, {
          color: "#f4c430",
          weight: 5,
          opacity: 0.95,
          lineCap: "round",
          lineJoin: "round",
          dashArray: "18 26",
          className: "service-snake-route",
        }).addTo(map);
        map.fitBounds(bounds, { padding: [34, 34] });
        setActive(areas[0].slug);
      }
      triggers.forEach((trigger) => {
        trigger.addEventListener("click", () => setActive(trigger.dataset.areaTarget));
      });
      initMap();
    })();
  </script>

<Popup />


<script is:inline>
  (function () {
    function initCarousel(carousel) {
      if (!carousel) return;
      var slideSelector = carousel.classList.contains('hero-carousel') ? '.hero-carousel-slide' : '.image-carousel-slide';
      var dotsSelector = carousel.classList.contains('hero-carousel') ? '.hero-carousel-dots' : '.image-carousel-dots';
      var slides = carousel.querySelectorAll(slideSelector);
      var dotsContainer = carousel.querySelector(dotsSelector);
      var prevBtn = carousel.querySelector('.carousel-arrow-prev');
      var nextBtn = carousel.querySelector('.carousel-arrow-next');
      var current = 0;
      var interval;
      var DURATION = 6000;

      if (dotsContainer) {
        slides.forEach(function (_, i) {
          var btn = document.createElement('button');
          btn.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          btn.addEventListener('click', function () {
            goTo(i);
            resetTimer();
          });
          dotsContainer.appendChild(btn);
        });
      }

      var dots = dotsContainer ? dotsContainer.querySelectorAll('button') : [];

      function update() {
        slides.forEach(function (slide, i) {
          slide.classList.toggle('is-active', i === current);
        });
        dots.forEach(function (dot, i) {
          dot.classList.toggle('is-active', i === current);
        });
      }

      function prev() {
        current = (current - 1 + slides.length) % slides.length;
        update();
      }

      function next() {
        current = (current + 1) % slides.length;
        update();
      }

      function goTo(index) {
        current = index;
        update();
      }

      function resetTimer() {
        clearInterval(interval);
        interval = setInterval(next, DURATION);
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function () { prev(); resetTimer(); });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', function () { next(); resetTimer(); });
      }

      update();
      interval = setInterval(next, DURATION);

      carousel.addEventListener('mouseenter', function () { clearInterval(interval); });
      carousel.addEventListener('mouseleave', function () { interval = setInterval(next, DURATION); });
      carousel.addEventListener('focusin', function () { clearInterval(interval); });
      carousel.addEventListener('focusout', function () { interval = setInterval(next, DURATION); });
    }

    document.querySelectorAll('[data-carousel]').forEach(initCarousel);
  })();
</script>
</BaseLayout>