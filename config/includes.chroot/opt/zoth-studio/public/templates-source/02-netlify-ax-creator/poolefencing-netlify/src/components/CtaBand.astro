---
import { site } from "../data/site.js";

const {
  heading = "Stop wondering and get a real number.",
  text = "Tell us about your project and we will get you a free quote within 24-48 hours."
} = Astro.props;
---

<section class="cta-band" data-cta-reveal>
  <div class="cta-band-glow" aria-hidden="true"></div>
  <div class="container cta-band-inner">
    <div class="cta-band-content">
      <span class="eyebrow eyebrow-light">Free quote</span>
      <h2 class="cta-band-heading">{heading}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-band-actions">
      <a class="button button-primary" href="/contact-us">Get a Free Quote &rarr;</a>
      <a class="button button-cta-call" href={site.phoneHref}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Call {site.phoneDisplay}
      </a>
    </div>
  </div>

  <script is:inline>
    (function () {
      var section = document.querySelector("[data-cta-reveal]");
      var heading = section && section.querySelector(".cta-band-heading");
      if (!section || !heading) return;

      heading.classList.add("cta-band-heading--hidden");

      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            heading.classList.remove("cta-band-heading--hidden");
            heading.classList.add("cta-band-heading--visible");
          } else {
            heading.classList.remove("cta-band-heading--visible");
            heading.classList.add("cta-band-heading--hidden");
          }
        });
      }, { threshold: 0.3 });

      observer.observe(section);
    })();
  </script>
</section>
