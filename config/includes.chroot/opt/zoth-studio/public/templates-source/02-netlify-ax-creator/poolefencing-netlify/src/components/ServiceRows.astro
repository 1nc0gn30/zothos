---
import { services } from "../data/site.js";

const accents: Record<string, string> = {
  "vinyl-fencing": "#f4c430",
  "wood-fencing": "#8b6914",
  "residential-chainlink": "#6b8e6b",
  "commercial-chainlink": "#4a6741",
  "ornamental-aluminum": "#2c2c2c",
  "farm-field-fencing": "#b8860b",
  "custom-gates": "#8b4513",
};
---

<div class="service-card-grid">
  {services.map((service) => (
    <a class="service-card" href={`/services/${service.slug}`} style={`--card-accent: ${accents[service.slug] || "var(--gold)"}`}>
      <span class="service-card-tag">{service.eyebrow}</span>
      <h3 class="service-card-title">{service.h1}</h3>
      <p class="service-card-desc">{service.summary}</p>
      <span class="service-card-arrow" aria-hidden="true">&rarr;</span>
    </a>
  ))}
</div>
