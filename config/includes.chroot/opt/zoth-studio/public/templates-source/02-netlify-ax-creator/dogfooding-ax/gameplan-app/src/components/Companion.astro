<script>
  const JAI_TIPS = [
    'Did you draft your strategy summary? Keep it to exactly one page! 📄',
    'Contacting QEDC? Keep your email concise, professional, and clear! 📞',
    'Agile sprints are usually 1–2 weeks. Build, dogfood, iterate! ⚡',
    'Dogfooding is key: use your own product relentlessly to find issues! 🐶',
    'Prepare 3–5 specific questions for Jai ahead of your mentor call! 🎓',
    'Agile sprint delivery keeps you focused. Avoid tutorial hell! 💻',
    'If QEDC is full, search SCORE chapters or local SBDCs as backups! 🗺️',
    'Confirm NY business registration details early for kitchen access. 🏢',
    'Bork! Ship fast, iterate relentlessly. 🏆'
  ];

  const welcomeMessages = [
    'Systems online! Ready to ship the thing? 🚀',
    'CyberBuddy at your service. Let\'s master the gameplan! 🐶',
    'Bork! Welcome back, cadet. Let\'s build sprints! ⚡'
  ];

  let bubbleTimeout = null;
  let lastProgress = -1;

  const bubble = document.getElementById('companion-bubble');
  const text = document.getElementById('companion-text');
  const trigger = document.getElementById('companion-trigger');

  function showMessage(msg) {
    if (!bubble || !text) return;
    if (bubbleTimeout) clearTimeout(bubbleTimeout);
    text.textContent = msg;
    bubble.classList.add('visible');
    bubbleTimeout = setTimeout(() => {
      bubble.classList.remove('visible');
    }, 6500);
  }

  setTimeout(() => {
    const welcome = welcomeMessages[Math.floor(Math.random() * welcomeMessages.length)];
    showMessage(welcome);
  }, 1500);

  trigger?.addEventListener('click', () => {
    trigger.classList.add('bounce-active');
    const tip = JAI_TIPS[Math.floor(Math.random() * JAI_TIPS.length)];
    showMessage(tip);
    setTimeout(() => {
      trigger.classList.remove('bounce-active');
    }, 600);
  });

  let scrolled = false;
  window.addEventListener('scroll', () => {
    if (scrolled) return;
    const scrollPercent = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
    if (scrollPercent > 25) {
      scrolled = true;
      showMessage('Keep scrolling to check our phases and fuel options! 🗺️');
    }
  }, { passive: true });

  window.addEventListener('gameplan-task-toggled', (event) => {
    const { percent } = event.detail;
    if (lastProgress === -1) {
      lastProgress = percent;
      return;
    }

    if (percent > lastProgress) {
      if (percent === 100) {
        showMessage('WOOF! 100% complete! All systems go, time to ship and deploy! 🏆🎉');
      } else if (percent === 50) {
        showMessage('50% of the gameplan completed! Halfway to launch velocity! 🚀');
      } else {
        const congrats = [
          'Bork! Another milestone closer to our goal! 🎯',
          'Nice sprint move! That task is done! ✅',
          'Agile execution in action! Keep checked! ⚡',
          'Bork! Excellent! Jai would be proud. 🐶'
        ];
        showMessage(congrats[Math.floor(Math.random() * congrats.length)]);
      }
    } else if (percent < lastProgress) {
      showMessage('Ah, adjusting the backlog? Keep it agile! 🔧');
    }

    lastProgress = percent;
  });
</script>
