---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import GameplanTracker from '../components/GameplanTracker';
import Timeline from '../components/Timeline';
import Resources from '../components/Resources';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import ParallaxBackground from '../components/ParallaxBackground.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import StickyStatus from '../components/StickyStatus.astro';
import SpotlightBeam from '../components/SpotlightBeam.astro';
import AmbientMotion from '../components/AmbientMotion.astro';
import GyroHint from '../components/GyroHint.astro';
import Companion from '../components/Companion.astro';
---

<Layout
  title="Dogfooding Gameplan — Execute Jai’s Action Plan"
  description="A mission-control dashboard for executing Jai’s Agile App Academy gameplan: master the course, secure a commercial kitchen, prep for your mentor call, and ship in agile sprints."
  canonical="https://dogfooding-mission.netlify.app"
>
  <ParallaxBackground />
  <SpotlightBeam />
  <ScrollProgress />
  <StickyStatus percent={0} />
  <GyroHint />

  <main>
    <Hero />

    <ScrollReveal delay={1}>
      <div class="float-section">
        <GameplanTracker client:load />
      </div>
    </ScrollReveal>

    <ScrollReveal delay={2}>
      <div class="float-section">
        <Timeline />
      </div>
    </ScrollReveal>

    <ScrollReveal delay={3}>
      <div class="float-section">
        <Resources />
      </div>
    </ScrollReveal>

    <ScrollReveal delay={1}>
      <Footer />
    </ScrollReveal>
  </main>

  <Companion />
  <AmbientMotion />
</Layout>
