---

<div class="parallax-root" aria-hidden="true">
  <div class="parallax-layer layer-1" data-speed="0.03"></div>
  <div class="parallax-layer layer-2" data-speed="0.07"></div>
  <div class="parallax-layer layer-3" data-speed="0.13"></div>
  <div class="parallax-layer layer-4" data-speed="0.22"></div>
  <div class="parallax-layer layer-5" data-speed="0.34"></div>
  <div class="parallax-grid" data-speed="0.04"></div>
  <div class="parallax-dust" data-speed="0.06"></div>
  <div class="depth-vignette"></div>
</div>

<script>
  const root = document.querySelector('.parallax-root');
  if (root) {
    const layers = root.querySelectorAll('[data-speed]');
    let targetY = 0;
    let currentY = 0;
    let ticking = false;

    const update = () => {
      currentY += (targetY - currentY) * 0.07;

      layers.forEach((layer) => {
        const speed = parseFloat(layer.getAttribute('data-speed') || '0');
        const y = currentY * speed;
        layer.style.transform = `translate3d(0, ${y}px, 0)`;
      });

      ticking = false;
    };

    const onScroll = () => {
      targetY = window.scrollY;
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    };

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!reduced.matches) {
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  }
</script>
