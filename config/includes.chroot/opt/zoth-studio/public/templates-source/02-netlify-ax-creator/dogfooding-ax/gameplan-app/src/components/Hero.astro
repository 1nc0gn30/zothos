---
import MissionVisual from './MissionVisual.astro';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-bg-overlay" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-content">
      <div class="hero-kicker">
        <span class="dot" aria-hidden="true"></span>
        Jai’s Action Plan — Live Tracker
      </div>
      <h1 id="hero-heading" class="hero-title">
        Execute the gameplan. <span class="gradient">Ship the thing.</span>
      </h1>
      <p class="hero-subtitle">
        A mission-control dashboard for the playbook Jai laid out: master the Agile App Academy,
        lock in a commercial kitchen, prep for the mentor call, and run agile sprints until launch.
      </p>
      <div class="hero-actions">
        <a href="#phases" class="button">
          View mission phases
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5v14M5 12l7 7 7-7" />
          </svg>
        </a>
        <a href="https://trydogfooding.com/agile-app-academy" target="_blank" rel="noopener noreferrer" class="button button-secondary">
          Open the academy
        </a>
      </div>
      <div class="hero-meta">
        <span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
          </svg>
          4 mission phases
        </span>
        <span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9M12 20V4M3 20h9M3 20V10m0-6h18" />
          </svg>
          22 action items
        </span>
        <span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
          ~3 week sprint
        </span>
      </div>
    </div>

    <div class="hero-visual-stage">
      <div class="hero-visual-tilt">
        <MissionVisual />
      </div>
    </div>
  </div>
</section>
