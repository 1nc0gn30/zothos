---
---

<svg
  class="mission-visual"
  viewBox="0 0 400 400"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="mv-core-gradient" x1="200" y1="100" x2="200" y2="300" gradientUnits="userSpaceOnUse">
      <stop stop-color="#00f0ff" />
      <stop offset="1" stop-color="#a78bfa" />
    </linearGradient>
    <linearGradient id="mv-ring-gradient" x1="0" y1="0" x2="1" y2="1">
      <stop stop-color="#00f0ff" />
      <stop offset="1" stop-color="#ff9f43" />
    </linearGradient>
    <radialGradient id="mv-glow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0%" stop-color="#00f0ff" stop-opacity="0.35" />
      <stop offset="100%" stop-color="#00f0ff" stop-opacity="0" />
    </radialGradient>
  </defs>

  <circle cx="200" cy="200" r="160" fill="url(#mv-glow)" />

  <g class="orbit-slow">
    <circle cx="200" cy="200" r="150" stroke="rgba(255,255,255,0.06)" stroke-width="1" />
    <circle cx="350" cy="200" r="6" fill="#ff9f43" />
  </g>

  <g class="orbit">
    <circle cx="200" cy="200" r="110" stroke="rgba(0,240,255,0.15)" stroke-width="1" stroke-dasharray="8 8" />
    <circle cx="200" cy="90" r="5" fill="#00f0ff" />
  </g>

  <circle class="pulse-ring" cx="200" cy="200" r="70" stroke="#00f0ff" stroke-width="1.5" opacity="0.6" />
  <circle class="pulse-ring" cx="200" cy="200" r="70" stroke="#ff9f43" stroke-width="1.5" opacity="0.4" style={{ animationDelay: '1.5s' }} />

  <g class="pulse-core">
    <polygon
      points="200,130 260,165 260,235 200,270 140,235 140,165"
      fill="rgba(10,12,20,0.8)"
      stroke="url(#mv-core-gradient)"
      stroke-width="2"
    />
    <circle cx="200" cy="200" r="28" fill="url(#core-gradient)" />
    <path
      d="M188 200 L196 208 L214 190"
      stroke="#08090d"
      stroke-width="4"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    />
  </g>

  {
    Array.from({ length: 12 }).map((_, i) => {
      const angle = (i * 30 * Math.PI) / 180;
      const r1 = 178;
      const r2 = 188;
      const x1 = 200 + r1 * Math.cos(angle);
      const y1 = 200 + r1 * Math.sin(angle);
      const x2 = 200 + r2 * Math.cos(angle);
      const y2 = 200 + r2 * Math.sin(angle);
      return (
        <line
          x1={x1}
          y1={y1}
          x2={x2}
          y2={y2}
          stroke="rgba(255,255,255,0.15)"
          stroke-width="2"
          stroke-linecap="round"
        />
      );
    })
  }
</svg>
