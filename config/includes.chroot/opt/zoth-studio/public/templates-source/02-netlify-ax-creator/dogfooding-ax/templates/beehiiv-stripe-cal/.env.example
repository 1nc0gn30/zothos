# Environment variables for beehiiv + Stripe + Cal.com template

# Newsletter
BEEHIIV_API_KEY=your_beehiiv_api_key
BEEHIIV_PUBLICATION_ID=your_beehiiv_publication_id

# Payments — Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PRICE_ID=price_your_stripe_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Booking — Cal.com
VITE_CAL_USERNAME=your_cal_username

# Branding
VITE_BRAND_NAME=CreatorKit
VITE_BRAND_TAGLINE=Turn your audience into income
VITE_PRODUCT_NAME=CreatorKit License
VITE_PRODUCT_PRICE=$49

# CORS
ALLOWED_ORIGINS=http://localhost:3456,https://your-site.netlify.app
