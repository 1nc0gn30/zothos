# ═══════════════════════════════════════════════════════════════════════════════
#  ZOTHOS HERMETIC MATRIX XFWM4 WINDOW MANAGER THEME v2.0
#  Neon emerald titlebars, volumetric borders, frosted glass gradient
#  Target: 2028-2030 cutting-edge window decoration
# ═══════════════════════════════════════════════════════════════════════════════

# ── Active Window — Neon Emerald Titlebar ────────────────────────────────────
active_color_1=0x050807       # Deep obsidian base
active_color_2=0x000000       # Pure black bottom
active_hilight_1=0x00ff9d     # Emerald neon top highlight
active_hilight_2=0x00cc7d     # Darker emerald mid
active_mid_1=0x0a0e17         # Rich void mid
active_mid_2=0x06090e         # Dark void
active_shadow_1=0x000000      # Shadow base
active_shadow_2=0x000000      # Shadow depth
active_text_color=0x00ff9d    # Emerald title text
active_border_color=0x00ff9d  # Neon border on focus

# ── Inactive Window — Dimmed Void ────────────────────────────────────────────
inactive_color_1=0x030505     # Darker obsidian
inactive_color_2=0x000000     # Black
inactive_hilight_1=0x0a0e17   # Dimmed slate
inactive_hilight_2=0x060810   # Darker slate
inactive_mid_1=0x040609       # Deep void
inactive_mid_2=0x020304       # Near black
inactive_shadow_1=0x000000    # Shadow
inactive_shadow_2=0x000000    # Shadow
inactive_text_color=0x4a5568  # Muted slate text
inactive_border_color=0x1a2530 # Subtle border

# ── Window Border Layout ──────────────────────────────────────────────────────
title_shadow_active=under
title_shadow_inactive=none

# ── Title Font (JetBrains Mono for tech aesthetic) ───────────────────────────
title_font=JetBrains Mono Bold 10

# ── Button Layout (standard: left=menu, right=minimize/maximize/close) ──────
button_layout=O|HMC
button_offset=4
button_spacing=3

# ── Frame & Border Dimensions ────────────────────────────────────────────────
border_width=2                # Thicker border for neon effect
bottom_height=6               # More room for gradient
left_width=4
right_width=4
title_height=36               # Taller titlebar for presence

# ── Button Sizing ────────────────────────────────────────────────────────────
button_size=20
button_align=center

# ── Misc ──────────────────────────────────────────────────────────────────────
show_app_icon=false           # Clean, no app icons — text only
maximized_offset=0
shadow_opacity=90             # Stronger shadow for depth
shadow_x_offset=0
shadow_y_offset=6             # Deep drop shadow
