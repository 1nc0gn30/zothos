# ZOTHOS Plymouth Script (Hermetic Matrix Animation)
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# Pure obsidian background
Window.SetBackgroundTopColor(0.02, 0.03, 0.03);
Window.SetBackgroundBottomColor(0.00, 0.00, 0.00);

# Status Text (Emerald Green)
status.image = Image.Text("ZOTHOS :: TRANSMUTING CONSCIOUSNESS", 0.0, 1.0, 0.62);
status.sprite = Sprite(status.image);
status.sprite.SetPosition(screen_width / 2 - status.image.GetWidth() / 2, screen_height * 0.75, 10);

fun refresh_callback() {
    # Pulsing status effect
}

Plymouth.SetRefreshFunction(refresh_callback);
