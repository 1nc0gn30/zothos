# ═══════════════════════════════════════════════════════════════════════════════
#  ZOTHOS — Hermetic Matrix GTK-2.0 Theme v2.0
#  Emerald Phosphor Cyberpunk | zoth.nullai.tech inspired
#  Target: 2028-2030 cutting-edge GTK-2 desktop experience
# ═══════════════════════════════════════════════════════════════════════════════

# ── Engine ─────────────────────────────────────────────────────────────
gtk-color-scheme = "~"#00ff9d:emerald\n"
                    "~"#00ff66:emerald_bright\n"
                    "~"#04060b:void_black\n"
                    "~"#0a0e17:surface_1\n"
                    "~"#0d1421:surface_2\n"
                    "~"#121a2a:surface_3\n"
                    "~"#1c2541:border_subtle\n"
                    "~"#e0e6f0:text_primary\n"
                    "~"#6a7585:text_muted\n"
                    "~"#ffd700:gold\n"
                    "~"#00ccff:cyan\n"

# ── Primary colors ────────────────────────────────────────────────────
gtk-primary(bg) = #0a1020
gtk-primary(fg) = #00ff9d
gtk-primary-border = #1c2541

# ── Text and base ─────────────────────────────────────────────────────
gtk-text(bg) = #0a0e17
gtk-text(fg) = #e0e6f0
gtk-base(bg) = #0a0e17
gtk-base(fg) = #e0e6f0

# ── Engine colors ────────────────────────────────────────────────────
gtk-engine(bg) = #0a1020
gtk-engine(fg) = #00ff9d

# ── Button ────────────────────────────────────────────────────────────
# Button background
button_bg = #0d1421
button_fg = #e0e6f0
button_border = #1c2541

# Button hover
button_hover_bg = #0f1830
button_hover_fg = #00ff9d

# Button active
button_active_bg = #00ff9d
button_active_fg = #000000

# ── Menu ──────────────────────────────────────────────────────────────
menu_bg = #0a1020
menu_fg = #e0e6f0
menu_border = #162040
menu_hover_bg = #0f1830
menu_hover_fg = #00ff9d
menu_active_bg = #00ff9d
menu_active_fg = #000000

# ── Input ────────────────────────────────────────────────────────────
input_bg = #0a0e17
input_fg = #e0e6f0
input_border = #1c2541
input_hover_border = #00ff9d
input_focus_border = #00ff9d

# ── Scrollbar ──────────────────────────────────────────────────────────
scrollbar_bg = #0a0e17
scrollbar_fg = #00ff9d
scrollbar_button = #0d1421
scrollbar_button_hover = #0f1830
scrollbar_track = #04060b

# ── Tooltip ────────────────────────────────────────────────────────────
tooltip_bg = #0f1525
tooltip_fg = #00ff9d
tooltip_border = #00ff9d

# ── Window decoration ──────────────────────────────────────────────────
window_bg = #04060b
window_fg = #e0e6f0
window_title_bg = #0a1020
window_title_fg = #00ff9d
window_active_title_bg = #001a0d
window_active_title_fg = #00ff9d
window_inactive_title_bg = #0a1020
window_inactive_title_fg = #5a6575

# ── Progress bar ───────────────────────────────────────────────────────
progress_bg = #0a0e17
progress_fg = #00ff9d
progress_border = #00ff9d

# ── Tree view ──────────────────────────────────────────────────────────
tree_bg = #0a0e17
tree_fg = #e0e6f0
tree_selected_bg = #003d1f
tree_selected_fg = #ffffff
tree_row_bg = #0a0e17
tree_hover_bg = #0d1421

# ── Check and radio ────────────────────────────────────────────────────
check_bg = #0a1020
check_fg = #00ff9d
check_active_bg = #00ff9d

