#!/usr/bin/env bash
# ==============================================================================
#  Zoth Animated BG — Cyber Gold Celtic Matrix Engine
# ==============================================================================
set -euo pipefail

HTML_PATH="/opt/zoth-live-wallpaper/index.html"
if [[ ! -f "$HTML_PATH" ]]; then
    HTML_PATH="/home/neo/zothos/config/includes.chroot/opt/zoth-live-wallpaper/index.html"
fi

if command -v chromium >/dev/null 2>&1; then
    exec chromium --app="file://$HTML_PATH" --window-size=1280,800 "$@"
elif command -v google-chrome >/dev/null 2>&1; then
    exec google-chrome --app="file://$HTML_PATH" --window-size=1280,800 "$@"
elif command -v firefox >/dev/null 2>&1; then
    exec firefox "file://$HTML_PATH" "$@"
else
    xdg-open "file://$HTML_PATH" 2>/dev/null || true
fi
