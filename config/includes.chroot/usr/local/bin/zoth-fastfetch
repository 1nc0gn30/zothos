#!/usr/bin/env bash
# ==============================================================================
#  🜂 ZOTHOS HERMETIC FASTFETCH v2.0 🜄
#  Alchemical Emerald Tablet Status Deck & Vitals
# ==============================================================================

EMERALD="\e[38;5;48m"
GREEN="\e[38;5;42m"
GOLD="\e[38;5;214m"
AMBER="\e[38;5;208m"
CYAN="\e[38;5;51m"
DARK="\e[38;5;239m"
WHITE="\e[1;37m"
PURPLE="\e[38;5;177m"
RESET="\e[0m"

# Current reality mode
MODE="${EMERALD}Hermetic Matrix [Emerald Phosphor]${RESET}"
if [[ -f "$HOME/.config/zothos/current_mode" ]]; then
    m=$(cat "$HOME/.config/zothos/current_mode" 2>/dev/null || echo "matrix")
    if [[ "$m" == "ghost" ]]; then
        MODE="\e[38;5;196mGhostmode [nullai.tech Stealth]${RESET}"
    elif [[ "$m" == "incognito" ]]; then
        MODE="\e[38;5;39mIncognito [Windows 11 Chameleon]${RESET}"
    fi
fi

# Tor status
TOR_STATUS="${DARK}Direct Clearnet Route${RESET}"
if [[ -f "/run/zoth_ghostmode.state" ]] || systemctl is-active --quiet tor 2>/dev/null; then
    TOR_STATUS="${EMERALD}● Torified & Cloaked [Active]${RESET}"
fi

# AI status
AI_STATUS="${DARK}Engine Standby${RESET}"
if pgrep -x "ollama" >/dev/null 2>&1; then
    AI_STATUS="${GOLD}● Ollama Neural Server Online${RESET}"
fi

# Planetary hour symbol calculation based on current hour
PLANETS=("☉ Sol" "♀ Venus" "☿ Mercury" "☽ Luna" "♄ Saturn" "♃ Jupiter" "♂ Mars")
H=$(date +%H)
P_IDX=$(( 10#$H % 7 ))
PLANETARY_HOUR="${GOLD}${PLANETS[$P_IDX]}${RESET}"

UPTIME=$(uptime -p 2>/dev/null | sed 's/up //' || uptime | awk -F',' '{print $1}')
KERNEL=$(uname -r)
SHELL_NAME=$(basename "$SHELL")
MEM_USED=$(free -m | awk '/Mem:/ {print $3}')
MEM_TOTAL=$(free -m | awk '/Mem:/ {print $2}')
MEM_PCT=$(( MEM_USED * 100 / MEM_TOTAL ))

echo -e "
${EMERALD}       ▲             ${GOLD}ZOTHOS Linux 1.0 [Codename: Azoth]${RESET}
${EMERALD}      ▲ ▲            ${DARK}─────────────────────────────────────────────────${RESET}
${EMERALD}     ▲   ▲           ${WHITE}OS Reality:       ${MODE}
${EMERALD}    ▲  ${GOLD}☉${EMERALD}  ▲          ${WHITE}Kernel:           ${CYAN}${KERNEL}${RESET}
${EMERALD}   ▲   |   ▲         ${WHITE}Planetary Hour:   ${PLANETARY_HOUR}
${EMERALD}  ▲ ${AMBER}🜂${EMERALD}  ${CYAN}☿${EMERALD}  ${AMBER}🜄${EMERALD} ▲        ${WHITE}Desktop Surface:  ${CYAN}XFCE 4.18 + Picom (Matrix Glass)${RESET}
${EMERALD} ▲             ▲       ${WHITE}Shell & Prompt:   ${CYAN}${SHELL_NAME} (Alchemical Powerline)${RESET}
${EMERALD}▲═══════${PURPLE}🜁${EMERALD}═══════▲      ${WHITE}Memory / Vitals:  ${EMERALD}${MEM_USED}MB / ${MEM_TOTAL}MB (${MEM_PCT}%)${RESET}
${EMERALD}  \\   ${AMBER}🜃${EMERALD}     /        ${WHITE}Security Arsenal: ${EMERALD}Kali + Parrot Dual Repos [Active]${RESET}
${EMERALD}   \\   |   /         ${WHITE}Frontier AI:      ${AI_STATUS}
${EMERALD}    \\  ${GOLD}🝘${EMERALD}  /          ${WHITE}Ghost Routing:    ${TOR_STATUS}
${EMERALD}     \\   /           ${WHITE}Zoth Studio:      ${GOLD}v3.2 Sovereign Cockpit [Linked]${RESET}
${EMERALD}      ▼              ${WHITE}Hermetic Axiom:   ${DARK}\"As above, so below; as code, so mind.\"${RESET}
"
