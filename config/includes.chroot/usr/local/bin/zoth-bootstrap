#!/usr/bin/env bash
# =============================================================================
#  ZOTHOS Bootstrap Provisioner — First-Boot Auto-Installer
#  Installs ALL required packages and configures the full sovereign toolchain.
# =============================================================================
set -euo pipefail

MARKER="/var/lib/zothos/.bootstrap-done"
LOG="/var/log/zothos-bootstrap.log"
VENV="/opt/zothos-ai-env"
TIMESTAMP=$(date -Iseconds)

[[ -f "$MARKER" ]] && exit 0

mkdir -p /var/lib/zothos /var/log
exec > >(tee -a "$LOG") 2>&1

echo "══════════════════════════════════════════════════"
echo "[+] ZOTHOS Bootstrap Provisioner — $TIMESTAMP"
echo "══════════════════════════════════════════════════"

# ── 1. APT Configuration ───────────────────────────────────────────────────
export DEBIAN_FRONTEND=noninteractive
export APT_KEY_DONT_WARN_ON_DANGEROUS_USAGE=1

echo "[APT] Refreshing package lists..."
apt-get update -qq || { echo "[WARN] apt update failed, continuing with cached data"; }

echo "[APT] Installing core system packages..."
apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv python3-gi python3-cairo \
    gir1.2-gtk-3.0 gir1.2-gdk-3.0 gir1.2-pango-1.0 \
    python3-gi-cairo libgirepository1.0-dev \
    xfce4-terminal xfce4-notifyd xfce4-power-manager \
    feh picom compton \
    tor macchanger iptables \
    nmap masscan tshark nikto sqlmap radare2 john hashcat binwalk \
    tesseract-ocr pandoc graphviz flameshot zathura tree \
    tmux neovim git curl wget jq unzip p7zip-full \
    golang-go gcc g++ clang make cmake \
    nodejs npm \
    sqlite3 rclone \
    wireguard-tools \
    libssl-dev libffi-dev build-essential \
    fonts-jetbrains-mono fonts-firacode \
    2>/dev/null || true

echo "[APT] Core packages installed."

echo "[VENV] Setting up Python AI environment at $VENV..."
apt-get install -y python3-venv python3-full 2>/dev/null || true
python3 -m venv "$VENV" --system-site-packages 2>/dev/null || python3 -m venv "$VENV" 2>/dev/null || true
if [[ -f "$VENV/bin/activate" ]]; then
    source "$VENV/bin/activate"
fi

echo "[PIP] Installing AI/ML Python packages..."
"$VENV/bin/pip" install --quiet --upgrade pip 2>/dev/null || true

PYTHON_PKGS=(
    "aider-chat"
    "fastmcp"
    "litellm"
    "requests"
    "rich"
    "psutil"
    "PyMuPDF"
    "httpx"
    "pydantic"
    "websockets"
    "fastapi"
    "uvicorn[standard]"
    "typer"
    "click"
    "python-dotenv"
)

for pkg in "${PYTHON_PKGS[@]}"; do
    echo "[PIP] Installing $pkg..."
    "$VENV/bin/pip" install --quiet "$pkg" 2>>"$LOG" && echo "[OK] $pkg" || echo "[SKIP] $pkg failed"
done

deactivate

# ── 3. Node.js Global Packages ────────────────────────────────────────────
if command -v npm &>/dev/null; then
    echo "[NPM] Installing global node tools..."
    npm install -g --silent @anthropic-ai/claude-code 2>/dev/null || true
    npm install -g --silent @openai/codex 2>/dev/null || true
    npm install -g --silent opencode-ai 2>/dev/null || true
fi

# ── 4. Rust Toolchain ─────────────────────────────────────────────────────
if ! command -v rustc &>/dev/null; then
    echo "[RUST] Installing Rust toolchain..."
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path 2>/dev/null || true
fi

# ── 5. Go Tools ───────────────────────────────────────────────────────────
if command -v go &>/dev/null; then
    echo "[GO] Installing Go security tools..."
    export GOPATH=/root/go
    go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest 2>/dev/null || true
    go install github.com/ffuf/ffuf/v2@latest 2>/dev/null || true
fi

# ── 6. Ollama (Local LLM Runtime) ─────────────────────────────────────────
if ! command -v ollama &>/dev/null; then
    echo "[OLLAMA] Installing Ollama local LLM runtime..."
    curl -fsSL https://ollama.ai/install.sh | sh 2>/dev/null || true
fi

# ── 7. Desktop Configuration ──────────────────────────────────────────────
echo "[DESKTOP] Applying ZOTHOS desktop configuration..."

# Trust all desktop launchers
if [[ -d /etc/skel/Desktop ]]; then
    chmod +x /etc/skel/Desktop/*.desktop 2>/dev/null || true
fi

# Update icon cache
gtk-update-icon-cache -f -q /usr/share/icons/hicolor 2>/dev/null || true
gtk-update-icon-cache -f -q /usr/share/icons/Zoth-Hermetic 2>/dev/null || true

# Set GTK theme via gsettings for all users
for home_dir in /root /home/neo /etc/skel; do
    if [[ -d "$home_dir" ]]; then
        mkdir -p "$home_dir/.config/xfce4/xfconf/xfce-perchannel-xml" 2>/dev/null || true
    fi
done

# ── 8. Font Installation ──────────────────────────────────────────────────
echo "[FONTS] Installing premium fonts..."
mkdir -p /usr/local/share/fonts/zothos
# Copy any bundled fonts
cp /usr/share/fonts/truetype/jetbrains-mono/*.ttf /usr/local/share/fonts/zothos/ 2>/dev/null || true
fc-cache -f 2>/dev/null || true

# ── 9. Completion Marker ──────────────────────────────────────────────────
echo "Bootstrap completed at $TIMESTAMP" > "$MARKER"
chmod 444 "$MARKER"

echo ""
echo "══════════════════════════════════════════════════"
echo "✓ ZOTHOS Bootstrap Complete!"
echo "  Log: $LOG"
echo "  AI venv: $VENV"
echo "══════════════════════════════════════════════════"
