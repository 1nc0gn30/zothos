#!/usr/bin/env bash
# ==============================================================================
#  ZOTHOS INCOGNITO / UNDERCOVER MODE
#  Transforms the Linux environment instantly into a Windows 11 enterprise desktop.
#  Designed for physical operational security and covert environments.
# ==============================================================================

set -e

UNDERCOVER_STATE="$HOME/.config/zothos/undercover.state"
mkdir -p "$HOME/.config/zothos"

is_active() {
    [[ -f "$UNDERCOVER_STATE" ]]
}

enable_undercover() {
    echo -e "\e[1;34m[*] Engaging Windows 11 Incognito Camouflage...\e[0m"

    # 1. Swap Wallpaper to Windows 11 Bloom
    local wp="/usr/share/backgrounds/zothos/win11-bloom.jpg"
    if [[ -f "$wp" ]] && command -v xfconf-query >/dev/null 2>&1; then
        for prop in $(xfconf-query -c xfce4-desktop -l | grep "last-image"); do
            xfconf-query -c xfce4-desktop -p "$prop" -s "$wp" || true
        done
    fi

    # 2. GTK Theme & Icons
    if command -v xfconf-query >/dev/null 2>&1; then
        xfconf-query -c xsettings -p /Net/ThemeName -s "Zoth-Incognito-Win11" 2>/dev/null || true
        xfconf-query -c xsettings -p /Net/IconThemeName -s "Windows-11-Icons" 2>/dev/null || true
        xfconf-query -c xfwm4 -p /general/theme -s "Zoth-Incognito-Win11" 2>/dev/null || true
        xfconf-query -c xfwm4 -p /general/button_layout -s "O|HMC" 2>/dev/null || true # Windows button order: Title left, Min/Max/Close right
    fi

    # 3. Disguise XFCE4 Terminal as Windows PowerShell
    if command -v xfce4-terminal >/dev/null 2>&1; then
        mkdir -p "$HOME/.config/xfce4/terminal"
        cat <<'EOF' > "$HOME/.config/xfce4/terminal/terminalrc"
[Configuration]
ColorPalette=#0c0c0c;#c50f1f;#13a10e;#c19c00;#0037da;#881798;#3a96dd;#cccccc;#767676;#e74856;#16c60c;#f9f1a5;#3b78ff;#b4009e;#61d6d6;#f2f2f2
ColorForeground=#ffffff
ColorBackground=#012456
ColorCursor=#ffffff
FontName=Consolas 11
ScrollingBar=TERMINAL_SCROLLING_BAR_ALWAYS
MiscToolbarDefault=FALSE
MiscMenubarDefault=FALSE
TitleMode=TERMINAL_TITLE_REPLACE
Title=Windows PowerShell
EOF
    fi

    # 4. Generate Fake Desktop Shortcuts
    mkdir -p "$HOME/Desktop"
    cat <<'EOF' > "$HOME/Desktop/This-PC.desktop"
[Desktop Entry]
Version=1.0
Type=Application
Name=This PC
Comment=Access local drives and files
Exec=thunar
Icon=computer
Terminal=false
StartupNotify=true
EOF

    cat <<'EOF' > "$HOME/Desktop/Recycle-Bin.desktop"
[Desktop Entry]
Version=1.0
Type=Application
Name=Recycle Bin
Comment=Contains deleted files
Exec=thunar trash:///
Icon=user-trash
Terminal=false
StartupNotify=true
EOF

    cat <<'EOF' > "$HOME/Desktop/Microsoft-Edge.desktop"
[Desktop Entry]
Version=1.0
Type=Application
Name=Microsoft Edge
Comment=Browse the Web
Exec=x-www-browser
Icon=ms-edge
Terminal=false
StartupNotify=true
EOF
    chmod +x "$HOME/Desktop/"*.desktop 2>/dev/null || true

    touch "$UNDERCOVER_STATE"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -i "system-settings" "Windows Security" "Device protection status: OK. All services running normally." 2>/dev/null || true
    fi
    echo -e "\e[1;32m[✓] Camouflage Active. System visually mimics Windows 11 Enterprise.\e[0m"
}

disable_undercover() {
    echo -e "\e[1;32m[*] Disabling Incognito Mode, returning to Hermetic Matrix...\e[0m"
    rm -f "$UNDERCOVER_STATE"
    rm -f "$HOME/Desktop/This-PC.desktop" "$HOME/Desktop/Recycle-Bin.desktop" "$HOME/Desktop/Microsoft-Edge.desktop" 2>/dev/null || true
    zoth-mode matrix
}

case "${1:-toggle}" in
    on|enable)
        enable_undercover
        ;;
    off|disable)
        disable_undercover
        ;;
    toggle)
        if is_active; then
            disable_undercover
        else
            enable_undercover
        fi
        ;;
    status)
        if is_active; then
            echo "Incognito (Windows 11) is ACTIVE"
        else
            echo "Incognito is INACTIVE"
        fi
        ;;
    *)
        echo "Usage: zoth-undercover {on|off|toggle|status}"
        exit 1
        ;;
esac
