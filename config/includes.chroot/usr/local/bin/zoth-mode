#!/usr/bin/env bash
# ==============================================================================
#  ⚡ ZOTHOS REALITY SWITCHER v2.0
#  Seamlessly shifts desktop reality between:
#    1. [Hermetic Matrix] - Emerald Neon Phosphor, Azoth Glyphs, Matrix Rain
#    2. [NullAI Ghostmode] - Amnesic Stealth, Tor Routing, Anti-Forensics
#    3. [Incognito Win11]  - Corporate Chameleon disguise
# ==============================================================================

set -euo pipefail

STATE_FILE="$HOME/.config/zothos/current_mode"
mkdir -p "$HOME/.config/zothos"

GREEN="\e[38;2;0;255;157m"
GOLD="\e[38;2;255;215;0m"
CYAN="\e[38;2;0;229;255m"
RED="\e[38;2;255;51;85m"
GRAY="\e[38;2;120;140;160m"
BOLD="\e[1m"
RESET="\e[0m"

notify() {
    local title="$1"
    local msg="$2"
    local icon="${3:-dialog-information}"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "ZOTHOS" -i "$icon" "$title" "$msg" 2>/dev/null || true
    fi
    echo -e "${GREEN}[*] ZOTHOS:${RESET} ${BOLD}$title${RESET} - $msg"
}

get_current_mode() {
    if [[ -f "$STATE_FILE" ]]; then
        cat "$STATE_FILE"
    else
        echo "matrix"
    fi
}

apply_matrix_mode() {
    echo -e "${GREEN}[+] Engaging Hermetic Matrix Reality (Emerald Void)...${RESET}"
    
    local wp="/usr/share/backgrounds/zothos/hermetic-matrix.png"
    if [[ ! -f "$wp" ]]; then
        wp=$(ls /usr/share/backgrounds/zothos/*.png /usr/share/backgrounds/zothos/*.jpg 2>/dev/null | head -1)
    fi

    if [[ -f "$wp" ]]; then
        if command -v xfconf-query >/dev/null 2>&1; then
            for prop in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep "last-image" || true); do
                xfconf-query -c xfce4-desktop -p "$prop" -s "$wp" 2>/dev/null || true
            done
        fi
        if command -v feh >/dev/null 2>&1; then
            feh --bg-fill "$wp" 2>/dev/null || true
        fi
    fi

    if command -v xfconf-query >/dev/null 2>&1; then
        xfconf-query -c xsettings -p /Net/ThemeName -s "Zoth-Hermetic-Matrix" 2>/dev/null || true
        xfconf-query -c xsettings -p /Net/IconThemeName -s "Zoth-Hermetic" 2>/dev/null || true
        xfconf-query -c xfwm4 -p /general/theme -s "Zoth-Hermetic-Matrix" 2>/dev/null || true
    fi

    echo "matrix" > "$STATE_FILE"
    notify "Reality Shift" "Hermetic Matrix reality engaged. Emerald phosphor active." "dialog-information"
}

apply_ghost_mode() {
    echo -e "${CYAN}[+] Engaging NullAI Ghostmode Reality (Amnesic Stealth)...${RESET}"
    
    local wp="/usr/share/backgrounds/zothos/ghostmode-nullai.png"
    if [[ ! -f "$wp" ]]; then
        wp="/usr/share/backgrounds/zothos/hermetic-matrix.png"
    fi

    if [[ -f "$wp" ]]; then
        if command -v xfconf-query >/dev/null 2>&1; then
            for prop in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep "last-image" || true); do
                xfconf-query -c xfce4-desktop -p "$prop" -s "$wp" 2>/dev/null || true
            done
        fi
        if command -v feh >/dev/null 2>&1; then
            feh --bg-fill "$wp" 2>/dev/null || true
        fi
    fi

    if command -v zoth-ghost >/dev/null 2>&1; then
        sudo zoth-ghost start 2>/dev/null || true
    fi

    echo "ghost" > "$STATE_FILE"
    notify "Ghostmode Activated" "Anti-forensics active. Tor routed, MAC cloaked, traces zeroed." "security-high"
}

apply_incognito_mode() {
    echo -e "${GOLD}[+] Engaging Corporate Chameleon (Windows 11 Guise)...${RESET}"

    if command -v zoth-undercover >/dev/null 2>&1; then
        zoth-undercover on 2>/dev/null || true
    fi

    echo "incognito" > "$STATE_FILE"
    notify "Incognito Mode" "Corporate Windows 11 disguise active. Stay hidden in plain sight." "security-medium"
}

interactive_menu() {
    while true; do
        clear
        local cur=$(get_current_mode)
        echo -e "${GREEN}${BOLD}══════════════════════════════════════════════════════════════════════${RESET}"
        echo -e "${GOLD}${BOLD}              ⚡ ZOTHOS REALITY & CHAMELEON SWITCHER ⚡${RESET}"
        echo -e "${CYAN}             Active Reality Surface: [${BOLD}${cur^^}${RESET}${CYAN}]${RESET}"
        echo -e "${GREEN}${BOLD}══════════════════════════════════════════════════════════════════════${RESET}"
        echo ""
        echo -e "  ${BOLD}${GREEN}[1]${RESET} 🪐  ${BOLD}Hermetic Matrix Reality${RESET}  ${GRAY}(Emerald Phosphor, Alchemical Void)${RESET}"
        echo -e "  ${BOLD}${CYAN}[2]${RESET} 👻  ${BOLD}NullAI Ghostmode Stealth${RESET}  ${GRAY}(Tor Routed, Amnesic RAM, MAC Spoofed)${RESET}"
        echo -e "  ${BOLD}${GOLD}[3]${RESET} 🪟  ${BOLD}Incognito Windows 11${RESET}      ${GRAY}(Corporate Chameleon Disguise)${RESET}"
        echo -e "  ${BOLD}${RED}[4]${RESET} 🔄  ${BOLD}Toggle to Next Reality${RESET}"
        echo -e "  ${BOLD}${GRAY}[5]${RESET} 📊  ${BOLD}View Telemetry / Status${RESET}"
        echo -e "  ${BOLD}${GRAY}[0]${RESET} 🚪  ${BOLD}Exit${RESET}"
        echo ""
        echo -e "${GREEN}${BOLD}══════════════════════════════════════════════════════════════════════${RESET}"
        read -p "Select reality shift [0-5]: " choice
        case "$choice" in
            1) apply_matrix_mode; sleep 1 ;;
            2) apply_ghost_mode; sleep 1 ;;
            3) apply_incognito_mode; sleep 1 ;;
            4) 
                if [[ "$cur" == "matrix" ]]; then apply_ghost_mode;
                elif [[ "$cur" == "ghost" ]]; then apply_incognito_mode;
                else apply_matrix_mode; fi
                sleep 1 ;;
            5)
                echo ""
                echo -e "${BOLD}Current State:${RESET} $cur"
                echo -e "${BOLD}Desktop Manager:${RESET} XFCE 4.18 + Picom Matrix Glass"
                read -p "Press Enter to continue..." _
                ;;
            0|q|Q) break ;;
            *) echo -e "${RED}Invalid option${RESET}"; sleep 1 ;;
        esac
    done
}

target="${1:-interactive}"

case "$target" in
    matrix)
        apply_matrix_mode
        ;;
    ghost)
        apply_ghost_mode
        ;;
    incognito|windows|undercover)
        apply_incognito_mode
        ;;
    toggle)
        cur=$(get_current_mode)
        if [[ "$cur" == "matrix" ]]; then
            apply_ghost_mode
        elif [[ "$cur" == "ghost" ]]; then
            apply_incognito_mode
        else
            apply_matrix_mode
        fi
        ;;
    status)
        cur=$(get_current_mode)
        echo -e "${GREEN}ZOTHOS Active Reality:${RESET} ${CYAN}${cur^^}${RESET}"
        ;;
    interactive|"")
        interactive_menu
        ;;
    *)
        echo "Usage: zoth-mode {matrix|ghost|incognito|toggle|status}"
        exit 1
        ;;
esac
