#!/usr/bin/env bash
# ==============================================================================
#  ⚡ ZOTHOS REALITY SWITCHER v3.0 - POWERED BY ZOTH STUDIO
#  Seamlessly shifts desktop reality between authentic Zoth Studio themes:
#    1. [Zoth Studio Hero Deck]  - Master Alchemical Void & Hero Artwork
#    2. [Hermetic Matrix]       - Emerald Phosphor #00FF9D & Matrix Glyphs
#    3. [Zoth Studio 2026]      - Cyberpunk Alchemical Citadel Banner
#    4. [Neural City Matrix]    - Neon Skyline & Cybernetic Infrastructure
#    5. [Azoth Gold Sanctum]    - Radiant Gold #FFD700 & Solar Orbs
#    6. [NullAI Ghostmode]      - Amnesic Stealth, Tor Routing & OpSec
#    7. [Incognito Win11]       - Corporate Chameleon Disguise
# ==============================================================================

set -euo pipefail

STATE_FILE="$HOME/.config/zothos/current_mode"
mkdir -p "$HOME/.config/zothos"

GREEN="\e[38;2;0;255;157m"
GOLD="\e[38;2;255;215;0m"
CYAN="\e[38;2;0;229;255m"
RED="\e[38;2;255;51;85m"
GRAY="\e[38;2;120;140;160m"
BOLD="\e[1m"
RESET="\e[0m"

notify() {
    local title="$1"
    local msg="$2"
    local icon="${3:-/usr/share/pixmaps/zothos.png}"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "Zoth Studio" -i "$icon" "$title" "$msg" 2>/dev/null || true
    fi
    echo -e "${GREEN}[*] Zoth Studio:${RESET} ${BOLD}$title${RESET} - $msg"
}

set_wallpaper() {
    local wp="$1"
    if [[ -f "$wp" ]]; then
        if command -v xfconf-query >/dev/null 2>&1; then
            for prop in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep "last-image" || true); do
                xfconf-query -c xfce4-desktop -p "$prop" -s "$wp" 2>/dev/null || true
            done
            for prop in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep "image-style" || true); do
                xfconf-query -c xfce4-desktop -p "$prop" -s 5 2>/dev/null || true
            done
        fi
        if command -v feh >/dev/null 2>&1; then
            feh --bg-fill "$wp" 2>/dev/null || true
        fi
    fi
}

get_current_mode() {
    if [[ -f "$STATE_FILE" ]]; then
        cat "$STATE_FILE"
    else
        echo "zoth-hero"
    fi
}

apply_zoth_hero() {
    echo -e "${GOLD}[+] Engaging Zoth Studio Master Hero Reality...${RESET}"
    set_wallpaper "/usr/share/backgrounds/zothos/zoth-studio-hero.jpg"
    if command -v xfconf-query >/dev/null 2>&1; then
        xfconf-query -c xsettings -p /Net/ThemeName -s "Zoth-Hermetic-Matrix" 2>/dev/null || true
        xfconf-query -c xsettings -p /Net/IconThemeName -s "Zoth-Hermetic" 2>/dev/null || true
        xfconf-query -c xfwm4 -p /general/theme -s "Zoth-Hermetic-Matrix" 2>/dev/null || true
    fi
    echo "zoth-hero" > "$STATE_FILE"
    notify "Zoth Studio Master" "Master Alchemical Hero deck active." "/usr/share/pixmaps/zoth-studio.png"
}

apply_matrix_mode() {
    echo -e "${GREEN}[+] Engaging Hermetic Matrix Reality (Emerald Void)...${RESET}"
    set_wallpaper "/usr/share/backgrounds/zothos/hermetic-matrix.png"
    if command -v xfconf-query >/dev/null 2>&1; then
        xfconf-query -c xsettings -p /Net/ThemeName -s "Zoth-Hermetic-Matrix" 2>/dev/null || true
        xfconf-query -c xsettings -p /Net/IconThemeName -s "Zoth-Hermetic" 2>/dev/null || true
        xfconf-query -c xfwm4 -p /general/theme -s "Zoth-Hermetic-Matrix" 2>/dev/null || true
    fi
    echo "matrix" > "$STATE_FILE"
    notify "Hermetic Matrix" "Phosphor emerald matrix reality engaged." "/usr/share/pixmaps/zoth-mode.png"
}

apply_zoth_banner() {
    echo -e "${CYAN}[+] Engaging Zoth Studio 2026 Alchemical Citadel Reality...${RESET}"
    set_wallpaper "/usr/share/backgrounds/zothos/zoth-studio-banner.jpg"
    echo "zoth-banner" > "$STATE_FILE"
    notify "Zoth Studio 2026" "Alchemical Citadel banner active." "/usr/share/pixmaps/zothos.png"
}

apply_neural_city() {
    echo -e "${CYAN}[+] Engaging Neural City Cybernetic Reality...${RESET}"
    set_wallpaper "/usr/share/backgrounds/zothos/project-neural-city.jpg"
    echo "neural-city" > "$STATE_FILE"
    notify "Neural City" "Cybernetic skyline reality engaged." "/usr/share/pixmaps/opencode.png"
}

apply_gold_mode() {
    echo -e "${GOLD}[+] Engaging Azoth Gold Sanctum Reality...${RESET}"
    set_wallpaper "/usr/share/backgrounds/zothos/alchemical-gold.png"
    echo "gold" > "$STATE_FILE"
    notify "Azoth Gold Sanctum" "Radiant gold alchemy reality active." "/usr/share/pixmaps/distributor-logo.png"
}

apply_ghost_mode() {
    echo -e "${CYAN}[+] Engaging NullAI Ghostmode Reality (Amnesic Stealth)...${RESET}"
    set_wallpaper "/usr/share/backgrounds/zothos/project-nullai.jpg"
    if command -v zoth-ghost >/dev/null 2>&1; then
        sudo zoth-ghost start 2>/dev/null || true
    fi
    echo "ghost" > "$STATE_FILE"
    notify "NullAI Ghostmode" "Tor routed, MAC spoofed, traces amnesic." "/usr/share/pixmaps/nullai-ghostmode.png"
}

apply_incognito_mode() {
    echo -e "${GOLD}[+] Engaging Corporate Chameleon (Windows 11 Guise)...${RESET}"
    if command -v zoth-undercover >/dev/null 2>&1; then
        zoth-undercover on 2>/dev/null || true
    fi
    echo "incognito" > "$STATE_FILE"
    notify "Incognito Chameleon" "Corporate Windows 11 disguise active." "/usr/share/pixmaps/security-high.png"
}

interactive_menu() {
    while true; do
        clear
        local cur=$(get_current_mode)
        echo -e "${GREEN}${BOLD}══════════════════════════════════════════════════════════════════════════════${RESET}"
        echo -e "${GOLD}${BOLD}              ⚡ ZOTH STUDIO REALITY & THEME SWITCHER ⚡${RESET}"
        echo -e "${CYAN}                  Active Reality Surface: [${BOLD}${cur^^}${RESET}${CYAN}]${RESET}"
        echo -e "${GREEN}${BOLD}══════════════════════════════════════════════════════════════════════════════${RESET}"
        echo ""
        echo -e "  ${BOLD}${GOLD}[1]${RESET} 🏛️   ${BOLD}Zoth Studio Master Hero${RESET}   ${GRAY}(Official Zoth Studio Hero Artwork)${RESET}"
        echo -e "  ${BOLD}${GREEN}[2]${RESET} 🪐  ${BOLD}Hermetic Matrix Reality${RESET}   ${GRAY}(Emerald Phosphor, Alchemical Rain)${RESET}"
        echo -e "  ${BOLD}${CYAN}[3]${RESET} ⚡  ${BOLD}Zoth Studio 2026 Citadel${RESET}  ${GRAY}(Cyberpunk Alchemical Citadel Banner)${RESET}"
        echo -e "  ${BOLD}${CYAN}[4]${RESET} 🌆  ${BOLD}Neural City Cybernetic${RESET}    ${GRAY}(Neon Skyline & Deep Neural Grid)${RESET}"
        echo -e "  ${BOLD}${GOLD}[5]${RESET} 👑  ${BOLD}Azoth Gold Sanctum${RESET}        ${GRAY}(Radiant Gold #FFD700 & Solar Orbs)${RESET}"
        echo -e "  ${BOLD}${RED}[6]${RESET} 👻  ${BOLD}NullAI Ghostmode Stealth${RESET}  ${GRAY}(Tor Routed, Amnesic RAM, MAC Cloaked)${RESET}"
        echo -e "  ${BOLD}${GRAY}[7]${RESET} 🪟  ${BOLD}Incognito Windows 11${RESET}      ${GRAY}(Corporate Chameleon Disguise)${RESET}"
        echo -e "  ${BOLD}${GREEN}[8]${RESET} 🔄  ${BOLD}Cycle to Next Theme${RESET}"
        echo -e "  ${BOLD}${GRAY}[0]${RESET} 🚪  ${BOLD}Exit Switcher${RESET}"
        echo ""
        echo -e "${GREEN}${BOLD}══════════════════════════════════════════════════════════════════════════════${RESET}"
        read -p "Select reality shift [0-8]: " choice
        case "$choice" in
            1) apply_zoth_hero; sleep 1 ;;
            2) apply_matrix_mode; sleep 1 ;;
            3) apply_zoth_banner; sleep 1 ;;
            4) apply_neural_city; sleep 1 ;;
            5) apply_gold_mode; sleep 1 ;;
            6) apply_ghost_mode; sleep 1 ;;
            7) apply_incognito_mode; sleep 1 ;;
            8) 
                case "$cur" in
                    zoth-hero) apply_matrix_mode ;;
                    matrix) apply_zoth_banner ;;
                    zoth-banner) apply_neural_city ;;
                    neural-city) apply_gold_mode ;;
                    gold) apply_ghost_mode ;;
                    ghost) apply_incognito_mode ;;
                    *) apply_zoth_hero ;;
                esac
                sleep 1 ;;
            0|q|Q) break ;;
            *) echo -e "${RED}Invalid option${RESET}"; sleep 1 ;;
        esac
    done
}

target="${1:-interactive}"

case "$target" in
    zoth-hero|hero) apply_zoth_hero ;;
    matrix) apply_matrix_mode ;;
    zoth-banner|banner) apply_zoth_banner ;;
    neural-city|city) apply_neural_city ;;
    gold) apply_gold_mode ;;
    ghost) apply_ghost_mode ;;
    incognito|win11) apply_incognito_mode ;;
    next|toggle)
        cur=$(get_current_mode)
        case "$cur" in
            zoth-hero) apply_matrix_mode ;;
            matrix) apply_zoth_banner ;;
            zoth-banner) apply_neural_city ;;
            neural-city) apply_gold_mode ;;
            gold) apply_ghost_mode ;;
            ghost) apply_incognito_mode ;;
            *) apply_zoth_hero ;;
        esac
        ;;
    interactive|*) interactive_menu ;;
esac
