REFRESH_MS        = 800


class DetailedGraph:
    """Vector time-series wave graph with glowing grid, peak trackers & area gradient."""
    def __init__(self, capacity=45, label="METRIC"):
        self.capacity = capacity
        self.label = label
        self.data = [0.0] * capacity

    def push(self, val):
        self.data.append(val)
        if len(self.data) > self.capacity:
            self.data.pop(0)

    def draw(self, cr, x, y, w, h, color, max_scale=100.0, show_grid=True):
        if len(self.data) < 2 or w <= 0 or h <= 0:
            return

        # 1. Subtle Background Grid
        if show_grid:
            cr.set_source_rgba(1.0, 1.0, 1.0, 0.05)
            cr.set_line_width(0.7)
            for g_pct in [0.33, 0.66]:
                gy = y + h - (g_pct * h)
                cr.move_to(x, gy)
                cr.line_to(x + w, gy)
                cr.stroke()

        # 2. Compute Points
        step = w / (len(self.data) - 1)
        scale = max(1.0, max_scale)
        pts = []
        for i, v in enumerate(self.data):
            norm_v = min(1.0, max(0.0, v / scale))
            px = x + i * step
            py = y + h - (norm_v * h)
            pts.append((px, py))

        # 3. Fill Gradient under Curve
        cr.move_to(*pts[0])
        for px, py in pts[1:]:
            cr.line_to(px, py)
        cr.line_to(pts[-1][0], y + h)
        cr.line_to(pts[0][0], y + h)
        cr.close_path()

        pat = cairo.LinearGradient(x, y, x, y + h)
        pat.add_color_stop_rgba(0, color[0], color[1], color[2], 0.30)
        pat.add_color_stop_rgba(1, color[0], color[1], color[2], 0.02)
        cr.set_source(pat)
        cr.fill()

        # 4. Glowing Stroke Line
        cr.set_source_rgba(color[0], color[1], color[2], 0.95)
        cr.set_line_width(1.5)
        cr.move_to(*pts[0])
        for px, py in pts[1:]:
            cr.line_to(px, py)
        cr.stroke()

        # 5. Glowing Peak Dot on latest value
        last_x, last_y = pts[-1]
        cr.arc(last_x, last_y, 2.8, 0, 2 * math.pi)
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.95)
        cr.fill()
        cr.arc(last_x, last_y, 4.5, 0, 2 * math.pi)
        cr.set_source_rgba(color[0], color[1], color[2], 0.45)
        cr.stroke()


class ZothApexHUD(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("ZOTHOS APEX TELEMETRY HUD")
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.DOCK)
        self.set_keep_below(True)
        self.set_accept_focus(False)
        
        self.drawer_mode = None  # None, 'cpu', 'ram'
        self._cur_height = HUD_H_BASE
        self.set_default_size(HUD_W, self._cur_height)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual and screen.is_composited():
            self.set_visual(visual)
        self.set_app_paintable(True)

        # Position top-right
        try:
            display = Gdk.Display.get_default()
            monitor = display.get_primary_monitor() or display.get_monitor(0)
            sw = monitor.get_geometry().width if monitor else 1920
        except Exception:
            sw = 1920
        self.move(sw - HUD_W - 20, 36)

        # State
        self.theme_name = "emerald"
        self.compact_mode = False
        self._pulse = 0.0
        self._last_t = time.time()
        self._cpu_prev = self._read_stat()
        self._net_prev = self._read_net()

        self.cpu_pct = 0.0
        self.cpu_cores = []
        self.cpu_freq_ghz = 0.0
        self.ram_pct = 0.0
        self.ram_used_gb = 0.0
        self.ram_total_gb = 0.0
        self.ram_cached_gb = 0.0
        self.ram_buffers_gb = 0.0
        self.disk_pct = 0.0
        self.disk_free_gb = 0.0
        self.disk_total_gb = 0.0
        self.net_rx = 0.0
        self.net_tx = 0.0
        self.cpu_temp = -1.0
        self.tor_active = False
        self.top_proc = "system"
        self.top_proc_cpu = 0.0
        self.ai_model = "llama3.2"
        self.sentinel_active = True
        self.net_identities = []
        self.uptime_str = "0h 00m"

        # Detailed Process Lists for interactive inspection
        self.cpu_processes = []
        self.ram_processes = []

        # High-Fidelity Graphs
        self.graph_cpu = DetailedGraph(45, "CPU")
        self.graph_ram = DetailedGraph(45, "RAM")
        self.graph_net_rx = DetailedGraph(45, "RX")

        # Hotspots map: name -> (x, y, w, h, callback)
        self.hotspots = {}

        self._update_metrics()
        self.connect("draw", self._on_draw)
        self.connect("delete-event", Gtk.main_quit)
        self.connect("button-press-event", self._on_click)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)

        GLib.timeout_add(REFRESH_MS, self._tick)

    # ── Proc Telemetry Readers ──────────────────────────────────
    def _read_stat(self):
        try:
            with open('/proc/stat', 'r') as f:
                lines = f.readlines()
            out = []
            for line in lines:
                if not line.startswith('cpu'):
                    break
                p = list(map(float, line.split()[1:8]))
                out.append((sum(p[3:5]), sum(p)))
            return out
        except Exception:
            return [(0, 1)]

    def _read_cpu_freq(self):
        try:
            with open('/proc/cpuinfo', 'r') as f:
                for line in f:
                    if 'cpu MHz' in line:
                        mhz = float(line.split(':')[1].strip())
                        return mhz / 1000.0
        except Exception:
            pass
        return 2.4

    def _read_net(self):
        rx = tx = 0
        try:
            with open('/proc/net/dev', 'r') as f:
                lines = f.readlines()[2:]
            for line in lines:
                p = line.split()
                if not p[0].startswith(('lo', 'docker', 'br-', 'veth')):
                    rx += int(p[1])
                    tx += int(p[9])
        except Exception:
            pass
        return rx, tx

    def _read_temp(self):
        for path in ['/sys/class/thermal/thermal_zone0/temp',
                     '/sys/class/hwmon/hwmon0/temp1_input',
                     '/sys/class/hwmon/hwmon1/temp1_input']:
            if os.path.exists(path):
                try:
                    with open(path) as f:
                        return float(f.read().strip()) / 1000.0
                except Exception:
                    pass
        return -1.0

    def _read_processes(self):
        cpu_procs = []
        try:
            res = subprocess.run(
                ["ps", "-eo", "pid,user,%cpu,%mem,comm", "--sort=-%cpu", "--no-headers"],
                capture_output=True, text=True, timeout=1
            )
            for line in res.stdout.strip().splitlines()[:6]:
                p = line.split(None, 4)
                if len(p) >= 5:
                    cpu_procs.append({
                        "pid": p[0],
                        "user": p[1][:8],
                        "cpu": float(p[2]),
                        "mem": float(p[3]),
                        "name": p[4]
                    })
        except Exception:
            pass

        ram_procs = []
        try:
            res = subprocess.run(
                ["ps", "-eo", "pid,user,rss,%mem,comm", "--sort=-rss", "--no-headers"],
                capture_output=True, text=True, timeout=1
            )
            for line in res.stdout.strip().splitlines()[:6]:
                p = line.split(None, 4)
                if len(p) >= 5:
                    rss_mb = int(p[2]) / 1024.0
                    ram_procs.append({
                        "pid": p[0],
                        "user": p[1][:8],
                        "rss_mb": rss_mb,
                        "mem": float(p[3]),
                        "name": p[4]
                    })
        except Exception:
            pass

        return cpu_procs, ram_procs

    def _read_sentinel_info(self):
        cfg_path = "/etc/zothos/sentinel.json"
        if os.path.exists(cfg_path):
            try:
                with open(cfg_path, 'r') as f:
                    data = json.load(f)
                    return f"{data.get('model', 'llama3.2')} ({data.get('provider', 'ollama')})"
            except Exception:
                pass
        return "llama3.2:latest (ollama)"

    def _read_network_identities(self):
        identities = []
        try:
            def iface_priority(name):
                if name.startswith(('en', 'eth', 'wl')):
                    return 0
                if name.startswith(('tun', 'tap', 'wg', 'tailscale', 'proton')):
                    return 1
                if name.startswith(('br', 'docker', 'veth', 'virbr')):
                    return 3
                return 2

            ifaces = os.listdir('/sys/class/net/')
            sorted_ifaces = sorted([i for i in ifaces if i != 'lo'], key=lambda x: (iface_priority(x), x))
            for iface in sorted_ifaces:
                mac_path = f'/sys/class/net/{iface}/address'
                mac = "00:00:00:00:00:00"
                if os.path.exists(mac_path):
                    with open(mac_path, 'r') as f:
                        mac = f.read().strip()

                ip = ""
                try:
                    res = subprocess.run(
                        ["ip", "-4", "-brief", "addr", "show", iface],
                        capture_output=True, text=True, timeout=1
                    )
                    parts = res.stdout.strip().split()
                    if len(parts) >= 3:
                        ip = parts[2].split('/')[0]
                except Exception:
                    pass

                if ip or (mac and mac != "00:00:00:00:00:00"):
                    identities.append({
                        "iface": iface,
                        "ip": ip or "0.0.0.0 (Offline)",
                        "mac": mac.upper()
                    })
        except Exception:
            pass
        return identities

    # ── Update loop ─────────────────────────────────────────────
    def _update_metrics(self):
        now = time.time()
        dt = max(0.1, now - self._last_t)
        self._last_t = now

        # CPU
        cur = self._read_stat()
        if cur and self._cpu_prev and len(cur) == len(self._cpu_prev):
            idle_d = cur[0][0] - self._cpu_prev[0][0]
            total_d = max(1.0, cur[0][1] - self._cpu_prev[0][1])
            self.cpu_pct = max(0.0, min(100.0, (1 - idle_d / total_d) * 100))
            self.cpu_cores = []
            for i in range(1, len(cur)):
                id2 = cur[i][0] - self._cpu_prev[i][0]
                to2 = max(1.0, cur[i][1] - self._cpu_prev[i][1])
                self.cpu_cores.append(max(0.0, min(100.0, (1 - id2 / to2) * 100)))
        self._cpu_prev = cur
        self.cpu_freq_ghz = self._read_cpu_freq()

        # RAM
        try:
            mem = {}
            with open('/proc/meminfo', 'r') as f:
                for line in f:
                    k, v = line.split(':')
                    mem[k.strip()] = int(v.split()[0])
            total = mem.get('MemTotal', 4194304)
            avail = mem.get('MemAvailable', total // 2)
            cached = mem.get('Cached', 0)
            buffers = mem.get('Buffers', 0)
            used = total - avail
            self.ram_pct = max(0.0, min(100.0, (used / total) * 100))
            self.ram_used_gb = used / (1024 * 1024)
            self.ram_total_gb = total / (1024 * 1024)
            self.ram_cached_gb = cached / (1024 * 1024)
            self.ram_buffers_gb = buffers / (1024 * 1024)
        except Exception:
            pass

        # Storage
        try:
            st = os.statvfs('/')
            total_b = st.f_blocks * st.f_frsize
            free_b  = st.f_bavail * st.f_frsize
            used_b  = total_b - free_b
            self.disk_pct = max(0.0, min(100.0, (used_b / total_b) * 100))
            self.disk_free_gb = free_b / (1024**3)
            self.disk_total_gb = total_b / (1024**3)
        except Exception:
            pass

        # Network Rate
        nrx, ntx = self._read_net()
        if self._net_prev:
            self.net_rx = max(0.0, (nrx - self._net_prev[0]) / dt / 1024.0)
            self.net_tx = max(0.0, (ntx - self._net_prev[1]) / dt / 1024.0)
        self._net_prev = (nrx, ntx)

        # Temp & Extras
        self.cpu_temp = self._read_temp()
        self.tor_active = (subprocess.run(['systemctl', 'is-active', 'tor'], capture_output=True).returncode == 0)
        
        self.cpu_processes, self.ram_processes = self._read_processes()
        if self.cpu_processes:
            self.top_proc = self.cpu_processes[0]['name']
            self.top_proc_cpu = self.cpu_processes[0]['cpu']

        self.ai_model = self._read_sentinel_info()
        self.sentinel_active = (subprocess.run(['systemctl', 'is-active', 'zoth-sentinel'], capture_output=True).returncode == 0)
        self.net_identities = self._read_network_identities()

        # Uptime
        try:
            with open('/proc/uptime') as f:
                up_s = int(float(f.read().split()[0]))
                h = up_s // 3600
                m = (up_s % 3600) // 60
                self.uptime_str = f"{h}h {m:02d}m"
        except Exception:
            pass

        # Push to Detailed Graphs
        self.graph_cpu.push(self.cpu_pct)
        self.graph_ram.push(self.ram_pct)
        self.graph_net_rx.push(self.net_rx)

    def _tick(self):
        self._pulse += 0.12
        self._update_metrics()
        self.queue_draw()
        return True

    # ── Interactive Actions ─────────────────────────────────────
    def toggle_drawer(self, mode):
        """Toggle interactive inspection drawers (cpu, ram)."""
        if self.drawer_mode == mode:
            self.drawer_mode = None
            self._cur_height = HUD_H_BASE
        else:
            self.drawer_mode = mode
            self._cur_height = HUD_H_WITH_DRAWER
        self.resize(HUD_W, self._cur_height)
        self.queue_draw()

    def randomize_mac(self, iface):
        """Randomize MAC address on the given interface with feedback."""
        def do_spoof():
            try:
                mac = [0x02, random.randint(0x00, 0x7f), random.randint(0x00, 0xff),
                       random.randint(0x00, 0xff), random.randint(0x00, 0xff), random.randint(0x00, 0xff)]
                mac_str = ":".join(f"{b:02x}" for b in mac)
                
                subprocess.run(["sudo", "ip", "link", "set", "dev", iface, "down"], check=True)
                subprocess.run(["sudo", "ip", "link", "set", "dev", iface, "address", mac_str], check=True)
                subprocess.run(["sudo", "ip", "link", "set", "dev", iface, "up"], check=True)
                
                subprocess.Popen([
                    "notify-send", "-i", "/usr/share/pixmaps/zothos.png",
                    "[+] MAC CLOAKED",
                    f"Interface {iface} spoofed to:\n{mac_str.upper()}"
                ])
            except Exception:
                subprocess.run(["sudo", "macchanger", "-r", iface], capture_output=True)
                subprocess.Popen([
                    "notify-send", "-i", "/usr/share/pixmaps/zothos.png",
                    "[+] MAC RANDOMIZED",
                    f"Interface {iface} randomized via macchanger"
                ])
        GLib.idle_add(do_spoof)

    def renew_dhcp(self, iface):
        """Re-request DHCP lease and refresh network identity."""
        def do_renew():
            try:
                subprocess.run(["sudo", "nmcli", "device", "reapply", iface], capture_output=True)
                subprocess.Popen([
                    "notify-send", "-i", "/usr/share/pixmaps/zothos.png",
                    "[+] IP RENEWED",
                    f"DHCP lease refreshed on {iface}"
                ])
            except Exception:
                subprocess.run(["sudo", "dhclient", "-r", iface], capture_output=True)
                subprocess.run(["sudo", "dhclient", iface], capture_output=True)
        GLib.idle_add(do_renew)

    def cloak_full_identity(self):
        """One-click full anonymity cloak (Randomize MAC + Renew DHCP + Flush DNS)."""
        if self.net_identities:
            iface = self.net_identities[0]['iface']
            self.randomize_mac(iface)
            GLib.timeout_add(1500, lambda: self.renew_dhcp(iface) or False)
            subprocess.Popen(["sudo", "resolvectl", "flush-caches"])

    def kill_process(self, pid, name):
        """Kill a process from the interactive drawer."""
        try:
            subprocess.run(["kill", "-9", str(pid)])
            subprocess.Popen([
                "notify-send", "-u", "critical",
                "[!] PROCESS TERMINATED",
                f"Killed {name} (PID: {pid})"
            ])
            self._update_metrics()
            self.queue_draw()
        except Exception:
            pass

    def cycle_theme(self):
        keys = list(THEMES.keys())
        idx = (keys.index(self.theme_name) + 1) % len(keys)
        self.theme_name = keys[idx]

    def toggle_tor(self):
        cmd = ["sudo", "systemctl", "stop" if self.tor_active else "start", "tor"]
        subprocess.Popen(cmd)

    def toggle_sentinel_hud(self):
        subprocess.Popen(["/usr/local/bin/zoth-sentinel-hud"])

    def purge_ram(self):
        subprocess.Popen(["bash", "-c", "sync; echo 3 | sudo tee /proc/sys/vm/drop_caches >/dev/null 2>&1; notify-send -i /usr/share/pixmaps/zothos.png '[✓] MEMORY PURGED' 'PageCache and dentries cleared'"])

    def run_self_heal(self):
        subprocess.Popen(["/usr/local/bin/zoth-heal", "--quick"])

    # ── Input & Hotspot Dispatch ────────────────────────────────
    def _on_click(self, widget, event):
        x, y = event.x, event.y

        # Drag window on header click
        if event.button == 1 and y < 48:
            if event.type == Gdk.EventType._2BUTTON_PRESS:
                self.compact_mode = not self.compact_mode
                h = HUD_H_MINI if self.compact_mode else self._cur_height
                self.resize(HUD_W, h)
                self.queue_draw()
                return True
            self.begin_move_drag(event.button, int(event.x_root), int(event.y_root), event.time)
            return True

        # Check action hotspots
        for name, (hx, hy, hw, hh, cb) in self.hotspots.items():
            if hx <= x <= hx + hw and hy <= y <= hy + hh:
                cb()
                self.queue_draw()
                return True
        return False

    # ── Drawing Primitives ──────────────────────────────────────
    def _rrect(self, cr, x, y, w, h, r):
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()

    def _card(self, cr, x, y, w, h, thm, r=10, active=False):
        """Draws an acrylic glass sub-card container with subtle neon border."""
        self._rrect(cr, x, y, w, h, r)
        cr.set_source_rgba(*thm["card_bg"])
        cr.fill_preserve()
        
        border_col = thm["primary"] if active else thm["card_border"]
        cr.set_source_rgba(*border_col)
        cr.set_line_width(1.1 if not active else 1.5)
        cr.stroke()

    def _bar(self, cr, x, y, w, h, pct, color):
        r, g, b = color[:3]
        self._rrect(cr, x, y, w, h, h / 2)
        cr.set_source_rgba(*C_BAR_BG)
        cr.fill()

        fw = max(h, (w * min(100.0, max(0.0, pct)) / 100.0))
        self._rrect(cr, x, y, fw, h, h / 2)
        pat = cairo.LinearGradient(x, y, x + fw, y)
        pat.add_color_stop_rgba(0, r, g, b, 0.70)
        pat.add_color_stop_rgba(1, r, g, b, 1.00)
        cr.set_source(pat)
        cr.fill()

    def _text(self, cr, x, y, text, size=9.0, bold=False, color=C_WHITE, font="JetBrains Mono"):
        cr.save()
        layout = PangoCairo.create_layout(cr)
        desc_str = f"{font} {'Bold ' if bold else ''}{size}pt"
        desc = Pango.FontDescription(desc_str)
        layout.set_font_description(desc)
        layout.set_text(str(text), -1)
        cr.set_source_rgba(*color)
        cr.move_to(x, y)
        PangoCairo.show_layout(cr, layout)
        cr.restore()

    def _button_pill(self, cr, x, y, w, h, text, active, color, name, cb, font_size=8.0):
        self.hotspots[name] = (x, y, w, h, cb)
        self._rrect(cr, x, y, w, h, 6)
        
        if active:
            pat = cairo.LinearGradient(x, y, x, y + h)
            pat.add_color_stop_rgba(0, color[0], color[1], color[2], 0.35)
            pat.add_color_stop_rgba(1, color[0], color[1], color[2], 0.12)
            cr.set_source(pat)
            cr.fill_preserve()
            cr.set_source_rgba(color[0], color[1], color[2], 0.85)
            cr.set_line_width(1.1)
            cr.stroke()
            self._text(cr, x + (w - len(text) * (font_size * 0.65)) / 2, y + (h - font_size * 1.35) / 2, text, size=font_size, bold=True, color=C_WHITE)
        else:
            cr.set_source_rgba(0.08, 0.12, 0.18, 0.85)
            cr.fill_preserve()
            cr.set_source_rgba(*C_DIM)
            cr.set_line_width(0.8)
            cr.stroke()
            self._text(cr, x + (w - len(text) * (font_size * 0.65)) / 2, y + (h - font_size * 1.35) / 2, text, size=font_size, bold=False, color=C_DIM)

    # ── Master Draw Canvas ──────────────────────────────────────
    def _on_draw(self, widget, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)

        thm = THEMES[self.theme_name]
        W = HUD_W
        H = HUD_H_MINI if self.compact_mode else self._cur_height
        PAD = 14
        CARD_W = W - PAD * 2
        self.hotspots.clear()

        # ── Master Card Acrylic Frame ──────────────────────────────
        self._rrect(cr, 2, 2, W - 4, H - 4, 18)
        pat = cairo.LinearGradient(0, 0, 0, H)
        pat.add_color_stop_rgba(0, *thm["bg_top"])
        pat.add_color_stop_rgba(1.0, *thm["bg_bot"])
        cr.set_source(pat)
        cr.fill_preserve()

        # Pulsing Neon Outer Border
        pulse_alpha = 0.45 + (math.sin(self._pulse) * 0.18)
        cr.set_source_rgba(thm["primary"][0], thm["primary"][1], thm["primary"][2], pulse_alpha)
        cr.set_line_width(1.6)
        cr.stroke()

        # ── Header Bar ─────────────────────────────────────────────
        self._rrect(cr, 2, 2, W - 4, 46, 18)
        cr.set_source_rgba(thm["primary"][0], thm["primary"][1], thm["primary"][2], 0.10)
        cr.fill()

        # Glowing Pulse Dot
        orb_x, orb_y = PAD + 4, 23
        cr.arc(orb_x, orb_y, 4.5, 0, 2 * math.pi)
        cr.set_source_rgba(*thm["primary"])
        cr.fill()

        self._text(cr, PAD + 16, 13, "ZOTHOS APEX HUD", size=10.5, bold=True, color=thm["accent"])
        self._text(cr, PAD + 16, 28, f"PRO SOVEREIGN // [{self.theme_name.upper()}]", size=7.5, color=C_DIM)

        # Header Buttons (MINI & THEME FX)
        self._button_pill(cr, W - 108, 12, 44, 22, "MINI", self.compact_mode, thm["primary"], "btn_mini", lambda: self._toggle_mini())
        self._button_pill(cr, W - 58, 12, 44, 22, "FX", True, thm["secondary"], "btn_theme", self.cycle_theme)

        if self.compact_mode:
            self._text(cr, PAD + 4, 58, f"CPU: {self.cpu_pct:.1f}%  |  RAM: {self.ram_pct:.0f}%  |  NET: ▼{self.net_rx:.0f}K", size=9.5, bold=True, color=thm["primary"])
            return False

        y = 54

        # ── Card 1: CPU Compute Matrix (Interactive Click to Inspect)
        c1_h = 114
        is_cpu_drawer = (self.drawer_mode == 'cpu')
        self._card(cr, PAD, y, CARD_W, c1_h, thm, active=is_cpu_drawer)
        self.hotspots["card_cpu"] = (PAD, y, CARD_W, c1_h, lambda: self.toggle_drawer('cpu'))
        
        # Line 1: Header + Temp
        self._text(cr, PAD + 12, y + 8, "CPU COMPUTE MATRIX", size=8.5, bold=True, color=thm["primary"])
        if self.cpu_temp > 0:
            tc = C_RED if self.cpu_temp > 80 else thm["accent"]
            self._text(cr, W - PAD - 68, y + 8, f"{self.cpu_temp:.0f}°C", size=8, bold=True, color=tc)
        
        # Line 2: Big Metric + Frequency + Top Process
        pct_color = C_RED if self.cpu_pct > 85 else thm["primary"]
        self._text(cr, PAD + 12, y + 24, f"{self.cpu_pct:.1f}%", size=18, bold=True, color=pct_color)
        self._text(cr, PAD + 84, y + 27, f"[{self.cpu_freq_ghz:.1f} GHz]", size=7.5, color=C_DIM)
        self._text(cr, W - PAD - 150, y + 27, f"Top: {self.top_proc[:10]} ({self.top_proc_cpu:.0f}%)", size=8, color=C_MUTED)

        # Line 3: Per-Core Equalizer Load Bars
        if self.cpu_cores:
            n = len(self.cpu_cores)
            cw = (CARD_W - 24 - (n - 1) * 3) / max(1, n)
            for i, cp in enumerate(self.cpu_cores):
                cx = PAD + 12 + i * (cw + 3)
                self._bar(cr, cx, y + 46, cw, 3, cp, thm["secondary"])

        # Line 4: High-Fidelity Wave Graph
        self.graph_cpu.draw(cr, PAD + 12, y + 54, CARD_W - 24, 52, thm["primary"], max_scale=100.0)
        y += c1_h + 8

        # ── Interactive CPU Process Drawer (If Opened) ─────────────
        if is_cpu_drawer:
            d_h = 142
            self._card(cr, PAD, y, CARD_W, d_h, thm, r=8, active=True)
            self._text(cr, PAD + 12, y + 8, "⚡ TOP CPU PROCESSES // CLICK TO TERMINATE", size=8, bold=True, color=thm["accent"])
            py_offset = y + 26
            for proc in self.cpu_processes[:5]:
                p_text = f"PID {proc['pid']:>5}  {proc['user']:<8} {proc['cpu']:>4.1f}% CPU  {proc['name'][:12]}"
                self._text(cr, PAD + 12, py_offset, p_text, size=8, color=C_WHITE)
                btn_name = f"kill_cpu_{proc['pid']}"
                self._button_pill(cr, W - PAD - 48, py_offset - 2, 38, 16, "KILL", False, C_RED, btn_name, 
                                  lambda p=proc: self.kill_process(p['pid'], p['name']), font_size=7)
                py_offset += 22
            y += d_h + 8

        # ── Card 2: Dynamic Memory Buffer (Interactive Click to Inspect)
        c2_h = 98
        is_ram_drawer = (self.drawer_mode == 'ram')
        self._card(cr, PAD, y, CARD_W, c2_h, thm, active=is_ram_drawer)
        self.hotspots["card_ram"] = (PAD, y, CARD_W, c2_h, lambda: self.toggle_drawer('ram'))

        # Line 1: Header + % Used
        self._text(cr, PAD + 12, y + 8, "DYNAMIC MEMORY BUFFER", size=8.5, bold=True, color=thm["secondary"])
        self._text(cr, W - PAD - 68, y + 8, f"{int(self.ram_pct)}% USED", size=8, bold=True, color=thm["secondary"])

        # Line 2: GB Metric + Cache info
        ram_str = f"{self.ram_used_gb:.2f} GB / {self.ram_total_gb:.2f} GB"
        self._text(cr, PAD + 12, y + 24, ram_str, size=11, bold=True, color=C_WHITE)
        self._text(cr, PAD + 180, y + 25, f"Cache: {self.ram_cached_gb:.2f} GB", size=8, color=C_MUTED)

        # Line 3: Multi-Segment Split Bar
        self._bar(cr, PAD + 12, y + 42, CARD_W - 24, 4, self.ram_pct, thm["secondary"])
        # Line 4: High-Fidelity Wave Graph
        self.graph_ram.draw(cr, PAD + 12, y + 50, CARD_W - 24, 42, thm["secondary"], max_scale=100.0)
        y += c2_h + 8

        # ── Interactive RAM Process Drawer (If Opened) ─────────────
        if is_ram_drawer:
            d_h = 142
            self._card(cr, PAD, y, CARD_W, d_h, thm, r=8, active=True)
            self._text(cr, PAD + 12, y + 8, "💾 TOP MEMORY CONSUMERS // CLICK TO TERMINATE", size=8, bold=True, color=thm["accent"])
            py_offset = y + 26
            for proc in self.ram_processes[:5]:
                p_text = f"PID {proc['pid']:>5}  {proc['user']:<8} {proc['rss_mb']:>5.0f}MB ({proc['mem']:>3.1f}%) {proc['name'][:10]}"
                self._text(cr, PAD + 12, py_offset, p_text, size=8, color=C_WHITE)
                btn_name = f"kill_ram_{proc['pid']}"
                self._button_pill(cr, W - PAD - 48, py_offset - 2, 38, 16, "KILL", False, C_RED, btn_name, 
                                  lambda p=proc: self.kill_process(p['pid'], p['name']), font_size=7)
                py_offset += 22
            y += d_h + 8

        # ── Card 3: Storage & Network I/O (Dual Grid) ──────────────
        c3_h = 92
        half_w = (CARD_W - 10) // 2

        # Left: Storage
        self._card(cr, PAD, y, half_w, c3_h, thm)
        self._text(cr, PAD + 10, y + 8, "NVMe STORAGE", size=8, bold=True, color=thm["accent"])
        self._text(cr, PAD + 10, y + 24, f"{self.disk_free_gb:.1f} GB Free", size=10, bold=True, color=C_WHITE)
        self._text(cr, PAD + 10, y + 40, f"Used: {self.disk_pct:.0f}% of {self.disk_total_gb:.0f}G", size=7.5, color=C_MUTED)
        self._bar(cr, PAD + 10, y + 62, half_w - 20, 6, self.disk_pct, thm["accent"])

        # Right: Network I/O
        self._card(cr, PAD + half_w + 10, y, half_w, c3_h, thm)
        self._text(cr, PAD + half_w + 18, y + 8, "NETWORK I/O", size=8, bold=True, color=thm["primary"])
        self._text(cr, PAD + half_w + 18, y + 24, f"▼ {self.net_rx:.1f} KB/s", size=9, bold=True, color=thm["primary"])
        self._text(cr, PAD + half_w + 18, y + 38, f"▲ {self.net_tx:.1f} KB/s", size=7.5, color=C_MUTED)
        self.graph_net_rx.draw(cr, PAD + half_w + 18, y + 54, half_w - 28, 28, thm["primary"], max_scale=max(50.0, self.net_rx * 2), show_grid=False)
        y += c3_h + 8

        # ── Card 4: Network Hardware Identity (Interactive Spoofing & DHCP)
        c4_h = 104 if len(self.net_identities) > 1 else 82
        self._card(cr, PAD, y, CARD_W, c4_h, thm)

        self._text(cr, PAD + 12, y + 8, "NETWORK ADAPTERS // SPOOF & RENEW", size=8.5, bold=True, color=thm["secondary"])
        self._button_pill(cr, W - PAD - 96, y + 6, 92, 19, "👻 CLOAK ALL", True, thm["accent"], "btn_cloak_all", self.cloak_full_identity, font_size=7.5)

        ny = y + 28
        if self.net_identities:
            for idx, ident in enumerate(self.net_identities[:2]):
                iface = ident['iface']
                # Row 1: Iface Badge + IP
                self._text(cr, PAD + 12, ny, f"[{iface}]", size=8.5, bold=True, color=thm["primary"])
                self._text(cr, PAD + 74, ny, ident['ip'], size=9, bold=True, color=C_WHITE)
                
                # Renew Button
                btn_renew_name = f"btn_renew_{iface}"
                self._button_pill(cr, W - PAD - 146, ny - 2, 68, 18, "🔄 RENEW", False, thm["secondary"], btn_renew_name, 
                                  lambda i=iface: self.renew_dhcp(i), font_size=7.0)

                # Spoof Button
                btn_mac_name = f"btn_mac_{iface}"
                self._button_pill(cr, W - PAD - 72, ny - 2, 68, 18, "🎲 SPOOF", False, thm["primary"], btn_mac_name, 
                                  lambda i=iface: self.randomize_mac(i), font_size=7.0)

                # Row 2: MAC Address
                self._text(cr, PAD + 12, ny + 15, f"HW MAC: {ident['mac']}", size=7.5, color=C_MUTED)

                ny += 34
        else:
            self._text(cr, PAD + 12, ny, "No active physical network interfaces", size=8.5, color=C_DIM)

        y += c4_h + 8

        # ── Card 5: Autonomous Sentinel AI & Security Ring ─────────
        c5_h = 58
        self._card(cr, PAD, y, CARD_W, c5_h, thm)

        self._text(cr, PAD + 12, y + 8, "AUTONOMOUS SENTINEL AI", size=8.5, bold=True, color=thm["accent"])
        ai_st = "● ACTIVE" if self.sentinel_active else "○ IDLE"
        self._text(cr, W - PAD - 68, y + 8, ai_st, size=8.5, bold=True, color=thm["primary"] if self.sentinel_active else C_RED)

        self._text(cr, PAD + 12, y + 24, f"Neural Core: {self.ai_model}", size=8, bold=True, color=C_WHITE)
        self._text(cr, PAD + 12, y + 38, "Security Authority: Ring-1 (Root Kernel Execution)", size=7.5, color=C_MUTED)
        y += c5_h + 10

        # ── Quick Action Command Deck ──────────────────────────────
        pw = (CARD_W - 18) // 4
        tor_lbl = "TOR: ON" if self.tor_active else "TOR: OFF"
        self._button_pill(cr, PAD, y, pw, 26, tor_lbl, self.tor_active, thm["primary"], "btn_tor", self.toggle_tor, font_size=7.5)
        self._button_pill(cr, PAD + pw + 6, y, pw, 26, "⚡ SENTINEL", True, thm["accent"], "btn_ai", self.toggle_sentinel_hud, font_size=7.5)
        self._button_pill(cr, PAD + (pw + 6) * 2, y, pw, 26, "🧹 PURGE", True, thm["secondary"], "btn_purge", self.purge_ram, font_size=7.5)
        self._button_pill(cr, PAD + (pw + 6) * 3, y, pw, 26, "🩺 HEAL OS", True, thm["primary"], "btn_heal", self.run_self_heal, font_size=7.5)
        y += 34

        # ── Footer Telemetry ───────────────────────────────────────
        self._text(cr, PAD + 4, y, f"UPTIME: {self.uptime_str}  •  ZOTHOS APEX v4.0 PRO", size=7.5, color=C_DIM)

        return False

    def _toggle_mini(self):
        self.compact_mode = not self.compact_mode
        h = HUD_H_MINI if self.compact_mode else self._cur_height
        self.resize(HUD_W, h)
        self.queue_draw()


def main():
    signal.signal(signal.SIGTERM, lambda *a: Gtk.main_quit())
    signal.signal(signal.SIGINT, lambda *a: Gtk.main_quit())
    app = ZothApexHUD()
    app.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
