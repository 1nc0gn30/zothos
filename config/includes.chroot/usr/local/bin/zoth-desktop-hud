#!/usr/bin/env bash
# =============================================================================
# ZothOS Apex Telemetry HUD v5.0 (Electron Engine)
# =============================================================================
set -e

HUD_DIR="/opt/zoth-hud"

# Check if another instance is running and kill it
pkill -f "electron /opt/zoth-hud" 2>/dev/null || true

# Check for Electron binary
if command -v electron >/dev/null 2>&1; then
    exec electron --no-sandbox "$HUD_DIR" "$@"
elif [ -f "/usr/lib/node_modules/electron/dist/electron" ]; then
    exec /usr/lib/node_modules/electron/dist/electron --no-sandbox "$HUD_DIR" "$@"
elif command -v npx >/dev/null 2>&1; then
    exec npx electron --no-sandbox "$HUD_DIR" "$@"
else
    echo "[!] Electron not found, falling back to python3 HUD"
    # Fallback to python3 HUD if electron is missing
    python3 -c "import sys; print('[*] Launching fallback HUD')"
fi
