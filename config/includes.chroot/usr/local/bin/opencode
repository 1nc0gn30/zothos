#!/usr/bin/env bash
# ==============================================================================
#  ZOTHOS OpenCode AI Auto-Bootstrap & Runner
# ==============================================================================

if command -v opencode-ai >/dev/null 2>&1 && [[ "$(which opencode-ai)" != "$0" ]]; then
    exec "$(which opencode-ai)" "$@"
fi

if [[ -f "/usr/local/lib/node_modules/opencode-ai/bin/opencode.js" ]]; then
    exec node "/usr/local/lib/node_modules/opencode-ai/bin/opencode.js" "$@"
fi

if [[ -f "/usr/lib/node_modules/opencode-ai/bin/opencode.js" ]]; then
    exec node "/usr/lib/node_modules/opencode-ai/bin/opencode.js" "$@"
fi

if command -v npx >/dev/null 2>&1; then
    exec npx opencode-ai "$@"
fi

echo -e "\e[38;2;255;215;0m[⚡ ZOTHOS AI]\e[0m \e[1;37mOpenCode AI CLI (opencode-ai) not found.\e[0m"
echo -e "\e[38;2;0;229;255m[*] To install OpenCode AI now, run:\e[0m npm install -g opencode-ai"
read -p "Install opencode-ai now? (y/N): " choice
if [[ "$choice" =~ ^[Yy]$ ]]; then
    npm install -g opencode-ai
    exec npx opencode-ai "$@"
fi
exit 1
