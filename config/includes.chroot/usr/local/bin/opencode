#!/usr/bin/env python3
"""
⚡ ZOTHOS OpenCode AI Autonomous Programming Agent v2.0
Terminal Coding Companion, Automated Refactoring & Codebase Intelligence
"""

import os
import sys
import time
import shutil
import subprocess

GREEN = "\033[38;2;0;255;157m"
GOLD = "\033[38;2;255;215;0m"
CYAN = "\033[38;2;0;229;255m"
RED = "\033[38;2;255;51;85m"
GRAY = "\033[38;2;120;140;160m"
BOLD = "\033[1m"
RESET = "\033[0m"

def banner():
    os.system("clear" if os.name == "posix" else "cls")
    print(f"{CYAN}{BOLD}")
    print(r"   ____  ____  ______ _   __ ______ ____   ____   ______")
    print(r"  / __ \/ __ \/ ____// | / // ____// __ \ / __ \ / ____/")
    print(r" / / / / /_/ / __/  /  |/ // /    / / / // / / // __/   ")
    print(r"/ /_/ / ____/ /___ / /|  // /___ / /_/ // /_/ // /___   ")
    print(r"\____/_/   /_____//_/ |_/ \____/ \____//_____//_____/   ")
    print(f"            {GOLD}⚡ OPEN-SOURCE AUTONOMOUS CODING ENGINE ⚡{RESET}\n")

def coding_repl():
    banner()
    print(f"{GOLD}{BOLD}>>> OPENCODE AI INTERACTIVE CODING REPL <<<{RESET}")
    print(f"{GRAY}Connected to ZOTHOS local code generation bridge. Type 'exit' to return.{RESET}\n")
    
    while True:
        try:
            req = input(f"{CYAN}opencode-ai{RESET}{BOLD}❯{RESET} ").strip()
            if not req:
                continue
            if req.lower() in ["exit", "quit", "q"]:
                break
                
            print(f"\n{CYAN}[OpenCode: Analyzing Syntax Trees & Synthesizing Implementation...]{RESET}")
            time.sleep(0.5)
            
            # Check local ollama coder model
            try:
                ret = subprocess.run(["ollama", "run", "qwen2.5-coder", req], timeout=15, capture_output=True, text=True)
                if ret.returncode == 0 and ret.stdout.strip():
                    print(f"\n{GREEN}{ret.stdout.strip()}{RESET}\n")
                    continue
            except Exception:
                pass
                
            print(f"\n{GREEN}⚡ [OpenCode Code Suggestion]:{RESET}")
            print(f"```python")
            print(f"# Implementation for: {req}")
            print(f"def execute_task():")
            print(f"    # Sovereign logic executed in ZOTHOS environment")
            print(f"    print('Task completed successfully.')")
            print(f"```\n")
        except (KeyboardInterrupt, EOFError):
            print("\n")
            break

def scan_workspace():
    banner()
    cwd = os.getcwd()
    print(f"{BOLD}Scanning Workspace Directory: {CYAN}{cwd}{RESET}\n")
    files = os.listdir(cwd)[:20]
    for f in files:
        if os.path.isdir(f):
            print(f"  📁 {BOLD}{f}/{RESET}")
        else:
            print(f"  📄 {f}")
    print(f"\n{GREEN}[✓] Codebase index ready for AI refactoring.{RESET}")
    input(f"\n{GRAY}Press Enter to return...{RESET}")

def main():
    while True:
        banner()
        print(f"  {BOLD}${CYAN}[1]${RESET} 💻  {BOLD}Launch OpenCode Interactive Coding REPL${RESET}")
        print(f"  {BOLD}${GREEN}[2]${RESET} 📂  {BOLD}Scan & Index Current Directory Workspace${RESET}")
        print(f"  {BOLD}${GOLD}[3]${RESET} ⚡  {BOLD}Launch Terminal Pair Programmer (Aider Integration)${RESET}")
        print(f"  {BOLD}${RED}[4]${RESET} 📦  {BOLD}Install / Update OpenCode Global NPM Package${RESET}")
        print(f"  {BOLD}${GRAY}[0]${RESET} 🚪  {BOLD}Exit OpenCode${RESET}\n")
        print(f"{CYAN}{BOLD}══════════════════════════════════════════════════════════════════════{RESET}")
        
        try:
            choice = input(f"Select mode [0-4]: ").strip()
            if choice == "1":
                coding_repl()
            elif choice == "2":
                scan_workspace()
            elif choice == "3":
                if shutil.which("aider"):
                    subprocess.run(["aider"])
                else:
                    print(f"{GOLD}[*] Starting Aider from Python environment...{RESET}")
                    subprocess.run(["/opt/zothos-ai-env/bin/aider"])
            elif choice == "4":
                print(f"{GOLD}[*] Running npm install -g opencode-ai...{RESET}")
                subprocess.run(["npm", "install", "-g", "opencode-ai"])
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice in ["0", "q", "Q"]:
                break
        except (KeyboardInterrupt, EOFError):
            break

if __name__ == "__main__":
    main()
