#!/usr/bin/env bash
# ==============================================================================
#  ZOTHOS OpenCode AI Auto-Bootstrap & Runner
# ==============================================================================
set -euo pipefail

if ! command -v npm >/dev/null 2>&1; then
    echo -e "\e[1;33m[*] Installing Node.js & npm runtime for OpenCode...\e[0m"
    sudo apt-get update -y && sudo apt-get install -y nodejs npm
fi

if ! npm list -g opencode-ai >/dev/null 2>&1 && ! command -v opencode >/dev/null 2>&1; then
    echo -e "\e[1;36m[⚡] ZOTHOS: Auto-installing OpenCode CLI (opencode-ai)...\e[0m"
    sudo npm install -g opencode-ai || npm install -g opencode-ai
fi

if command -v opencode >/dev/null 2>&1 && [[ "$(which opencode)" != "$0" ]]; then
    exec "$(which opencode)" "$@"
else
    npx opencode-ai "$@"
fi
