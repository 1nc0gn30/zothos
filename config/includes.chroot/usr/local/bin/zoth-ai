#!/usr/bin/env bash
# ==============================================================================
#  ZOTHOS AI COMMAND CENTER (Mainstream & Frontier/Underground AI Hub)
#  Harnesses, Brand Apps, Local Inference, Agent Orchestrators & Automation
# ==============================================================================

# Interactive script: no set -e to allow soft checks

GREEN="\e[1;32m"
CYAN="\e[1;36m"
YELLOW="\e[1;33m"
RED="\e[1;31m"
PURPLE="\e[1;35m"
BOLD="\e[1m"
RESET="\e[0m"

banner() {
    clear
    echo -e "${GREEN}"
    echo "  ╔══════════════════════════════════════════════════════════════════════╗"
    echo "  ║      ███████╗ ██████╗ ████████╗██╗  ██╗     █████╗ ██╗               ║"
    echo "  ║      ╚══███╔╝██╔═══██╗╚══██╔══╝██║  ██║    ██╔══██╗██║               ║"
    echo "  ║        ███╔╝ ██║   ██║   ██║   ███████║    ███████║██║               ║"
    echo "  ║       ███╔╝  ██║   ██║   ██║   ██╔══██║    ██╔══██║██║               ║"
    echo "  ║      ███████╗╚██████╔╝   ██║   ██║  ██║    ██║  ██║██║               ║"
    echo "  ║      ╚══════╝ ╚═════╝    ╚═╝   ╚═╝  ╚═╝    ╚═╝  ╚═╝╚═╝               ║"
    echo "  ║               ALCHEMICAL SYNTHESIS & AGENTIC FORGE                   ║"
    echo "  ╚══════════════════════════════════════════════════════════════════════╝"
    echo -e "${RESET}"
}

check_service() {
    local port="$1"
    if ss -tuln 2>/dev/null | grep -q ":$port "; then
        echo -e "${GREEN}[ONLINE :$port]${RESET}"
    else
        echo -e "${RED}[OFFLINE]${RESET}"
    fi
}

show_status() {
    banner
    echo -e "${BOLD}${CYAN}--- [ MAINSTREAM LOCAL INFERENCE STATUS ] ---${RESET}"
    printf "  %-25s %s\n" "Ollama API (11434)" "$(check_service 11434)"
    printf "  %-25s %s\n" "Open WebUI (8080)" "$(check_service 8080)"
    printf "  %-25s %s\n" "ComfyUI (8188)" "$(check_service 8188)"
    printf "  %-25s %s\n" "vLLM Engine (8000)" "$(check_service 8000)"
    printf "  %-25s %s\n" "llama.cpp Server (8081)" "$(check_service 8081)"
    
    echo -e "\n${BOLD}${PURPLE}--- [ ZOTH STUDIO & AGENT PLATFORM ] ---${RESET}"
    printf "  %-25s %s\n" "Zoth Studio Hub (8989)" "$(check_service 8989)"
    printf "  %-25s %s\n" "Hermes Bus Mirror" "$(check_service 8989)"
    
    echo -e "\n${BOLD}${YELLOW}--- [ HARDWARE ACCELERATION ] ---${RESET}"
    if command -v nvidia-smi >/dev/null 2>&1; then
        local gpu_info
        gpu_info=$(nvidia-smi --query-gpu=name,memory.total,utilization.gpu --format=csv,noheader 2>/dev/null || echo "NVIDIA Driver Loaded")
        echo -e "  GPU: ${GREEN}$gpu_info${RESET}"
    else
        echo -e "  GPU: ${YELLOW}CPU/ROCm Fallback Mode${RESET}"
    fi
    echo ""
}

run_menu() {
    while true; do
        show_status
        echo -e "${BOLD}Select Arsenal Action:${RESET}"
        echo -e "  ${GREEN}[1]${RESET} Launch Ollama Server / Models"
        echo -e "  ${GREEN}[2]${RESET} Launch Open WebUI (Local ChatGPT-style Interface)"
        echo -e "  ${GREEN}[3]${RESET} Launch ComfyUI (Generative Visuals & Diffusion Lattices)"
        echo -e "  ${GREEN}[4]${RESET} Launch Zoth Studio (Hermetic Operations Center)"
        echo -e "  ${PURPLE}[5]${RESET} Agent Orchestrator Suite (Hermes, CrewAI, LangGraph, AutoGen)"
        echo -e "  ${PURPLE}[6]${RESET} Automation & Browser Agents (Browser-Use, Open Interpreter)"
        echo -e "  ${RED}[7]${RESET} Frontier AI Red Teaming & Audit Harnesses (Garak, PyRIT, Promptfoo)"
        echo -e "  ${YELLOW}[8]${RESET} Benchmark & Eval Harnesses (lm-eval-harness, inspect_ai)"
        echo -e "  ${CYAN}[9]${RESET} Underground Data & OSINT Scrapers (Crawl4AI, Caido)"
        echo -e "  ${BOLD}[0]${RESET} Exit"
        echo ""
        read -r -p "ZOTH-AI [choice]: " opt

        case "$opt" in
            1)
                if ! pgrep -x "ollama" >/dev/null; then
                    echo -e "${GREEN}[*] Starting Ollama background daemon...${RESET}"
                    ollama serve >/dev/null 2>&1 &
                    sleep 2
                fi
                echo -e "${CYAN}Available local models:${RESET}"
                ollama list 2>/dev/null || true
                read -r -p "Model name to chat with (or press enter to return): " mname
                [[ -n "$mname" ]] && ollama run "$mname"
                ;;
            2)
                echo -e "${GREEN}[*] Launching Open WebUI on http://localhost:8080 ...${RESET}"
                if command -v open-webui >/dev/null 2>&1; then
                    open-webui serve &
                elif command -v docker >/dev/null 2>&1; then
                    docker run -d -p 8080:8080 --add-host=host.docker.internal:host-gateway -v open-webui:/app/backend/data --name open-webui --restart always ghcr.io/open-webui/open-webui:main 2>/dev/null || docker start open-webui
                fi
                xdg-open "http://localhost:8080" 2>/dev/null || true
                read -r -p "Press Enter to continue..."
                ;;
            3)
                echo -e "${GREEN}[*] Launching ComfyUI on http://localhost:8188 ...${RESET}"
                if [[ -d "/opt/ComfyUI" ]]; then
                    (cd /opt/ComfyUI && python3 main.py --listen 127.0.0.1 --port 8188) &
                elif [[ -d "$HOME/ComfyUI" ]]; then
                    (cd "$HOME/ComfyUI" && python3 main.py --listen 127.0.0.1 --port 8188) &
                fi
                xdg-open "http://localhost:8188" 2>/dev/null || true
                read -r -p "Press Enter to continue..."
                ;;
            4)
                echo -e "${PURPLE}[*] Launching Zoth Studio...${RESET}"
                if command -v zoth >/dev/null 2>&1; then
                    zoth &
                elif [[ -f "/opt/zoth-studio/launch.sh" ]]; then
                    /opt/zoth-studio/launch.sh &
                else
                    echo "Starting local Zoth Studio Hub..."
                    xdg-open "http://localhost:8989" 2>/dev/null || true
                fi
                read -r -p "Press Enter to continue..."
                ;;
            5)
                banner
                echo -e "${PURPLE}=== [ AGENT ORCHESTRATION SUITE ] ===${RESET}"
                echo "1. Hermes Autonomous Agent (CLI / Skills)"
                echo "2. CrewAI Multi-Agent Swarm"
                echo "3. LangGraph Workflow Studio"
                echo "4. AutoGen Conversational Agents"
                echo "0. Back"
                read -r -p "Agent [choice]: " aopt
                case "$aopt" in
                    1) command -v hermes >/dev/null && hermes || echo "Hermes CLI ready in ~/.hermes" ;;
                    2) python3 -c "import crewai; print('[✓] CrewAI operational')" 2>/dev/null || echo "CrewAI available via venv" ;;
                    3) python3 -c "import langgraph; print('[✓] LangGraph operational')" 2>/dev/null || echo "LangGraph available" ;;
                    4) python3 -c "import autogen; print('[✓] AutoGen operational')" 2>/dev/null || echo "AutoGen available" ;;
                esac
                read -r -p "Press Enter to continue..."
                ;;
            6)
                banner
                echo -e "${PURPLE}=== [ AUTOMATION & BROWSER AGENTS ] ===${RESET}"
                echo "1. Browser-Use (Drive browser via LLM)"
                echo "2. Open Interpreter (Local execution loop)"
                read -r -p "Automation [choice]: " bopt
                case "$bopt" in
                    1) python3 -m browser_use.cli 2>/dev/null || echo "Browser-use installed in python environment." ;;
                    2) command -v interpreter >/dev/null && interpreter || echo "Open-interpreter available." ;;
                esac
                read -r -p "Press Enter to continue..."
                ;;
            7)
                banner
                echo -e "${RED}=== [ FRONTIER AI RED TEAMING & SECURITY HARNESSES ] ===${RESET}"
                echo "1. Garak (Generative AI Vulnerability Scanner)"
                echo "2. PyRIT (Microsoft AI Red Teaming Orchestrator)"
                echo "3. Promptfoo (LLM Security & Jailbreak Testing)"
                read -r -p "Red Team [choice]: " ropt
                case "$ropt" in
                    1) python3 -m garak --help | head -n 20 2>/dev/null || echo "Garak installed." ;;
                    2) python3 -c "import pyrit; print('[✓] PyRIT framework ready')" 2>/dev/null || echo "PyRIT ready." ;;
                    3) npx promptfoo --version 2>/dev/null || echo "Promptfoo installed." ;;
                esac
                read -r -p "Press Enter to continue..."
                ;;
            8)
                banner
                echo -e "${YELLOW}=== [ EVALUATION & BENCHMARK HARNESSES ] ===${RESET}"
                echo "1. lm-evaluation-harness (EleutherAI MMLU / GSM8k / TruthfulQA)"
                echo "2. inspect_ai (Frontier Safety & Capability Evals)"
                read -r -p "Eval [choice]: " eopt
                case "$eopt" in
                    1) lm_eval --help 2>/dev/null || python3 -m lm_eval --help 2>/dev/null || echo "lm-eval ready." ;;
                    2) inspect --version 2>/dev/null || echo "inspect_ai ready." ;;
                esac
                read -r -p "Press Enter to continue..."
                ;;
            9)
                banner
                echo -e "${CYAN}=== [ UNDERGROUND OSINT & SCRAPING AGENTS ] ===${RESET}"
                echo "1. Crawl4AI (LLM-friendly ultra-fast crawler)"
                echo "2. Caido Web Security Interceptor"
                read -r -p "Scraper [choice]: " sopt
                case "$sopt" in
                    1) crawl4ai-doctor 2>/dev/null || python3 -c "import crawl4ai; print('[✓] Crawl4AI operational')" ;;
                    2) caido & ;;
                esac
                read -r -p "Press Enter to continue..."
                ;;
            0)
                exit 0
                ;;
        esac
    done
}

if [[ $# -eq 0 ]]; then
    run_menu
else
    case "$1" in
        status)
            show_status
            ;;
        ollama)
            ollama "${@:2}"
            ;;
        studio)
            xdg-open "http://localhost:8989" 2>/dev/null || true
            ;;
        *)
            echo "Usage: zoth-ai [status|ollama|studio]"
            exit 1
            ;;
    esac
fi
