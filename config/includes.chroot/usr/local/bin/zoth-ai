#!/usr/bin/env bash
# ==============================================================================
#  ZOTHOS AI COMMAND CENTER (Mainstream, Frontier & Underground AI Hub)
#  Hermes, Ollama, Codex, Grok, HexStrike, OpenCode, Claude Code & MCP Ecosystem
# ==============================================================================

GREEN="\e[1;32m"
CYAN="\e[1;36m"
YELLOW="\e[1;33m"
RED="\e[1;31m"
PURPLE="\e[1;35m"
BOLD="\e[1m"
RESET="\e[0m"

banner() {
    clear
    echo -e "${GREEN}"
    echo "  ╔══════════════════════════════════════════════════════════════════════╗"
    echo "  ║      ███████╗ ██████╗ ████████╗██╗  ██╗     █████╗ ██╗               ║"
    echo "  ║      ╚══███╔╝██╔═══██╗╚══██╔══╝██║  ██║    ██╔══██╗██║               ║"
    echo "  ║        ███╔╝ ██║   ██║   ██║   ███████║    ███████║██║               ║"
    echo "  ║       ███╔╝  ██║   ██║   ██║   ██╔══██║    ██╔══██║██║               ║"
    echo "  ║      ███████╗╚██████╔╝   ██║   ██║  ██║    ██║  ██║██║               ║"
    echo "  ║      ╚══════╝ ╚═════╝    ╚═╝   ╚═╝  ╚═╝    ╚═╝  ╚═╝╚═╝               ║"
    echo "  ║               ALCHEMICAL SYNTHESIS & AGENTIC FORGE                   ║"
    echo "  ╚══════════════════════════════════════════════════════════════════════╝"
    echo -e "${RESET}"
}

check_service() {
    local port="$1"
    if ss -tuln 2>/dev/null | grep -q ":$port "; then
        echo -e "${GREEN}[ONLINE :$port]${RESET}"
    else
        echo -e "${RED}[OFFLINE]${RESET}"
    fi
}

check_bin() {
    local bin="$1"
    if command -v "$bin" >/dev/null 2>&1; then
        echo -e "${GREEN}[READY]${RESET}"
    else
        echo -e "${YELLOW}[STANDBY]${RESET}"
    fi
}

show_status() {
    banner
    echo -e "${BOLD}${CYAN}--- [ PRE-INSTALLED FRONTIER & MAINSTREAM AI ENGINES ] ---${RESET}"
    printf "  %-28s %-12s %-28s %s\n" "Hermes Agent (CLI)" "$(check_bin hermes)" "Ollama Daemon (11434)" "$(check_service 11434)"
    printf "  %-28s %-12s %-28s %s\n" "OpenAI Codex CLI" "$(check_bin codex)" "x.ai Grok CLI" "$(check_bin grok)"
    printf "  %-28s %-12s %-28s %s\n" "Claude Code (Anthropic)" "$(check_bin claude)" "OpenCode AI" "$(check_bin opencode)"
    printf "  %-28s %-12s %-28s %s\n" "HexStrike AI Pentesting" "$(check_bin hexstrike_mcp)" "Zoth Studio Hub (8989)" "$(check_service 8989)"
    
    echo -e "\n${BOLD}${PURPLE}--- [ LOCAL INFERENCE & DIFFUSION WORKFLOWS ] ---${RESET}"
    printf "  %-28s %-12s %-28s %s\n" "ComfyUI Visuals (8188)" "$(check_service 8188)" "vLLM Engine (8000)" "$(check_service 8000)"
    printf "  %-28s %-12s %-28s %s\n" "Open WebUI (8080)" "$(check_service 8080)" "Model Context Protocol" "$(check_bin zoth-mcp)"
    
    echo -e "\n${BOLD}${YELLOW}--- [ HARDWARE ACCELERATION ] ---${RESET}"
    if command -v nvidia-smi >/dev/null 2>&1; then
        local gpu_info
        gpu_info=$(nvidia-smi --query-gpu=name,memory.total,utilization.gpu --format=csv,noheader 2>/dev/null || echo "NVIDIA Driver Active")
        echo -e "  GPU: ${GREEN}$gpu_info${RESET}"
    else
        echo -e "  GPU: ${YELLOW}CPU / Vulkan / VirtIO Accelerated Graphics Mode${RESET}"
    fi
    echo ""
}

run_menu() {
    while true; do
        show_status
        echo -e "${BOLD}Select Arsenal Action:${RESET}"
        echo -e "  ${GREEN}[1]${RESET} Launch Hermes Agent (Autonomous Tool-Calling Agent)"
        echo -e "  ${GREEN}[2]${RESET} Launch Ollama Server / Models (Local LLM Inference)"
        echo -e "  ${GREEN}[3]${RESET} Launch OpenAI Codex (AI Coding Assistant CLI)"
        echo -e "  ${GREEN}[4]${RESET} Launch Grok CLI (x.ai Intelligence & Search)"
        echo -e "  ${PURPLE}[5]${RESET} Launch HexStrike AI (Autonomous AI Red Teaming & MCP)"
        echo -e "  ${PURPLE}[6]${RESET} Launch Claude Code / OpenCode CLI"
        echo -e "  ${CYAN}[7]${RESET} ZOTH MCP Server Registry (Sync & Test Hot MCP Servers)"
        echo -e "  ${YELLOW}[8]${RESET} Launch Zoth Studio v3.2 (Hermetic Operations Dashboard)"
        echo -e "  ${RED}[9]${RESET} AI Red Teaming & Eval Suite (Garak, PyRIT, Crawl4AI, Aider)"
        echo -e "  ${BOLD}[0]${RESET} Exit"
        echo ""
        read -r -p "ZOTH-AI [choice]: " opt

        case "$opt" in
            1)
                echo -e "${GREEN}[*] Launching Hermes Agent...${RESET}"
                if command -v hermes >/dev/null 2>&1; then
                    hermes chat || hermes --help
                else
                    echo "Hermes binary ready. Run 'hermes --help' to configure keys."
                fi
                read -r -p "Press Enter to continue..."
                ;;
            2)
                if ! pgrep -x "ollama" >/dev/null; then
                    echo -e "${GREEN}[*] Starting Ollama daemon...${RESET}"
                    ollama serve >/dev/null 2>&1 &
                    sleep 2
                fi
                echo -e "${CYAN}Available local models:${RESET}"
                ollama list 2>/dev/null || true
                read -r -p "Model name to chat with (or press enter to return): " mname
                [[ -n "$mname" ]] && ollama run "$mname"
                ;;
            3)
                echo -e "${GREEN}[*] Launching OpenAI Codex CLI...${RESET}"
                codex --help || echo "Codex ready. Provide API key or session."
                read -r -p "Press Enter to continue..."
                ;;
            4)
                echo -e "${GREEN}[*] Launching x.ai Grok CLI...${RESET}"
                grok --help || echo "Grok CLI ready."
                read -r -p "Press Enter to continue..."
                ;;
            5)
                echo -e "${PURPLE}[*] Launching HexStrike AI Platform...${RESET}"
                if command -v hexstrike_server >/dev/null 2>&1; then
                    echo "Starting HexStrike Server on http://127.0.0.1:8888..."
                    hexstrike_server &
                    sleep 2
                fi
                if command -v hexstrike_mcp >/dev/null 2>&1; then
                    echo -e "${GREEN}[✓] HexStrike MCP Server active.${RESET}"
                fi
                read -r -p "Press Enter to continue..."
                ;;
            6)
                banner
                echo -e "${PURPLE}=== [ CODING AGENTS ] ===${RESET}"
                echo "1. Claude Code (@anthropic-ai/claude-code)"
                echo "2. OpenCode AI (opencode-ai)"
                echo "0. Back"
                read -r -p "Select [1-2]: " copt
                case "$copt" in
                    1) command -v claude >/dev/null 2>&1 && claude || npx @anthropic-ai/claude-code ;;
                    2) command -v opencode >/dev/null 2>&1 && opencode || npx opencode-ai ;;
                esac
                read -r -p "Press Enter to continue..."
                ;;
            7)
                zoth-mcp list
                echo ""
                echo -e "Run ${CYAN}zoth-mcp sync${RESET} to synchronize all MCP servers into Claude, Hermes, Codex, and OpenCode."
                read -r -p "Run sync now? (y/N): " ssync
                if [[ "$ssync" == "y" || "$ssync" == "Y" ]]; then
                    zoth-mcp sync
                fi
                read -r -p "Press Enter to continue..."
                ;;
            8)
                echo -e "${YELLOW}[*] Launching Zoth Studio...${RESET}"
                if command -v zoth >/dev/null 2>&1; then
                    zoth &
                elif [[ -f "/opt/zoth-studio/launch.sh" ]]; then
                    /opt/zoth-studio/launch.sh &
                else
                    xdg-open "http://localhost:8989" 2>/dev/null || true
                fi
                read -r -p "Press Enter to continue..."
                ;;
            9)
                banner
                echo -e "${RED}=== [ FRONTIER AI SECURITY, AUDIT & TERMINAL TOOLS ] ===${RESET}"
                echo "1. Garak (Generative AI Vulnerability Scanner)"
                echo "2. PyRIT (Microsoft AI Red Teaming Orchestrator)"
                echo "3. Crawl4AI (LLM-friendly ultra-fast crawler)"
                echo "4. Aider (AI Pair Programming Terminal)"
                echo "5. Open WebUI (Local ChatGPT interface on :8080)"
                echo "6. ComfyUI (Generative Visuals on :8188)"
                echo "0. Back"
                read -r -p "Select [choice]: " ropt
                case "$ropt" in
                    1) python3 -m garak --help 2>/dev/null || echo "Garak installed in python env." ;;
                    2) python3 -c "import pyrit; print('[✓] PyRIT framework ready')" 2>/dev/null || echo "PyRIT ready." ;;
                    3) python3 -c "import crawl4ai; print('[✓] Crawl4AI ready')" 2>/dev/null || echo "Crawl4AI ready." ;;
                    4) command -v aider >/dev/null 2>&1 && aider || echo "Aider AI ready." ;;
                    5) xdg-open "http://localhost:8080" 2>/dev/null || true ;;
                    6) xdg-open "http://localhost:8188" 2>/dev/null || true ;;
                esac
                read -r -p "Press Enter to continue..."
                ;;
            0)
                exit 0
                ;;
        esac
    done
}

if [[ $# -eq 0 ]]; then
    run_menu
else
    case "$1" in
        status)
            show_status
            ;;
        ollama)
            ollama "${@:2}"
            ;;
        hermes)
            hermes "${@:2}"
            ;;
        codex)
            codex "${@:2}"
            ;;
        grok)
            grok "${@:2}"
            ;;
        claude)
            claude "${@:2}"
            ;;
        opencode)
            opencode "${@:2}"
            ;;
        hexstrike)
            hexstrike_mcp "${@:2}"
            ;;
        mcp)
            zoth-mcp "${@:2}"
            ;;
        studio)
            xdg-open "http://localhost:8989" 2>/dev/null || true
            ;;
        *)
            echo "Usage: zoth-ai [status|hermes|ollama|codex|grok|claude|opencode|hexstrike|mcp|studio]"
            exit 1
            ;;
    esac
fi
