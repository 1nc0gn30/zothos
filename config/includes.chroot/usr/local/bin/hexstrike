#!/usr/bin/env bash
# ==============================================================================
#  ZOTHOS HexStrike AI Autonomous Pentesting Engine Runner
# ==============================================================================
set -euo pipefail

HEX_DIR="/usr/share/hexstrike-ai"

if [[ ! -d "$HEX_DIR" ]]; then
    HEX_DIR="/home/neo/hexstrike-ai"
fi

if [[ -f "$HEX_DIR/hexstrike_mcp.py" ]]; then
    exec python3 "$HEX_DIR/hexstrike_mcp.py" "$@"
elif [[ -f "$HEX_DIR/hexstrike_server.py" ]]; then
    exec python3 "$HEX_DIR/hexstrike_server.py" "$@"
else
    echo -e "\e[1;31m[!] HexStrike AI engine files not found in $HEX_DIR\e[0m"
    exit 1
fi
