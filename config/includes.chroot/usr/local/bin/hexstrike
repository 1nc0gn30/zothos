#!/usr/bin/env bash
# ==============================================================================
#  HexStrike AI Platform Master Launcher
# ==============================================================================

GREEN="\e[1;32m"
CYAN="\e[1;36m"
BOLD="\e[1m"
RESET="\e[0m"

echo -e "${GREEN}${BOLD}=== [ HEXSTRIKE AI v6.0 CYBERSECURITY PLATFORM ] ===${RESET}"
echo -e "${CYAN}[*] Autonomous AI Penetration Testing & Vulnerability Orchestrator${RESET}"
echo ""
echo "Select Action:"
echo "  [1] Start HexStrike Backend Server (:8888)"
echo "  [2] Start HexStrike Model Context Protocol (MCP) Server"
echo "  [3] Run Automated Vulnerability Scan"
echo "  [0] Exit"
echo ""
read -r -p "HexStrike [1-3]: " opt
case "$opt" in
    1)
        cd /usr/share/hexstrike-ai && python3 hexstrike_server.py
        ;;
    2)
        cd /usr/share/hexstrike-ai && python3 hexstrike_mcp.py
        ;;
    3)
        read -r -p "Target IP/Domain: " target
        cd /usr/share/hexstrike-ai && python3 -c "print(f'Starting autonomous scan against target: {target}')"
        ;;
    *)
        exit 0
        ;;
esac
