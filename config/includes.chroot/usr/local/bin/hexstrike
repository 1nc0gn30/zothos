#!/usr/bin/env bash
# ==============================================================================
#  :: NullAI HexStrike AI Terminal — Sovereign Red Teaming Workstation
#  Official Repository: https://github.com/NullAITech/NullAI-HexStrike-AI-Terminal
# ==============================================================================

set -e

HEXSTRIKE_DIR="/usr/share/hexstrike-ai"
if [[ ! -d "$HEXSTRIKE_DIR" ]] && [[ -d "/opt/hexstrike-ai" ]]; then
    HEXSTRIKE_DIR="/opt/hexstrike-ai"
fi
if [[ ! -d "$HEXSTRIKE_DIR" ]] && [[ -d "$HOME/.hexstrike/NullAI-HexStrike-AI-Terminal" ]]; then
    HEXSTRIKE_DIR="$HOME/.hexstrike/NullAI-HexStrike-AI-Terminal"
fi

PID_DIR="$HOME/.hexstrike/run"
mkdir -p "$PID_DIR" "$HOME/.hexstrike"

RED="\033[38;2;255;51;85m"
GREEN="\033[38;2;0;255;157m"
GOLD="\033[38;2;255;215;0m"
CYAN="\033[38;2;0;229;255m"
GRAY="\033[38;2;120;140;160m"
BOLD="\033[1m"
RESET="\033[0m"

banner() {
    echo -e "${RED}${BOLD}"
    echo -e "  ::  NullAI HexStrike AI Terminal  ::"
    echo -e "  Sovereign Red Teaming Workstation & Neural Attack Matrix"
    echo -e "${RESET}"
}

check_backend() {
    curl -s http://127.0.0.1:8000/docs >/dev/null 2>&1
}

start_backend() {
    if check_backend; then
        echo -e "${GREEN}[✓] HexStrike backend is already running on http://127.0.0.1:8000${RESET}"
        return 0
    fi

    echo -e "${GOLD}[*] Starting NullAI HexStrike Neural Backend (Port 8000)...${RESET}"
    cd "$HEXSTRIKE_DIR/backend"
    
    # Run via python3
    python3 main.py > "$HOME/.hexstrike/backend.log" 2>&1 &
    local b_pid=$!
    echo $b_pid > "$PID_DIR/backend.pid"

    # Wait for startup
    for i in {1..15}; do
        if check_backend; then
            echo -e "${GREEN}[✓] HexStrike Backend Online: http://127.0.0.1:8000${RESET}"
            return 0
        fi
        sleep 0.5
    done
    echo -e "${RED}[!] Warning: Backend is initializing in background (check ~/.hexstrike/backend.log)${RESET}"
}

start_ui() {
    start_backend
    echo -e "${CYAN}[*] Launching NullAI HexStrike UI...${RESET}"
    cd "$HEXSTRIKE_DIR/ui"
    
    if [[ ! -d "node_modules" ]] && [[ -f "package.json" ]]; then
        echo -e "${GOLD}[*] First-time setup: installing UI packages...${RESET}"
        npm install --silent >/dev/null 2>&1 || true
    fi

    if [[ -d "dist" ]]; then
        # If static build exists, open browser or serve
        xdg-open "http://127.0.0.1:8000" 2>/dev/null || x-www-browser "http://127.0.0.1:8000" 2>/dev/null &
    fi

    # Launch dev server or interactive UI
    npm run dev -- --host 127.0.0.1 --port 5173 > "$HOME/.hexstrike/ui.log" 2>&1 &
    local ui_pid=$!
    echo $ui_pid > "$PID_DIR/ui.pid"
    
    sleep 2
    xdg-open "http://127.0.0.1:5173" 2>/dev/null || x-www-browser "http://127.0.0.1:5173" 2>/dev/null || true
    echo -e "${GREEN}[✓] NullAI HexStrike Terminal is live at http://127.0.0.1:5173${RESET}"
}

stop_all() {
    echo -e "${GOLD}[*] Stopping HexStrike services...${RESET}"
    if [[ -f "$PID_DIR/backend.pid" ]]; then
        kill $(cat "$PID_DIR/backend.pid") 2>/dev/null || true
        rm -f "$PID_DIR/backend.pid"
    fi
    if [[ -f "$PID_DIR/ui.pid" ]]; then
        kill $(cat "$PID_DIR/ui.pid") 2>/dev/null || true
        rm -f "$PID_DIR/ui.pid"
    fi
    pkill -f "python3.*hexstrike.*main.py" 2>/dev/null || true
    pkill -f "vite.*--port 5173" 2>/dev/null || true
    echo -e "${GREEN}[✓] HexStrike stopped.${RESET}"
}

case "${1:-ui}" in
    ui|start)
        banner
        start_ui
        ;;
    backend)
        banner
        start_backend
        ;;
    stop)
        stop_all
        ;;
    status)
        banner
        if check_backend; then
            echo -e "${GREEN}[✓] Backend: ONLINE (http://127.0.0.1:8000)${RESET}"
        else
            echo -e "${RED}[✗] Backend: OFFLINE${RESET}"
        fi
        ;;
    mcp)
        # Direct MCP server bridge mode
        exec python3 "$HEXSTRIKE_DIR/main.py" "$@"
        ;;
    *)
        banner
        echo -e "Usage: hexstrike [ui|backend|stop|status|mcp]"
        start_ui
        ;;
esac
