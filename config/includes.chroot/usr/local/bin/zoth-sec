#!/usr/bin/env bash
# ==============================================================================
#  ZOTHOS SECURITY ARSENAL (Kali Linux & Parrot OS Unified Toolkit)
#  Multi-Vector Recon, Vulnerability Analysis, Exploitation & MCP Bridge
# ==============================================================================

set -uo pipefail

GREEN="\e[1;32m"
CYAN="\e[1;36m"
YELLOW="\e[1;33m"
RED="\e[1;31m"
PURPLE="\e[1;35m"
BOLD="\e[1m"
RESET="\e[0m"

header() {
    echo -e "${RED}"
    echo "  ╔════════════════════════════════════════════════════════════════════╗"
    echo "  ║      ███████╗ ██████╗ ████████╗██╗  ██╗    ███████╗███████╗ ██████╗ ║"
    echo "  ║      ╚══███╔╝██╔═══██╗╚══██╔══╝██║  ██║    ██╔════╝██╔════╝██╔════╝ ║"
    echo "  ║        ███╔╝ ██║   ██║   ██║   ███████║    ███████╗█████╗  ██║      ║"
    echo "  ║       ███╔╝  ██║   ██║   ██║   ██╔══██║    ╚════██║██╔══╝  ██║      ║"
    echo "  ║      ███████╗╚██████╔╝   ██║   ██║  ██║    ███████║███████╗╚██████╗ ║"
    echo "  ║      ╚══════╝ ╚═════╝    ╚═╝   ╚═╝  ╚═╝    ╚══════╝╚══════╝ ╚═════╝ ║"
    echo "  ║                  OFFENSIVE & DEFENSIVE MATRIX ARSENAL              ║"
    echo "  ╚════════════════════════════════════════════════════════════════════╝"
    echo -e "${RESET}"
}

show_help() {
    header
    echo -e "${BOLD}Usage:${RESET} zoth-sec [command] [options]"
    echo ""
    echo -e "${BOLD}Commands:${RESET}"
    echo -e "  ${GREEN}check${RESET}                 Comprehensive check of all installed Kali/Parrot security tools"
    echo -e "  ${GREEN}list${RESET}                  List available categories and security tools"
    echo -e "  ${GREEN}run <tool> [args...]${RESET}  Execute authorized security arsenal tool"
    echo -e "  ${GREEN}mcp${RESET}                   Run security arsenal MCP JSON-RPC bridge"
    echo -e "  ${GREEN}interactive${RESET}           Launch full-screen terminal interactive arsenal menu"
    echo -e "  ${GREEN}help, -h, --help${RESET}      Show this help documentation"
    echo ""
    echo -e "Categories: 01-Recon, 02-Vuln, 03-Exploit, 04-Wireless, 05-Passwords, 06-Reverse, 07-Sniffing, 08-Forensics, 09-Anonymity"
}

check_tool() {
    local t="$1"
    if command -v "$t" >/dev/null 2>&1; then
        echo -e "${GREEN}[INSTALLED]${RESET}"
    else
        echo -e "${YELLOW}[AVAILABLE VIA REPO]${RESET}"
    fi
}

show_cat() {
    local title="$1"
    shift
    echo -e "\n${BOLD}${CYAN}--- [ $title ] ---${RESET}"
    for tool in "$@"; do
        printf "  %-20s %b\n" "$tool" "$(check_tool "$tool")"
    done
}

run_check_all() {
    header
    echo -e "${BOLD}ZOTHOS Kali/Parrot Security Arsenal Integrity Audit:${RESET}"
    show_cat "01 - Information Gathering" nmap masscan amass nuclei sublist3r theHarvester recon-ng maltego
    show_cat "02 - Vulnerability Analysis" sqlmap nikto wpscan commix testssl.sh gobuster ffuf feroxbuster
    show_cat "03 - Exploitation Frameworks" msfconsole searchsploit beef-xss sliver routerploit
    show_cat "04 - Wireless & RF Warfare" aircrack-ng airgeddon kismet wifite bully reaver gqrx hackrf
    show_cat "05 - Password & Hashes" hashcat john hydra medusa crunch ophcrack cewl
    show_cat "06 - Reverse Engineering" ghidra radare2 cutter binwalk gdb rasm2
    show_cat "07 - Sniffing & Spoofing" wireshark tshark bettercap mitmproxy responder impacket-smbexec
    show_cat "08 - Post-Exploitation & Forensics" autopsy volatility lynis chkrootkit bloodhound
    show_cat "09 - Anonymity & Anti-Forensics" tor anonsurf macchanger bleachbit mat2 firejail proxychains4
    echo ""
}

run_mcp_bridge() {
    # Fast lightweight stdio MCP server for Kali/Parrot security tools
    python3 - <<'EOF'
import sys
import json
import subprocess
import shutil

VALID_TOOLS = {
    "nmap": "Network exploration tool and security / port scanner",
    "masscan": "High-speed TCP port scanner",
    "nuclei": "Fast and customizable vulnerability scanner based on simple YAML DSL",
    "sqlmap": "Automatic SQL injection and database takeover tool",
    "nikto": "Web server scanner for dangerous files, CGIs, and outdated software",
    "ffuf": "Fast web fuzzer written in Go",
    "gobuster": "Directory/file, DNS and VHost busting tool",
    "hashcat": "Advanced password recovery utility",
    "john": "John the Ripper password cracker",
    "searchsploit": "Command-line search tool for Exploit-DB"
}

def handle_request(req):
    req_id = req.get("id")
    method = req.get("method")
    params = req.get("params", {})

    if method == "initialize":
        return {
            "jsonrpc": "2.0",
            "id": req_id,
            "result": {
                "protocolVersion": "2024-11-05",
                "capabilities": {"tools": {}},
                "serverInfo": {
                    "name": "kali-parrot-sectools",
                    "version": "2.0.0"
                }
            }
        }
    elif method == "tools/list":
        tools = []
        for name, desc in VALID_TOOLS.items():
            tools.append({
                "name": f"sec_{name}",
                "description": desc,
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "target": {"type": "string", "description": "Target IP, hostname, or URL"},
                        "args": {"type": "string", "description": "Optional CLI arguments", "default": ""}
                    },
                    "required": ["target"]
                }
            })
        return {
            "jsonrpc": "2.0",
            "id": req_id,
            "result": {"tools": tools}
        }
    elif method == "tools/call":
        name = params.get("name", "").replace("sec_", "")
        args = params.get("arguments", {})
        target = args.get("target", "")
        extra_args = args.get("args", "")

        if name not in VALID_TOOLS:
            return {
                "jsonrpc": "2.0",
                "id": req_id,
                "error": {"code": -32601, "message": f"Tool '{name}' not authorized or recognized."}
            }
        
        cmd = f"{name} {extra_args} {target}".strip()
        try:
            res = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=180)
            return {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [
                        {"type": "text", "text": f"Exit code: {res.returncode}\n\nSTDOUT:\n{res.stdout}\n\nSTDERR:\n{res.stderr}"}
                    ],
                    "isError": res.returncode != 0
                }
            }
        except subprocess.TimeoutExpired:
            return {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [{"type": "text", "text": "Error: Security tool command timed out after 180 seconds."}],
                    "isError": True
                }
            }
        except Exception as e:
            return {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [{"type": "text", "text": f"Execution error: {str(e)}"}],
                    "isError": True
                }
            }
    else:
        return {
            "jsonrpc": "2.0",
            "id": req_id,
            "result": {}
        }

for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        req = json.loads(line)
        resp = handle_request(req)
        sys.stdout.write(json.dumps(resp) + "\n")
        sys.stdout.flush()
    except Exception as e:
        err = {"jsonrpc": "2.0", "error": {"code": -32700, "message": str(e)}}
        sys.stdout.write(json.dumps(err) + "\n")
        sys.stdout.flush()
EOF
}

interactive_menu() {
    while true; do
        clear
        header
        echo -e "${BOLD}Select Arsenal Category:${RESET}"
        echo -e "  ${GREEN}[1]${RESET} 01 - Information Gathering & Recon (Nmap, Amass, Nuclei, Recon-ng)"
        echo -e "  ${GREEN}[2]${RESET} 02 - Vulnerability Analysis (SQLMap, Nikto, WPScan, Commix)"
        echo -e "  ${RED}[3]${RESET} 03 - Exploitation Frameworks (Metasploit, BeEF, Searchsploit)"
        echo -e "  ${CYAN}[4]${RESET} 04 - Wireless & RF Warfare (Aircrack-ng, Airgeddon, Kismet, Wifite)"
        echo -e "  ${YELLOW}[5]${RESET} 05 - Password Cracking & Hashes (Hashcat, John the Ripper, Hydra)"
        echo -e "  ${PURPLE}[6]${RESET} 06 - Reverse Engineering & Binaries (Ghidra, Radare2, Cutter, Binwalk)"
        echo -e "  ${RED}[7]${RESET} 07 - Sniffing, Spoofing & MITM (Wireshark, Bettercap, Responder, Impacket)"
        echo -e "  ${CYAN}[8]${RESET} 08 - Post-Exploitation & Forensics (Autopsy, Volatility, Lynis, BloodHound)"
        echo -e "  ${GREEN}[9]${RESET} 09 - Anonymity & Anti-Forensics (Tor, Anonsurf, Macchanger, BleachBit)"
        echo -e "  ${BOLD}[0]${RESET} Exit"
        echo ""
        read -r -p "ZOTH-SEC [choice]: " cat_opt

        case "$cat_opt" in
            1)
                header
                show_cat "01 - Information Gathering" nmap masscan amass nuclei sublist3r theHarvester recon-ng maltego
                echo ""
                read -r -p "Run tool (e.g. nmap -sV target, or press enter to back): " cmd
                [[ -n "$cmd" ]] && eval "$cmd"
                read -r -p "Press Enter to continue..." _
                ;;
            2)
                header
                show_cat "02 - Vulnerability Analysis" sqlmap nikto wpscan commix testssl.sh gobuster ffuf feroxbuster
                echo ""
                read -r -p "Run tool (or press enter to back): " cmd
                [[ -n "$cmd" ]] && eval "$cmd"
                read -r -p "Press Enter to continue..." _
                ;;
            3)
                header
                show_cat "03 - Exploitation Frameworks" msfconsole searchsploit beef-xss sliver routerploit
                echo ""
                read -r -p "Run tool (e.g. msfconsole, or press enter to back): " cmd
                [[ -n "$cmd" ]] && eval "$cmd"
                read -r -p "Press Enter to continue..." _
                ;;
            4)
                header
                show_cat "04 - Wireless & RF" aircrack-ng airgeddon kismet wifite bully reaver gqrx hackrf
                echo ""
                read -r -p "Run tool (e.g. airgeddon, or press enter to back): " cmd
                [[ -n "$cmd" ]] && eval "$cmd"
                read -r -p "Press Enter to continue..." _
                ;;
            5)
                header
                show_cat "05 - Password & Hashes" hashcat john hydra medusa crunch ophcrack cewl
                echo ""
                read -r -p "Run tool (or press enter to back): " cmd
                [[ -n "$cmd" ]] && eval "$cmd"
                read -r -p "Press Enter to continue..." _
                ;;
            6)
                header
                show_cat "06 - Reverse Engineering" ghidra radare2 cutter binwalk gdb rasm2
                echo ""
                read -r -p "Run tool (or press enter to back): " cmd
                [[ -n "$cmd" ]] && eval "$cmd"
                read -r -p "Press Enter to continue..." _
                ;;
            7)
                header
                show_cat "07 - Sniffing & Spoofing" wireshark tshark bettercap mitmproxy responder impacket-smbexec
                echo ""
                read -r -p "Run tool (or press enter to back): " cmd
                [[ -n "$cmd" ]] && eval "$cmd"
                read -r -p "Press Enter to continue..." _
                ;;
            8)
                header
                show_cat "08 - Post-Exploitation & Forensics" autopsy volatility lynis chkrootkit bloodhound
                echo ""
                read -r -p "Run tool (or press enter to back): " cmd
                [[ -n "$cmd" ]] && eval "$cmd"
                read -r -p "Press Enter to continue..." _
                ;;
            9)
                header
                show_cat "09 - Anonymity & Anti-Forensics" tor anonsurf macchanger bleachbit mat2 firejail proxychains4
                echo ""
                read -r -p "Run tool (or press enter to back): " cmd
                [[ -n "$cmd" ]] && eval "$cmd"
                read -r -p "Press Enter to continue..." _
                ;;
            0|q|Q)
                exit 0
                ;;
        esac
    done
}

if [[ $# -eq 0 ]]; then
    if [[ -t 0 ]]; then
        interactive_menu
    else
        run_check_all
    fi
else
    case "$1" in
        check|status|audit)
            run_check_all
            ;;
        list|categories)
            run_check_all
            ;;
        run)
            shift
            if [[ $# -eq 0 ]]; then
                echo -e "${RED}Error:${RESET} Specify tool name to run (e.g. zoth-sec run nmap -F 127.0.0.1)"
                exit 1
            fi
            "$@"
            ;;
        mcp)
            run_mcp_bridge
            ;;
        interactive)
            interactive_menu
            ;;
        help|-h|--help)
            show_help
            ;;
        *)
            echo -e "${RED}Unknown command: $1${RESET}\n"
            show_help
            exit 1
            ;;
    esac
fi
