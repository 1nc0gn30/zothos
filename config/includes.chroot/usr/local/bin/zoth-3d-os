#!/usr/bin/env bash
# ==============================================================================
#  ZOTHOS 3D Spatial OS Master Environment Launcher
# ==============================================================================

OS_3D_HTML="/usr/share/zothos/3d-os/index.html"

echo -e "\e[1;32m[*] Engaging ZOTHOS 3D Spatial OS Environment...\e[0m"
echo -e "\e[1;33m[*] Press ESC to toggle 2D fallback desktop at any time.\e[0m"

if command -v chromium >/dev/null 2>&1; then
    chromium --app="file://$OS_3D_HTML" --start-fullscreen --window-position=0,0 >/dev/null 2>&1 &
elif command -v firefox-esr >/dev/null 2>&1; then
    firefox-esr --new-window "file://$OS_3D_HTML" >/dev/null 2>&1 &
elif command -v firefox >/dev/null 2>&1; then
    firefox --new-window "file://$OS_3D_HTML" >/dev/null 2>&1 &
else
    xdg-open "file://$OS_3D_HTML" 2>/dev/null || true
fi
