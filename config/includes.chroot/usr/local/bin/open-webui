#!/usr/bin/env bash
if [[ ! -x "/opt/zothos-ai-env/bin/open-webui" ]]; then
    echo -e "\033[38;2;255;215;0m[ZOTHOS NEXUS]\033[0m Provisioning Open-WebUI into Zoth AI environment..."
    /opt/zothos-ai-env/bin/pip install --ignore-installed open-webui
fi
exec /opt/zothos-ai-env/bin/open-webui serve "$@"
