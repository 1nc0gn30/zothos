#!/usr/bin/env bash
# ==============================================================================
#  ZOTHOS Claude Code Auto-Bootstrap & Runner
# ==============================================================================
set -euo pipefail

if ! command -v npm >/dev/null 2>&1; then
    echo -e "\e[1;33m[*] Installing Node.js & npm runtime for Claude Code...\e[0m"
    sudo apt-get update -y && sudo apt-get install -y nodejs npm
fi

# Check if claude-code is installed globally or locally
if ! npm list -g @anthropic-ai/claude-code >/dev/null 2>&1 && ! command -v claude-code >/dev/null 2>&1; then
    echo -e "\e[1;36m[⚡] ZOTHOS: Auto-installing Claude Code CLI (@anthropic-ai/claude-code)...\e[0m"
    sudo npm install -g @anthropic-ai/claude-code || npm install -g @anthropic-ai/claude-code
fi

# Resolve binary
if command -v claude-code >/dev/null 2>&1; then
    exec claude-code "$@"
elif [[ -f "/usr/local/lib/node_modules/@anthropic-ai/claude-code/bin/claude.js" ]]; then
    exec node "/usr/local/lib/node_modules/@anthropic-ai/claude-code/bin/claude.js" "$@"
elif [[ -f "/usr/lib/node_modules/@anthropic-ai/claude-code/bin/claude.js" ]]; then
    exec node "/usr/lib/node_modules/@anthropic-ai/claude-code/bin/claude.js" "$@"
else
    npx @anthropic-ai/claude-code "$@"
fi
