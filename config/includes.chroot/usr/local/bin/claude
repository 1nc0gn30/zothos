#!/usr/bin/env bash
# ==============================================================================
#  ZOTHOS Claude Code Auto-Bootstrap & Runner
# ==============================================================================

if command -v claude-code >/dev/null 2>&1 && [[ "$(which claude-code)" != "$0" ]]; then
    exec "$(which claude-code)" "$@"
fi

if [[ -f "/usr/local/lib/node_modules/@anthropic-ai/claude-code/bin/claude.js" ]]; then
    exec node "/usr/local/lib/node_modules/@anthropic-ai/claude-code/bin/claude.js" "$@"
fi

if [[ -f "/usr/lib/node_modules/@anthropic-ai/claude-code/bin/claude.js" ]]; then
    exec node "/usr/lib/node_modules/@anthropic-ai/claude-code/bin/claude.js" "$@"
fi

if command -v npx >/dev/null 2>&1; then
    exec npx @anthropic-ai/claude-code "$@"
fi

echo -e "\e[38;2;255;215;0m[⚡ ZOTHOS AI]\e[0m \e[1;37mClaude Code CLI (@anthropic-ai/claude-code) not found.\e[0m"
echo -e "\e[38;2;0;229;255m[*] To install Claude Code CLI now, run:\e[0m npm install -g @anthropic-ai/claude-code"
read -p "Install @anthropic-ai/claude-code now? (y/N): " choice
if [[ "$choice" =~ ^[Yy]$ ]]; then
    npm install -g @anthropic-ai/claude-code
    exec npx @anthropic-ai/claude-code "$@"
fi
exit 1
