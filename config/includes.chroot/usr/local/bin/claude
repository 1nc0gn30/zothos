#!/usr/bin/env python3
"""
⚡ ZOTHOS Claude Code Sovereign Agent Workstation v2.0
Anthropic Claude Code Terminal Interface & Polyglot Agent Console
"""

import os
import sys
import time
import shutil
import subprocess

GREEN = "\033[38;2;0;255;157m"
GOLD = "\033[38;2;255;215;0m"
CYAN = "\033[38;2;0;229;255m"
RED = "\033[38;2;255;51;85m"
GRAY = "\033[38;2;120;140;160m"
BOLD = "\033[1m"
RESET = "\033[0m"

def banner():
    os.system("clear" if os.name == "posix" else "cls")
    print(f"{GOLD}{BOLD}")
    print(r"   ██████╗██╗      █████╗ ██╗   ██╗██████╗ ███████╗")
    print(r"  ██╔════╝██║     ██╔══██╗██║   ██║██╔══██╗██╔════╝")
    print(r"  ██║     ██║     ███████║██║   ██║██║  ██║█████╗  ")
    print(r"  ██║     ██║     ██╔══██║██║   ██║██║  ██║██╔══╝  ")
    print(r"  ╚██████╗███████╗██║  ██║╚██████╔╝██████╔╝███████╗")
    print(r"   ╚═════╝╚══════╝╚═╝  ╚═╝ ╚═════╝ ╚═════╝ ╚══════╝")
    print(f"         {CYAN}⚡ CLAUDE CODE AUTONOMOUS AGENT WORKSTATION ⚡{RESET}\n")

def chat_repl():
    banner()
    print(f"{GOLD}{BOLD}>>> CLAUDE CODE INTERACTIVE REPL <<<{RESET}")
    print(f"{GRAY}Type your coding objective or instructions. Type 'exit' to return.{RESET}\n")
    
    while True:
        try:
            prompt = input(f"{GOLD}claude-code{RESET}{BOLD}❯{RESET} ").strip()
            if not prompt:
                continue
            if prompt.lower() in ["exit", "quit", "q"]:
                break
                
            print(f"\n{CYAN}[Claude Code: Analyzing Project Files & Reasoning...]{RESET}")
            time.sleep(0.6)
            
            print(f"\n{GREEN}⚡ [Claude Code]:{RESET}")
            print(f"I've analyzed your request: \"{prompt}\"")
            print(f"Workspace context loaded. Ready to perform edits, create artifacts, and run tests.\n")
        except (KeyboardInterrupt, EOFError):
            print("\n")
            break

def config_keys():
    banner()
    print(f"{BOLD}Anthropic API Key Configuration:{RESET}\n")
    key = input("Enter ANTHROPIC_API_KEY (leave empty to skip): ").strip()
    if key:
        env_file = os.path.expanduser("~/.config/zothos/env")
        os.makedirs(os.path.dirname(env_file), exist_ok=True)
        with open(env_file, "a") as f:
            f.write(f"\nexport ANTHROPIC_API_KEY='{key}'\n")
        print(f"{GREEN}[✓] API Key saved to {env_file}{RESET}")
    else:
        print(f"{GRAY}Skipped.{RESET}")
    input(f"\n{GRAY}Press Enter to return...{RESET}")

def install_claude_npm():
    banner()
    print(f"{GOLD}[*] Installing @anthropic-ai/claude-code globally via npm...{RESET}\n")
    subprocess.run(["npm", "install", "-g", "@anthropic-ai/claude-code"])
    input(f"\n{GRAY}Press Enter to return...{RESET}")

def main():
    # If official claude-code is present, try running it directly
    if shutil.which("claude-code") and shutil.which("claude-code") != sys.argv[0]:
        try:
            os.execv(shutil.which("claude-code"), sys.argv)
        except Exception:
            pass

    while True:
        banner()
        print(f"  {BOLD}${GOLD}[1]${RESET} 💬  {BOLD}Launch Claude Code Interactive Session${RESET}")
        print(f"  {BOLD}${CYAN}[2]${RESET} 🔑  {BOLD}Configure Anthropic API Key${RESET}")
        print(f"  {BOLD}${GREEN}[3]${RESET} 📦  {BOLD}Install / Update @anthropic-ai/claude-code Package${RESET}")
        print(f"  {BOLD}${GRAY}[0]${RESET} 🚪  {BOLD}Exit Workstation${RESET}\n")
        print(f"{GOLD}{BOLD}══════════════════════════════════════════════════════════════════════{RESET}")
        
        try:
            choice = input(f"Select option [0-3]: ").strip()
            if choice == "1":
                chat_repl()
            elif choice == "2":
                config_keys()
            elif choice == "3":
                install_claude_npm()
            elif choice in ["0", "q", "Q"]:
                break
        except (KeyboardInterrupt, EOFError):
            break

if __name__ == "__main__":
    main()
