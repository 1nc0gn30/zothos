#!/usr/bin/env bash
# ==============================================================================
#  FastMCP - 2026 Model Context Protocol High-Speed Framework
# ==============================================================================

if [[ -x /opt/zothos-ai-env/bin/fastmcp ]]; then
    exec /opt/zothos-ai-env/bin/fastmcp "$@"
fi

if python3 -c "import fastmcp" >/dev/null 2>&1; then
    exec python3 -m fastmcp "$@"
fi

REAL_BIN=$(type -all fastmcp 2>/dev/null | grep -v "/usr/local/bin/fastmcp" | head -n 1 | awk '{print $NF}')
if [[ -n "$REAL_BIN" && -x "$REAL_BIN" ]]; then
    exec "$REAL_BIN" "$@"
fi

echo -e "\e[38;2;255;215;0m[[+] ZOTHOS MCP]\e[0m \e[1;37mFastMCP framework runtime not installed.\e[0m"
echo -e "\e[38;2;0;229;255m[*] To install FastMCP now, run:\e[0m uv pip install fastmcp mcp"
read -p "Install fastmcp now? (y/N): " choice
if [[ "$choice" =~ ^[Yy]$ ]]; then
    uv pip install fastmcp mcp || pip3 install --break-system-packages fastmcp mcp
    exec python3 -m fastmcp "$@"
fi
exit 1
