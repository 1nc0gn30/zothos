#!/usr/bin/env bash
# ==============================================================================
#  ⚡ NOUS RESEARCH HERMES AGENT - SOVEREIGN WORKSTATION CLI
#  Official Nous Research Agent Runtime (https://nousresearch.com)
# ==============================================================================

unset PYTHONPATH
unset PYTHONHOME

# Priority 1: System-wide /opt installation
if [[ -x "/opt/hermes-agent/venv/bin/python" ]] && [[ -f "/opt/hermes-agent/hermes" ]]; then
    exec "/opt/hermes-agent/venv/bin/python" "/opt/hermes-agent/hermes" "$@"
fi

# Priority 2: User-level ~/.hermes installation
if [[ -x "$HOME/.hermes/hermes-agent/venv/bin/python" ]] && [[ -f "$HOME/.hermes/hermes-agent/hermes" ]]; then
    exec "$HOME/.hermes/hermes-agent/venv/bin/python" "$HOME/.hermes/hermes-agent/hermes" "$@"
fi

# Priority 3: Python module fallback
if python3 -c "import hermes_cli" 2>/dev/null; then
    exec python3 -m hermes_cli "$@"
fi

# Priority 4: Direct CLI executable
if command -v hermes-agent &>/dev/null; then
    exec hermes-agent "$@"
fi

echo "[!] Hermes Agent runtime not found in /opt/hermes-agent or ~/.hermes/hermes-agent."
echo "    Please run 'zoth-ai hermes' to configure the agent environment."
exit 1
