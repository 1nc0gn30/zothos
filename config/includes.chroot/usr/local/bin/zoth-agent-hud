#!/usr/bin/env python3
"""
ZOTHOS AI AGENT HUD & OS CONTROLLER GUI
Interactive Desktop Control Center with Layer Authority Selector & Live Telemetry.
"""

import os
import sys
import json
import time
import threading
import subprocess
import tkinter as tk
from tkinter import ttk, messagebox, scrolledtext

CONFIG_FILE = "/etc/zothos/agent-permissions.json"
USER_STATE = os.path.expanduser("~/.config/zothos/agent-layer.state")

LAYER_COLORS = {
    0: ("#00f3ff", "SPECTRE", "Observer / Read-Only (0 Mutation)"),
    1: ("#00ff88", "RUNECRAFTER", "User Shell & Workspace Code"),
    2: ("#3b82f6", "CYBERPUPPET", "GUI, Mouse & Keyboard Computer Use"),
    3: ("#a855f7", "WARLOCK", "Offensive Security & Ghostmode"),
    4: ("#fbbf24", "SOVEREIGN", "Root, Kernel & Amnesic Authority"),
}

class AgentHUDApp:
    def __init__(self, root):
        self.root = root
        self.root.title("ZOTHOS // SOVEREIGN AI AGENT HUD")
        self.root.geometry("820x680")
        self.root.configure(bg="#02040a")

        self.active_layer = self.load_layer()
        self.pulse_phase = 0

        self.setup_ui()
        self.start_pulse_thread()
        self.update_telemetry()

    def load_layer(self) -> int:
        if os.path.exists(USER_STATE):
            try:
                with open(USER_STATE, "r") as f:
                    return int(f.read().strip())
            except Exception:
                pass
        return 2

    def save_layer(self, layer: int):
        self.active_layer = layer
        os.makedirs(os.path.dirname(USER_STATE), exist_ok=True)
        with open(USER_STATE, "w") as f:
            f.write(str(layer))
        self.refresh_layer_buttons()
        self.log(f"[AUTH] Elevated agent permission to Layer {layer}: {LAYER_COLORS[layer][1]}")

    def setup_ui(self):
        # Header Frame
        header = tk.Frame(self.root, bg="#030814", highlightbackground="#00f3ff", highlightthickness=1)
        header.pack(fill="x", padx=12, pady=10)

        # Title & AI Alive Indicator
        title_box = tk.Frame(header, bg="#030814")
        title_box.pack(side="left", padx=15, pady=10)

        self.orb_canvas = tk.Canvas(title_box, width=28, height=28, bg="#030814", highlightthickness=0)
        self.orb_canvas.pack(side="left", padx=(0, 10))
        self.orb = self.orb_canvas.create_oval(4, 4, 24, 24, fill="#00ff88", outline="#00f3ff", width=2)

        lbl_title = tk.Label(
            title_box,
            text="ZOTHOS AGENT // OS OVERLORD",
            font=("Orbitron", 14, "bold"),
            fg="#00f3ff",
            bg="#030814"
        )
        lbl_title.pack(side="left")

        self.lbl_status = tk.Label(
            header,
            text="● AI ALIVE [READY]",
            font=("JetBrains Mono", 10, "bold"),
            fg="#00ff88",
            bg="#030814"
        )
        self.lbl_status.pack(side="right", padx=15)

        # ── PERMISSION LAYERS SELECTOR ──────────────────────────────────────
        layer_frame = tk.LabelFrame(
            self.root,
            text=" [ SECURITY RINGS // AUTONOMOUS OS AUTHORITY ] ",
            font=("JetBrains Mono", 10, "bold"),
            fg="#00f3ff",
            bg="#02040a",
            highlightbackground="#00f3ff",
            highlightthickness=1
        )
        layer_frame.pack(fill="x", padx=12, pady=6)

        self.layer_btns = {}
        btn_box = tk.Frame(layer_frame, bg="#02040a")
        btn_box.pack(fill="x", padx=10, pady=8)

        for lvl in range(5):
            color, name, desc = LAYER_COLORS[lvl]
            btn = tk.Button(
                btn_box,
                text=f"L{lvl}: {name}\n{desc.split()[0]}",
                font=("JetBrains Mono", 9, "bold"),
                bg="#061226",
                fg=color,
                activebackground=color,
                activeforeground="#000000",
                relief="flat",
                bd=0,
                padx=6,
                pady=6,
                command=lambda l=lvl: self.save_layer(l)
            )
            btn.pack(side="left", expand=True, fill="x", padx=3)
            self.layer_btns[lvl] = btn

        self.refresh_layer_buttons()

        # ── COMMAND INPUT BOX ───────────────────────────────────────────────
        input_frame = tk.Frame(self.root, bg="#02040a")
        input_frame.pack(fill="x", padx=12, pady=6)

        self.cmd_entry = tk.Entry(
            input_frame,
            font=("JetBrains Mono", 11),
            bg="#050e1f",
            fg="#e2e8f0",
            insertbackground="#00f3ff",
            highlightbackground="#00f3ff",
            highlightthickness=1,
            bd=0
        )
        self.cmd_entry.pack(side="left", fill="x", expand=True, ipady=8, padx=(0, 8))
        self.cmd_entry.bind("<Return>", lambda e: self.dispatch_command())
        self.cmd_entry.insert(0, "Open terminal, check git status, and take a screenshot")

        btn_run = tk.Button(
            input_frame,
            text="TRANSMUTE ❯",
            font=("Orbitron", 10, "bold"),
            bg="#00ff88",
            fg="#000000",
            activebackground="#00f3ff",
            relief="flat",
            bd=0,
            padx=14,
            pady=8,
            command=self.dispatch_command
        )
        btn_run.pack(side="right")

        # ── QUICK ACTIONS BAR ───────────────────────────────────────────────
        quick_frame = tk.Frame(self.root, bg="#02040a")
        quick_frame.pack(fill="x", padx=12, pady=4)

        actions = [
            ("📸 Capture Screen", "gui_screenshot"),
            ("🥷 Toggle Ghostmode", "toggle_ghostmode"),
            ("🔍 Nmap Localhost", "nmap 127.0.0.1"),
            ("🔮 Zoth Studio", "open studio"),
            ("⚡ Hermes Agent", "open terminal"),
            ("🪟 Win11 Incognito", "zoth-undercover")
        ]

        for label, act in actions:
            qbtn = tk.Button(
                quick_frame,
                text=label,
                font=("JetBrains Mono", 8),
                bg="#041224",
                fg="#38bdf8",
                activebackground="#38bdf8",
                activeforeground="#000000",
                relief="flat",
                bd=0,
                padx=6,
                pady=4,
                command=lambda a=act: self.run_quick_action(a)
            )
            qbtn.pack(side="left", expand=True, fill="x", padx=2)

        # ── TELEMETRY & LOG CONSOLE ─────────────────────────────────────────
        log_frame = tk.LabelFrame(
            self.root,
            text=" [ LIVE ACTION STREAM // SYSTEM TELEMETRY ] ",
            font=("JetBrains Mono", 9, "bold"),
            fg="#00ff88",
            bg="#02040a",
            highlightbackground="#00ff88",
            highlightthickness=1
        )
        log_frame.pack(fill="both", expand=True, padx=12, pady=8)

        self.log_area = scrolledtext.ScrolledText(
            log_frame,
            font=("JetBrains Mono", 9),
            bg="#010308",
            fg="#a7f3d0",
            insertbackground="#00ff88",
            bd=0,
            padx=8,
            pady=8
        )
        self.log_area.pack(fill="both", expand=True)

        self.log(f"ZOTHOS Sovereign OS Agent HUD Initialized. Authority: Layer {self.active_layer}")
        self.log("Ready to execute multi-layer autonomous commands.")

    def refresh_layer_buttons(self):
        for lvl, btn in self.layer_btns.items():
            color, name, _ = LAYER_COLORS[lvl]
            if lvl == self.active_layer:
                btn.configure(bg=color, fg="#000000", text=f"★ L{lvl}: {name}\n[ACTIVE]")
            else:
                btn.configure(bg="#061226", fg=color, text=f"L{lvl}: {name}\nLocked" if lvl > self.active_layer else f"L{lvl}: {name}\nAllowed")

    def log(self, text: str):
        ts = time.strftime("%H:%M:%S")
        self.log_area.insert("end", f"[{ts}] {text}\n")
        self.log_area.see("end")

    def dispatch_command(self):
        cmd = self.cmd_entry.get().strip()
        if not cmd:
            return
        self.lbl_status.configure(text="● AI THINKING...", fg="#00f3ff")
        self.log(f"[USER] ❯ {cmd}")
        
        threading.Thread(target=self._run_async, args=(cmd,), daemon=True).start()

    def _run_async(self, cmd: str):
        try:
            res = subprocess.run(
                ["zoth-agent-os", "run", cmd],
                capture_output=True,
                text=True,
                timeout=60
            )
            out = res.stdout.strip() or res.stderr.strip()
            self.root.after(0, lambda: self.log(f"[AGENT RESULT]:\n{out}\n"))
        except Exception as e:
            self.root.after(0, lambda: self.log(f"[ERROR]: {str(e)}"))
        finally:
            self.root.after(0, lambda: self.lbl_status.configure(text="● AI ALIVE [READY]", fg="#00ff88"))

    def run_quick_action(self, action: str):
        self.cmd_entry.delete(0, "end")
        self.cmd_entry.insert(0, action)
        self.dispatch_command()

    def start_pulse_thread(self):
        def pulse_loop():
            colors = ["#00ff88", "#00f3ff", "#38bdf8", "#00ff88"]
            idx = 0
            while True:
                idx = (idx + 1) % len(colors)
                try:
                    self.orb_canvas.itemconfig(self.orb, fill=colors[idx])
                except Exception:
                    break
                time.sleep(0.8)
        threading.Thread(target=pulse_loop, daemon=True).start()

    def update_telemetry(self):
        def loop():
            while True:
                time.sleep(15)
                # auto ping system status
                if self.root:
                    try:
                        self.root.after(0, lambda: self.log(f"[TELEMETRY] CPU/RAM nominal. Layer {self.active_layer} stable."))
                    except Exception:
                        break
        threading.Thread(target=loop, daemon=True).start()

def main():
    try:
        if not os.environ.get("DISPLAY"):
            raise RuntimeError("No DISPLAY environment variable set.")
        root = tk.Tk()
        app = AgentHUDApp(root)
        root.mainloop()
    except Exception as e:
        print(f"\033[38;2;255;215;0m[⚡ ZOTHOS AGENT]\033[0m Falling back to CLI Agent Layer mode ({e})")
        subprocess.run(["zoth-agent-os", "status"])

if __name__ == "__main__":
    main()
