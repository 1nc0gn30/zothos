#!/usr/bin/env python3
"""
==============================================================================
 * ZOTHOS APEX AGENT & OS CONTROLLER HUD v3.5 ULTRA *
 Interactive Cyber-Alchemical Command Cockpit with Autonomous Sentinel Engine.
==============================================================================
"""

import os
import sys
import json
import time
import threading
import subprocess
import tkinter as tk
from tkinter import ttk, messagebox, scrolledtext

USER_STATE = os.path.expanduser("~/.config/zothos/agent-layer.state")
SENTINEL_CONFIG = "/etc/zothos/sentinel.json"

LAYER_COLORS = {
    0: ("#00e5ff", "SPECTRE", "Observer / Read-Only Telemetry"),
    1: ("#00ff9d", "RUNECRAFTER", "Workspace Code & CLI Tasks"),
    2: ("#3b82f6", "CYBERPUPPET", "GUI, Computer Use & Browser"),
    3: ("#a855f7", "WARLOCK", "Offensive Sec & Tor Ghostmode"),
    4: ("#ffd700", "SOVEREIGN", "Full Root, Kernel & Sentinel Engine"),
}

CORE_TOOLS = [
    ("Zoth Studio", "/opt/zoth-studio/index.html", "zoth-studio", "chrome --app=file:///opt/zoth-studio/index.html"),
    ("HexStrike AI", "hexstrike", "hexstrike", "/usr/local/bin/hexstrike"),
    ("Maya Linux", "maya", "maya", "/usr/local/bin/maya"),
    ("Hermes Agent", "hermes", "hermes", "/usr/local/bin/hermes"),
    ("Tor Ghostmode", "zoth-ghost", "zoth-ghost", "/usr/local/bin/zoth-ghost toggle"),
    ("Live Wallpaper", "zoth-live-wallpaper", "zoth-live-wallpaper", "/usr/local/bin/zoth-live-wallpaper toggle"),
    ("Bitwarden Vault", "bw", "bitwarden", "x-terminal-emulator -e bw login"),
    ("Obsidian Vault", "obsidian", "obsidian", "obsidian")
]


class AgentHUDApp:
    def __init__(self, root):
        self.root = root
        self.root.title("ZOTHOS // APEX AGENT & TELEMETRY COCKPIT")
        self.root.geometry("880x720")
        self.root.configure(bg="#03060c")

        self.active_layer = self.load_layer()
        self.pulse_phase = 0.0

        self.setup_ui()
        self.start_pulse_thread()
        self.update_telemetry()

    def load_layer(self) -> int:
        if os.path.exists(USER_STATE):
            try:
                with open(USER_STATE, "r") as f:
                    return int(f.read().strip())
            except Exception:
                pass
        return 4

    def save_layer(self, layer: int):
        self.active_layer = layer
        os.makedirs(os.path.dirname(USER_STATE), exist_ok=True)
        with open(USER_STATE, "w") as f:
            f.write(str(layer))
        self.refresh_layer_buttons()
        self.log(f"[AUTH] Elevated agent permission to Layer {layer}: {LAYER_COLORS[layer][1]}")

    def setup_ui(self):
        # ── Header Frame ─────────────────────────────────────────────
        header = tk.Frame(self.root, bg="#080e18", highlightbackground="#00ff9d", highlightthickness=1)
        header.pack(fill="x", padx=14, pady=10)

        title_box = tk.Frame(header, bg="#080e18")
        title_box.pack(side="left", padx=16, pady=12)

        self.orb_canvas = tk.Canvas(title_box, width=28, height=28, bg="#080e18", highlightthickness=0)
        self.orb_canvas.pack(side="left", padx=(0, 10))
        self.orb = self.orb_canvas.create_oval(4, 4, 24, 24, fill="#00ff9d", outline="#00e5ff", width=2)

        lbl_title = tk.Label(
            title_box,
            text="🜂 ZOTHOS APEX // AGENT & OS COCKPIT",
            font=("JetBrains Mono", 13, "bold"),
            fg="#00ff9d",
            bg="#080e18"
        )
        lbl_title.pack(side="left")

        self.lbl_status = tk.Label(
            header,
            text="● SENTINEL AI: ACTIVE",
            font=("JetBrains Mono", 10, "bold"),
            fg="#00ff9d",
            bg="#080e18"
        )
        self.lbl_status.pack(side="right", padx=16)

        # ── Security Rings / Layer Selector ──────────────────────────
        layer_frame = tk.LabelFrame(
            self.root,
            text=" [ SECURITY RINGS // AUTONOMOUS OS AUTHORITY ] ",
            font=("JetBrains Mono", 9, "bold"),
            fg="#00e5ff",
            bg="#03060c",
            highlightbackground="#00e5ff",
            highlightthickness=1
        )
        layer_frame.pack(fill="x", padx=14, pady=4)

        self.layer_btns = []
        btn_grid = tk.Frame(layer_frame, bg="#03060c")
        btn_grid.pack(fill="x", padx=8, pady=8)

        for lvl, (color, name, desc) in LAYER_COLORS.items():
            f = tk.Frame(btn_grid, bg="#080e18", highlightbackground=color, highlightthickness=1)
            f.pack(side="left", expand=True, fill="both", padx=4)

            btn = tk.Button(
                f,
                text=f"L{lvl}: {name}\n{desc}",
                font=("JetBrains Mono", 8),
                bg="#080e18",
                fg=color,
                relief="flat",
                command=lambda l=lvl: self.save_layer(l)
            )
            btn.pack(fill="both", expand=True, padx=2, pady=2)
            self.layer_btns.append((lvl, f, btn))

        self.refresh_layer_buttons()

        # ── Middle Pane: Telemetry & Core Tool Arsenal ───────────────
        mid_pane = tk.Frame(self.root, bg="#03060c")
        mid_pane.pack(fill="x", padx=14, pady=6)

        # Telemetry Card
        telem_box = tk.LabelFrame(
            mid_pane,
            text=" [ LIVE SYSTEM TELEMETRY ] ",
            font=("JetBrains Mono", 9, "bold"),
            fg="#ffd700",
            bg="#080e18",
            highlightbackground="#ffd700",
            highlightthickness=1
        )
        telem_box.pack(side="left", fill="both", expand=True, padx=(0, 6))

        self.lbl_cpu = tk.Label(telem_box, text="CPU: --%", font=("JetBrains Mono", 10), fg="#00ff9d", bg="#080e18")
        self.lbl_cpu.pack(anchor="w", padx=12, pady=2)

        self.lbl_ram = tk.Label(telem_box, text="RAM: -- / -- GB", font=("JetBrains Mono", 10), fg="#00e5ff", bg="#080e18")
        self.lbl_ram.pack(anchor="w", padx=12, pady=2)

        self.lbl_net = tk.Label(telem_box, text="NET: -- | MAC: --", font=("JetBrains Mono", 9), fg="#ffd700", bg="#080e18")
        self.lbl_net.pack(anchor="w", padx=12, pady=2)

        self.lbl_tor = tk.Label(telem_box, text="TOR: CLEARNET", font=("JetBrains Mono", 10), fg="#ff3355", bg="#080e18")
        self.lbl_tor.pack(anchor="w", padx=12, pady=2)

        # Arsenal Card
        arsenal_box = tk.LabelFrame(
            mid_pane,
            text=" [ APEX ARSENAL LAUNCHER ] ",
            font=("JetBrains Mono", 9, "bold"),
            fg="#00ff9d",
            bg="#080e18",
            highlightbackground="#00ff9d",
            highlightthickness=1
        )
        arsenal_box.pack(side="right", fill="both", expand=True, padx=(6, 0))

        tools_grid = tk.Frame(arsenal_box, bg="#080e18")
        tools_grid.pack(fill="both", expand=True, padx=8, pady=6)

        for i, (name, match, icon, cmd) in enumerate(CORE_TOOLS):
            row, col = divmod(i, 2)
            btn = tk.Button(
                tools_grid,
                text=f"▶ {name}",
                font=("JetBrains Mono", 8, "bold"),
                bg="#0c1424",
                fg="#00ff9d",
                relief="flat",
                highlightbackground="#00ff9d",
                highlightthickness=1,
                command=lambda c=cmd: subprocess.Popen(c, shell=True)
            )
            btn.grid(row=row, column=col, sticky="ew", padx=4, pady=3)
            tools_grid.grid_columnconfigure(col, weight=1)

        # ── Sentinel AI Interactive Prompt Bar ───────────────────────
        prompt_frame = tk.LabelFrame(
            self.root,
            text=" [ AUTONOMOUS SENTINEL AI PROMPT & ROOT EXECUTOR ] ",
            font=("JetBrains Mono", 9, "bold"),
            fg="#00ff9d",
            bg="#080e18",
            highlightbackground="#00ff9d",
            highlightthickness=1
        )
        prompt_frame.pack(fill="x", padx=14, pady=6)

        input_box = tk.Frame(prompt_frame, bg="#0c1424")
        input_box.pack(fill="x", padx=10, pady=8)

        lbl_p = tk.Label(input_box, text=" ⚡ > ", font=("JetBrains Mono", 11, "bold"), fg="#ffd700", bg="#0c1424")
        lbl_p.pack(side="left")

        self.cmd_entry = tk.Entry(
            input_box,
            font=("JetBrains Mono", 10),
            bg="#0c1424",
            fg="#ffffff",
            insertbackground="#00ff9d",
            relief="flat",
            bd=0
        )
        self.cmd_entry.pack(side="left", fill="x", expand=True, padx=6)
        self.cmd_entry.bind("<Return>", self.dispatch_ai_command)

        exec_btn = tk.Button(
            input_box,
            text="EXECUTE",
            font=("JetBrains Mono", 9, "bold"),
            bg="#00ff9d",
            fg="#03060c",
            relief="flat",
            command=self.dispatch_ai_command
        )
        exec_btn.pack(side="right", padx=4)

        # ── Output Log Console ───────────────────────────────────────
        self.log_area = scrolledtext.ScrolledText(
            self.root,
            font=("JetBrains Mono", 8),
            bg="#020408",
            fg="#d1d5db",
            relief="flat",
            bd=0,
            padx=10,
            pady=10,
            height=10
        )
        self.log_area.pack(fill="both", expand=True, padx=14, pady=(0, 10))
        self.log("ZOTHOS APEX COCKPIT v3.5 INITIALIZED — ALL SYSTEMS NOMINAL.")

    def log(self, text: str):
        self.log_area.insert(tk.END, f"[{time.strftime('%H:%M:%S')}] {text}\n")
        self.log_area.see(tk.END)

    def refresh_layer_buttons(self):
        for lvl, frame, btn in self.layer_btns:
            color = LAYER_COLORS[lvl][0]
            if lvl == self.active_layer:
                frame.configure(bg=color)
                btn.configure(bg=color, fg="#03060c", font=("JetBrains Mono", 8, "bold"))
            else:
                frame.configure(bg="#080e18")
                btn.configure(bg="#080e18", fg=color, font=("JetBrains Mono", 8))

    def dispatch_ai_command(self, event=None):
        query = self.cmd_entry.get().strip()
        if not query:
            return
        self.cmd_entry.delete(0, tk.END)
        self.log(f"[USER QUERY] ➜ {query}")

        def worker():
            cmd = ["/usr/local/bin/zoth-sentinel", "exec" if query.startswith("!") else "ask", query]
            try:
                p = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
                out = p.stdout.strip()
                self.root.after(0, lambda: self.log(f"[SENTINEL RESPONSE]\n{out}"))
            except Exception as e:
                self.root.after(0, lambda: self.log(f"[ERROR] {e}"))

        threading.Thread(target=worker, daemon=True).start()

    def update_telemetry(self):
        # Read sentinel status
        try:
            res = subprocess.run(["/usr/local/bin/zoth-sentinel", "status"], capture_output=True, text=True, timeout=2)
            lines = res.stdout.splitlines()
            ip_val = ""
            mac_val = ""
            for line in lines:
                clean = line.strip()
                if "CPU Usage:" in clean:
                    self.lbl_cpu.config(text=clean)
                elif "RAM Usage:" in clean:
                    self.lbl_ram.config(text=clean)
                elif "Primary IP:" in clean:
                    ip_val = clean.replace("Primary IP:", "").strip()
                elif "Primary MAC:" in clean:
                    mac_val = clean.replace("Primary MAC:", "").strip()
                elif "Tor Stealth:" in clean:
                    self.lbl_tor.config(text=clean)

            if ip_val or mac_val:
                self.lbl_net.config(text=f"NET: {ip_val or '127.0.0.1'} | MAC: {mac_val or '00:00:00:00:00:00'}")
        except Exception:
            pass

        self.root.after(2000, self.update_telemetry)

    def start_pulse_thread(self):
        def pulse():
            while True:
                self.pulse_phase = (self.pulse_phase + 0.1) % (2 * 3.14159)
                r = int(127 + 127 * (0.5 + 0.5 * (self.pulse_phase / 3.14159)))
                time.sleep(0.1)

        threading.Thread(target=pulse, daemon=True).start()


def main():
    root = tk.Tk()
    app = AgentHUDApp(root)
    root.mainloop()


if __name__ == "__main__":
    main()
