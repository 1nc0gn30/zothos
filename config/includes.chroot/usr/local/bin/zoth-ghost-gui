#!/usr/bin/env bash
# ==============================================================================
#  ZOTH GHOSTMODE GUI LAUNCHER
# ==============================================================================
set -euo pipefail

if [[ -n "${DISPLAY:-}" ]] && command -v electron >/dev/null 2>&1 && [[ -f "/opt/zoth-ghost-app/main.js" ]]; then
    exec electron /opt/zoth-ghost-app
elif [[ -d "/home/neo/zothos/config/includes.chroot/opt/zoth-ghost-app" ]]; then
    exec electron /home/neo/zothos/config/includes.chroot/opt/zoth-ghost-app
else
    exec xfce4-terminal -T 'Ghostmode Operations' -e '/usr/local/bin/zoth-ghost'
fi
