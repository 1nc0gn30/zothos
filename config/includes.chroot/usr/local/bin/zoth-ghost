#!/usr/bin/env bash
# ==============================================================================
#  [+] ZOTHOS NULLAI GHOSTMODE & ANONSURF ENGINE (nullai.tech sovereign protocol v4.0)
#  Autonomous Anti-Forensics, Amnesic Memory, MAC-Spoofing & Torified Transparent Proxy
# ==============================================================================
set -e

GHOST_STATE="/run/zoth_ghostmode.state"
AMNESIC_SERVICE="zoth-ghost-amnesic.service"

GREEN="\e[38;2;0;255;157m"
GOLD="\e[38;2;255;215;0m"
CYAN="\e[38;2;0;229;255m"
RED="\e[38;2;255;51;85m"
GRAY="\e[38;2;120;140;160m"
BOLD="\e[1m"
RESET="\e[0m"

print_banner() {
    echo -e "${RED}${BOLD}"
    echo "  ███████╗ ██████╗ ████████╗██╗  ██╗    ██████╗ ██╗  ██╗ ██████╗ ███████╗████████╗"
    echo "  ╚══███╔╝██╔═══██╗╚══██╔══╝██║  ██║   ██╔════╝ ██║  ██║██╔═══██╗██╔════╝╚══██╔══╝"
    echo "    ███╔╝ ██║   ██║   ██║   ███████║   ██║  ███╗███████║██║   ██║███████╗   ██║   "
    echo "   ███╔╝  ██║   ██║   ██║   ██╔══██║   ██║   ██║██╔══██║██║   ██║╚════██║   ██║   "
    echo "  ███████╗╚██████╔╝   ██║   ██║  ██║██╗╚██████╔╝██║  ██║╚██████╔╝███████║   ██║   "
    echo "  ╚══════╝ ╚═════╝    ╚═╝   ╚═╝  ╚═╝╚═╝ ╚═════╝ ╚═╝  ╚═╝ ╚═════╝ ╚══════╝   ╚═╝   "
    echo "               [ nullai.tech sovereign transparent tor protocol v4.0 ]"
    echo -e "${RESET}"
}

trigger_netkill() {
    echo -e "${RED}[!] Engaging emergency network killswitch...${RESET}"
    if command -v zoth-netkill >/dev/null 2>&1; then
        zoth-netkill engage || true
    else
        sudo iptables -P INPUT DROP
        sudo iptables -P OUTPUT DROP
        sudo iptables -P FORWARD DROP
        sudo iptables -F
    fi
}

start_ghostmode() {
    print_banner
    echo -e "${GREEN}[*] Engaging nullai.tech Ghostmode Sovereign Protocol...${RESET}"

    # 1. Randomize MAC Addresses
    echo -e "${CYAN}[1/7] Randomizing hardware MAC addresses across physical interfaces...${RESET}"
    for iface in $(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | grep -v -E "lo|docker|veth|br-|tun|tap" || true); do
        if command -v macchanger >/dev/null 2>&1; then
            sudo ip link set dev "$iface" down 2>/dev/null || true
            sudo macchanger -r "$iface" 2>/dev/null || true
            sudo ip link set dev "$iface" up 2>/dev/null || true
            echo -e "      ${GREEN}✓${RESET} MAC randomized on: $iface"
        fi
    done

    # 2. Ephemeral Hostname Cloaking
    echo -e "${CYAN}[2/7] Cloaking hostname with ephemeral cryptographic tag...${RESET}"
    local rand_hex=$(head -c 4 /dev/urandom | xxd -p 2>/dev/null || echo "null")
    local ghost_host="ghost-$rand_hex"
    sudo hostname "$ghost_host" 2>/dev/null || true
    echo "$ghost_host" | sudo tee /etc/hostname >/dev/null 2>&1 || true
    echo -e "      ${GREEN}✓${RESET} Hostname cloaked as: $ghost_host"

    # 3. Transparent Tor Proxy & IPv6 Leak Prevention (AnonSurf / Iptables)
    echo -e "${CYAN}[3/7] Arming Full-System Transparent Torification & DNS Redirection...${RESET}"
    if command -v anonsurf >/dev/null 2>&1; then
        sudo anonsurf start >/dev/null 2>&1 || true
        echo -e "      ${GREEN}✓${RESET} AnonSurf transparent proxy engaged"
    else
        # Built-in Transparent Proxy Fallback
        sudo systemctl start tor || true
        # Disable IPv6
        sudo sysctl -w net.ipv6.conf.all.disable_ipv6=1 >/dev/null 2>&1 || true
        sudo sysctl -w net.ipv6.conf.default.disable_ipv6=1 >/dev/null 2>&1 || true
        # Redirect DNS & TCP
        sudo iptables -F
        sudo iptables -t nat -F
        sudo iptables -t nat -A OUTPUT -m owner --uid-owner debian-tor -j RETURN
        sudo iptables -t nat -A OUTPUT -p udp --dport 53 -j REDIRECT --to-ports 53
        sudo iptables -t nat -A OUTPUT -p tcp --dport 53 -j REDIRECT --to-ports 53
        for net in 127.0.0.0/8 192.168.0.0/16 172.16.0.0/12 10.0.0.0/8; do
            sudo iptables -t nat -A OUTPUT -d "$net" -j RETURN
        done
        sudo iptables -t nat -A OUTPUT -p tcp --syn -j REDIRECT --to-ports 9040
        sudo iptables -A OUTPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
        sudo iptables -A OUTPUT -m owner --uid-owner debian-tor -j ACCEPT
        sudo iptables -A OUTPUT -j REJECT
        echo -e "      ${GREEN}✓${RESET} Custom transparent iptables rules applied"
    fi

    # 4. Anti-Forensic RAM Scrubbing
    echo -e "${CYAN}[4/7] Scrubbing RAM cache and shell history...${RESET}"
    history -c 2>/dev/null || true
    for hf in ~/.bash_history ~/.zsh_history ~/.lesshst ~/.viminfo; do
        [[ -f "$hf" ]] && shred -u "$hf" 2>/dev/null || true
    done
    rm -rf ~/.cache/thumbnails/* /tmp/* 2>/dev/null || true
    sudo sync 2>/dev/null || true
    echo 3 | sudo tee /proc/sys/vm/drop_caches >/dev/null 2>&1 || true
    echo -e "      ${GREEN}✓${RESET} RAM cleared and history shredded"

    # 5. DNS Cache Flush
    echo -e "${CYAN}[5/7] Flushing local DNS resolvers...${RESET}"
    sudo resolvectl flush-caches 2>/dev/null || true
    sudo systemctl restart nscd 2>/dev/null || true

    # 6. Real-Time Tor Verification & Exit IP Check
    echo -e "${CYAN}[6/7] Verifying live exit node cloaking...${RESET}"
    local tor_check
    tor_check=$(curl -s -m 6 https://check.torproject.org/api/ip 2>/dev/null || echo '{"IsTor":false}')
    local is_tor=$(echo "$tor_check" | grep -o '"IsTor":true' || true)
    local exit_ip=$(echo "$tor_check" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -n 1 || echo "Unknown")

    if [[ -n "$is_tor" ]]; then
        echo -e "      ${GOLD}${BOLD}✓ TOR VERIFIED: Exit IP is $exit_ip (Sovereign Cloak Active)${RESET}"
        if command -v notify-send >/dev/null 2>&1; then
            notify-send -u normal -i /usr/share/pixmaps/zothos.png "[🛡️] GHOSTMODE ACTIVE" "Tor Exit IP: $exit_ip (100% Cloaked)"
        fi
    else
        # Check fallback
        local alt_ip
        alt_ip=$(curl -s -m 5 https://api.ipify.org 2>/dev/null || echo "Cloaked")
        echo -e "      ${GREEN}✓ Tunnel Active. Detected IP: $alt_ip${RESET}"
    fi

    # 7. Register State
    echo -e "${CYAN}[7/7] Registering Ghostmode lock state...${RESET}"
    sudo touch "$GHOST_STATE" 2>/dev/null || touch "/tmp/zoth_ghostmode.state"

    echo ""
    echo -e "${GOLD}${BOLD}[✓] NULLAI GHOSTMODE FULLY ENGAGED. ZERO LEAKS DETECTED.${RESET}"
}

stop_ghostmode() {
    print_banner
    echo -e "${GOLD}[*] Disengaging Ghostmode... Restoring standard clearnet profile.${RESET}"

    if command -v anonsurf >/dev/null 2>&1; then
        sudo anonsurf stop >/dev/null 2>&1 || true
    else
        sudo iptables -F
        sudo iptables -t nat -F
        sudo sysctl -w net.ipv6.conf.all.disable_ipv6=0 >/dev/null 2>&1 || true
    fi

    sudo rm -f "$GHOST_STATE" "/tmp/zoth_ghostmode.state" 2>/dev/null || true
    sudo hostname "zothos" 2>/dev/null || true
    echo "zothos" | sudo tee /etc/hostname >/dev/null 2>&1 || true

    local pub_ip
    pub_ip=$(curl -s -m 5 https://api.ipify.org 2>/dev/null || echo "Clearnet")

    echo -e "${GREEN}[✓] Ghostmode disabled. Clearnet restored (IP: $pub_ip).${RESET}"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u normal -i /usr/share/pixmaps/zothos.png "[○] CLEARNET RESTORED" "Standard connection active (IP: $pub_ip)"
    fi
}

change_identity() {
    echo -e "${GOLD}[*] Requesting fresh Tor identity circuit & rotating exit node...${RESET}"
    if command -v anonsurf >/dev/null 2>&1; then
        sudo anonsurf change >/dev/null 2>&1 || true
    else
        echo -e 'AUTHENTICATE ""\r\nSIGNAL NEWNYM\r\nQUIT' | nc 127.0.0.1 9051 2>/dev/null || true
    fi
    sleep 2
    local new_ip
    new_ip=$(curl -s -m 5 https://api.ipify.org 2>/dev/null || echo "New Circuit Active")
    echo -e "${GREEN}[✓] New Tor Exit IP: $new_ip${RESET}"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -i /usr/share/pixmaps/zothos.png "[☿] TOR IDENTITY ROTATED" "New Exit IP: $new_ip"
    fi
}

check_ip() {
    echo -e "${BOLD}══════════════════════════════════════════════════════════════════════${RESET}"
    echo -e "${GOLD}${BOLD}              ZOTHOS REAL-TIME IP & LEAK AUDIT${RESET}"
    echo -e "${BOLD}══════════════════════════════════════════════════════════════════════${RESET}"
    
    local check_res
    check_res=$(curl -s -m 6 https://check.torproject.org/api/ip 2>/dev/null || echo '{"IsTor":false,"IP":"Unknown"}')
    local is_tor=$(echo "$check_res" | grep -o '"IsTor":true' || true)
    local ip_val=$(echo "$check_res" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -n 1 || echo "Unknown")

    if [[ -n "$is_tor" ]]; then
        echo -e "  Public WAN IP:       ${GREEN}${BOLD}$ip_val${RESET}"
        echo -e "  Tor Circuit:         ${GREEN}${BOLD}● CLOAKED (Tor Exit Node Verified)${RESET}"
        echo -e "  IPv6 Leaks:          ${GREEN}NONE (IPv6 Disabled/Blocked)${RESET}"
        echo -e "  DNS Leak Status:     ${GREEN}SECURE (Proxied through Tor 127.0.0.1:53)${RESET}"
    else
        echo -e "  Public WAN IP:       ${RED}${BOLD}$ip_val${RESET}"
        echo -e "  Tor Circuit:         ${RED}${BOLD}○ EXPOSED (Clearnet ISP Traffic)${RESET}"
        echo -e "  Notice:              ${GOLD}Run 'zoth-ghost start' or click [TOR] / [CLOAK ALL] in HUD${RESET}"
    fi
    echo ""
}

status_ghostmode() {
    print_banner
    echo -e "${BOLD}══════════════════════════════════════════════════════════════════════${RESET}"
    echo -e "${GOLD}${BOLD}              GHOSTMODE OPSEC TELEMETRY STATUS${RESET}"
    echo -e "${BOLD}══════════════════════════════════════════════════════════════════════${RESET}"
    echo ""
    if [[ -f "$GHOST_STATE" ]] || [[ -f "/tmp/zoth_ghostmode.state" ]] || iptables -t nat -L OUTPUT 2>/dev/null | grep -q "9040"; then
        echo -e "  State:               ${RED}${BOLD}● ACTIVE (Amnesic / Cloaked)${RESET}"
    else
        echo -e "  State:               ${GREEN}${BOLD}○ STANDBY (Standard Clear Profile)${RESET}"
    fi
    echo -e "  Current Hostname:    ${CYAN}$(hostname)${RESET}"
    echo -e "  Tor Daemon:          $(pgrep -x tor >/dev/null && echo -e "${GREEN}Running (Port 9040/9050)${RESET}" || echo -e "${GRAY}Stopped${RESET}")"
    echo -e "  Transparent Proxy:   $(iptables -t nat -L OUTPUT 2>/dev/null | grep -q "9040" && echo -e "${GREEN}Active (All Traffic Torified)${RESET}" || echo -e "${GRAY}Disabled${RESET}")"
    echo -e "  Killswitch:          ${GREEN}Armed & Ready${RESET}"
    echo ""
    check_ip
}

amnesic_scrub() {
    echo -e "${RED}[*] Executing Anti-Forensics Memory & History Scrub...${RESET}"
    history -c 2>/dev/null || true
    for hf in ~/.bash_history ~/.zsh_history ~/.lesshst ~/.viminfo; do
        [[ -f "$hf" ]] && shred -u "$hf" 2>/dev/null || true
    done
    rm -rf ~/.cache/thumbnails/* /tmp/* 2>/dev/null || true
    sudo sync 2>/dev/null || true
    echo 3 | sudo tee /proc/sys/vm/drop_caches >/dev/null 2>&1 || true
    echo -e "${GREEN}[✓] Memory purged and forensic artifacts wiped.${RESET}"
}

interactive_menu() {
    while true; do
        clear
        status_ghostmode
        echo -e "${BOLD}Actions:${RESET}"
        echo -e "  ${BOLD}${GREEN}[1]${RESET} [SEC]    ${BOLD}Engage Ghostmode (Tor Transparent Proxy + MAC + Ephemeral Host)${RESET}"
        echo -e "  ${BOLD}${GOLD}[2]${RESET} [SYNC]   ${BOLD}Disengage Ghostmode (Return to Clearnet)${RESET}"
        echo -e "  ${BOLD}${CYAN}[3]${RESET} [NEW IP] ${BOLD}Rotate Tor Identity / Request New Exit Node${RESET}"
        echo -e "  ${BOLD}${GOLD}[4]${RESET} [AUDIT]  ${BOLD}Audit IP & Leak Status${RESET}"
        echo -e "  ${BOLD}${RED}[5]${RESET} [SCRUB]  ${BOLD}Amnesic Scrub (Purge RAM & History)${RESET}"
        echo -e "  ${BOLD}${RED}[6]${RESET} ⛔       ${BOLD}Emergency Network Killswitch (Blackhole)${RESET}"
        echo -e "  ${BOLD}${GRAY}[0]${RESET} [X]      ${BOLD}Exit Deck${RESET}"
        echo ""
        read -p "Select Ghostmode operation [0-6]: " choice
        case "$choice" in
            1) start_ghostmode; read -p "Press Enter to continue..." _ ;;
            2) stop_ghostmode; read -p "Press Enter to continue..." _ ;;
            3) change_identity; read -p "Press Enter to continue..." _ ;;
            4) check_ip; read -p "Press Enter to continue..." _ ;;
            5) amnesic_scrub; read -p "Press Enter to continue..." _ ;;
            6) trigger_netkill; read -p "Press Enter to continue..." _ ;;
            0|q|Q) break ;;
            *) echo -e "${RED}Invalid selection${RESET}"; sleep 1 ;;
        esac
    done
}

action="${1:-interactive}"

case "$action" in
    start|enable|on)
        start_ghostmode
        ;;
    stop|disable|off)
        stop_ghostmode
        ;;
    status)
        status_ghostmode
        ;;
    ip|check|verify)
        check_ip
        ;;
    change|rotate|newip)
        change_identity
        ;;
    scrub|wipe)
        amnesic_scrub
        ;;
    netkill)
        trigger_netkill
        ;;
    interactive|"")
        interactive_menu
        ;;
    *)
        echo "Usage: zoth-ghost {start|stop|status|ip|change|scrub|netkill|interactive}"
        exit 1
        ;;
esac
