#!/usr/bin/env bash
# ==============================================================================
#  ZOTHOS GHOSTMODE ENGINE (influenced by nullai.tech)
#  Autonomous Anti-Forensics, Amnesic Memory, MAC-Spoofing & Torified Cloaking
# ==============================================================================

set -e

GHOST_STATE="/run/zoth_ghostmode.state"
AMNESIC_SERVICE="zoth-ghost-amnesic.service"

print_banner() {
    echo -e "\e[1;31m"
    echo "  ███████╗ ██████╗ ████████╗██╗  ██╗    ██████╗ ██╗  ██╗ ██████╗ ███████╗████████╗"
    echo "  ╚══███╔╝██╔═══██╗╚══██╔══╝██║  ██║   ██╔════╝ ██║  ██║██╔═══██╗██╔════╝╚══██╔══╝"
    echo "    ███╔╝ ██║   ██║   ██║   ███████║   ██║  ███╗███████║██║   ██║███████╗   ██║   "
    echo "   ███╔╝  ██║   ██║   ██║   ██╔══██║   ██║   ██║██╔══██║██║   ██║╚════██║   ██║   "
    echo "  ███████╗╚██████╔╝   ██║   ██║  ██║██╗╚██████╔╝██║  ██║╚██████╔╝███████║   ██║   "
    echo "  ╚══════╝ ╚═════╝    ╚═╝   ╚═╝  ╚═╝╚═╝ ╚═════╝ ╚═╝  ╚═╝ ╚═════╝ ╚══════╝   ╚═╝   "
    echo "                     [ nullai.tech ghost protocol v3.0 ]"
    echo -e "\e[0m"
}

is_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "\e[1;33m[!] Elevated privileges required. Requesting sudo...\e[0m"
        exec sudo "$0" "$@"
    fi
}

trigger_netkill() {
    echo -e "\e[1;31m[!] CRITICAL: Failure detected in ghostmode! Engaging emergency network killswitch...\e[0m"
    if command -v zoth-netkill >/dev/null 2>&1; then
        zoth-netkill engage
    elif [[ -x /usr/local/bin/zoth-netkill ]]; then
        /usr/local/bin/zoth-netkill engage
    fi
}

on_ghost_failure() {
    local exit_code=$?
    echo -e "\n\e[1;31m[!] Ghostmode initialization encountered an error (exit code: $exit_code)!\e[0m"
    trigger_netkill
    exit "$exit_code"
}

start_ghostmode() {
    is_root
    print_banner
    echo -e "\e[1;32m[*] Engaging nullai.tech Ghostmode Protocol...\e[0m"

    # Trap any uncaught failure during initialization to immediately cut leaks
    trap 'on_ghost_failure' ERR

    # 1. Randomize MAC Addresses on all active non-virtual interfaces
    echo -e "\e[1;34m[1/7] Randomizing hardware MAC addresses...\e[0m"
    for iface in $(ip -o link show | awk -F': ' '{print $2}' | grep -v -E "lo|docker|veth|br-|tun|tap"); do
        if command -v macchanger >/dev/null 2>&1; then
            ip link set dev "$iface" down 2>/dev/null || true
            macchanger -r "$iface" 2>/dev/null || true
            ip link set dev "$iface" up 2>/dev/null || true
            echo -e "    -> Cloaked MAC on interface: \e[1;32m$iface\e[0m"
        fi
    done

    # 2. Hostname Randomization
    echo -e "\e[1;34m[2/7] Scrambling system hostname...\e[0m"
    local rand_host="node-$(tr -dc 'a-f0-9' < /dev/urandom | head -c 8)"
    hostnamectl set-hostname "$rand_host" 2>/dev/null || hostname "$rand_host" 2>/dev/null || true
    echo -e "    -> Identity masked as: \e[1;32m$rand_host\e[0m"

    # 3. Transparent Tor Routing / Anonsurf
    echo -e "\e[1;34m[3/7] Torifying network routing & DNS...\e[0m"
    local tor_active=0
    if command -v anonsurf >/dev/null 2>&1; then
        if anonsurf start 2>/dev/null; then
            tor_active=1
        fi
    elif systemctl is-active --quiet tor 2>/dev/null; then
        echo "    -> Tor service active. Enabling strict DNS redirect."
        iptables -t nat -A OUTPUT -p udp --dport 53 -j REDIRECT --to-ports 5353 2>/dev/null || true
        tor_active=1
    else
        echo "    -> Attempting to start Tor daemon..."
        if systemctl start tor 2>/dev/null; then
            sleep 1
            if systemctl is-active --quiet tor 2>/dev/null; then
                iptables -t nat -A OUTPUT -p udp --dport 53 -j REDIRECT --to-ports 5353 2>/dev/null || true
                tor_active=1
            fi
        fi
    fi

    # Fail closed: if Tor routing cannot be validated, cut network instantly
    if [[ $tor_active -ne 1 ]]; then
        echo -e "\e[1;31m[!] Failed to establish Torified routing pipeline.\e[0m"
        trigger_netkill
        exit 1
    fi

    # 4. Anti-Forensics & Session Ephemeralization
    echo -e "\e[1;34m[4/7] Scrubbing runtime metadata and shell history...\e[0m"
    export HISTFILE=/dev/null
    set +o history 2>/dev/null || true
    for udir in /root /home/*; do
        if [[ -d "$udir" ]]; then
            rm -f "$udir/.local/share/recently-used.xbel" 2>/dev/null || true
            rm -rf "$udir/.cache/thumbnails/*" 2>/dev/null || true
            for hfile in "$udir/.bash_history" "$udir/.zsh_history" "$udir/.history"; do
                if [[ -f "$hfile" ]]; then
                    shred -u -z -n 3 "$hfile" 2>/dev/null || rm -f "$hfile" 2>/dev/null || true
                    touch "$hfile" 2>/dev/null || true
                    chmod 600 "$hfile" 2>/dev/null || true
                fi
            done
        fi
    done

    # 5. Flush Caches & RAM scrub
    echo -e "\e[1;34m[5/7] Flushing Linux RAM caches & buffer caches...\e[0m"
    sync
    echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
    swapoff -a 2>/dev/null || true

    # 6. IPv6 Leak Prevention
    echo -e "\e[1;34m[6/7] Hardening network stack (Disabling IPv6 leak vectors)...\e[0m"
    sysctl -w net.ipv6.conf.all.disable_ipv6=1 >/dev/null 2>&1 || true
    sysctl -w net.ipv6.conf.default.disable_ipv6=1 >/dev/null 2>&1 || true

    # 7. Arm Amnesic Service (Sleep & Shutdown cleaner)
    echo -e "\e[1;34m[7/7] Arming ZOTHOS amnesic anti-forensics service...\e[0m"
    if systemctl list-unit-files "$AMNESIC_SERVICE" >/dev/null 2>&1 || [[ -f "/etc/systemd/system/$AMNESIC_SERVICE" ]]; then
        systemctl enable "$AMNESIC_SERVICE" 2>/dev/null || true
        systemctl start "$AMNESIC_SERVICE" 2>/dev/null || true
        echo -e "    -> Amnesic service: \e[1;32mARMED\e[0m (Active for sleep/shutdown triggers)"
    fi

    # Disarm error trap once initialization finishes safely
    trap - ERR

    touch "$GHOST_STATE"
    echo -e "\n\e[1;32m[✓] GHOSTMODE ACTIVE. System is amnesic, cloaked, and untraceable.\e[0m\n"
}

stop_ghostmode() {
    is_root
    echo -e "\e[1;33m[*] Disengaging Ghostmode...\e[0m"

    if command -v anonsurf >/dev/null 2>&1; then
        anonsurf stop 2>/dev/null || true
    fi

    # Restore IPv6
    sysctl -w net.ipv6.conf.all.disable_ipv6=0 >/dev/null 2>&1 || true
    sysctl -w net.ipv6.conf.default.disable_ipv6=0 >/dev/null 2>&1 || true

    # Reset interfaces to permanent MAC if possible
    for iface in $(ip -o link show | awk -F': ' '{print $2}' | grep -v -E "lo|docker|veth|br-|tun|tap"); do
        if command -v macchanger >/dev/null 2>&1; then
            ip link set dev "$iface" down 2>/dev/null || true
            macchanger -p "$iface" 2>/dev/null || true
            ip link set dev "$iface" up 2>/dev/null || true
        fi
    done

    hostnamectl set-hostname "zothos" 2>/dev/null || hostname "zothos" 2>/dev/null || true
    rm -f "$GHOST_STATE"
    echo -e "\e[1;32m[✓] Standard network state restored.\e[0m"
}

amnesic_scrub() {
    is_root
    echo -e "\e[1;31m[*] Executing ZOTHOS Amnesic Anti-Forensics Wipe...\e[0m"

    # 1. Sync filesystem buffers
    sync

    # 2. Flush RAM page caches, dentries and inodes
    echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true

    # 3. Securely shred bash & shell history files across root and all user profiles
    echo -e "    -> Shredding shell histories..."
    export HISTFILE=/dev/null
    set +o history 2>/dev/null || true
    for hfile in /root/.bash_history /root/.zsh_history /root/.history /home/*/.bash_history /home/*/.zsh_history /home/*/.history; do
        if [[ -f "$hfile" ]]; then
            shred -u -z -n 3 "$hfile" 2>/dev/null || rm -f "$hfile" 2>/dev/null || true
            touch "$hfile" 2>/dev/null || true
            chmod 600 "$hfile" 2>/dev/null || true
        fi
    done

    # 4. Clear thumbnails and recently-used document metadata
    echo -e "    -> Purging thumbnails and recent files..."
    rm -rf /root/.cache/thumbnails/* /home/*/.cache/thumbnails/* 2>/dev/null || true
    rm -f /root/.local/share/recently-used.xbel /home/*/.local/share/recently-used.xbel 2>/dev/null || true
    rm -f /root/.recently-used /home/*/.recently-used 2>/dev/null || true

    # 5. Disable and purge swap spaces
    swapoff -a 2>/dev/null || true

    # 6. Final sync & drop
    sync
    echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true

    echo -e "\e[1;32m[✓] Amnesic scrub finished: Caches flushed, histories shredded, metadata sanitized.\e[0m"
}

panic_mode() {
    is_root
    echo -e "\e[1;31m"
    echo "  ██████╗  █████╗ ███╗   ██╗██╗ ██████╗██╗██╗"
    echo "  ██╔══██╗██╔══██╗████╗  ██║██║██╔════╝██║██║"
    echo "  ██████╔╝███████║██╔██╗ ██║██║██║     ██║██║"
    echo "  ██╔═══╝ ██╔══██║██║╚██╗██║██║██║     ╚═╝╚═╝"
    echo "  ██║     ██║  ██║██║ ╚████║██║╚██████╗██╗██╗"
    echo "  ╚═╝     ╚═╝  ╚═╝╚═╝  ╚═══╝╚═╝ ╚═════╝╚═╝╚═╝"
    echo "       [ EMERGENCY PANIC PROTOCOL ENGAGED ]"
    echo -e "\e[0m"

    echo "<1>[ZOTHOS] EMERGENCY PANIC LOCKDOWN & AMNESIC WIPE TRIGGERED" > /dev/kmsg 2>/dev/null || true

    # 1. Trigger instant network blackout
    trigger_netkill

    # 2. Trigger memory flush and amnesic metadata scrub
    amnesic_scrub

    # 3. Trigger emergency screen lock
    if command -v zoth-quicklock >/dev/null 2>&1; then
        zoth-quicklock 2>/dev/null || true
    elif [[ -x /usr/local/bin/zoth-quicklock ]]; then
        /usr/local/bin/zoth-quicklock 2>/dev/null || true
    fi
}

status_ghostmode() {
    if [[ -f "$GHOST_STATE" ]]; then
        echo -e "\e[1;31m[!] GHOSTMODE: ACTIVE (Amnesic / Torified / Cloaked)\e[0m"
        echo -e "Hostname: $(hostname)"
        echo -e "External IP Route: $(curl -s --max-time 3 https://check.torproject.org/api/ip 2>/dev/null || echo 'Isolated / Torified')"
    else
        echo -e "\e[1;32m[*] GHOSTMODE: INACTIVE (Standard Operation)\e[0m"
    fi

    if systemctl is-active --quiet "$AMNESIC_SERVICE" 2>/dev/null; then
        echo -e "Amnesic Protection: \e[1;32mARMED (systemd service active)\e[0m"
    elif [[ -f "/etc/systemd/system/$AMNESIC_SERVICE" ]]; then
        echo -e "Amnesic Protection: \e[1;33mSTANDBY (Unit installed)\e[0m"
    else
        echo -e "Amnesic Protection: \e[1;31mNOT INSTALLED\e[0m"
    fi

    if [[ -f "/run/zoth_netkill.state" ]]; then
        echo -e "Network Killswitch: \e[1;31mENGAGED (BLACKHOLE ACTIVE)\e[0m"
    else
        echo -e "Network Killswitch: \e[1;32mSTANDBY / ARMED\e[0m"
    fi
}

case "${1:-status}" in
    start|enable|on)
        start_ghostmode
        ;;
    stop|disable|off)
        stop_ghostmode
        ;;
    status)
        status_ghostmode
        ;;
    scrub|wipe)
        amnesic_scrub
        ;;
    panic)
        panic_mode
        ;;
    netkill)
        trigger_netkill
        ;;
    *)
        echo "Usage: zoth-ghost {start|stop|status|scrub|panic|netkill}"
        exit 1
        ;;
esac
