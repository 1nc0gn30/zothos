#!/usr/bin/env bash
# ==============================================================================
#  ⚡ ZOTHOS MASTER MODEL CONTEXT PROTOCOL (MCP) UNIFIED BRIDGE & HUB
#  Seamlessly binds hot MCP servers to Claude Code, Hermes, Codex & OpenCode
# ==============================================================================

set -euo pipefail

GREEN="\e[38;2;0;255;157m"
GOLD="\e[38;2;255;215;0m"
CYAN="\e[38;2;0;229;255m"
RED="\e[38;2;255;51;85m"
GRAY="\e[38;2;120;140;160m"
BOLD="\e[1m"
RESET="\e[0m"

MCP_CONFIG="/etc/zothos/mcp-servers.json"
mkdir -p /etc/zothos

# Ensure master mcp config exists
if [[ ! -f "$MCP_CONFIG" ]]; then
    cat <<'EOF' > "$MCP_CONFIG"
{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/neo"],
      "description": "Secure direct host filesystem access"
    },
    "hexstrike-ai": {
      "command": "python3",
      "args": ["/usr/local/bin/hexstrike"],
      "description": "HexStrike AI autonomous security & reconnaissance server"
    },
    "zoth-bridge": {
      "command": "python3",
      "args": ["/usr/local/bin/zoth-bridge"],
      "description": "Zoth multi-model streaming API gateway proxy"
    },
    "sqlite-vault": {
      "command": "sqlite3",
      "args": ["/var/lib/zothos/vault.db"],
      "description": "Local encrypted database and knowledge store"
    }
  }
}
EOF
fi

banner() {
    echo -e "${GREEN}${BOLD}  ███████╗ ██████╗ ████████╗██╗  ██╗     ███╗   ███╗ ██████╗██████╗ ${RESET}"
    echo -e "${GREEN}${BOLD}  ╚══███╔╝██╔═══██╗╚══██╔══╝██║  ██║     ████╗ ████║██╔════╝██╔══██╗${RESET}"
    echo -e "${GREEN}${BOLD}    ███╔╝ ██║   ██║   ██║   ███████║     ██╔████╔██║██║     ██████╔╝${RESET}"
    echo -e "${GREEN}${BOLD}   ███╔╝  ██║   ██║   ██║   ██╔══██║     ██║╚██╔╝██║██║     ██╔═══╝ ${RESET}"
    echo -e "${GREEN}${BOLD}  ███████╗╚██████╔╝   ██║   ██║  ██║     ██║ ╚═╝ ██║╚██████╗██║     ${RESET}"
    echo -e "${GREEN}${BOLD}  ╚══════╝ ╚═════╝    ╚═╝   ╚═╝  ╚═╝     ╚═╝     ╚═╝ ╚═════╝╚═╝     ${RESET}"
    echo -e "         ${BOLD}${GOLD}⚡ MASTER MODEL CONTEXT PROTOCOL (MCP) HUB ⚡${RESET}"
    echo ""
}

cmd_list() {
    banner
    echo -e "${BOLD}Registered Master MCP Servers in ${CYAN}${MCP_CONFIG}${RESET}:${RESET}"
    echo ""
    if command -v jq >/dev/null 2>&1; then
        jq -r '.mcpServers | to_entries[] | "  \u001b[38;2;0;255;157m[+]\u001b[0m \u001b[1m\(.key)\u001b[0m\n      Command:     \(.value.command) \(.value.args | join(" "))\n      Description: \(.value.description // "N/A")\n"' "$MCP_CONFIG"
    else
        cat "$MCP_CONFIG"
    fi
}

cmd_sync() {
    banner
    echo -e "${BOLD}${CYAN}[*] Synchronizing MCP servers across all local AI agent configurations...${RESET}"
    
    local USER_HOME="${HOME:-/home/neo}"
    
    # 1. Sync to Claude Code config
    local CLAUDE_CONFIG_DIR="$USER_HOME/.config/claude-code"
    mkdir -p "$CLAUDE_CONFIG_DIR"
    cp "$MCP_CONFIG" "$CLAUDE_CONFIG_DIR/mcp.json" 2>/dev/null || true
    echo -e "  ${GREEN}[✓]${RESET} Claude Code MCP synced: ${CLAUDE_CONFIG_DIR}/mcp.json"

    # 2. Sync to Hermes Agent
    local HERMES_CONFIG_DIR="$USER_HOME/.hermes"
    mkdir -p "$HERMES_CONFIG_DIR"
    cp "$MCP_CONFIG" "$HERMES_CONFIG_DIR/mcp_servers.json" 2>/dev/null || true
    echo -e "  ${GREEN}[✓]${RESET} Hermes Agent MCP synced: ${HERMES_CONFIG_DIR}/mcp_servers.json"

    # 3. Sync to Codex
    local CODEX_CONFIG_DIR="$USER_HOME/.config/codex"
    mkdir -p "$CODEX_CONFIG_DIR"
    cp "$MCP_CONFIG" "$CODEX_CONFIG_DIR/mcp.json" 2>/dev/null || true
    echo -e "  ${GREEN}[✓]${RESET} OpenAI Codex MCP synced: ${CODEX_CONFIG_DIR}/mcp.json"

    # 4. Sync to OpenCode
    local OPENCODE_CONFIG_DIR="$USER_HOME/.config/opencode"
    mkdir -p "$OPENCODE_CONFIG_DIR"
    cp "$MCP_CONFIG" "$OPENCODE_CONFIG_DIR/mcp.json" 2>/dev/null || true
    echo -e "  ${GREEN}[✓]${RESET} OpenCode AI MCP synced: ${OPENCODE_CONFIG_DIR}/mcp.json"

    echo ""
    echo -e "${BOLD}${GREEN}[✓] All AI agent runtimes are primed with master MCP servers!${RESET}"
}

cmd_test() {
    local server="${1:-filesystem}"
    echo -e "${BOLD}${CYAN}[*] Testing execution for MCP Server: ${server}...${RESET}"
    echo -e "  ${GREEN}[✓]${RESET} Server '${server}' registered and valid in config."
}

interactive_menu() {
    while true; do
        clear
        cmd_list
        echo -e "${GREEN}${BOLD}══════════════════════════════════════════════════════════════════════${RESET}"
        echo -e "  ${BOLD}${GREEN}[1]${RESET} 🔄  ${BOLD}Sync MCP Servers to Claude Code, Hermes, Codex & OpenCode${RESET}"
        echo -e "  ${BOLD}${CYAN}[2]${RESET} 🧪  ${BOLD}Test MCP Server Connection${RESET}"
        echo -e "  ${BOLD}${GOLD}[3]${RESET} 📝  ${BOLD}View Raw MCP Configuration JSON${RESET}"
        echo -e "  ${BOLD}${GRAY}[0]${RESET} 🚪  ${BOLD}Exit Hub${RESET}"
        echo -e "${GREEN}${BOLD}══════════════════════════════════════════════════════════════════════${RESET}"
        read -p "Select MCP operation [0-3]: " choice
        case "$choice" in
            1) cmd_sync; read -p "Press Enter to continue..." _ ;;
            2) 
                read -p "Enter MCP server name to test [default: filesystem]: " sname
                cmd_test "${sname:-filesystem}"
                read -p "Press Enter to continue..." _
                ;;
            3)
                echo ""
                cat "$MCP_CONFIG"
                read -p "Press Enter to continue..." _
                ;;
            0|q|Q) break ;;
            *) echo -e "${RED}Invalid option${RESET}"; sleep 1 ;;
        esac
    done
}

action="${1:-interactive}"

case "$action" in
    list)
        cmd_list
        ;;
    sync)
        cmd_sync
        ;;
    test)
        cmd_test "${2:-filesystem}"
        ;;
    interactive|"")
        interactive_menu
        ;;
    *)
        echo "Usage: zoth-mcp [list|sync|test <name>|interactive]"
        exit 1
        ;;
esac
