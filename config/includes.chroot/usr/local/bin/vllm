#!/usr/bin/env bash
if ! /opt/zothos-ai-env/bin/python3 -c "import vllm" 2>/dev/null; then
    echo -e "\033[38;2;255;215;0m[ZOTHOS NEXUS]\033[0m Provisioning vLLM accelerator..."
    /opt/zothos-ai-env/bin/pip install vllm
fi
exec /opt/zothos-ai-env/bin/python3 -m vllm.entrypoints.openai.api_server "$@"
