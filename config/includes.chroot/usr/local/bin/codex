#!/usr/bin/env bash
# ==============================================================================
#  ZOTHOS OpenAI Codex CLI Auto-Bootstrap & Runner
# ==============================================================================

if command -v codex-cli >/dev/null 2>&1 && [[ "$(which codex-cli)" != "$0" ]]; then
    exec "$(which codex-cli)" "$@"
fi

if [[ -f "/usr/local/lib/node_modules/@openai/codex/bin/codex.js" ]]; then
    exec node "/usr/local/lib/node_modules/@openai/codex/bin/codex.js" "$@"
fi

if [[ -f "/usr/lib/node_modules/@openai/codex/bin/codex.js" ]]; then
    exec node "/usr/lib/node_modules/@openai/codex/bin/codex.js" "$@"
fi

if command -v npx >/dev/null 2>&1; then
    exec npx @openai/codex "$@"
fi

echo -e "\e[38;2;255;215;0m[⚡ ZOTHOS AI]\e[0m \e[1;37mOpenAI Codex CLI (@openai/codex) not found.\e[0m"
echo -e "\e[38;2;0;229;255m[*] To install Codex CLI now, run:\e[0m npm install -g @openai/codex"
read -p "Install @openai/codex now? (y/N): " choice
if [[ "$choice" =~ ^[Yy]$ ]]; then
    npm install -g @openai/codex
    exec npx @openai/codex "$@"
fi
exit 1
