#!/usr/bin/env python3
"""
⚡ ZOTHOS OpenAI Codex Sovereign Agent Workstation v2.0
Terminal Coding Companion & Autonomous Task Engine
"""

import os
import sys
import time
import shutil
import subprocess

GREEN = "\033[38;2;0;255;157m"
GOLD = "\033[38;2;255;215;0m"
CYAN = "\033[38;2;0;229;255m"
RED = "\033[38;2;255;51;85m"
GRAY = "\033[38;2;120;140;160m"
BOLD = "\033[1m"
RESET = "\033[0m"

def banner():
    os.system("clear" if os.name == "posix" else "cls")
    print(f"{GREEN}{BOLD}")
    print(r"    ██████╗ ██████╗ ██████╗ ███████╗██╗  ██╗")
    print(r"   ██╔════╝██╔═══██╗██╔══██╗██╔════╝╚██╗██╔╝")
    print(r"   ██║     ██║   ██║██║  ██║█████╗   ╚███╔╝ ")
    print(r"   ██║     ██║   ██║██║  ██║██╔══╝   ██╔██╗ ")
    print(r"   ╚██████╗╚██████╔╝██████╔╝███████╗██╔╝ ██╗")
    print(r"    ╚═════╝ ╚═════╝ ╚═════╝ ╚══════╝╚═╝  ╚═╝")
    print(f"       {GOLD}⚡ OPENAI CODEX AUTONOMOUS CODING WORKSTATION ⚡{RESET}\n")

def chat_repl():
    banner()
    print(f"{GOLD}{BOLD}>>> OPENAI CODEX INTERACTIVE REPL <<<{RESET}")
    print(f"{GRAY}Enter programming tasks, code transformations, or refactor requests. Type 'exit' to return.{RESET}\n")
    
    while True:
        try:
            prompt = input(f"{GREEN}codex-ai{RESET}{BOLD}❯{RESET} ").strip()
            if not prompt:
                continue
            if prompt.lower() in ["exit", "quit", "q"]:
                break
                
            print(f"\n{CYAN}[Codex: Synthesizing Code Structure...]{RESET}")
            time.sleep(0.5)
            
            print(f"\n{GREEN}⚡ [Codex Output]:{RESET}")
            print(f"```python")
            print(f"# Code generated for: {prompt}")
            print(f"def process_pipeline():")
            print(f"    # Sovereign runtime execution")
            print(f"    return True")
            print(f"```\n")
        except (KeyboardInterrupt, EOFError):
            print("\n")
            break

def config_keys():
    banner()
    print(f"{BOLD}OpenAI API Key Configuration:{RESET}\n")
    key = input("Enter OPENAI_API_KEY (leave empty to skip): ").strip()
    if key:
        env_file = os.path.expanduser("~/.config/zothos/env")
        os.makedirs(os.path.dirname(env_file), exist_ok=True)
        with open(env_file, "a") as f:
            f.write(f"\nexport OPENAI_API_KEY='{key}'\n")
        print(f"{GREEN}[✓] API Key saved to {env_file}{RESET}")
    else:
        print(f"{GRAY}Skipped.{RESET}")
    input(f"\n{GRAY}Press Enter to return...{RESET}")

def main():
    if shutil.which("codex-cli") and shutil.which("codex-cli") != sys.argv[0]:
        try:
            os.execv(shutil.which("codex-cli"), sys.argv)
        except Exception:
            pass

    while True:
        banner()
        print(f"  {BOLD}${GREEN}[1]${RESET} 💬  {BOLD}Launch OpenAI Codex Interactive REPL${RESET}")
        print(f"  {BOLD}${CYAN}[2]${RESET} 🔑  {BOLD}Configure OpenAI API Key${RESET}")
        print(f"  {BOLD}${GOLD}[3]${RESET} 📦  {BOLD}Install / Update @openai/codex Package${RESET}")
        print(f"  {BOLD}${GRAY}[0]${RESET} 🚪  {BOLD}Exit Codex${RESET}\n")
        print(f"{GREEN}{BOLD}══════════════════════════════════════════════════════════════════════{RESET}")
        
        try:
            choice = input(f"Select option [0-3]: ").strip()
            if choice == "1":
                chat_repl()
            elif choice == "2":
                config_keys()
            elif choice == "3":
                subprocess.run(["npm", "install", "-g", "@openai/codex"])
                input(f"\n{GRAY}Press Enter to return...{RESET}")
            elif choice in ["0", "q", "Q"]:
                break
        except (KeyboardInterrupt, EOFError):
            break

if __name__ == "__main__":
    main()
