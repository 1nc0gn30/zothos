#!/usr/bin/env bash
# ==============================================================================
#  Aider - 2026 AI Pair Programming Agent in the Terminal
# ==============================================================================

# 1. Try local venv
if [[ -x /opt/zothos-ai-env/bin/aider ]]; then
    exec /opt/zothos-ai-env/bin/aider "$@"
fi

# 2. Try python module
if python3 -m aider --version >/dev/null 2>&1; then
    exec python3 -m aider "$@"
fi

# 3. Try global binary (excluding this script)
REAL_BIN=$(type -all aider 2>/dev/null | grep -v "/usr/local/bin/aider" | head -n 1 | awk '{print $NF}')
if [[ -n "$REAL_BIN" && -x "$REAL_BIN" ]]; then
    exec "$REAL_BIN" "$@"
fi

# 4. If missing, offer bootstrap or run interactive guidance
echo -e "\e[38;2;255;215;0m[[+] ZOTHOS AI]\e[0m \e[1;37mAider AI Pair Programmer is not yet provisioned in Python environment.\e[0m"
echo -e "\e[38;2;0;229;255m[*] To install Aider now, run:\e[0m uv pip install aider-chat"
read -p "Install aider-chat now? (y/N): " choice
if [[ "$choice" =~ ^[Yy]$ ]]; then
    uv pip install aider-chat || pip3 install --break-system-packages aider-chat
    exec python3 -m aider "$@"
fi
exit 1
