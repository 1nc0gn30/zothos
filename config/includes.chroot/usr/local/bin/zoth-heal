#!/usr/bin/env bash
# ==============================================================================
#  * ZOTHOS AUTONOMOUS SELF-HEALING & RESILIENCE SUBSYSTEM (zoth-heal) v3.0 *
#  Autonomous diagnostic & self-repair engine for sovereign OS reliability.
#  Covers: APT locks/GPG/mirrors, X11/compositors, Network/DNS/Tor, Disk pressure,
#          Audio daemons, Python/MCP dependencies, and Desktop config integrity.
# ==============================================================================

set -uo pipefail

# ANSI Cyber-Alchemical Palette
EMERALD="\e[38;2;0;255;157m"
GOLD="\e[38;2;255;215;0m"
CYAN="\e[38;2;0;229;255m"
CRIMSON="\e[38;2;255;51;85m"
GRAY="\e[38;2;120;140;160m"
WHITE="\e[38;2;240;245;255m"
BOLD="\e[1m"
DIM="\e[2m"
RESET="\e[0m"

# Mode flags
FLAG_ALL=true
FLAG_NETWORK=false
FLAG_DISPLAY=false
FLAG_PACKAGES=false
FLAG_DISK=false
FLAG_DESKTOP=false
FLAG_AUDIO=false
FLAG_PYTHON=false
FLAG_QUICK=false
FLAG_QUIET=false
FLAG_JSON=false

# Metrics tracking
ACTIONS_TAKEN=()
HEALED_COUNT=0
WARN_COUNT=0
FAIL_COUNT=0
CHECK_RESULTS=()

log_info() {
    [[ "$FLAG_QUIET" == "true" ]] && return
    echo -e "${CYAN}[*]${RESET} $1"
}

log_pass() {
    [[ "$FLAG_QUIET" == "true" ]] && return
    echo -e "  ${EMERALD}[✓ HEALTHY]${RESET} $1"
}

log_fixed() {
    [[ "$FLAG_QUIET" == "true" ]] && return
    echo -e "  ${GOLD}[⚡ HEALED]${RESET}  ${BOLD}$1${RESET}"
}

log_warn() {
    [[ "$FLAG_QUIET" == "true" ]] && return
    echo -e "  ${GOLD}[⚠ WARN]${RESET}    $1"
}

log_fail() {
    [[ "$FLAG_QUIET" == "true" ]] && return
    echo -e "  ${CRIMSON}[✗ ERROR]${RESET}   $1"
}

record_action() {
    local domain="$1"
    local status="$2"
    local details="$3"
    ACTIONS_TAKEN+=("{\"domain\":\"$domain\",\"status\":\"$status\",\"details\":\"$details\"}")
}

banner() {
    [[ "$FLAG_QUIET" == "true" || "$FLAG_JSON" == "true" ]] && return
    echo -e "${EMERALD}${BOLD}"
    echo "  ╔════════════════════════════════════════════════════════════════════╗"
    echo "  ║         *  ZOTHOS AUTONOMOUS SELF-HEALING ENGINE v3.0  *          ║"
    echo "  ║            Proactive Resilience & OS Recovery Subsystem            ║"
    echo "  ╚════════════════════════════════════════════════════════════════════╝"
    echo -e "${RESET}"
}

usage() {
    echo -e "${BOLD}Usage:${RESET} zoth-heal [OPTIONS]"
    echo ""
    echo -e "${BOLD}Options:${RESET}"
    echo "  --all         Execute comprehensive self-healing across all subsystems (default)"
    echo "  --quick       Fast non-blocking audit and lightweight critical repairs"
    echo "  --packages    Repair APT locks, broken dependencies, expired GPG keys, mirror fallbacks"
    echo "  --display     Restore compositor (picom), window manager (xfwm4), panels, and xrender"
    echo "  --network     Repair NetworkManager, flush DNS cache, fix resolv.conf, reset Tor/interfaces"
    echo "  --disk        Clean APT caches, vacuum systemd logs, purge /tmp, clean docker dangling"
    echo "  --desktop     Verify and restore ~/.config integrity from /etc/skel templates"
    echo "  --audio       Restart PipeWire / WirePlumber / PulseAudio daemons if unresponsive"
    echo "  --python      Verify Python venvs, repair MCP registry & permissions JSON"
    echo "  --quiet, -q   Suppress verbose console output (ideal for background cron/timers)"
    echo "  --json        Output structured JSON results of diagnostics and remediation"
    echo "  --help, -h    Display this help message and exit"
    echo ""
    exit 0
}

# ─────────────────────────────────────────────────────────────────────────────
# MODULE 1: PACKAGE MANAGEMENT & APT RESILIENCE
# ─────────────────────────────────────────────────────────────────────────────
heal_packages() {
    log_info "Auditing APT Package Manager, DPKG Locks & Mirror Integrity..."
    local mod_healed=0

    # 1. Check for stale lock files
    local locks=(
        "/var/lib/dpkg/lock-frontend"
        "/var/lib/dpkg/lock"
        "/var/lib/apt/lists/lock"
        "/var/cache/apt/archives/lock"
    )

    local dpkg_active=false
    if pgrep -x dpkg >/dev/null 2>&1 || pgrep -x apt >/dev/null 2>&1 || pgrep -x apt-get >/dev/null 2>&1; then
        dpkg_active=true
    fi

    for lock in "${locks[@]}"; do
        if [[ -f "$lock" ]]; then
            if [[ "$dpkg_active" == "false" ]]; then
                if fuser "$lock" >/dev/null 2>&1; then
                    # Process holding lock without standard name; kill stale holder if older than 5m
                    fuser -k -TERM "$lock" >/dev/null 2>&1 || true
                    sleep 1
                    fuser -k -KILL "$lock" >/dev/null 2>&1 || true
                fi
                if rm -f "$lock" 2>/dev/null; then
                    log_fixed "Removed stale APT/DPKG lock: $lock"
                    mod_healed=$((mod_healed + 1))
                    record_action "packages" "healed" "Cleared stale lock file: $lock"
                fi
            else
                log_warn "APT/DPKG lock active and owned by running process ($lock)"
            fi
        fi
    done

    # 2. DPKG Configure Interruptions
    if [[ "$EUID" -eq 0 || -w "/var/lib/dpkg" ]]; then
        if dpkg --audit >/dev/null 2>&1; then
            log_pass "DPKG database in consistent state"
        else
            log_info "Attempting dpkg --configure -a..."
            if DEBIAN_FRONTEND=noninteractive dpkg --configure -a >/dev/null 2>&1; then
                log_fixed "Resolved unconfigured/interrupted DPKG packages"
                mod_healed=$((mod_healed + 1))
                record_action "packages" "healed" "dpkg --configure -a executed successfully"
            else
                log_warn "dpkg --configure -a completed with warnings or requires manual attention"
                WARN_COUNT=$((WARN_COUNT + 1))
            fi
        fi

        # 3. Broken package dependencies
        if [[ "$FLAG_QUICK" == "false" ]]; then
            log_info "Verifying apt dependency graph..."
            if DEBIAN_FRONTEND=noninteractive apt-get install -f -y --fix-broken >/dev/null 2>&1; then
                log_pass "APT dependency tree is healthy and satisfied"
            else
                log_warn "apt-get install -f completed with non-zero exit code"
            fi
        fi
    else
        log_pass "DPKG locks check completed (non-root execution)"
    fi

    # 4. Expired GPG keys and Archive Keyring verification
    local keyring_dirs=("/etc/apt/trusted.gpg.d" "/usr/share/keyrings")
    local keyring_missing=false
    if [[ ! -f "/usr/share/keyrings/debian-archive-keyring.gpg" ]] && [[ ! -f "/etc/apt/trusted.gpg.d/debian-archive-keyring.gpg" ]]; then
        keyring_missing=true
    fi

    if [[ "$keyring_missing" == "true" && ("$EUID" -eq 0 || -w "/etc/apt") ]]; then
        log_info "Restoring Debian/Kali/Parrot archive keyrings..."
        apt-get install -y --reinstall debian-archive-keyring 2>/dev/null || true
        mod_healed=$((mod_healed + 1))
        record_action "packages" "healed" "Reinstalled archive keyrings"
    fi

    # 5. Mirror Reachability & Fallbacks
    if [[ "$FLAG_QUICK" == "false" ]]; then
        local primary_sources="/etc/apt/sources.list"
        if [[ -f "$primary_sources" ]]; then
            # Verify primary debian mirror is reachable
            if ! curl -Is --connect-timeout 3 http://deb.debian.org >/dev/null 2>&1; then
                log_warn "Primary deb.debian.org timed out; testing fast mirror fallback (cdn-fastly.deb.debian.org)..."
                record_action "packages" "warn" "Primary mirror slow or unreachable"
            else
                log_pass "APT repositories & CDN mirrors reachable"
            fi
        fi
    fi

    HEALED_COUNT=$((HEALED_COUNT + mod_healed))
}

# ─────────────────────────────────────────────────────────────────────────────
# MODULE 2: X11 / XFCE / PICOM DISPLAY & COMPOSITOR RECOVERY
# ─────────────────────────────────────────────────────────────────────────────
heal_display() {
    log_info "Auditing X11 Display Server, Compositor & XFCE Desktop Shell..."
    local mod_healed=0
    local disp="${DISPLAY:-:0}"

    # Verify X Server is active or reachable
    if ! xset q -display "$disp" >/dev/null 2>&1; then
        log_warn "Display server $disp not reachable or running in headless mode"
        record_action "display" "skipped" "Display $disp not reachable"
        return 0
    fi

    # 1. Verify and Fix .Xauthority permissions
    local xauth_file="${XAUTHORITY:-$HOME/.Xauthority}"
    if [[ -f "$xauth_file" ]]; then
        local perm
        perm=$(stat -c "%a" "$xauth_file" 2>/dev/null || echo "600")
        if [[ "$perm" != "600" ]]; then
            chmod 600 "$xauth_file" 2>/dev/null || true
            log_fixed "Fixed permissions on $xauth_file (set to 600)"
            mod_healed=$((mod_healed + 1))
            record_action "display" "healed" "Fixed $xauth_file permissions"
        else
            log_pass "Xauthority credentials secure"
        fi
    fi

    # 2. Compositor (picom) health & fallback
    if command -v picom >/dev/null 2>&1; then
        if ! pgrep -x picom >/dev/null 2>&1; then
            log_warn "Compositor (picom) is not running; attempting clean restart..."
            local pconf="/etc/xdg/picom/picom-matrix.conf"
            [[ -f "$HOME/.config/picom/picom.conf" ]] && pconf="$HOME/.config/picom/picom.conf"
            [[ -f "$HOME/.config/picom.conf" ]] && pconf="$HOME/.config/picom.conf"

            # Attempt launch with config; if fails, fallback to clean xrender backend
            if DISPLAY="$disp" picom --config "$pconf" -b >/dev/null 2>&1; then
                log_fixed "Started Picom compositor daemon with profile ($pconf)"
                mod_healed=$((mod_healed + 1))
                record_action "display" "healed" "Started Picom with $pconf"
            else
                log_warn "GLX Picom failed; falling back to fail-safe XRender backend..."
                DISPLAY="$disp" picom --backend xrender --no-vsync -b >/dev/null 2>&1 || true
                log_fixed "Started Picom compositor with fail-safe XRender engine"
                mod_healed=$((mod_healed + 1))
                record_action "display" "healed" "Picom started with fail-safe xrender"
            fi
        else
            log_pass "Picom compositor running normally"
        fi
    fi

    # 3. Window Manager (xfwm4) health
    if command -v xfwm4 >/dev/null 2>&1; then
        if ! pgrep -x xfwm4 >/dev/null 2>&1; then
            log_warn "XFCE Window Manager (xfwm4) is dead or crashed; reviving..."
            DISPLAY="$disp" nohup xfwm4 --replace >/dev/null 2>&1 &
            sleep 1
            if pgrep -x xfwm4 >/dev/null 2>&1; then
                log_fixed "Restored and replaced XFCE Window Manager (xfwm4)"
                mod_healed=$((mod_healed + 1))
                record_action "display" "healed" "Restarted xfwm4"
            else
                log_fail "Failed to revive xfwm4 window manager"
                FAIL_COUNT=$((FAIL_COUNT + 1))
            fi
        else
            log_pass "Window Manager (xfwm4) operational"
        fi
    fi

    # 4. XFCE Desktop Shell & Panel
    if command -v xfce4-panel >/dev/null 2>&1; then
        if ! pgrep -x xfce4-panel >/dev/null 2>&1; then
            log_warn "xfce4-panel not detected; reviving desktop panels..."
            DISPLAY="$disp" nohup xfce4-panel >/dev/null 2>&1 &
            mod_healed=$((mod_healed + 1))
            record_action "display" "healed" "Restarted xfce4-panel"
        else
            log_pass "XFCE Desktop Panel active"
        fi
    fi

    if command -v xfdesktop >/dev/null 2>&1; then
        if ! pgrep -x xfdesktop >/dev/null 2>&1; then
            log_warn "xfdesktop not detected; launching desktop icons/background manager..."
            DISPLAY="$disp" nohup xfdesktop >/dev/null 2>&1 &
            mod_healed=$((mod_healed + 1))
            record_action "display" "healed" "Restarted xfdesktop"
        else
            log_pass "XFCE Desktop Manager active"
        fi
    fi

    HEALED_COUNT=$((HEALED_COUNT + mod_healed))
}

# ─────────────────────────────────────────────────────────────────────────────
# MODULE 3: NETWORK, DNS, RESOLVER, TOR & VPN RECOVERY
# ─────────────────────────────────────────────────────────────────────────────
heal_network() {
    log_info "Auditing Network Interfaces, DNS Resolvers, Tor Stealth & VPN..."
    local mod_healed=0

    # 1. Interface states
    local ifaces
    ifaces=$(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | grep -v '^lo$' || true)
    for iface in $ifaces; do
        # Ignore docker/bridge sub-interfaces from bringing down alerts
        if [[ "$iface" =~ ^(docker|br-|veth) ]]; then
            continue
        fi
        local state
        state=$(cat "/sys/class/net/$iface/operstate" 2>/dev/null || echo "unknown")
        if [[ "$state" == "down" ]]; then
            log_warn "Network interface $iface is DOWN; attempting link up..."
            if [[ "$EUID" -eq 0 ]] || sudo -n true 2>/dev/null; then
                sudo ip link set "$iface" up 2>/dev/null || true
                mod_healed=$((mod_healed + 1))
                record_action "network" "healed" "Brought link up on $iface"
            fi
        fi
    done

    # 2. DNS Resolution & Cache Flush
    local dns_healthy=false
    if getent hosts debian.org >/dev/null 2>&1 || getent hosts 1.1.1.1 >/dev/null 2>&1; then
        dns_healthy=true
        log_pass "DNS resolver operating normally"
    else
        log_warn "DNS resolution failed; initiating resolver cache purge & repair..."
        # Try resolvectl flush-caches
        if command -v resolvectl >/dev/null 2>&1; then
            resolvectl flush-caches 2>/dev/null || true
        elif command -v systemd-resolve >/dev/null 2>&1; then
            systemd-resolve --flush-caches 2>/dev/null || true
        fi

        # Check /etc/resolv.conf integrity
        if [[ ! -s "/etc/resolv.conf" ]] || ! grep -q "nameserver" /etc/resolv.conf 2>/dev/null; then
            log_warn "/etc/resolv.conf missing or empty; injecting sovereign fallback nameservers..."
            if [[ "$EUID" -eq 0 ]] || sudo -n true 2>/dev/null; then
                {
                    echo "# Generated by ZothOS Autonomous Resilience Subsystem"
                    echo "nameserver 1.1.1.1"
                    echo "nameserver 8.8.8.8"
                    echo "nameserver 9.9.9.9"
                } | sudo tee /etc/resolv.conf >/dev/null 2>&1 || true
                mod_healed=$((mod_healed + 1))
                record_action "network" "healed" "Injected sovereign fallback nameservers into /etc/resolv.conf"
            fi
        fi

        # Restart systemd-resolved if present
        if systemctl is-active systemd-resolved >/dev/null 2>&1; then
            systemctl restart systemd-resolved 2>/dev/null || true
        fi
    fi

    # 3. NetworkManager Service
    if systemctl list-unit-files NetworkManager.service >/dev/null 2>&1; then
        if ! systemctl is-active NetworkManager >/dev/null 2>&1; then
            log_warn "NetworkManager daemon is inactive or failed; restarting..."
            if [[ "$EUID" -eq 0 ]] || sudo -n true 2>/dev/null; then
                sudo systemctl restart NetworkManager 2>/dev/null || true
                mod_healed=$((mod_healed + 1))
                record_action "network" "healed" "Restarted NetworkManager"
            fi
        else
            log_pass "NetworkManager daemon is active"
        fi
    fi

    # 4. Tor Ghostmode Daemon Health
    if [[ -f "/home/neo/.config/zothos/ghostmode_active" ]] || [[ -f "$HOME/.config/zothos/ghostmode_active" ]]; then
        log_info "ZothOS Ghostmode active; auditing Tor stealth proxy..."
        if ! pgrep -x tor >/dev/null 2>&1; then
            log_warn "Tor daemon stopped while Ghostmode is active; restarting Tor..."
            if [[ "$EUID" -eq 0 ]] || sudo -n true 2>/dev/null; then
                sudo systemctl restart tor 2>/dev/null || true
                mod_healed=$((mod_healed + 1))
                record_action "network" "healed" "Restarted Tor for Ghostmode"
            fi
        else
            log_pass "Tor stealth daemon operational"
        fi
    fi

    HEALED_COUNT=$((HEALED_COUNT + mod_healed))
}

# ─────────────────────────────────────────────────────────────────────────────
# MODULE 4: DISK SPACE PRESSURE & EPHEMERAL PURGE
# ─────────────────────────────────────────────────────────────────────────────
heal_disk() {
    log_info "Auditing Disk Space Pressure, Ephemeral Inodes & Cache Bloat..."
    local mod_healed=0

    # Calculate root disk usage percentage
    local root_usage
    root_usage=$(df / --output=pcent 2>/dev/null | tail -1 | tr -dc '0-9')
    [[ -z "$root_usage" ]] && root_usage=0
    log_info "Root filesystem utilization: ${root_usage}%"

    # 1. Clean APT Archives and package caches
    if [[ -d "/var/cache/apt/archives" ]]; then
        local apt_cache_size
        apt_cache_size=$(du -sm /var/cache/apt/archives 2>/dev/null | tail -1 | awk '{print $1}')
        [[ -z "$apt_cache_size" || ! "$apt_cache_size" =~ ^[0-9]+$ ]] && apt_cache_size=0
        if [[ "$apt_cache_size" -gt 100 || "$root_usage" -gt 85 || "$FLAG_QUICK" == "false" ]]; then
            log_info "Clearing APT archives cache (${apt_cache_size}MB)..."
            if [[ "$EUID" -eq 0 ]] || sudo -n true 2>/dev/null; then
                sudo apt-get clean -y >/dev/null 2>&1 || true
                sudo apt-get autoclean -y >/dev/null 2>&1 || true
                mod_healed=$((mod_healed + 1))
                record_action "disk" "healed" "Cleaned APT archive cache (${apt_cache_size}MB freed)"
            fi
        else
            log_pass "APT cache size optimal (${apt_cache_size}MB)"
        fi
    fi

    # 2. Systemd Journal Vacuuming
    if command -v journalctl >/dev/null 2>&1; then
        if [[ "$EUID" -eq 0 ]] || sudo -n true 2>/dev/null; then
            log_info "Vacuuming systemd journal logs (>2 days or >100MB)..."
            sudo journalctl --vacuum-time=2d >/dev/null 2>&1 || true
            sudo journalctl --vacuum-size=100M >/dev/null 2>&1 || true
            mod_healed=$((mod_healed + 1))
            record_action "disk" "healed" "Vacuumed systemd journal logs to 2d/100M"
        fi
    fi

    # 3. Clean stale temporary files in /tmp and /var/tmp
    local tmp_cleared=0
    find /tmp -maxdepth 1 -type f -atime +2 -delete 2>/dev/null && tmp_cleared=1 || true
    find /var/tmp -maxdepth 1 -type f -atime +3 -delete 2>/dev/null && tmp_cleared=1 || true
    if [[ $tmp_cleared -eq 1 ]]; then
        log_pass "Purged stale ephemeral objects from /tmp and /var/tmp"
        record_action "disk" "healed" "Cleaned stale files in /tmp and /var/tmp"
    fi

    # 4. User Thumbnail & Stale Cache Clean
    local thumb_dir="$HOME/.cache/thumbnails"
    if [[ -d "$thumb_dir" ]]; then
        local thumb_size
        thumb_size=$(du -sm "$thumb_dir" 2>/dev/null | tail -1 | awk '{print $1}')
        [[ -z "$thumb_size" || ! "$thumb_size" =~ ^[0-9]+$ ]] && thumb_size=0
        if [[ "$thumb_size" -gt 50 ]]; then
            rm -rf "${thumb_dir:?}"/* 2>/dev/null || true
            log_fixed "Purged bloated thumbnail cache (${thumb_size}MB)"
            mod_healed=$((mod_healed + 1))
            record_action "disk" "healed" "Purged user thumbnail cache (${thumb_size}MB)"
        fi
    fi

    # 5. Docker dangling prune if docker is available and running
    if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
        log_info "Pruning dangling docker images and build cache..."
        docker image prune -f >/dev/null 2>&1 || true
        docker container prune -f >/dev/null 2>&1 || true
        mod_healed=$((mod_healed + 1))
        record_action "disk" "healed" "Pruned dangling Docker containers and images"
    fi

    HEALED_COUNT=$((HEALED_COUNT + mod_healed))
}

# ─────────────────────────────────────────────────────────────────────────────
# MODULE 5: AUDIO SUBSYSTEM (PIPEWIRE / WIREPLUMBER / PULSEAUDIO)
# ─────────────────────────────────────────────────────────────────────────────
heal_audio() {
    log_info "Auditing Audio Subsystem Daemons (PipeWire / PulseAudio)..."
    local mod_healed=0

    local audio_healthy=false
    if command -v pactl >/dev/null 2>&1; then
        if pactl info >/dev/null 2>&1; then
            audio_healthy=true
        fi
    elif command -v wpctl >/dev/null 2>&1; then
        if wpctl status >/dev/null 2>&1; then
            audio_healthy=true
        fi
    fi

    if [[ "$audio_healthy" == "true" ]]; then
        log_pass "Audio server daemon responsive"
    else
        log_warn "Audio server unresponsive or hung; restarting audio daemons..."
        if command -v systemctl >/dev/null 2>&1; then
            systemctl --user restart pipewire pipewire-pulse wireplumber 2>/dev/null || true
        fi
        pkill -x pulseaudio 2>/dev/null || true
        sleep 1
        if command -v pulseaudio >/dev/null 2>&1; then
            pulseaudio --start 2>/dev/null || true
        fi
        mod_healed=$((mod_healed + 1))
        record_action "audio" "healed" "Restarted PipeWire / PulseAudio services"
        log_fixed "Restored audio subsystem services"
    fi

    HEALED_COUNT=$((HEALED_COUNT + mod_healed))
}

# ─────────────────────────────────────────────────────────────────────────────
# MODULE 6: PYTHON ENVIRONMENTS & MCP REGISTRY INTEGRITY
# ─────────────────────────────────────────────────────────────────────────────
heal_python() {
    log_info "Auditing Python Virtualenvs, MCP Server Manifests & Permission Rings..."
    local mod_healed=0

    # 1. MCP Registry JSON Syntax
    local mcp_file="/etc/zothos/mcp-servers.json"
    if [[ -f "$mcp_file" ]]; then
        if command -v jq >/dev/null 2>&1; then
            if jq empty "$mcp_file" 2>/dev/null; then
                log_pass "MCP Server Registry JSON valid ($mcp_file)"
            else
                log_fail "Corrupted JSON detected in $mcp_file; regenerating minimal schema..."
                if [[ "$EUID" -eq 0 ]] || sudo -n true 2>/dev/null; then
                    cat << 'EOF' | sudo tee "$mcp_file" >/dev/null
{
  "version": "1.0.0",
  "mcpServers": {
    "hexstrike": {
      "command": "/usr/local/bin/hexstrike_mcp",
      "args": [],
      "env": {},
      "description": "HexStrike AI Pentesting MCP Engine"
    }
  }
}
EOF
                    log_fixed "Restored default valid MCP Server Registry schema"
                    mod_healed=$((mod_healed + 1))
                    record_action "python" "healed" "Regenerated corrupt mcp-servers.json"
                fi
            fi
        fi
    fi

    # 2. Agent Permissions JSON Syntax
    local perm_file="/etc/zothos/agent-permissions.json"
    if [[ -f "$perm_file" ]]; then
        if command -v jq >/dev/null 2>&1; then
            if jq empty "$perm_file" 2>/dev/null; then
                log_pass "Agent Permission Ring config valid ($perm_file)"
            else
                log_warn "Corrupted JSON in $perm_file"
                WARN_COUNT=$((WARN_COUNT + 1))
            fi
        fi
    fi

    # 3. Python AI Environment check
    local venv_path="/opt/zothos-ai-env"
    if [[ -d "$venv_path" ]]; then
        if [[ -x "$venv_path/bin/python3" ]]; then
            log_pass "Python AI Virtualenv active at $venv_path"
        else
            log_warn "Python venv binary missing or broken at $venv_path"
            WARN_COUNT=$((WARN_COUNT + 1))
        fi
    fi

    HEALED_COUNT=$((HEALED_COUNT + mod_healed))
}

# ─────────────────────────────────────────────────────────────────────────────
# MODULE 7: USER DESKTOP CONFIG & SKELETON INTEGRITY
# ─────────────────────────────────────────────────────────────────────────────
heal_desktop() {
    log_info "Auditing Desktop Config Integrity against /etc/skel Templates..."
    local mod_healed=0
    local target_home="${HOME:-/home/neo}"
    local skel_dir="/etc/skel"

    if [[ ! -d "$skel_dir" ]]; then
        log_warn "Skeleton directory /etc/skel not found; skipping template reconciliation"
        return 0
    fi

    # 1. Verify ~/.config/xfce4 structure
    local xfce_cfg="$target_home/.config/xfce4"
    if [[ ! -d "$xfce_cfg" && -d "$skel_dir/.config/xfce4" ]]; then
        log_warn "Missing $xfce_cfg; cloning default hierarchy from /etc/skel..."
        mkdir -p "$target_home/.config"
        cp -r "$skel_dir/.config/xfce4" "$target_home/.config/" 2>/dev/null || true
        log_fixed "Restored default ~/.config/xfce4 layout"
        mod_healed=$((mod_healed + 1))
        record_action "desktop" "healed" "Restored ~/.config/xfce4 from /etc/skel"
    else
        log_pass "XFCE desktop configuration tree intact"
    fi

    # 2. Verify Desktop Launchers
    local desktop_dir="$target_home/Desktop"
    if [[ -d "$skel_dir/Desktop" ]]; then
        mkdir -p "$desktop_dir"
        for dfile in "$skel_dir/Desktop"/*.desktop; do
            [[ -f "$dfile" ]] || continue
            local bname
            bname=$(basename "$dfile")
            if [[ ! -f "$desktop_dir/$bname" ]]; then
                cp "$dfile" "$desktop_dir/" 2>/dev/null || true
                chmod +x "$desktop_dir/$bname" 2>/dev/null || true
                log_fixed "Restored missing desktop shortcut: $bname"
                mod_healed=$((mod_healed + 1))
                record_action "desktop" "healed" "Restored desktop launcher $bname"
            fi
        done
    fi

    # 3. Verify Picom Config Directory
    local picom_cfg_dir="$target_home/.config/picom"
    if [[ ! -d "$picom_cfg_dir" ]]; then
        mkdir -p "$picom_cfg_dir"
        if [[ -f "/etc/xdg/picom/picom-matrix.conf" ]]; then
            cp "/etc/xdg/picom/picom-matrix.conf" "$picom_cfg_dir/picom.conf" 2>/dev/null || true
            log_fixed "Created default picom config in ~/.config/picom/picom.conf"
            mod_healed=$((mod_healed + 1))
            record_action "desktop" "healed" "Installed default picom configuration"
        fi
    fi

    HEALED_COUNT=$((HEALED_COUNT + mod_healed))
}

# ─────────────────────────────────────────────────────────────────────────────
# CLI PARSER & CONTROLLER DISPATCH
# ─────────────────────────────────────────────────────────────────────────────
TARGET_SPECIFIED=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --all)
            FLAG_ALL=true
            TARGET_SPECIFIED=true
            shift
            ;;
        --quick)
            FLAG_QUICK=true
            shift
            ;;
        --packages)
            FLAG_PACKAGES=true
            FLAG_ALL=false
            TARGET_SPECIFIED=true
            shift
            ;;
        --display)
            FLAG_DISPLAY=true
            FLAG_ALL=false
            TARGET_SPECIFIED=true
            shift
            ;;
        --network)
            FLAG_NETWORK=true
            FLAG_ALL=false
            TARGET_SPECIFIED=true
            shift
            ;;
        --disk)
            FLAG_DISK=true
            FLAG_ALL=false
            TARGET_SPECIFIED=true
            shift
            ;;
        --desktop)
            FLAG_DESKTOP=true
            FLAG_ALL=false
            TARGET_SPECIFIED=true
            shift
            ;;
        --audio)
            FLAG_AUDIO=true
            FLAG_ALL=false
            TARGET_SPECIFIED=true
            shift
            ;;
        --python)
            FLAG_PYTHON=true
            FLAG_ALL=false
            TARGET_SPECIFIED=true
            shift
            ;;
        --quiet|-q)
            FLAG_QUIET=true
            shift
            ;;
        --json)
            FLAG_JSON=true
            FLAG_QUIET=true
            shift
            ;;
        --help|-h)
            usage
            ;;
        *)
            echo -e "${CRIMSON}Unknown option: $1${RESET}"
            usage
            ;;
    esac
done

banner

# Execute Modules
if [[ "$FLAG_ALL" == "true" ]]; then
    heal_packages
    heal_display
    heal_network
    heal_disk
    heal_audio
    heal_python
    heal_desktop
else
    [[ "$FLAG_PACKAGES" == "true" ]] && heal_packages
    [[ "$FLAG_DISPLAY" == "true" ]]  && heal_display
    [[ "$FLAG_NETWORK" == "true" ]]  && heal_network
    [[ "$FLAG_DISK" == "true" ]]     && heal_disk
    [[ "$FLAG_AUDIO" == "true" ]]    && heal_audio
    [[ "$FLAG_PYTHON" == "true" ]]   && heal_python
    [[ "$FLAG_DESKTOP" == "true" ]]  && heal_desktop
fi

# ─────────────────────────────────────────────────────────────────────────────
# SUMMARY & OUTPUT GENERATION
# ─────────────────────────────────────────────────────────────────────────────
if [[ "$FLAG_JSON" == "true" ]]; then
    actions_json=$(IFS=,; echo "[${ACTIONS_TAKEN[*]}]")
    cat << EOF
{
  "timestamp": $(date +%s),
  "status": "$([[ $FAIL_COUNT -eq 0 ]] && echo 'healthy' || echo 'degraded')",
  "healed_items": $HEALED_COUNT,
  "warnings": $WARN_COUNT,
  "failures": $FAIL_COUNT,
  "actions": $actions_json
}
EOF
else
    if [[ "$FLAG_QUIET" == "false" ]]; then
        echo -e "\n${DIM}──────────────────────────────────────────────────────────────────────${RESET}"
        echo -e "  ${BOLD}Healed Anomaly Count:${RESET} ${GOLD}${BOLD}${HEALED_COUNT}${RESET} | ${BOLD}Warnings:${RESET} ${GOLD}${WARN_COUNT}${RESET} | ${BOLD}Failures:${RESET} ${CRIMSON}${FAIL_COUNT}${RESET}"
        if [[ $FAIL_COUNT -eq 0 ]]; then
            echo -e "  ${EMERALD}${BOLD}>>> RESILIENCE AUDIT COMPLETE: ALL SYSTEMS NOMINAL & REPAIRED <<<${RESET}\n"
        else
            echo -e "  ${CRIMSON}${BOLD}>>> CRITICAL ANOMALIES DETECTED: SOME HEALING ACTIONS FAILED <<<${RESET}\n"
        fi
    fi
fi

if [[ $FAIL_COUNT -gt 0 ]]; then
    exit 1
fi
exit 0
