#!/usr/bin/env bash
# ==============================================================================
#  ZOTHOS Agent Permission Layer Switcher & Security Ring Controller
# ==============================================================================

set -euo pipefail

CONFIG_FILE="/etc/zothos/agent-permissions.json"
DEV_CONFIG_FILE="/home/neo/zothos/config/includes.chroot/etc/zothos/agent-permissions.json"
USER_STATE="$HOME/.config/zothos/agent-layer.state"
USER_RING_STATE="$HOME/.config/zothos/agent-ring.state"

GREEN="\e[1;32m"
CYAN="\e[1;36m"
YELLOW="\e[1;33m"
RED="\e[1;31m"
PURPLE="\e[1;35m"
BLUE="\e[1;34m"
BOLD="\e[1m"
RESET="\e[0m"

get_active_layer() {
    if [[ -f "$USER_STATE" ]]; then
        cat "$USER_STATE"
    elif [[ -f "$CONFIG_FILE" ]] && command -v jq >/dev/null 2>&1; then
        jq -r '.active_layer // 2' "$CONFIG_FILE"
    elif [[ -f "$DEV_CONFIG_FILE" ]] && command -v jq >/dev/null 2>&1; then
        jq -r '.active_layer // 2' "$DEV_CONFIG_FILE"
    else
        echo "2"
    fi
}

get_active_ring() {
    if [[ -f "$USER_RING_STATE" ]]; then
        cat "$USER_RING_STATE"
    else
        local l
        l=$(get_active_layer)
        case "$l" in
            4) echo "0" ;;
            3) echo "1" ;;
            2|1) echo "2" ;;
            0) echo "3" ;;
            *) echo "2" ;;
        esac
    fi
}

set_active_ring() {
    local target="$1"
    if [[ ! "$target" =~ ^[0-3]$ ]]; then
        echo -e "${RED}[!] Invalid ring '$target'. Must be between 0 (Root) and 3 (Sandbox).${RESET}"
        exit 1
    fi
    mkdir -p "$(dirname "$USER_RING_STATE")"
    echo "$target" > "$USER_RING_STATE"
    
    # Also update layer state for backward compatibility
    local layer_equiv=2
    case "$target" in
        0) layer_equiv=4 ;;
        1) layer_equiv=3 ;;
        2) layer_equiv=2 ;;
        3) layer_equiv=0 ;;
    esac
    echo "$layer_equiv" > "$USER_STATE"

    local codename=""
    local title=""
    case "$target" in
        0) codename="SOVEREIGN"; title="Ring 0: Root, Kernel & Amnesic Authority" ;;
        1) codename="SYSADMIN"; title="Ring 1: System Admin & Privileged Operations" ;;
        2) codename="TOOLMASTER"; title="Ring 2: Agent Tools & MCP Runtime" ;;
        3) codename="SPECTRE"; title="Ring 3: Sandboxed LLM Execution & Untrusted Code" ;;
    esac

    echo -e "${GREEN}[✓] ZOTHOS Agent Security Ring updated to Ring ${target}: ${BOLD}${codename}${RESET} (${title})"
    
    if [[ -n "${DISPLAY:-}" ]] && command -v notify-send >/dev/null 2>&1; then
        notify-send -u normal -i /usr/share/icons/Zoth-Hermetic/scalable/apps/zoth-agent.svg \
            "ZOTHOS Security Ring: Ring $target ($codename)" \
            "$title" 2>/dev/null || true
    fi
}

set_active_layer() {
    local target="$1"
    if [[ ! "$target" =~ ^[0-4]$ ]]; then
        echo -e "${RED}[!] Invalid layer '$target'. Must be between 0 and 4.${RESET}"
        exit 1
    fi
    mkdir -p "$(dirname "$USER_STATE")"
    echo "$target" > "$USER_STATE"
    
    local ring_equiv=2
    case "$target" in
        4) ring_equiv=0 ;;
        3) ring_equiv=1 ;;
        2|1) ring_equiv=2 ;;
        0) ring_equiv=3 ;;
    esac
    echo "$ring_equiv" > "$USER_RING_STATE"
    
    local codename=""
    local title=""
    case "$target" in
        0) codename="SPECTRE"; title="Observer / Read-Only Telemetry (Cyan)" ;;
        1) codename="RUNECRAFTER"; title="User-Space Shell & Code Execution (Emerald)" ;;
        2) codename="CYBERPUPPET"; title="GUI, Mouse & Keyboard Computer Use (Blue)" ;;
        3) codename="WARLOCK"; title="Security & Offensive Arsenal (Purple)" ;;
        4) codename="SOVEREIGN"; title="Root, Kernel & Amnesic Authority (Gold)" ;;
    esac
    
    echo -e "${GREEN}[✓] ZOTHOS Agent Security Ring updated to Layer ${target}: ${BOLD}${codename}${RESET} (${title})"
    
    if [[ -n "${DISPLAY:-}" ]] && command -v notify-send >/dev/null 2>&1; then
        notify-send -u normal -i /usr/share/icons/Zoth-Hermetic/scalable/apps/zoth-agent.svg \
            "ZOTHOS Agent Authority: Layer $target ($codename)" \
            "$title" 2>/dev/null || true
    fi
}

show_status() {
    local active_layer
    active_layer=$(get_active_layer)
    local active_ring
    active_ring=$(get_active_ring)

    echo -e "${GREEN}  ███████╗ ██████╗ ████████╗██╗  ██╗     █████╗  ██████╗ ███████╗███╗   ██╗████████╗${RESET}"
    echo -e "${GREEN}  ╚══███╔╝██╔═══██╗╚══██╔══╝██║  ██║    ██╔══██╗██╔════╝ ██╔════╝████╗  ██║╚══██╔══╝${RESET}"
    echo -e "${GREEN}    ███╔╝ ██║   ██║   ██║   ███████║    ███████║██║  ███╗█████╗  ██╔██╗ ██║   ██║   ${RESET}"
    echo -e "${GREEN}   ███╔╝  ██║   ██║   ██║   ██╔══██║    ██╔══██║██║   ██║██╔══╝  ██║╚██╗██║   ██║   ${RESET}"
    echo -e "${GREEN}  ███████╗╚██████╔╝   ██║   ██║  ██║    ██║  ██║╚██████╔╝███████╗██║ ╚████║   ██║   ${RESET}"
    echo -e "${GREEN}  ╚══════╝ ╚═════╝    ╚═╝   ╚═╝  ╚═╝    ╚═╝  ╚═╝ ╚═════╝ ╚══════╝╚═╝  ╚═══╝   ╚═╝   ${RESET}"
    echo -e "                   ${BOLD}${CYAN}AUTONOMOUS OS CONTROL PERMISSION RINGS${RESET}\n"
    
    echo -e "${BOLD}Current Active Authority:${RESET} ${YELLOW}Ring ${active_ring}${RESET} / ${CYAN}Layer ${active_layer}${RESET}\n"
    
    echo -e "${BOLD}${PURPLE}--- [ SECURITY RINGS (0 to 3) ] ---${RESET}"
    local rings=(
        "0|SOVEREIGN|Ring 0: Root, Kernel & Amnesia|Sudo execution, systemd services, firewall, panic RAM purge"
        "1|SYSADMIN|Ring 1: System Admin & Privileged Ops|User-space daemons, network routing, security audit"
        "2|TOOLMASTER|Ring 2: Agent Tools & MCP Runtime|Filesystem, GUI automation, Puppeteer, SQLite/DuckDB, HexStrike"
        "3|SPECTRE|Ring 3: Sandboxed LLM & Untrusted Code|Strict firejail/sandbox, read-only telemetry, isolated loopback"
    )
    for entry in "${rings[@]}"; do
        IFS="|" read -r rnum rcode rtitle rdesc <<< "$entry"
        local prefix="  "
        local color="${CYAN}"
        if [[ "$rnum" -eq "$active_ring" ]]; then
            prefix="${GREEN}▶ [ACTIVE]${RESET} "
            color="${BOLD}${GREEN}"
        fi
        echo -e "${prefix}${color}Ring ${rnum}: ${rcode}${RESET} - ${BOLD}${rtitle}${RESET}"
        echo -e "      ${RESET}${rdesc}"
    done

    echo -e "\n${BOLD}${CYAN}--- [ COMPATIBILITY LAYERS (0 to 4) ] ---${RESET}"
    local layers=(
        "0|SPECTRE|Observer / Read-Only Telemetry|Metrics, logs, search, process inspection (0 mutation)"
        "1|RUNECRAFTER|User-Space Shell & Code|Execute bash/zsh, build code, git repos in user space"
        "2|CYBERPUPPET|GUI, Mouse & Keyboard Computer Use|Click, type, drag windows, visual OCR, browser automation"
        "3|WARLOCK|Offensive Security & Red Team|Nmap, Metasploit, HexStrike AI, Tor routing, MAC randomize"
        "4|SOVEREIGN|Root, Kernel & Amnesic Authority|Sudo execution, systemd services, firewall, panic RAM purge"
    )
    for entry in "${layers[@]}"; do
        IFS="|" read -r lnum lcode ltitle ldesc <<< "$entry"
        local prefix="  "
        local color="${CYAN}"
        if [[ "$lnum" -eq "$active_layer" ]]; then
            prefix="${GREEN}▶ [ACTIVE]${RESET} "
            color="${BOLD}${GREEN}"
        fi
        echo -e "${prefix}${color}Layer ${lnum}: ${lcode}${RESET} - ${BOLD}${ltitle}${RESET}"
        echo -e "      ${RESET}${ldesc}"
    done
    echo ""
    echo -e "Usage: ${BOLD}zoth-agent-layer set <0-4>${RESET} | ${BOLD}zoth-agent-layer ring <0-3>${RESET} | ${BOLD}zoth-agent-layer get${RESET}"
}

show_help() {
    show_status
}

case "${1:-status}" in
    get)
        get_active_layer
        ;;
    get-ring)
        get_active_ring
        ;;
    set)
        if [[ -z "${2:-}" ]]; then
            echo -e "${RED}Error:${RESET} Specify layer number 0-4 (e.g., zoth-agent-layer set 2)"
            exit 1
        fi
        set_active_layer "$2"
        ;;
    ring)
        if [[ -z "${2:-}" ]]; then
            echo -e "${RED}Error:${RESET} Specify ring number 0-3 (e.g., zoth-agent-layer ring 2)"
            exit 1
        fi
        set_active_ring "$2"
        ;;
    status)
        show_status
        ;;
    lock)
        set_active_ring 3
        echo -e "${CYAN}[*] Agent locked in Sandboxed / Read-Only (Ring 3 SPECTRE) Mode.${RESET}"
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        echo "Usage: zoth-agent-layer [status|get|get-ring|set <0-4>|ring <0-3>|lock|help]"
        exit 1
        ;;
esac
