#!/usr/bin/env bash
# ==============================================================================
#  ZOTHOS Agent Permission Layer Switcher & Ring Controller
# ==============================================================================

set -euo pipefail

CONFIG_FILE="/etc/zothos/agent-permissions.json"
USER_STATE="$HOME/.config/zothos/agent-layer.state"

GREEN="\e[1;32m"
CYAN="\e[1;36m"
YELLOW="\e[1;33m"
RED="\e[1;31m"
PURPLE="\e[1;35m"
BLUE="\e[1;34m"
BOLD="\e[1m"
RESET="\e[0m"

get_active_layer() {
    if [[ -f "$USER_STATE" ]]; then
        cat "$USER_STATE"
    elif [[ -f "$CONFIG_FILE" ]] && command -v jq >/dev/null 2>&1; then
        jq -r '.active_layer // 2' "$CONFIG_FILE"
    else
        echo "2"
    fi
}

set_active_layer() {
    local target="$1"
    if [[ ! "$target" =~ ^[0-4]$ ]]; then
        echo -e "${RED}[!] Invalid layer '$target'. Must be between 0 and 4.${RESET}"
        exit 1
    fi
    mkdir -p "$(dirname "$USER_STATE")"
    echo "$target" > "$USER_STATE"
    
    local codename=""
    local title=""
    case "$target" in
        0) codename="SPECTRE"; title="Observer / Read-Only Telemetry (Cyan)" ;;
        1) codename="RUNECRAFTER"; title="User-Space Shell & Code Execution (Emerald)" ;;
        2) codename="CYBERPUPPET"; title="GUI, Mouse & Keyboard Computer Use (Blue)" ;;
        3) codename="WARLOCK"; title="Security & Offensive Arsenal (Purple)" ;;
        4) codename="SOVEREIGN"; title="Root, Kernel & Amnesic Authority (Gold)" ;;
    esac
    
    echo -e "${GREEN}[✓] ZOTHOS Agent Security Ring updated to Layer ${target}: ${BOLD}${codename}${RESET} (${title})"
    
    # Broadcast notification to desktop if graphical
    if [[ -n "${DISPLAY:-}" ]] && command -v notify-send >/dev/null 2>&1; then
        notify-send -u normal -i /usr/share/icons/Zoth-Hermetic/scalable/apps/zoth-agent.svg \
            "ZOTHOS Agent Authority: Layer $target ($codename)" \
            "$title" 2>/dev/null || true
    fi
}

show_status() {
    local active
    active=$(get_active_layer)
    echo -e "${GREEN}  ███████╗ ██████╗ ████████╗██╗  ██╗     █████╗  ██████╗ ███████╗███╗   ██╗████████╗${RESET}"
    echo -e "${GREEN}  ╚══███╔╝██╔═══██╗╚══██╔══╝██║  ██║    ██╔══██╗██╔════╝ ██╔════╝████╗  ██║╚══██╔══╝${RESET}"
    echo -e "${GREEN}    ███╔╝ ██║   ██║   ██║   ███████║    ███████║██║  ███╗█████╗  ██╔██╗ ██║   ██║   ${RESET}"
    echo -e "${GREEN}   ███╔╝  ██║   ██║   ██║   ██╔══██║    ██╔══██║██║   ██║██╔══╝  ██║╚██╗██║   ██║   ${RESET}"
    echo -e "${GREEN}  ███████╗╚██████╔╝   ██║   ██║  ██║    ██║  ██║╚██████╔╝███████╗██║ ╚████║   ██║   ${RESET}"
    echo -e "${GREEN}  ╚══════╝ ╚═════╝    ╚═╝   ╚═╝  ╚═╝    ╚═╝  ╚═╝ ╚═════╝ ╚══════╝╚═╝  ╚═══╝   ╚═╝   ${RESET}"
    echo -e "                   ${BOLD}${CYAN}AUTONOMOUS OS CONTROL PERMISSION RINGS${RESET}\n"
    
    echo -e "${BOLD}Current Active Authority Level:${RESET} ${YELLOW}Layer ${active}${RESET}\n"
    
    local layers=(
        "0|SPECTRE|Observer / Read-Only Telemetry|Metrics, logs, search, process inspection (0 mutation)"
        "1|RUNECRAFTER|User-Space Shell & Code|Execute bash/zsh, build code, git repos in user space"
        "2|CYBERPUPPET|GUI, Mouse & Keyboard Computer Use|Click, type, drag windows, visual OCR, browser automation"
        "3|WARLOCK|Offensive Security & Red Team|Nmap, Metasploit, HexStrike AI, Tor routing, MAC randomize"
        "4|SOVEREIGN|Root, Kernel & Amnesic Authority|Sudo execution, systemd services, firewall, panic RAM purge"
    )
    
    for entry in "${layers[@]}"; do
        IFS="|" read -r lnum lcode ltitle ldesc <<< "$entry"
        local prefix="  "
        local color="${CYAN}"
        if [[ "$lnum" -eq "$active" ]]; then
            prefix="${GREEN}▶ [ACTIVE]${RESET} "
            color="${BOLD}${GREEN}"
        fi
        echo -e "${prefix}${color}Layer ${lnum}: ${lcode}${RESET} - ${BOLD}${ltitle}${RESET}"
        echo -e "      ${RESET}${ldesc}"
    done
    echo ""
    echo -e "Usage: ${BOLD}zoth-agent-layer set <0-4>${RESET} or ${BOLD}zoth-agent-layer get${RESET}"
}

case "${1:-status}" in
    get)
        get_active_layer
        ;;
    set)
        if [[ -z "${2:-}" ]]; then
            echo -e "${RED}Error:${RESET} Specify layer number 0-4 (e.g., zoth-agent-layer set 2)"
            exit 1
        fi
        set_active_layer "$2"
        ;;
    status)
        show_status
        ;;
    lock)
        set_active_layer 0
        echo -e "${CYAN}[*] Agent locked in Read-Only (Layer 0 SPECTRE) Mode.${RESET}"
        ;;
    *)
        echo "Usage: zoth-agent-layer [status|get|set <0-4>|lock]"
        exit 1
        ;;
esac
