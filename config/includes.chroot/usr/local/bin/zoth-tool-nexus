GREEN = "\033[38;2;0;255;157m"
GOLD = "\033[38;2;255;215;0m"
CYAN = "\033[38;2;0;229;255m"
RED = "\033[38;2;255;0;85m"
GRAY = "\033[38;2;120;120;120m"
RESET = "\033[0m"
BOLD = "\033[1m"

def print_header():
    os.system("clear" if os.name == "posix" else "cls")
    print(f"{GREEN}{BOLD}══════════════════════════════════════════════════════════════════════════════{RESET}")
    print(f"{GOLD}{BOLD}   ⚡ ZOTHOS & NULLAI: SOVEREIGN 175+ TOOL NEXUS DISPATCHER ⚡{RESET}")
    print(f"{CYAN}   Decentralized Operating System Toolchain Matrix | Bookworm / Parrot Core{RESET}")
    print(f"{GREEN}{BOLD}══════════════════════════════════════════════════════════════════════════════{RESET}\n")

def check_tool_ready(cmd):
    first_word = cmd.split()[0] if cmd else ""
    return shutil.which(first_word) is not None

import itertools
import threading

def install_module(pkg_name):
    print(f"\n{GOLD}[MODULE INSTALLER]{RESET} Installing dependency: {CYAN}{pkg_name}{RESET}...")
    if pkg_name.startswith("npm:"):
        actual_pkg = pkg_name[4:]
        cmd = f"npm install -g {actual_pkg}"
    elif pkg_name.startswith("apt:"):
        actual_pkg = pkg_name[4:]
        cmd = f"sudo apt-get update -qq && sudo apt-get install -y {actual_pkg}"
    else:
        # Python module
        cmd = f"/opt/zothos-ai-env/bin/pip install {pkg_name} 2>/dev/null || pip3 install --break-system-packages {pkg_name}"
    
    print(f"{GRAY}Executing: {cmd}{RESET}\n")
    
    done = False
    def spinner():
        for c in itertools.cycle(['|', '/', '-', '\\']):
            if done:
                break
            sys.stdout.write(f'\r{GOLD}[WORKING]{RESET} Installing {pkg_name}... {c}')
            sys.stdout.flush()
            time.sleep(0.1)
        sys.stdout.write('\r' + ' ' * 60 + '\r')
    
    t = threading.Thread(target=spinner)
    t.start()
    
    try:
        ret = subprocess.run(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        done = True
        t.join()
        
        # Verify
        if pkg_name.startswith("npm:") or pkg_name.startswith("apt:"):
            success = ret.returncode == 0
        else:
            clean_pkg = pkg_name.replace("==", " ").replace(">=", " ").replace("<=", " ").split()[0]
            # some packages have different import names, but we try a basic check
            verify_cmd = f"python3 -c \"import {clean_pkg}\""
            verify_ret = subprocess.run(verify_cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            # just check return code, but if it fails we still might have succeeded installing
            success = ret.returncode == 0
            
        if success:
            print(f"\n{GREEN}✓ Module '{pkg_name}' successfully installed!{RESET}")
        else:
            print(f"\n{RED}✗ Failed to install '{pkg_name}' (exit {ret.returncode}){RESET}")
    except Exception as e:
        done = True
        t.join()
        print(f"\n{RED}Error: {e}{RESET}")
    input(f"\n{GRAY}Press Enter to continue...{RESET}")

def run_doctor():
    print_header()
    print(f"{GOLD}{BOLD}>>> SYSTEM HEALTH & TOOL MODULE DIAGNOSTICS <<<{RESET}\n")
    total_tools = 0
    ready_tools = 0
    missing_tools = []
    
    for d_id, data in DOMAINS.items():
        print(f"{CYAN}{BOLD}[{d_id}] {data['title']}{RESET}")
        domain_total = len(data['tools'])
        domain_ready = 0
        
        for tool_id, desc, cmd, mod in data['tools']:
            total_tools += 1
            first_word = cmd.split()[0] if cmd else ""
            is_ready = False
            
            if shutil.which(first_word):
                if mod != "none" and not mod.startswith("npm:") and not mod.startswith("apt:"):
                    clean_pkg = mod.replace("==", " ").replace(">=", " ").replace("<=", " ").split()[0]
                    verify_ret = subprocess.run(f"python3 -c \"import {clean_pkg}\"", shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    is_ready = verify_ret.returncode == 0
                else:
                    is_ready = True
                    
            if is_ready:
                ready_tools += 1
                domain_ready += 1
                status = f"{GREEN}✓ READY{RESET}"
            else:
                status = f"{RED}✗ MISSING{RESET} {GRAY}(module: {mod}){RESET}"
                missing_tools.append((tool_id, mod))
            print(f"   • {tool_id:<18} : {status}")
            
        bar_len = 30
        filled = int(bar_len * domain_ready / max(1, domain_total))
        bar = '█' * filled + '░' * (bar_len - filled)
        color = GREEN if domain_ready == domain_total else (GOLD if domain_ready > 0 else RED)
        print(f"   {color}Health: [{bar}] {domain_ready}/{domain_total}{RESET}\n")
    
    pct = (ready_tools / max(1, total_tools)) * 100
    
    if pct == 100:
        print(f"\n{GREEN}{BOLD}")
        print(r"  _   _  ______  ___  _    _____  _   _ __   __")
        print(r" | | | ||  ____|/ _ \| |  |_   _|| | | |\ \ / /")
        print(r" | |_| || |__  | |_| | |    | |  | |_| | \ V / ")
        print(r" |  _  ||  __| |  _  | |    | |  |  _  |  \ /  ")
        print(r" | | | || |____| | | | |____| |  | | | |  | |  ")
        print(r" \_| |_/\____/ \_| |_/\____/\_/  \_| |_/  \_/  ")
        print(f"{RESET}")
    elif pct > 50:
        print(f"\n{GOLD}{BOLD}")
        print(r" ______  ____  _____  ____   ___  ____  ____  ____ ")
        print(r" |  _  \| __ ||  ___||  _ \ / _ \|  _ \| __ ||  _ \\ ")
        print(r" | | | ||  __|| |_   | |_\ | |_| | | \ |  __|| | | |")
        print(r" |_| |_/\____|\___|  \____/\___/ |_| \_\____|\____/")
        print(f"{RESET}")
    else:
        print(f"\n{RED}{BOLD}")
        print(r"   ____  ____  _  _____  _  ____   ___  _      ")
        print(r"  / __/ |  _ \| ||_   _|| |/ __/  / _ \| |     ")
        print(r" / /_   | | \ | |  | |  | | /_   | |_| | |___  ")
        print(r" \____\ |_| \_\_|  |_|  |_|\____\\___/ |____|  ")
        print(f"{RESET}")

    print(f"{BOLD}Summary:{RESET} {GREEN}{ready_tools}{RESET}/{total_tools} tools ready ({pct:.1f}% operational)")
    if missing_tools:
        print(f"\n{GOLD}To install missing modules, run:{RESET} {CYAN}zoth-tool-nexus --install-modules all{RESET}")
    print(f"\n{GRAY}Press Enter to return...{RESET}")
    input()

def list_all_domains():
    print_header()
    for d_id, data in DOMAINS.items():
        ready_count = sum(1 for _, _, cmd, _ in data['tools'] if check_tool_ready(cmd))
        total_count = len(data['tools'])
        print(f" {GOLD}[{d_id.rjust(2)}]{RESET} {BOLD}{data['title']}{RESET}")
        print(f"      {GRAY}{data['description']}{RESET}")
        print(f"      {CYAN}Status:{RESET} {GREEN}{ready_count}/{total_count} Ready{RESET}\n")
    print(f"{GRAY}Enter (1-10) to browse, 'd' for Doctor, 's' to search, 'i' to install modules, 'q' to quit.{RESET}")

def view_domain(d_id):
    data = DOMAINS.get(str(d_id))
    if not data:
        print(f"{RED}Invalid domain ID: {d_id}{RESET}")
        return
    print_header()
    print(f"{GOLD}{BOLD}>>> {data['title']} <<<{RESET}")
    print(f"{GRAY}{data['description']}{RESET}\n")
    print(f"{'#':<4} {'TOOL ID':<18} {'STATUS':<10} {'DESCRIPTION'}")
    print(f"{'-'*78}")
    for idx, (tool_id, desc, cmd, mod) in enumerate(data['tools'], 1):
        is_ready = check_tool_ready(cmd)
        status_str = f"{GREEN}[READY]{RESET}" if is_ready else f"{GRAY}[INSTALL]{RESET}"
        print(f"{str(idx).rjust(2)}. {CYAN}{tool_id:<18}{RESET} {status_str:<19} {desc}")
    print(f"\n{GRAY}Enter tool # to execute, 'i <#>' to install module, 'b' to go back.{RESET}")

def execute_tool(tool_id, desc, cmd, mod):
    is_ready = check_tool_ready(cmd)
    if not is_ready and mod != "none":
        print(f"\n{GOLD}[WARNING]{RESET} Executable for '{tool_id}' is not in PATH.")
        choice = input(f"{CYAN}Would you like to install required module '{mod}' now? (y/n): {RESET}").strip().lower()
        if choice == 'y':
            install_module(mod)
            return
    
    print(f"\n{GOLD}[NEXUS]{RESET} Launching: {CYAN}{cmd}{RESET}...\n")
    try:
        subprocess.run(cmd, shell=True)
    except Exception as e:
        print(f"{RED}Execution failed: {e}{RESET}")
    input(f"\n{GRAY}Press Enter to return to Tool Nexus...{RESET}")

def search_tools(query):
    print_header()
    print(f"{GOLD}Search Results for:{RESET} '{CYAN}{query}{RESET}'\n")
    found = 0
    for d_id, data in DOMAINS.items():
        for tool_id, desc, cmd, mod in data['tools']:
            if query.lower() in tool_id.lower() or query.lower() in desc.lower():
                found += 1
                is_ready = check_tool_ready(cmd)
                status = f"{GREEN}[READY]{RESET}" if is_ready else f"{GRAY}[INSTALL]{RESET}"
                print(f" • {CYAN}{tool_id:<16}{RESET} {status} ({data['title'].split()[1]}): {desc}")
    if found == 0:
        print(f"{RED}No matching tools found.{RESET}")
    print(f"\n{GRAY}Total matches: {found}. Press Enter to continue...{RESET}")
    input()

def interactive_tui():
    while True:
        list_all_domains()
        choice = input(f"{GREEN}ZothNexus ❯ {RESET}").strip().lower()
        if choice in ['q', 'exit']:
            print(f"\n{GOLD}Exiting ZOTHOS Tool Nexus. Reality remains sovereign.{RESET}\n")
            break
        elif choice == 'd':
            run_doctor()
        elif choice == 's':
            q = input(f"{CYAN}Search query: {RESET}").strip()
            if q:
                search_tools(q)
        elif choice == 'i':
            pkg = input(f"{CYAN}Enter package or module name to install: {RESET}").strip()
            if pkg:
                install_module(pkg)
        elif choice in DOMAINS:
            while True:
                view_domain(choice)
                sub_choice = input(f"{GREEN}{DOMAINS[choice]['title'].split()[0]} ❯ {RESET}").strip().lower()
                if sub_choice in ['b', 'back']:
                    break
                elif sub_choice in ['q', 'exit']:
                    return
                elif sub_choice.startswith("i ") and sub_choice[2:].isdigit():
                    idx = int(sub_choice[2:]) - 1
                    tools = DOMAINS[choice]['tools']
                    if 0 <= idx < len(tools):
                        install_module(tools[idx][3])
                elif sub_choice.isdigit():
                    idx = int(sub_choice) - 1
                    tools = DOMAINS[choice]['tools']
                    if 0 <= idx < len(tools):
                        execute_tool(*tools[idx])
                    else:
                        print(f"{RED}Invalid selection.{RESET}")
                        time.sleep(1)

def main():
    parser = argparse.ArgumentParser(description="ZOTHOS Sovereign 175+ Tool Nexus Dispatcher")
    parser.add_argument("--list", action="store_true", help="List all registered tools across 10 domains")
    parser.add_argument("--doctor", action="store_true", help="Run full diagnostic scan on all tools & modules")
    parser.add_argument("--install-modules", type=str, help="Install modules for tool ID, domain (1-10), or 'all'")
    parser.add_argument("--domain", type=str, help="Display tools within domain (1-10)")
    parser.add_argument("--run", type=str, help="Directly run tool by ID")
    parser.add_argument("--search", type=str, help="Search tools by keyword")
    args = parser.parse_args()

    if args.doctor:
        run_doctor()
        return

    if args.install_modules:
        target = args.install_modules.strip()
        if target == "all":
            for d_id, data in DOMAINS.items():
                for tool_id, _, _, mod in data['tools']:
                    if mod != "none":
                        install_module(mod)
        else:
            for d_id, data in DOMAINS.items():
                for tool_id, _, _, mod in data['tools']:
                    if tool_id == target and mod != "none":
                        install_module(mod)
                        return
        return

    if args.list:
        for d_id, data in DOMAINS.items():
            print(f"\n=== {data['title']} ===")
            for tool_id, desc, cmd, mod in data['tools']:
                print(f"  - {tool_id:<20} : {desc}")
        return

    if args.run:
        target = args.run.strip()
        for d_id, data in DOMAINS.items():
            for tool_id, desc, cmd, mod in data['tools']:
                if tool_id == target:
                    execute_tool(tool_id, desc, cmd, mod)
                    return
        print(f"Tool '{target}' not found in registry.")
        return

    if args.search:
        search_tools(args.search)
        return

    interactive_tui()

if __name__ == "__main__":
    main()
