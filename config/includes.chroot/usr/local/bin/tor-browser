#!/usr/bin/env bash
# ==============================================================================
#  Tor Browser Launcher Wrapper
# ==============================================================================
set -euo pipefail

if command -v torbrowser-launcher >/dev/null 2>&1; then
    exec torbrowser-launcher "$@"
elif command -v tor-browser >/dev/null 2>&1; then
    exec tor-browser "$@"
else
    konsole --noclose -e bash -c "echo '[*] Tor Browser Launcher not present. Installing torbrowser-launcher...'; sudo apt-get update && sudo apt-get install -y torbrowser-launcher && exec torbrowser-launcher"
fi
