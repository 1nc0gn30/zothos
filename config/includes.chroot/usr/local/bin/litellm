#!/usr/bin/env bash
# ==============================================================================
#  LiteLLM - 2026 Universal 100+ LLM Proxy & OpenAI Gateway
# ==============================================================================

if [[ -x /opt/zothos-ai-env/bin/litellm ]]; then
    exec /opt/zothos-ai-env/bin/litellm "$@"
fi

if python3 -c "import litellm" >/dev/null 2>&1; then
    exec python3 -m litellm "$@"
fi

REAL_BIN=$(type -all litellm 2>/dev/null | grep -v "/usr/local/bin/litellm" | head -n 1 | awk '{print $NF}')
if [[ -n "$REAL_BIN" && -x "$REAL_BIN" ]]; then
    exec "$REAL_BIN" "$@"
fi

echo -e "\e[38;2;255;215;0m[[+] ZOTHOS AI]\e[0m \e[1;37mLiteLLM Gateway proxy not installed.\e[0m"
echo -e "\e[38;2;0;229;255m[*] To install LiteLLM now, run:\e[0m uv pip install \"litellm[proxy]\""
read -p "Install litellm now? (y/N): " choice
if [[ "$choice" =~ ^[Yy]$ ]]; then
    uv pip install "litellm[proxy]" || pip3 install --break-system-packages "litellm[proxy]"
    exec python3 -m litellm "$@"
fi
exit 1
