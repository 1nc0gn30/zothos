    # zoth watch / live
    p_watch = sub.add_parser("watch", aliases=["live", "monitor"], help="⚡ Real-Time Live Telemetry Stream & Watcher")
    p_watch.add_argument("--interval", "-i", type=float, default=1.0, help="Refresh interval in seconds (default: 1.0)")
    p_watch.set_defaults(func=cmd_watch)

    # zoth tui
    p_tui = sub.add_parser("tui", help="🎛️ Launch Interactive Terminal User Interface Cockpit (v3.1)")
    p_tui.set_defaults(func=cmd_tui)

    # zoth completion
    p_comp = sub.add_parser("completion", help="⚡ Generate shell autocompletion script (bash, zsh, fish)")
    p_comp.add_argument("shell", choices=["bash", "zsh", "fish"], default="bash", nargs="?")
    p_comp.set_defaults(func=cmd_completion)

    # zoth update
    p_update = sub.add_parser("update", help="🔄 Self-update Zoth Studio & refresh binaries")
    p_update.set_defaults(func=cmd_update)

    args = parser.parse_args()
    if not args.command:
        cmd_status(args)
