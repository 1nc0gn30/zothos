def get_memory_url() -> str:
    return "http://127.0.0.1:8788"

def load_all_local_memories() -> list[dict]:
    candidates = [
        MEMORY_DAEMON_DIR / "data" / "memories.json",
        CORE_APP_DIR / "public" / "data" / "memories.json"
    ]
    for c in candidates:
        if c.exists():
            try:
                data = json.loads(c.read_text(encoding="utf-8"))
                if isinstance(data, list) and data:
                    return data
            except Exception:
                pass
    return []

def cmd_memory(args):
    action = getattr(args, "mem_action", "status") or "status"
    print_banner()

    if action == "status":
        print(f"{BOLD}🧠 Zoth Neuroscience Vector Memory Matrix (:8788) Status:{RESET}\n")
        try:
            req = urllib.request.Request(f"{get_memory_url()}/v1/brain/status", headers={"User-Agent": "ZothCLI/3.2"})
            with urllib.request.urlopen(req, timeout=0.8) as resp:
                brain = json.loads(resp.read().decode("utf-8"))
                print(f"  {GREEN}● ACTIVE BIOMORPHIC MATRIX{RESET}")
                print(f"  {BOLD}Theory Architecture:{RESET}   {CYAN}{brain.get('theory', 'CLS + STDP')}{RESET}")
                print(f"  {BOLD}Total Synaptic Nodes:{RESET}  {GOLD}{brain.get('total_nodes', 0)}{RESET}")
                print(f"  {BOLD}Total Synapses:{RESET}        {GOLD}{brain.get('total_synapses', 0)}{RESET} (Density: {brain.get('synaptic_density', 1.0):.3f})")
                print(f"  {BOLD}Total Rehearsals:{RESET}      {brain.get('total_rehearsals', 0)}\n")

                print(f"{BOLD}Subsystem Distribution:{RESET}")
                for sub_key, sub_info in brain.get("subsystems", {}).items():
                    print(f"  • {BOLD}{sub_info.get('name')}:{RESET} {GOLD}{sub_info.get('count', 0)} memories{RESET} — {GRAY}{sub_info.get('role')}{RESET}")
                print()
                return 0
        except Exception as e:
            print(f"  {RED}○ Memory Daemon (:8788) Offline or Unreachable:{RESET} {e}")
            local_mems = load_all_local_memories()
            print(f"  {GRAY}Found {len(local_mems)} memories in local offline cache.{RESET}\n")

    elif action == "graph":
        print(f"{BOLD}🧠 Neuroscience Synaptic Topology Graph:{RESET}\n")
        local_mems = load_all_local_memories()
        print(f"  {PURPLE}┌─────────────────────────[ HIPPOCAMPUS (DG / CA3 / CA1) ]─────────────────────────┐{RESET}")
