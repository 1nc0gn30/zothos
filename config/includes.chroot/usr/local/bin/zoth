# ═══════════════════════════════════════════════════════════════
# 🚀 Dev Server & Lifecycle Control
# ═══════════════════════════════════════════════════════════════

def cmd_serve(args):
    port = getattr(args, "port", 8199) or 8199
    server_script = CORE_APP_DIR / "tools" / "zoth_dev_server.py"
    if server_script.exists():
        subprocess.run([sys.executable, str(server_script), str(port)])
    else:
        subprocess.run([sys.executable, "-m", "http.server", str(port), "-d", str(PUBLIC_DIR)])

def cmd_start(args):
    print_banner()
    print(f"{BOLD}Starting Zoth Studio Sovereign Workstation Suite...{RESET}\n")
    
    # 1. Start Memory Daemon (:8788) if not running
    mem_daemon = WORKSPACE_ROOT / "memory-daemon" / "memory-ui-server.py"
    if mem_daemon.exists() and not check_port(8788):
        subprocess.Popen([sys.executable, str(mem_daemon), "8788"])
        print(f"  {GREEN}✔{RESET} Zoth Memory Daemon started on port {CYAN}8788{RESET} -> {GRAY}http://127.0.0.1:8788/ui/{RESET}")

    # 2. Start Dev Server (:8199) if not running
    dev_server = CORE_APP_DIR / "tools" / "zoth_dev_server.py"
    if dev_server.exists() and not check_port(8199):
        subprocess.Popen([sys.executable, str(dev_server), "8199"])
        print(f"  {GREEN}✔{RESET} Zoth Dev Server started on port {CYAN}8199{RESET} -> {GRAY}http://127.0.0.1:8199{RESET}")

    # 3. Start Workstation Suite scripts if available
    script_path = WORKSPACE_ROOT / "start-zoth-studio.sh"
    if script_path.exists():
        subprocess.run(["bash", str(script_path)])
    print(f"\n{GREEN}All Zoth background services active!{RESET}\n")

def cmd_stop(args):
    print_banner()
    print(f"{BOLD}Stopping active Zoth servers on ports 8199, 8484, 8088, 8787, 8788, 5225, 8767...{RESET}\n")
    for port in [8199, 8484, 8088, 8787, 8788, 5225, 8767]:
        try:
            out = subprocess.check_output(["lsof", "-ti", f":{port}"], text=True).strip()
            if out:
                pids = out.split()
                for pid in pids:
                    os.kill(int(pid), signal.SIGTERM)
                print(f"  {GREEN}✔ Port {port} freed (killed PID(s): {', '.join(pids)}){RESET}")
        except Exception:
            print(f"  {GRAY}○ Port {port} is idle.{RESET}")
    print(f"\n{GREEN}All Zoth servers stopped cleanly.{RESET}\n")

# ═══════════════════════════════════════════════════════════════
# 🔄 Sovereign Self-Updater
# ═══════════════════════════════════════════════════════════════

def find_git_root() -> Optional[Path]:
    candidates = [CORE_APP_DIR, WORKSPACE_ROOT]
    for c in candidates:
        if (c / ".git").exists():
            return c
    try:
        res = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=str(CORE_APP_DIR), capture_output=True, text=True)
        if res.returncode == 0 and res.stdout.strip():
            return Path(res.stdout.strip())
    except Exception:
        pass
    return None

def sync_binaries(git_root: Path):
    zoth_bin = CORE_APP_DIR / "bin" / "zoth"
    if zoth_bin.exists():
        try:
            zoth_bin.chmod(zoth_bin.stat().st_mode | 0o755)
        except Exception:
            pass
        if os.name != "nt":
            local_bin = Path.home() / ".local" / "bin"
            try:
                local_bin.mkdir(parents=True, exist_ok=True)
                target = local_bin / "zoth"
                if target.is_symlink() or target.exists():
                    target.unlink()
                target.symlink_to(zoth_bin)
                print(f"  {GREEN}✔{RESET} CLI symlink synced: {CYAN}{target}{RESET} -> {GRAY}{zoth_bin}{RESET}")
            except Exception as e:
                print(f"  {GOLD}⚠ Warning syncing symlink: {e}{RESET}")

def cmd_update(args):
    print_banner()
    print(f"{BOLD}Zoth Studio Sovereign Self-Updater{RESET}\n")
    git_root = find_git_root()
    if not git_root:
        print(f"{RED}Error: Git root not found.{RESET}\n")
        return 1
    sync_binaries(git_root)
    print(f"  {GREEN}✔ Zoth Studio Binaries & Symlinks Refreshed!{RESET}\n")

