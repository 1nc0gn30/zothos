def get_server_status() -> dict[str, Any]:
    status = {}
    for s in SERVER_MATRIX:
        is_up = check_port(s["port"])
        status[s["id"]] = {
            **s,
            "up": is_up
        }
    return status

def cmd_status(args):
    print_banner()
    print(f"{BOLD}Runtime Server Matrix & Sovereign Ports:{RESET}\n")
    statuses = get_server_status()
    for key, info in statuses.items():
        state_badge = f"{GREEN}● ACTIVE {RESET}" if info["up"] else f"{RED}○ OFFLINE{RESET}"
        print(f"  {state_badge}  {BOLD}{info['name']}{RESET}")
        print(f"       Port: {CYAN}{info['port']}{RESET}  │  URL: {GRAY}{info['url']}{RESET}")
        print(f"       {GRAY}↳ {info['desc']}{RESET}\n")

    # Check Vector Memory Nodes if active
    if statuses["memory"]["up"]:
        try:
            req = urllib.request.Request("http://127.0.0.1:8788/v1/brain/status", headers={"User-Agent": "ZothCLI/3.2"})
            with urllib.request.urlopen(req, timeout=0.6) as resp:
                brain = json.loads(resp.read().decode("utf-8"))
                nodes = brain.get("total_nodes", 0)
                synapses = brain.get("total_synapses", 0)
                print(f"  {PURPLE}🧠 Vector Memory Matrix Online:{RESET} {nodes} nodes · {synapses} synapses (Biomorphic CLS + STDP active)")
        except Exception:
            pass

    # Check Tool Registry if orchestrator is active
    if statuses["orchestrator"]["up"]:
        try:
            req = urllib.request.Request("http://127.0.0.1:8484/api/tools", headers={"User-Agent": "ZothCLI/3.2"})
            with urllib.request.urlopen(req, timeout=0.6) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                tool_count = data.get("tool_count", len(data.get("tools", [])))
                print(f"  {GOLD}⚡ Tool Registry Connected:{RESET} {tool_count} sovereign tools online.")
        except Exception:
            pass

    # Active Mascot Spirit
    active_spirit = get_active_spirit()
    print(f"  {GOLD}🐾 Active Companion:{RESET} {active_spirit['emoji']} {BOLD}{active_spirit['name']}{RESET} ({active_spirit['archetype']})\n")

