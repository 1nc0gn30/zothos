def calculate_tsubuyaki_point(pid: str, i: int, t_val: float) -> Tuple[float, float, float]:
    """Calculate (px, py, intensity/color_factor) for all 12 formulas."""
    p_lower = pid.lower()
    if p_lower == "v1":
        y = i / 289.0
        k = (4.0 + math.cos(y)) * math.cos(i / 7.0)
        e = y / 5.0 - 11.0
        d = math.hypot(k, e) - 6.0
        q = 99.0 + 3.0 * math.sin(9.0 / (k if abs(k) > 1e-4 else 1e-4)) + (y / 23.0) * k * (e + math.sin(-d * 4.0))
        c = d / 4.0 - t_val / 4.0 + (i % 2) * 9.0 + math.sin(t_val * 3.0 + e) / 9.0
        return q * math.sin(c), q * math.cos(c), d
    elif p_lower == "v2":
        y = i / 798.0
        k = (4.0 + math.cos(y)) * math.cos(i / 7.0)
        e = y / 5.0 - 11.0
        d = math.hypot(k, e) - 6.0
        c = d / 4.0 - t_val / 4.0 + (i % 6) * 9.0
        px = (79.0 + k * k) * math.sin(c)
        py = 119.0 * math.sin(c / 2.0) + (d**3 / 9.0) * math.sin(t_val * 3.0 - d / 0.7) + (y / 23.0) * k * (e + math.sin(e * 4.0 - d * 4.0))
        return px, py, d
    elif p_lower == "v4":
        y = i / 550.0
        k = math.sin(y) * math.cos(i / 9.0) * 6.0
        e = y / 4.0 - 8.0
        d = math.hypot(k, e) - 4.0
        c = d / 3.0 - t_val / 3.0 + (i % 4) * 8.0
        px = (85.0 + k * k * 2.0) * math.sin(c)
        py = 105.0 * math.cos(c / 2.0) + d * d * math.cos(t_val * 3.0 - d) + math.sin(y / 7.0) * k * (e + math.sin(e * 3.0 - d * 3.0))
        return px, py, d
    elif p_lower == "v5":
        y = i / 318.0
        r = math.cos(y * 3.0 + t_val) * 90.0 + 99.0
        p = y + t_val
        return r * math.sin(p) * math.cos(y), r * math.cos(p) * math.sin(y * 2.0), r
    elif p_lower == "v6":
        y = i / 440.0
        p = y * 5.0 + t_val
        cos_val = max(-1.0, min(1.0, math.cos(p * 3.0)))
        r = math.cos(5.0 - math.acos(cos_val)) * 99.0
        px = r * math.sin(p) * math.sin(y)
        py = r * math.cos(p) * math.cos(y) + math.sin(p * 2.0) * 40.0
        return px, py, r
    elif p_lower == "v7":
        y = i / 500.0
        u = y * 4.0 + t_val
        r = math.sqrt(abs(math.cos(u * 2.0) + math.sin(t_val) * 0.5)) * 140.0 + math.sin(u * 7.0) * 20.0
        return r * math.cos(y), r * math.sin(y), r
    elif p_lower == "v8":
        x = (i % 160) - 80
        z = (i // 160) - 80
        d = math.hypot(x, z) + 1e-4
        return x * 2.2 + math.sin(d / 9.0 - t_val * 2.0) * 20.0, z * 2.2 + math.cos(d / 9.0 - t_val * 2.0) * 20.0, d
    elif p_lower == "v9":
        y = i / 500.0
        k = math.sin(y * 7.0 + t_val) * math.cos(y * 5.0 - t_val) * 120.0
        p = y + math.sin(t_val + y) * 2.0
        px = (90.0 + k) * math.sin(p * 3.0)
        py = (90.0 + k) * math.cos(p * 2.0) + math.sin(y * 11.0) * 20.0
        return px, py, k
    elif p_lower == "v10":
        a_param = 1.4 + math.sin(t_val) * 0.2
        b_param = -2.3
        c_param = 2.4
        d_param = -2.1
        theta = (i % 500) * 0.05
        nx = math.sin(theta)
        ny = math.cos(theta)
        for _ in range(3):
            nx_next = math.sin(a_param * ny) + c_param * math.cos(a_param * nx)
            ny_next = math.sin(b_param * nx) + d_param * math.cos(b_param * ny)
            nx, ny = nx_next, ny_next
        return nx * 75.0, ny * 75.0, nx * ny
    elif p_lower == "v11":
        y = i / 10.0
        r = (1.0008 ** y) * math.sin(y / 13.0 + t_val) * 160.0
        p = y / 2.3999632 + t_val
        return r * math.sin(p), r * math.cos(p), r
    elif p_lower == "v12":
        r = math.sqrt(i) * 2.2
        p = i * 2.3999632 + math.sin(t_val + r / 20.0)
        return r * math.cos(p) * (1.0 + math.sin(t_val * 2.0 + r / 10.0) * 0.2), r * math.sin(p) * (1.0 + math.cos(t_val * 2.0 + r / 10.0) * 0.2), r
    else: # v3 default
        y = i / 663.0
        k = (4.0 + math.cos(y)) * math.cos(i)
        e = y / 5.0 - 11.0
        d = math.hypot(k, e) - 5.0
        c = d / 2.5 - t_val / 2.0 + (i % 2) * 8.0
        px = (79.0 + k * k) * math.cos(c)
        py = 99.0 * math.sin(c / 3.0) + d * d * math.sin(t_val * 2.0 - d) + math.sin(y / 9.0 + 6.0) * k * (e + math.sin(e * 4.0 - d * 4.0))
        return px, py, d

def cmd_tsubuyaki(args):
    action = getattr(args, "tsu_action", "list") or "list"
    
    if action == "list":
        print_banner()
        print(f"{BOLD}🪐 #つぶやきProcessing Harmonic Topology Catalog (12 Formulas):{RESET}\n")
        print(f"  {GRAY}{'ID':<6} {'CATEGORY':<12} {'NAME':<36} {'SIZE':<8} {'STATUS'}{RESET}")
        print(f"  {GRAY}{'─'*6} {'─'*12} {'─'*36} {'─'*8} {'─'*10}{RESET}")
        for p in TSUBUYAKI_PRESETS:
            print(f"  {CYAN}{p['id']:<6}{RESET} {GOLD}{p['category']:<12}{RESET} {BOLD}{p['name']:<36}{RESET} {GREEN}{p['size']:<8}{RESET} {GRAY}✓ 280B Valid{RESET}")
        print(f"\n{GRAY}Usage: zoth tsubuyaki show <id> | zoth tsubuyaki render <id> | zoth tsubuyaki copy <id> | zoth tsubuyaki web{RESET}\n")

    elif action == "show":
        pid = getattr(args, "preset_id", "v1") or "v1"
        p = next((item for item in TSUBUYAKI_PRESETS if item["id"] == pid.lower()), None)
        if not p:
            print(f"{RED}Error: Preset '{pid}' not found. Run 'zoth tsubuyaki list' for options.{RESET}")
            return 1
        print_banner()
        print(f"{GOLD}🪐 Preset [{p['id'].upper()}]: {BOLD}{p['name']}{RESET} ({CYAN}{p['size']}{RESET} · {p['category']})\n")
        print(f"{BOLD}Summary:{RESET} {p['desc']}\n")
        print(f"{BOLD}Trigonometric Carrier Formula:{RESET}\n  {GREEN}{p['formula']}{RESET}\n")
        print(f"{BOLD}Raw #つぶやきProcessing Code (280-Byte Golfed):{RESET}")
        print(f"{CYAN}────────────────────────────────────────────────────────────────────────{RESET}")
        print(p["code"])
        print(f"{CYAN}────────────────────────────────────────────────────────────────────────{RESET}\n")

    elif action == "copy":
        pid = getattr(args, "preset_id", "v1") or "v1"
        p = next((item for item in TSUBUYAKI_PRESETS if item["id"] == pid.lower()), None)
        if not p:
            print(f"{RED}Error: Preset '{pid}' not found.{RESET}")
            return 1
        
        copied = False
        for cmd in [["xclip", "-selection", "clipboard"], ["wl-copy"], ["pbcopy"], ["xsel", "--clipboard", "--input"]]:
            if shutil.which(cmd[0]):
                try:
                    proc = subprocess.Popen(cmd, stdin=subprocess.PIPE)
                    proc.communicate(p["code"].encode("utf-8"))
                    copied = True
                    break
                except Exception:
                    pass
        if copied:
            print(f"{GREEN}✔ Preset [{p['id']}] code ({p['size']}) copied to system clipboard!{RESET}")
        else:
            print(f"{GOLD}Code for [{p['id']}]:{RESET}\n{p['code']}")

    elif action == "render":
        pid = getattr(args, "preset_id", "v3") or "v3"
        
        # Interactive full-curses or standard terminal renderer
        try:
            import curses
            def _render_curses(stdscr):
                curses.curs_set(0)
                stdscr.nodelay(True)
                stdscr.timeout(40)
                if curses.has_colors():
                    curses.start_color()
                    curses.use_default_colors()
                    curses.init_pair(1, curses.COLOR_CYAN, -1)
                    curses.init_pair(2, curses.COLOR_YELLOW, -1)
                    curses.init_pair(3, curses.COLOR_GREEN, -1)
                    curses.init_pair(4, curses.COLOR_MAGENTA, -1)
                    curses.init_pair(5, curses.COLOR_RED, -1)
                    curses.init_pair(6, curses.COLOR_WHITE, -1)

                palettes = [
                    (1, 4, 2, 3), # Cyan, Purple, Gold, Green
                    (3, 3, 3, 3), # Matrix Green
                    (2, 2, 5, 2), # Solar Gold & Red
                    (1, 7 if curses.COLORS > 7 else 1, 4, 6), # Neon Cyan & White
                ]
                pal_idx = 0
                preset_list = [p["id"] for p in TSUBUYAKI_PRESETS]
                cur_idx = 0
                for idx, p in enumerate(TSUBUYAKI_PRESETS):
                    if p["id"] == pid.lower():
                        cur_idx = idx
                        break

                t_val = 0.0
                speed = 0.08
                paused = False

                while True:
                    ch = stdscr.getch()
                    if ch in [ord('q'), ord('Q'), 27]:
                        break
                    elif ch in [ord(' '), ord('p'), ord('P')]:
                        paused = not paused
                    elif ch in [ord('+'), ord('=')]:
                        speed = min(0.3, speed + 0.02)
                    elif ch in [ord('-'), ord('_')]:
                        speed = max(0.01, speed - 0.02)
                    elif ch in [ord('c'), ord('C')]:
                        pal_idx = (pal_idx + 1) % len(palettes)
                    elif ch in [curses.KEY_RIGHT, curses.KEY_DOWN, ord('n')]:
                        cur_idx = (cur_idx + 1) % len(preset_list)
                    elif ch in [curses.KEY_LEFT, curses.KEY_UP, ord('b')]:
                        cur_idx = (cur_idx - 1) % len(preset_list)
                    elif ord('1') <= ch <= ord('9'):
                        tgt = ch - ord('1')
                        if tgt < len(preset_list):
                            cur_idx = tgt
                    elif ch == ord('0'):
                        cur_idx = 9
                    elif ch == ord('-'):
                        cur_idx = 10
                    elif ch == ord('='):
                        cur_idx = 11

                    p_cur = TSUBUYAKI_PRESETS[cur_idx]
                    h, w = stdscr.getmaxyx()
                    if h < 10 or w < 30:
                        continue

                    stdscr.erase()
                    render_w = min(w - 2, 90)
                    render_h = min(h - 4, 32)
                    start_x = max(1, (w - render_w) // 2)
                    start_y = 2

                    cur_pal = palettes[pal_idx]

                    if not paused:
                        t_val += speed

                    # Header
                    hdr = f" 🪐 [{p_cur['id'].upper()}]: {p_cur['name']} │ dt={t_val:.2f} │ Speed: {speed*1000/80:.1f}x "
                    safe_addstr(stdscr, 0, max(0, (w - len(hdr)) // 2), hdr, curses.color_pair(2) | curses.A_BOLD)

                    # Compute & Draw Points
                    num_pts = min(2200, render_w * render_h)
                    for i in range(num_pts):
                        px, py, factor = calculate_tsubuyaki_point(p_cur["id"], i, t_val)
                        col = int((px + 170) / 340.0 * (render_w - 1))
                        row = int((py + 170) / 340.0 * (render_h - 1))
                        if 0 <= col < render_w and 0 <= row < render_h:
                            c_char = "✦" if i % 8 == 0 else ("*" if i % 4 == 0 else ("·" if i % 2 == 0 else "."))
                            c_color = cur_pal[0] if i % 8 == 0 else (cur_pal[1] if i % 4 == 0 else (cur_pal[2] if i % 2 == 0 else cur_pal[3]))
                            safe_addstr(stdscr, start_y + row, start_x + col, c_char, curses.color_pair(c_color) | curses.A_BOLD)

                    # Footer
                    ftr = " [1-9/0: Preset | ▲/▼: Swap | +/-: Speed | c: Colors | SPACE: Pause | q: Exit] "
                    safe_addstr(stdscr, h - 1, max(0, (w - len(ftr)) // 2), ftr, curses.color_pair(1) | curses.A_REVERSE)
                    stdscr.refresh()
                    time.sleep(0.035)

            curses.wrapper(_render_curses)
        except Exception:
            # Fallback simple stdout stream
            p = next((item for item in TSUBUYAKI_PRESETS if item["id"] == pid.lower()), TSUBUYAKI_PRESETS[2])
            print(f"\n{BOLD}Rendering ASCII Topology [{p['name']}] (Ctrl+C to exit)...{RESET}\n")
            time.sleep(0.3)
            width, height = 70, 26
            t_val = 0.0
            cur_pid = p["id"]
            try:
                while True:
                    grid = [[' ' for _ in range(width)] for _ in range(height)]
                    for i in range(2400):
                        px, py, factor = calculate_tsubuyaki_point(cur_pid, i, t_val)
                        col = int((px + 170) / 340.0 * (width - 1))
                        row = int((py + 170) / 340.0 * (height - 1))
                        if 0 <= col < width and 0 <= row < height:
                            if i % 8 == 0:
                                grid[row][col] = f"{CYAN}✦{RESET}"
                            elif i % 4 == 0:
                                grid[row][col] = f"{PURPLE}* {RESET}"
                            elif i % 2 == 0:
                                grid[row][col] = f"{GOLD}·{RESET}"
                            else:
                                grid[row][col] = f"{GREEN}.{RESET}"

                    sys.stdout.write("\033[H\033[J")
                    sys.stdout.write(f"{BOLD}🪐 Topology [{cur_pid.upper()}]: {p['name']}{RESET} {GRAY}[dt={t_val:.2f} | 60 FPS]{RESET}\n")
                    sys.stdout.write("\n".join("".join(r) for r in grid) + "\n")
                    sys.stdout.write(f"{GRAY}[Press Ctrl+C to return to terminal]{RESET}\n")
                    sys.stdout.flush()
                    t_val += 0.08
                    time.sleep(0.04)
            except KeyboardInterrupt:
                print(f"\n{GREEN}ASCII rendering stopped.{RESET}\n")

    elif action == "web":
        url = "http://127.0.0.1:8199/showcase/tsubuyaki-vortex.html"
        print(f"{BOLD}Launching Harmonic Topology Studio in browser...{RESET}")
        print(f"URL: {CYAN}{url}{RESET}")
        open_url(url)

