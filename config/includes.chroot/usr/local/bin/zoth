def cmd_comic(args):
    action = getattr(args, "comic_action", "list") or "list"
    
    if action == "list":
        print_banner()
        print(f"{BOLD}📖 AZOTH: The Zero-Leakage Saga — Comic Series Catalog:{RESET}\n")
        print(f"  {GRAY}{'EPISODE':<10} {'TITLE':<42} {'PAGES':<8} {'STATUS'}{RESET}")
        print(f"  {GRAY}{'─'*10} {'─'*42} {'─'*8} {'─'*12}{RESET}")
        for ep in COMIC_EPISODES:
            st_color = GREEN if ep["status"] == "RELEASED" else GOLD
            print(f"  {CYAN}{ep['id'].upper():<10}{RESET} {BOLD}{ep['title']:<42}{RESET} {GRAY}{ep['pages']} pgs{RESET}   {st_color}{ep['status']}{RESET}")
            print(f"             {GRAY}↳ {ep['synopsis']}{RESET}\n")
        print(f"{GRAY}Usage: zoth comic read <episode_id> | zoth comic play <episode_id>{RESET}\n")
    
    elif action == "read":
        ep_id = getattr(args, "episode_id", "s01e01") or "s01e01"
        url = f"http://127.0.0.1:8199/comic/{ep_id.lower()}.html"
        print(f"{BOLD}Opening AZOTH Comic [{ep_id.upper()}] in browser...{RESET}")
        print(f"URL: {CYAN}{url}{RESET}")
        open_url(url)

    elif action == "play":
        ep_id = getattr(args, "episode_id", "s01e01") or "s01e01"
        ep = next((e for e in COMIC_EPISODES if e["id"] == ep_id.lower()), None)
        if not ep:
            print(f"{RED}Error: Episode '{ep_id}' not found.{RESET}")
            return 1
        
        audio_path = PUBLIC_DIR / ep["audio"].lstrip("/")
        if audio_path.exists():
            print(f"\n{BOLD}Playing Audio Narration for {ep['title']}...{RESET}\n")
            for player in ["ffplay", "mpv", "aplay", "cvlc"]:
                if shutil.which(player):
                    if player == "ffplay":
                        subprocess.run(["ffplay", "-nodisp", "-autoexit", str(audio_path)])
                    else:
                        subprocess.run([player, str(audio_path)])
                    return 0
            print(f"{GRAY}Audio file located at: {audio_path}{RESET}")
        else:
            print(f"{RED}Audio narration file not found: {audio_path}{RESET}")

