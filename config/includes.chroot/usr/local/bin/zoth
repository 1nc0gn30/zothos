def cmd_speed(args):
    action = getattr(args, "speed_action", "audit") or "audit"
    print_banner()
    
    if action == "audit":
        print(f"{BOLD}🔍 Running Asset Integrity & Speed Audit across HTML Pages...{RESET}\n")
        html_files = []
        for root, dirs, files in os.walk(PUBLIC_DIR):
            if any(ignore in root for ignore in ['templates-source', 'node_modules', 'dist', '.git', 'open-source-library', 'workspaces']):
                continue
            for f in files:
                if f.endswith('.html'):
                    html_files.append(os.path.join(root, f))
        
        missing_count = 0
        total_refs = 0
        for html_path in html_files:
            rel_html = os.path.relpath(html_path, PUBLIC_DIR)
            with open(html_path, 'r', encoding='utf-8', errors='ignore') as fp:
                content = fp.read()
            urls = re.findall(r'(?:src|href|poster)=["\']([^"\']+)["\']', content)
            for url in urls:
                if url.startswith(('http://', 'https://', '//', 'data:', 'javascript:', 'mailto:', '#', 'tel:')):
                    continue
                clean_url = url.split('?')[0].split('#')[0]
                if not clean_url or '${' in clean_url or '{{' in clean_url:
                    continue
                total_refs += 1
                if clean_url.startswith('/'):
                    target = os.path.join(PUBLIC_DIR, clean_url.lstrip('/'))
                else:
                    target = os.path.join(os.path.dirname(html_path), clean_url)
                target = os.path.normpath(target)
                if not os.path.exists(target):
                    if os.path.exists(target + '.html') or os.path.exists(os.path.join(target, 'index.html')):
                        continue
                    if "about:blank" not in clean_url:
                        missing_count += 1
                        print(f"  {RED}✖ Missing:{RESET} [{rel_html}] -> {url}")
        
        if missing_count == 0:
            print(f"  {GREEN}✔ 100% Asset Integrity:{RESET} {len(html_files)} HTML pages and {total_refs} asset paths verified with 0 broken links.\n")
        else:
            print(f"\n  {RED}Found {missing_count} broken asset references.{RESET}\n")

    elif action == "bench":
        print(f"{BOLD}⚡ Measuring Local Server Response Times & Latency...{RESET}\n")
        endpoints = [
            ("/", "Studio Hub Root"),
            ("/showcase.html", "Showcase Omniverse"),
            ("/showcase/tsubuyaki-vortex.html", "Harmonic Topology Studio"),
            ("/comic/index.html", "AZOTH Anime Comic Reader"),
            ("/assets/zoth-speed-engine.js", "Speed & Prefetch Engine"),
            ("/sw.js", "Offline Service Worker"),
            ("/assets/vendor/p5.min.js", "Local p5.js Vendor Bundle"),
            ("/assets/vendor/three.min.js", "Local Three.js Bundle"),
        ]
        port = getattr(args, "port", 8199) or 8199
        print(f"  {GRAY}{'ENDPOINT':<38} {'ROUTE':<26} {'STATUS':<10} {'LATENCY'}{RESET}")
        print(f"  {GRAY}{'─'*38} {'─'*26} {'─'*10} {'─'*10}{RESET}")
        for route, label in endpoints:
            url = f"http://127.0.0.1:{port}{route}"
            t0 = time.perf_counter()
            try:
                req = urllib.request.urlopen(url, timeout=2.0)
                elapsed_ms = (time.perf_counter() - t0) * 1000.0
                print(f"  {BOLD}{label:<38}{RESET} {CYAN}{route:<26}{RESET} {GREEN}200 OK{RESET}     {GOLD}{elapsed_ms:.1f} ms{RESET}")
            except Exception as e:
                print(f"  {BOLD}{label:<38}{RESET} {CYAN}{route:<26}{RESET} {RED}FAIL{RESET}       {GRAY}{e}{RESET}")
        print()

