def get_pet_sprite_frame(pet_id: str, tick: int) -> list[str]:
    frames = ANIMATED_PET_SPRITES.get(pet_id.lower())
    if not frames:
        clean = pet_id.replace("-", "_")
        frames = ANIMATED_PET_SPRITES.get(clean)
    if not frames:
        return [
            r"    /\___/\    ",
            r"   (  o.o  )   ",
            r"    >  ^  <    ",
            f"   [{pet_id.upper()[:8]}]   "
        ]
    idx = (tick // 2) % len(frames)
    return frames[idx]

