# ═══════════════════════════════════════════════════════════════
# 🎛️ Terminal User Interface (TUI v3.1) Cockpit
# ═══════════════════════════════════════════════════════════════

def safe_addstr(win, y: int, x: int, text: str, attr: int = 0):
    try:
        h, w = win.getmaxyx()
        if 0 <= y < h and 0 <= x < w:
            max_len = w - x - 1
            if max_len > 0:
                win.addstr(y, x, text[:max_len], attr)
    except curses.error:
        pass

def run_tui(stdscr):
    curses.curs_set(0)
    stdscr.nodelay(True)
    stdscr.timeout(500)

    if curses.has_colors():
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_CYAN, -1)
        curses.init_pair(2, curses.COLOR_YELLOW, -1)
        curses.init_pair(3, curses.COLOR_GREEN, -1)
        curses.init_pair(4, curses.COLOR_MAGENTA, -1)
        curses.init_pair(5, curses.COLOR_RED, -1)
        curses.init_pair(6, curses.COLOR_WHITE, -1)

    menu_items = [
        "📊 Dashboard & Matrix",
        "🐾 Mascot Spirits & Pet Dex",
        "🪐 #つぶやきProcessing",
        "📖 AZOTH Manga Comic",
        "🧠 Vector Memory Matrix",
        "💬 SimpleX Comms Bridge",
        "🛠️ Sovereign Tools",
        "🩺 16-Point Diagnostics",
        "🔄 Restart Servers",
        "Quit (q)"
    ]
    selected_menu = 0
    tick_counter = 0

    while True:
        try:
            stdscr.erase()
            h, w = stdscr.getmaxyx()
            if h < 12 or w < 50:
                safe_addstr(stdscr, 1, 2, "Window too small for Zoth TUI (Min 50x12)", curses.A_BOLD)
                stdscr.refresh()
                time.sleep(0.2)
                ch = stdscr.getch()
                if ch in [ord('q'), 27]:
                    break
                continue

            # Header
            title = " ⚡ ZOTH STUDIO SOVEREIGN COMMAND COCKPIT (v3.1) ⚡ "
            safe_addstr(stdscr, 0, max(0, (w - len(title)) // 2), title, curses.color_pair(2) | curses.A_BOLD)
            safe_addstr(stdscr, 1, 2, "─" * max(1, w - 4), curses.color_pair(1) | curses.A_DIM)

            # Left Menu
            safe_addstr(stdscr, 3, 3, "COMMAND MENU", curses.color_pair(2) | curses.A_BOLD)
            for i, item in enumerate(menu_items):
                y = 5 + (i * 2)
                if y < h - 2:
                    if i == selected_menu:
                        safe_addstr(stdscr, y, 3, f" ▶ {item} ", curses.color_pair(2) | curses.A_REVERSE | curses.A_BOLD)
                    else:
                        safe_addstr(stdscr, y, 3, f"   {item}", curses.color_pair(6))

            # Vertical divider
            for y in range(2, h - 1):
                safe_addstr(stdscr, y, 30, "│", curses.color_pair(1) | curses.A_DIM)

            content_x = 33
            content_w = max(10, w - content_x - 2)

            # Dynamic Content
            if selected_menu == 0:
                # Dashboard
                safe_addstr(stdscr, 3, content_x, "SYSTEM TELEMETRY & RUNTIME PORTS", curses.color_pair(1) | curses.A_BOLD)
                statuses = get_server_status()
                y_off = 5
                for s_key, info in statuses.items():
                    if y_off >= h - 4:
                        break
                    is_up = info["up"]
                    color = curses.color_pair(3) if is_up else curses.color_pair(5)
                    st_txt = "[ONLINE] " if is_up else "[OFFLINE]"
                    safe_addstr(stdscr, y_off, content_x, st_txt, color | curses.A_BOLD)
                    safe_addstr(stdscr, y_off, content_x + 11, f"{info['name']} (:{info['port']})", curses.color_pair(6) | curses.A_BOLD)
                    y_off += 2

            elif selected_menu == 1:
                # Pet Dex
                active_s = get_active_spirit()
                safe_addstr(stdscr, 3, content_x, f"🐾 24 SOVEREIGN SPIRITS — ACTIVE: {active_s['name'].upper()}", curses.color_pair(2) | curses.A_BOLD)
                sprite = get_pet_sprite_frame(active_s["id"], tick_counter)
                for s_i, s_line in enumerate(sprite):
                    if 5 + s_i < h - 4:
                        safe_addstr(stdscr, 5 + s_i, content_x, s_line, curses.color_pair(2) | curses.A_BOLD)
                safe_addstr(stdscr, 12, content_x, f"Domain:    {active_s['domain']} │ Element: {active_s['element']}", curses.color_pair(1))
                safe_addstr(stdscr, 13, content_x, f"Soul Lore: {active_s['lore'][:content_w-10]}", curses.color_pair(6))
                safe_addstr(stdscr, 15, content_x, f"Dialogue:  \"{active_s['quote'][:content_w-10]}\"", curses.color_pair(2) | curses.A_BOLD)

            elif selected_menu == 2:
                # Tsubuyaki
                safe_addstr(stdscr, 3, content_x, "🪐 #つぶやきProcessing TOPOLOGY LAB", curses.color_pair(2) | curses.A_BOLD)
                for p_idx, p in enumerate(TSUBUYAKI_PRESETS[:7]):
                    y = 5 + (p_idx * 2)
                    if y < h - 2:
                        safe_addstr(stdscr, y, content_x, f"[{p['id']}] {p['name']} ({p['size']})", curses.color_pair(1) | curses.A_BOLD)
                        safe_addstr(stdscr, y + 1, content_x + 4, f"↳ {p['desc'][:content_w-10]}", curses.color_pair(6) | curses.A_DIM)

            elif selected_menu == 3:
                # Comic
                safe_addstr(stdscr, 3, content_x, "📖 AZOTH: THE ZERO-LEAKAGE SAGA COMIC", curses.color_pair(2) | curses.A_BOLD)
                for ep_idx, ep in enumerate(COMIC_EPISODES):
                    y = 5 + (ep_idx * 3)
                    if y < h - 2:
                        safe_addstr(stdscr, y, content_x, f"[{ep['id'].upper()}] {ep['title']}", curses.color_pair(2) | curses.A_BOLD)
                        safe_addstr(stdscr, y + 1, content_x + 4, f"↳ {ep['synopsis'][:content_w-10]}", curses.color_pair(6))

            elif selected_menu == 4:
                # Memory
                safe_addstr(stdscr, 3, content_x, "🧠 VECTOR MEMORY MATRIX (:8788)", curses.color_pair(4) | curses.A_BOLD)
                safe_addstr(stdscr, 5, content_x, "Neuroscience Subsystems: Hippocampus (DG/CA3/CA1), dlPFC, Neocortex", curses.color_pair(6))
                safe_addstr(stdscr, 7, content_x, "Synaptic Weight Plasticity: Hebbian STDP Active", curses.color_pair(3) | curses.A_BOLD)
                safe_addstr(stdscr, 9, content_x, "Press [m] to launch 3D Volumetric Memory Maze", curses.color_pair(1) | curses.A_BOLD)

            elif selected_menu == 5:
                # SimpleX
                safe_addstr(stdscr, 3, content_x, "💬 SIMPLEX SOVEREIGN POST-QUANTUM COMMS", curses.color_pair(1) | curses.A_BOLD)
                safe_addstr(stdscr, 5, content_x, "Double-Ratchet Post-Quantum Socket Daemon (:5225)", curses.color_pair(6))
                safe_addstr(stdscr, 7, content_x, "Local Web Bridge API Proxy (:8767)", curses.color_pair(6))
                safe_addstr(stdscr, 9, content_x, "Press [c] to launch Secure Messaging Console", curses.color_pair(2) | curses.A_BOLD)

            elif selected_menu == 6:
                # Tools
                safe_addstr(stdscr, 3, content_x, "🛠️ SOVEREIGN TOOL SUITE & AUTOMATION", curses.color_pair(2) | curses.A_BOLD)
                safe_addstr(stdscr, 5, content_x, "36 Sovereign CLI & AST Tools registered in local orchestrator", curses.color_pair(6))
                safe_addstr(stdscr, 7, content_x, "Run 'zoth tool list' or 'zoth tool run <tool>' for full execution pipeline", curses.color_pair(1))

            elif selected_menu == 7:
                # Doctor
                safe_addstr(stdscr, 3, content_x, "🩺 16-POINT SYSTEM DIAGNOSTICS", curses.color_pair(3) | curses.A_BOLD)
                safe_addstr(stdscr, 5, content_x, f"Python: {sys.version.split()[0]} │ Git: Ready │ Rust: Ready", curses.color_pair(6))
                safe_addstr(stdscr, 7, content_x, "Loopback Port Matrix: 8/8 Online", curses.color_pair(3) | curses.A_BOLD)
                safe_addstr(stdscr, 9, content_x, "Run 'zoth doctor' in terminal for full trace report", curses.color_pair(1))

            elif selected_menu == 8:
                # Restart
                safe_addstr(stdscr, 3, content_x, "RESTART LOCAL SERVER CLUSTER", curses.color_pair(2) | curses.A_BOLD)
                safe_addstr(stdscr, 5, content_x, "Press [ENTER] to restart :8199, :8484, :8088, :8788", curses.color_pair(6))

            # Footer
            footer = " [▲/▼] Navigate  |  [ENTER] Execute  |  [q] Exit TUI "
            safe_addstr(stdscr, h - 1, max(0, (w - len(footer)) // 2), footer, curses.color_pair(1) | curses.A_REVERSE)

            stdscr.refresh()

            tick_counter += 1
            ch = stdscr.getch()
            if ch in [ord('q'), ord('Q'), 27]:
                break
            elif ch in [curses.KEY_UP, ord('k')]:
                selected_menu = (selected_menu - 1) % len(menu_items)
            elif ch in [curses.KEY_DOWN, ord('j')]:
                selected_menu = (selected_menu + 1) % len(menu_items)
            elif ch in [10, 13, ord(' ')]:
                if selected_menu == 8:
                    cmd_stop(None)
                    cmd_start(None)
                elif selected_menu == 9:
                    break

        except curses.error:
            pass

def cmd_tui(args):
    try:
        curses.wrapper(run_tui)
    except Exception as e:
        print(f"{RED}TUI Error: {e}{RESET}")

