        ws_badge = f"{GREEN}● BOUND (:5225){RESET}" if ws_up else f"{RED}○ OFFLINE (:5225){RESET}"
        bridge_badge = f"{GREEN}● ACTIVE (:8767){RESET}" if bridge_up else f"{RED}○ OFFLINE (:8767){RESET}"
        
        print(f"  SimpleX Post-Quantum Socket Daemon: {ws_badge}")
        print(f"  SimpleX Web Bridge HTTP Proxy:      {bridge_badge}\n")
