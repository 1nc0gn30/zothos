    elif action == "send":
        text = getattr(args, "text", "")
        if not text:
            print(f"{RED}Error: Message text required.{RESET}\n")
            return 1
        try:
            req = urllib.request.Request(
                "http://127.0.0.1:8767/api/simplex/send",
                data=json.dumps({"text": text}).encode("utf-8"),
                headers={"Content-Type": "application/json", "User-Agent": "ZothCLI/3.2"},
                method="POST"
            )
            with urllib.request.urlopen(req, timeout=0.8) as resp:
                print(f"  {GREEN}✔ Message dispatched through SimpleX Bridge!{RESET}\n")
        except Exception as e:
            print(f"  {RED}Error sending SimpleX message:{RESET} {e}\n")

    elif action == "history" or action == "log":
        print(f"{BOLD}💬 Recent SimpleX Message Stream:{RESET}\n")
        try:
            with urllib.request.urlopen("http://127.0.0.1:8767/api/simplex/messages", timeout=0.8) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                msgs = data.get("messages", [])
                if not msgs:
                    print(f"  {GRAY}No active messages on bridge.{RESET}\n")
                    return 0
                for m in msgs[-15:]:
                    sender = m.get("sender", "anon")
                    txt = m.get("text", "")
                    ts = m.get("timestamp", "")
                    is_out = m.get("isOutbound", False)
                    arrow = f"{GOLD}➔{RESET}" if is_out else f"{CYAN}⬅{RESET}"
                    print(f"  {GRAY}[{ts}]{RESET} {arrow} {BOLD}{sender}:{RESET} {txt}")
                print()
        except Exception as e:
            print(f"  {RED}Error fetching SimpleX stream:{RESET} {e}\n")

    elif action == "web":
        url = "http://127.0.0.1:8199/secure-messaging/"
        print(f"{BOLD}Opening Sovereign SimpleX Console in browser...{RESET}")
        print(f"URL: {CYAN}{url}{RESET}")
        open_url(url)

