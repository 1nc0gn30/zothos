#!/usr/bin/env bash
# ==============================================================================
#  ZOTH STUDIO CLI Launcher
# ==============================================================================
set -euo pipefail

if [[ -f "/opt/zoth-studio/launch.sh" ]]; then
    exec /opt/zoth-studio/launch.sh "$@"
elif [[ -f "/media/neo/f2fdda77-178b-4603-ae80-c7aa4cd97908/zoth-studio/start-zoth-studio.sh" ]]; then
    exec /media/neo/f2fdda77-178b-4603-ae80-c7aa4cd97908/zoth-studio/start-zoth-studio.sh "$@"
else
    echo -e "\e[1;32m[[+]] Starting local Zoth Studio server...\e[0m"
    python3 -m http.server 8088 --bind 127.0.0.1 --directory "/opt/zoth-studio/public" 2>/dev/null &
    xdg-open "http://127.0.0.1:8088" 2>/dev/null || true
fi
