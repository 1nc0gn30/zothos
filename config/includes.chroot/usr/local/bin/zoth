def cmd_matrix(args):
    """Real-time high-performance terminal cyberpunk matrix stream."""
    import curses
    
    GLYPH_SETS = {
        "katakana": "0123456789ABCDEFｦｱｳｴｵｶｷｹｺｻｼｽｾｿﾀﾂﾃﾅﾆﾇﾈﾊﾋﾎﾏﾐﾑﾒﾓﾔﾕﾗﾘﾜ+-*/<>~%&",
        "alchemical": "🜀🜁🜂🜃🜄🜅🜆🜇🜈🜉🜊🜋🜌🜍🜎🜏🜐0123456789AZOTH✦✧",
        "binary": "010010110101011001101001011000100110010101110011",
        "hex": "0123456789ABCDEFDEADBEEFCAFEBA08484",
        "math": "∑∫∂√∞π≈≠≤≥⊕⊗∧∨¬∆∇∈∉∋⊆⊂⊇⊃λμσ",
        "braille": "⠁⠃⠇⠧⠷⠿⠾⠶⠦⠖⠒⠊⠑⠔⠢⠰⠠⠄⠂⠅⠍⠝⠹⠽⠵⠯"
    }

    def _matrix_loop(stdscr):
        curses.curs_set(0)
        stdscr.nodelay(True)
        stdscr.timeout(35)
        
        has_color = curses.has_colors()
        if has_color:
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, curses.COLOR_GREEN, -1)   # Emerald green
            curses.init_pair(2, curses.COLOR_YELLOW, -1)  # Cyber gold
            curses.init_pair(3, curses.COLOR_CYAN, -1)    # Neon cyan
            curses.init_pair(4, curses.COLOR_MAGENTA, -1) # Synthwave purple
            curses.init_pair(5, curses.COLOR_RED, -1)     # Crimson red
            curses.init_pair(6, curses.COLOR_WHITE, -1)   # Silver white
            curses.init_pair(7, curses.COLOR_BLUE, -1)    # Electric blue
            curses.init_pair(8, curses.COLOR_WHITE, -1)   # Head highlight

        modes = ["green", "gold", "cyan", "purple", "red", "silver", "prism"]
        mode_idx = 0
        glyph_keys = list(GLYPH_SETS.keys())
        glyph_idx = 0
        show_hud = True
        paused = False
        speed_mult = 1.0

        h, w = stdscr.getmaxyx()
        columns = [{"y": random.randint(-h, 0), "speed": random.uniform(0.5, 1.8), "len": random.randint(8, max(9, h - 2))} for _ in range(w)]
        frame = 0

        while True:
            ch = stdscr.getch()
            if ch in [ord('q'), ord('Q'), 27]:
                break
            elif ch in [ord(' '), ord('p'), ord('P')]:
                paused = not paused
            elif ch in [ord('h'), ord('H')]:
                show_hud = not show_hud
            elif ch in [ord('1')]:
                mode_idx = 0
            elif ch in [ord('2')]:
                mode_idx = 1
            elif ch in [ord('3')]:
                mode_idx = 2
            elif ch in [ord('4')]:
                mode_idx = 3
            elif ch in [ord('5')]:
                mode_idx = 4
            elif ch in [ord('6')]:
                mode_idx = 5
            elif ch in [ord('7')]:
                mode_idx = 6
            elif ch in [ord('c'), ord('C')]:
                mode_idx = (mode_idx + 1) % len(modes)
            elif ch in [ord('g'), ord('G')]:
                glyph_idx = (glyph_idx + 1) % len(glyph_keys)
            elif ch in [ord('+'), ord('=')]:
                speed_mult = min(3.0, speed_mult + 0.2)
            elif ch in [ord('-'), ord('_')]:
                speed_mult = max(0.2, speed_mult - 0.2)
            elif ch == curses.KEY_RESIZE:
                stdscr.clear()
                h, w = stdscr.getmaxyx()
                columns = [{"y": random.randint(-h, 0), "speed": random.uniform(0.5, 1.8), "len": random.randint(8, max(9, h - 2))} for _ in range(w)]

            if not paused:
                frame += 1
                stdscr.erase()
                mode_name = modes[mode_idx]
                glyphs = GLYPH_SETS[glyph_keys[glyph_idx]]

                for x, col in enumerate(columns):
                    if x >= w:
                        continue
                    head_y = int(col["y"])
                    for i in range(col["len"]):
                        y = head_y - i
                        if 0 <= y < h:
                            char = random.choice(glyphs)
                            if mode_name == "prism":
                                c_pair = ((x + y + frame // 4) % 7) + 1
                            elif mode_name == "green":
                                c_pair = 1
                            elif mode_name == "gold":
                                c_pair = 2
                            elif mode_name == "cyan":
                                c_pair = 3
                            elif mode_name == "purple":
                                c_pair = 4
                            elif mode_name == "red":
                                c_pair = 5
                            else:
                                c_pair = 6

                            if i == 0:
                                safe_addstr(stdscr, y, x, char, curses.color_pair(8) | curses.A_BOLD)
                            elif i < 3:
                                safe_addstr(stdscr, y, x, char, curses.color_pair(c_pair) | curses.A_BOLD)
                            else:
                                safe_addstr(stdscr, y, x, char, curses.color_pair(c_pair) | curses.A_DIM)
                    
                    col["y"] += col["speed"] * speed_mult
                    if col["y"] - col["len"] >= h:
                        col["y"] = random.randint(-8, 0)
                        col["speed"] = random.uniform(0.6, 1.9)
                        col["len"] = random.randint(8, max(9, h - 2))

                # HUD Overlay
                if show_hud and h >= 8 and w >= 50:
                    hud_color = curses.color_pair(2) if mode_name == "gold" else curses.color_pair(3)
                    hud_text = f" ⚡ ZOTH MATRIX [{mode_name.upper()}] ⚡ Glyphs: {glyph_keys[glyph_idx].upper()} │ Speed: {speed_mult:.1f}x │ [1-7: Colors | g: Glyphs | +/-: Speed | h: HUD | SPACE: Pause | q: Exit] "
                    safe_addstr(stdscr, h - 1, max(0, (w - len(hud_text)) // 2), hud_text, hud_color | curses.A_REVERSE | curses.A_BOLD)

                stdscr.refresh()
            time.sleep(0.035)

    try:
        curses.wrapper(_matrix_loop)
    except Exception:
        print(f"{GREEN}Matrix stream ended.{RESET}")

