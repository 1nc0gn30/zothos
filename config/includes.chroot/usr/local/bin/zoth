    if len(sys.argv) > 1 and sys.argv[1].lower() in ["help", "--help", "-h"]:
        class HelpArgs:
            topic = sys.argv[2] if len(sys.argv) > 2 else ""
        cmd_help(HelpArgs)
        return 0

