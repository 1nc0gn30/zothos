PET_STATE_FILE = Path.home() / ".zoth" / "active_pet.json"
FALLBACK_PET_STATE = CORE_APP_DIR / "data" / "active_pet.json"

def get_active_spirit() -> dict[str, Any]:
    for path in [PET_STATE_FILE, FALLBACK_PET_STATE]:
        if path.exists():
            try:
                data = json.loads(path.read_text(encoding="utf-8"))
                active_id = data.get("active_pet", "").lower()
                for s in SOVEREIGN_SPIRITS:
                    if s["id"] == active_id:
                        return s
            except Exception:
                pass
    return SOVEREIGN_SPIRITS[0]

def set_active_spirit(name_or_id: str) -> Optional[dict[str, Any]]:
    q = name_or_id.strip().lower()
    target = None
    for s in SOVEREIGN_SPIRITS:
        if s["id"] == q or s["name"].lower() == q or q in s["id"] or q in s["name"].lower():
            target = s
            break
    if not target:
        return None
    data = {
        "active_pet": target["id"],
        "name": target["name"],
        "archetype": target["archetype"],
        "element": target["element"],
        "domain": target["domain"],
        "summoned_at": datetime.now(timezone.utc).isoformat()
    }
    for p in [PET_STATE_FILE, FALLBACK_PET_STATE]:
        try:
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(json.dumps(data, indent=2), encoding="utf-8")
        except Exception:
            pass
    return target

def cmd_pet(args):
    action = getattr(args, "pet_cmd", "list") or "list"
    print_banner()

    if action == "list":
        active = get_active_spirit()
        print(f"{BOLD}🐾 24 Sovereign Mascot Spirits & Companion Dex:{RESET}\n")
        print(f"  {GRAY}{'#':<3} {'EMOJI':<4} {'NAME':<18} {'DOMAIN':<12} {'ARCHETYPE':<36} {'STATUS'}{RESET}")
        print(f"  {GRAY}{'─'*3} {'─'*4} {'─'*18} {'─'*12} {'─'*36} {'─'*10}{RESET}")
        for idx, s in enumerate(SOVEREIGN_SPIRITS, 1):
            is_active = (s["id"] == active["id"])
            st_tag = f"{GOLD}{BOLD}★ ACTIVE{RESET}" if is_active else f"{GRAY}AVAILABLE{RESET}"
            print(f"  {idx:<3} {s['emoji']:<4} {BOLD if is_active else ''}{s['name']:<18}{RESET} {s['domain']:<12} {s['archetype'][:34]:<36} {st_tag}")
        print(f"\n{GRAY}Usage: zoth pet summon <name> | zoth pet status | zoth pet play <name> | zoth pet ascii <name>{RESET}\n")

    elif action == "summon":
        name = getattr(args, "name", "")
        if not name:
            print(f"{RED}Error: Companion spirit name required.{RESET}\n")
            return 1
        spirit = set_active_spirit(name)
        if not spirit:
            print(f"{RED}Error: Companion spirit '{name}' not found.{RESET}\n")
            return 1
        print(f"{GOLD}{BOLD}🐾 SOVEREIGN COMPANION SUMMONED: {spirit['emoji']} {spirit['name'].upper()}{RESET}\n")
        print(f"  {BOLD}Archetype:{RESET}  {CYAN}{spirit['archetype']}{RESET}")
        print(f"  {BOLD}Element:{RESET}    {spirit['element']}")
        print(f"  {BOLD}Soul Lore:{RESET}  {GRAY}{spirit['lore']}{RESET}")
        print(f"  {BOLD}Dialogue:{RESET}   {GOLD}\"{spirit['quote']}\"{RESET}\n")
        print(f"  {GREEN}✔ Companion '{spirit['name']}' is now active and guarding your session.{RESET}\n")

    elif action == "status":
        s = get_active_spirit()
        print(f"{BOLD}🐾 Active Companion & Session Guardian:{RESET}\n")
        print(f"  {GOLD}Spirit:{RESET}    {s['emoji']} {BOLD}{s['name']}{RESET} ({s['id']})")
        print(f"  {GOLD}Archetype:{RESET} {CYAN}{s['archetype']}{RESET}")
        print(f"  {GOLD}Domain:{RESET}    {s['domain']}")
        print(f"  {GOLD}Element:{RESET}   {s['element']}")
        print(f"  {GOLD}Lore:{RESET}      {GRAY}{s['lore']}{RESET}")
        print(f"  {GOLD}Dialogue:{RESET}  {CYAN}\"{s['quote']}\"{RESET}\n")

    elif action == "ascii":
        name = getattr(args, "name", "")
        s = set_active_spirit(name) if name else get_active_spirit()
        if not s:
            s = get_active_spirit()
        print(f"{GOLD}🐾 ASCII Mascot Portrait: {BOLD}{s['name']}{RESET} ({CYAN}{s['id']}{RESET})\n")
        sprite = get_pet_sprite_frame(s["id"], 0)
        for line in sprite:
            print(f"  {CYAN}{line}{RESET}")
        print(f"\n  {ITALIC}\"{s['quote']}\"{RESET}\n")

    elif action == "play":
        name = getattr(args, "name", "")
        s = set_active_spirit(name) if name else get_active_spirit()
        if not s:
            s = get_active_spirit()
