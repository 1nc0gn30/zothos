# ═══════════════════════════════════════════════════════════════
# 🎵 Terminal Audio Jukebox (zoth audio)
# ═══════════════════════════════════════════════════════════════

AUDIO_TRACKS = [
    {"id": "ep1", "name": "Episode 1: Genesis in Silicon Rain", "file": "assets/comic/s01e01-narration.mp3", "type": "Narration"},
    {"id": "ep2", "name": "Episode 2: The Ghost in the Citadel", "file": "assets/comic/s01e02-narration.mp3", "type": "Narration"},
    {"id": "ep3", "name": "Episode 3: The Cipher Protocol", "file": "assets/comic/s01e03-narration.mp3", "type": "Narration"},
    {"id": "ep4", "name": "Episode 4: Pantheon of the Red Sands", "file": "assets/comic/s01e04-narration.mp3", "type": "Narration"},
    {"id": "theme", "name": "Zoth Alchemical Theme", "file": "assets/media/home/zoth-theme.mp3", "type": "Soundtrack"}
]

def cmd_audio(args):
    action = getattr(args, "audio_action", "list") or "list"
    print_banner()

    if action == "list":
        print(f"{BOLD}🎵 Zoth Studio Terminal Audio Jukebox:{RESET}\n")
        print(f"  {GRAY}{'TRACK ID':<10} {'TITLE':<44} {'TYPE'}{RESET}")
        print(f"  {GRAY}{'─'*10} {'─'*44} {'─'*12}{RESET}")
        for t in AUDIO_TRACKS:
            print(f"  {CYAN}{t['id']:<10}{RESET} {BOLD}{t['name']:<44}{RESET} {GOLD}{t['type']}{RESET}")
        print(f"\n{GRAY}Usage: zoth audio play <track_id>{RESET}\n")

    elif action == "play":
        tid = getattr(args, "track_id", "ep1") or "ep1"
        t = next((item for item in AUDIO_TRACKS if item["id"] == tid.lower()), None)
        if not t:
            print(f"{RED}Error: Audio track '{tid}' not found.{RESET}\n")
            return 1
        
        target = PUBLIC_DIR / t["file"]
        if target.exists():
            print(f"{GOLD}🎵 Playing Track: {BOLD}{t['name']}{RESET} (Ctrl+C to stop)...")
            for player in ["ffplay", "mpv", "cvlc", "aplay"]:
                if shutil.which(player):
                    if player == "ffplay":
                        subprocess.run(["ffplay", "-nodisp", "-autoexit", str(target)])
                    else:
                        subprocess.run([player, str(target)])
                    return 0
            print(f"{GRAY}Audio file at: {target}{RESET}")
        else:
            print(f"{RED}Track file not found: {target}{RESET}")

