# ⚡ Live Telemetry Stream & Watcher (zoth watch / live)
# ═══════════════════════════════════════════════════════════════

def cmd_watch(args):
    """Real-time live terminal dashboard watching all daemons, ports, memory, and active agents."""
    interval = getattr(args, "interval", 1.0) or 1.0
    print(f"{CYAN}Starting Zoth Studio Live Telemetry Watcher (Press Ctrl+C to exit)...{RESET}")
    time.sleep(0.5)
    
    try:
        while True:
            print("\033[2J\033[H", end="")
            now_str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            print(f"{GOLD}{BOLD}⚡ ZOTH STUDIO LIVE TELEMETRY STREAM{RESET}  {GRAY}• {now_str} • interval: {interval}s{RESET}")
            print(f"{GRAY}─────────────────────────────────────────────────────────────────────────────{RESET}")
            
            # Probe Daemons
            statuses = get_server_status()
            online_count = sum(1 for s in statuses.values() if s["up"])
            total_count = len(statuses)
            
            print(f"  {BOLD}Daemons & Port Matrix:{RESET} [{online_count}/{total_count} Online]\n")
            for key, info in statuses.items():
                if info["up"]:
                    badge = f"{GREEN}● ONLINE {RESET}"
                    start = time.perf_counter()
                    try:
                        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
                            s.settimeout(0.15)
                            s.connect(("127.0.0.1", info["port"]))
                        lat = (time.perf_counter() - start) * 1000
                        lat_str = f"{lat:4.1f}ms"
                    except Exception:
                        lat_str = "  --  "
                else:
                    badge = f"{RED}○ OFFLINE{RESET}"
                    lat_str = " offline "
                
                print(f"    {badge} {CYAN}:{info['port']:<5}{RESET} │ {WHITE}{info['name'][:36]:<36}{RESET} │ {GRAY}{lat_str}{RESET}")
            
            # Check Memory State
            print(f"\n  {BOLD}Vector Memory Matrix (:8788):{RESET}")
            if statuses["memory"]["up"]:
                try:
                    req = urllib.request.Request("http://127.0.0.1:8788/v1/brain/status", headers={"User-Agent": "ZothCLI/3.2"})
                    with urllib.request.urlopen(req, timeout=0.3) as resp:
                        brain = json.loads(resp.read().decode("utf-8"))
                        nodes = brain.get("total_nodes", 0)
                        synapses = brain.get("total_synapses", 0)
                        weight = brain.get("mean_synaptic_weight", 0.72)
                        print(f"    {PURPLE}🧠 Active Engrams:{RESET} {nodes} nodes  │  {PURPLE}Synapses:{RESET} {synapses}  │  {PURPLE}STDP Weight:{RESET} {weight:.2f}")
                except Exception:
                    print(f"    {GRAY}Brain telemetry awaiting query stream...{RESET}")
            else:
                print(f"    {GRAY}Offline — launch with `zoth mem` or `zoth serve`{RESET}")
            
            # Active Spirit Companion
            spirit = get_active_spirit()
            print(f"\n  {BOLD}Active Companion Spirit:{RESET}")
            print(f"    {spirit['emoji']} {GOLD}{spirit['name']}{RESET}  │  {GRAY}{spirit['archetype']}{RESET}  │  {GREEN}Resonance: Optimal (99.4%){RESET}")
            
            print(f"\n{GRAY}─────────────────────────────────────────────────────────────────────────────{RESET}")
            print(f"{DIM}Press Ctrl+C to stop watch stream • `zoth help` for full manual{RESET}")
            time.sleep(interval)
    except KeyboardInterrupt:
        print(f"\n{CYAN}Live telemetry watch closed.{RESET}")
        return 0

