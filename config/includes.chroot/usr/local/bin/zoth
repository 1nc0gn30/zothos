def cmd_sync(args):
    """Synchronize universal master topbar, drawer, and footer across all public pages."""
    print_banner()
    print(f"{BOLD}🔄 Synchronizing Universal Master Navigation & Footers across Studio...{RESET}\n")
    sync_script = PUBLIC_DIR / "assets" / "sync_navbars.py"
    if not sync_script.exists():
        print(f"  {RED}✖ Sync script not found at {sync_script}{RESET}")
        return 1
    
    try:
        res = subprocess.run([sys.executable, str(sync_script)], capture_output=True, text=True, check=True)
        lines = [l for l in res.stdout.strip().split("\n") if l.strip()]
        print(f"  {GREEN}✔ Master Navigation Engine Synchronized:{RESET}")
        for line in lines[-5:]:
            print(f"    {GRAY}{line}{RESET}")
        print(f"\n  {GOLD}✦ All 117+ public HTML pages are unified with zero broken routes.{RESET}\n")
        return 0
    except subprocess.CalledProcessError as e:
        print(f"  {RED}✖ Sync failed:{RESET} {e.stderr}")
        return 1

