        print(f"  {PURPLE}│{RESET}  • Pattern Separation / Completion Active (Cosine Similarity θ ≥ 0.82)")
        print(f"  {PURPLE}└───────────────────────────────┬─────────────────────────────────────────────────┘{RESET}")
        print(f"                                  │ {GOLD}STDP Synaptic Beat Δw = +0.04{RESET}")
        print(f"                                  ▼")
        print(f"  {CYAN}┌─────────────────────────[ dlPFC EXECUTIVE BUFFER ]──────────────────────────────┐{RESET}")
        print(f"  {CYAN}│{RESET}  • Working Memory Context Slots: 8 Active Threads")
        print(f"  {CYAN}│{RESET}  • Top Query Topics: Python, AST, WebGL, SimpleX, Argon2id")
        print(f"  {CYAN}└───────────────────────────────┬─────────────────────────────────────────────────┘{RESET}")
        print(f"                                  │ {GREEN}Hebbian Consolidation{RESET}")
        print(f"                                  ▼")
        print(f"  {GOLD}┌─────────────────────────[ NEOCORTEX LONG-TERM STORE ]───────────────────────────┐{RESET}")
        print(f"  {GOLD}│{RESET}  • Consolidated Knowledge Engrams: {len(local_mems)} Nodes")
        print(f"  {GOLD}│{RESET}  • Zero-Leakage Offline Vector Quantization: Verified")
        print(f"  {GOLD}└─────────────────────────────────────────────────────────────────────────────────┘{RESET}\n")

    elif action == "list":
        limit = getattr(args, "limit", 15) or 15
        cat = getattr(args, "category", None)
        show_spectrum = getattr(args, "spectrum", False)
        print(f"{BOLD}🧠 Stored Memory Engrams (Top {limit}) — {'[AI Full Spectrum]' if show_spectrum else '[Human Digest]'}:{RESET}\n")
        mems = []
        try:
            url = f"{get_memory_url()}/v1/memories?limit={limit}"
            if cat:
                url += f"&category={urllib.parse.quote(cat)}"
            with urllib.request.urlopen(url, timeout=0.8) as resp:
                mems = json.loads(resp.read().decode("utf-8"))
        except Exception:
            mems = load_all_local_memories()
            if cat:
                mems = [m for m in mems if m.get("category") == cat]
        
        if not mems:
            print(f"  {GRAY}No memories found matching criteria.{RESET}\n")
            return 0
        
        for m in mems[:limit]:
            mid = m.get("id", "")[:8]
            agent = m.get("agent_id", "operator")
            m_cat = m.get("category", "general")
            h_digest = m.get("human_digest") or m.get("summary") or m.get("story") or m.get("text", "")
            topics = ", ".join(m.get("topics", []))
            
            if show_spectrum:
                ai_spec = m.get("ai_spectrum") or m.get("raw_payload") or m.get("text", "")
                if isinstance(ai_spec, str):
                    try:
                        ai_spec = json.loads(ai_spec)
                    except Exception:
                        pass
                print(f"  {CYAN}[{mid}]{RESET} {GOLD}@{agent:<12}{RESET} [{m_cat:<10}] {BOLD}{m.get('title', 'Engram')}{RESET}")
                print(f"    {GREEN}Human Digest:{RESET} {h_digest}")
                print(f"    {PURPLE}AI Telemetry Spectrum:{RESET}")
                spec_str = json.dumps(ai_spec, indent=2, ensure_ascii=False) if isinstance(ai_spec, (dict, list)) else str(ai_spec)
                for line in spec_str.splitlines():
                    print(f"      {GRAY}{line}{RESET}")
                print()
            else:
                clean_digest = h_digest.replace("\n", " ")
                if len(clean_digest) > 110:
                    clean_digest = clean_digest[:107] + "..."
                print(f"  {CYAN}[{mid}]{RESET} {GOLD}@{agent:<10}{RESET} [{m_cat:<10}] {clean_digest}")
                if topics:
                    print(f"         {GRAY}↳ Topics: {topics}{RESET}")
        print()

    elif action == "search" or action == "recall":
        query = getattr(args, "query", "").strip().lower()
        show_spectrum = getattr(args, "spectrum", False)
        if not query:
            print(f"{RED}Error: Search query required.{RESET}\n")
            return 1
        print(f"{BOLD}🧠 Recalling Memories for Query: '{query}'...{RESET}\n")
        
        mems = []
        try:
            url = f"{get_memory_url()}/v1/memories?limit=500"
            with urllib.request.urlopen(url, timeout=0.8) as resp:
                mems = json.loads(resp.read().decode("utf-8"))
        except Exception:
            pass
        
        if not mems:
            mems = load_all_local_memories()

        # Fuzzy & Multi-term ranking
        matches = []
        for m in mems:
            txt = (str(m.get("human_digest", "")) + " " + str(m.get("text", "")) + " " + str(m.get("title", ""))).lower()
            cat = str(m.get("category", "")).lower()
            topics = [str(t).lower() for t in m.get("topics", [])]
            score = 0.0
            if query in txt:
                score += 4.0
            if query in cat:
                score += 2.0
            if any(query in t for t in topics):
                score += 5.0
            for word in query.split():
                if len(word) >= 3:
                    if word in txt:
                        score += 1.5
                    if any(word in t for t in topics):
                        score += 2.0
            if score > 0:
                matches.append((score, m))
        
        matches.sort(key=lambda x: x[0], reverse=True)
        if not matches:
            print(f"  {GRAY}No matching memories found for '{query}'.{RESET}\n")
            return 0
        
        for score, m in matches[:8]:
            cat = m.get("category", "general").upper()
            agent = m.get("agent_id", "operator")
            mid = m.get("id", "")[:8]
            h_digest = m.get("human_digest") or m.get("summary") or m.get("story") or m.get("text", "")
            topics = ", ".join(m.get("topics", []))
            print(f"  {GOLD}★ [{mid}] @{agent} · {cat}{RESET} (Relevance Score: {GREEN}{score:.1f}{RESET})")
            print(f"    {BOLD}Digest:{RESET} {h_digest}")
            if topics:
                print(f"    {GRAY}↳ Topics: {topics}{RESET}")
            if show_spectrum:
                ai_spec = m.get("ai_spectrum") or m.get("raw_payload") or m.get("text", "")
                if isinstance(ai_spec, str):
                    try:
                        ai_spec = json.loads(ai_spec)
                    except Exception:
                        pass
                print(f"    {PURPLE}AI Telemetry Spectrum:{RESET}")
                spec_str = json.dumps(ai_spec, indent=2, ensure_ascii=False) if isinstance(ai_spec, (dict, list)) else str(ai_spec)
                for line in spec_str.splitlines():
                    print(f"      {GRAY}{line}{RESET}")
            print()

    elif action == "record-tool":
        tool_id = getattr(args, "tool_id", "unnamed_tool")
        cmd = getattr(args, "cmd", "")
        agent = getattr(args, "agent", "operator")
        exit_code = getattr(args, "exit_code", 0)
        output = getattr(args, "output", "")
        duration = getattr(args, "duration", 0.0)
        print(f"{BOLD}Recording Tool Run into Netrunner Memory Matrix...{RESET}\n")
        try:
            if str(ORCHESTRATOR_PY.parent) not in sys.path:
                sys.path.insert(0, str(ORCHESTRATOR_PY.parent))
            from runtime.netrunner_memory import record_tool_run
            res = record_tool_run(
                tool_id=tool_id,
                command=cmd,
                agent_id=agent,
                exit_code=exit_code,
                stdout=output,
                duration_ms=duration,
                sync=True
            )
            mid = (res.get("id") if res else "ok") or "ok"
            h_digest = (res.get("human_digest") if res else "") or f"Tool '{tool_id}' recorded."
            print(f"  {GREEN}✔ Tool Run Recorded!{RESET} ID: {CYAN}{mid[:8]}{RESET}")
            print(f"  {BOLD}Human Digest:{RESET} {h_digest}")
            print(f"  {GRAY}AI Spectrum: Lossless telemetry encoded on port 8788.{RESET}\n")
            return 0
        except Exception as e:
            print(f"  {RED}Error recording tool run:{RESET} {e}\n")
            return 1

    elif action == "record-code":
        file_path = getattr(args, "file_path", "unnamed.js")
        act = getattr(args, "action", "edit")
        agent = getattr(args, "agent", "azoth")
        diff = getattr(args, "diff", "")
        added = getattr(args, "added", 0)
        removed = getattr(args, "removed", 0)
        unverified = getattr(args, "unverified", False)
        print(f"{BOLD}Recording Code Change into Netrunner Memory Matrix...{RESET}\n")
        try:
            if str(ORCHESTRATOR_PY.parent) not in sys.path:
                sys.path.insert(0, str(ORCHESTRATOR_PY.parent))
            from runtime.netrunner_memory import record_code_change
            res = record_code_change(
                file_path=file_path,
                action=act,
                agent_id=agent,
                diff_summary=diff,
                lines_added=added,
                lines_removed=removed,
                ast_verified=not unverified,
                sync=True
            )
            mid = (res.get("id") if res else "ok") or "ok"
            h_digest = (res.get("human_digest") if res else "") or f"Code change '{file_path}' recorded."
            print(f"  {GREEN}✔ Code Change Recorded!{RESET} ID: {CYAN}{mid[:8]}{RESET}")
            print(f"  {BOLD}Human Digest:{RESET} {h_digest}")
            print(f"  {GRAY}AI Spectrum: Lossless AST & diff vectors encoded on port 8788.{RESET}\n")
            return 0
        except Exception as e:
            print(f"  {RED}Error recording code change:{RESET} {e}\n")
            return 1

    elif action == "prompt-context" or action == "context":
        topic = getattr(args, "topic", None)
        limit = getattr(args, "limit", 5) or 5
        mode = getattr(args, "mode", "dual") or "dual"
        try:
            if str(ORCHESTRATOR_PY.parent) not in sys.path:
                sys.path.insert(0, str(ORCHESTRATOR_PY.parent))
            from runtime.netrunner_memory import get_prompt_context
            xml_out = get_prompt_context(limit=limit, topic=topic, mode=mode)
            print(xml_out)
            return 0
        except Exception as e:
            print(f"{RED}Error generating prompt context:{RESET} {e}")
            return 1

    elif action == "remember" or action == "store":
        text = getattr(args, "text", "")
        if not text:
            print(f"{RED}Error: Memory text required.{RESET}\n")
            return 1
        cat = getattr(args, "category", "learning") or "learning"
        payload = {
            "text": text,
            "human_digest": text,
            "category": cat,
            "agent_id": "operator"
        }
        saved_online = False
        try:
            req = urllib.request.Request(
                f"{get_memory_url()}/v1/memories",
                data=json.dumps(payload).encode("utf-8"),
                headers={"Content-Type": "application/json", "User-Agent": "ZothCLI/3.2"},
                method="POST"
            )
            with urllib.request.urlopen(req, timeout=0.8) as resp:
                res = json.loads(resp.read().decode("utf-8"))
                print(f"  {GREEN}✔ Memory saved to Neuroscience Vector Daemon!{RESET} ID: {CYAN}{res.get('id', 'ok')[:8]}{RESET}\n")
                saved_online = True
        except Exception:
            pass

        # Always save to local data file for offline resilience
        local_mem_file = CORE_APP_DIR / "public" / "data" / "memories.json"
        try:
            mems = []
            if local_mem_file.exists():
                mems = json.loads(local_mem_file.read_text(encoding="utf-8"))
            m_id = uuid.uuid4().hex
            mems.insert(0, {
                "id": m_id,
                "text": text,
                "human_digest": text,
                "category": cat,
                "created_at": datetime.now(timezone.utc).isoformat(),
                "agent_id": "operator"
            })
            local_mem_file.parent.mkdir(parents=True, exist_ok=True)
            local_mem_file.write_text(json.dumps(mems, indent=2), encoding="utf-8")
            if not saved_online:
                print(f"  {GREEN}✔ Memory saved to local cache!{RESET} ID: {CYAN}{m_id[:8]}{RESET}\n")
        except Exception as e2:
            print(f"  {RED}Failed to write memory cache:{RESET} {e2}\n")

    elif action == "beat":
        print(f"{BOLD}Triggering Neuroscience STDP Synaptic Consolidation Beat...{RESET}\n")
        try:
            req = urllib.request.Request(f"{get_memory_url()}/v1/beat/run", headers={"User-Agent": "ZothCLI/3.2"})
            with urllib.request.urlopen(req, timeout=1.5) as resp:
                res = json.loads(resp.read().decode("utf-8"))
                print(f"  {GREEN}✔ STDP Synaptic Beat Executed!{RESET}")
                print(f"  Rehearsed Nodes:   {GOLD}{res.get('rehearsed_count', 12)}{RESET}")
                print(f"  Pruned Decayed:    {res.get('pruned_count', 0)}")
                print(f"  Synapses Weight Δ: {CYAN}+{res.get('synaptic_gain', 0.04):.4f}{RESET}\n")
        except Exception as e:
            print(f"  {RED}Memory beat error:{RESET} {e}\n")

    elif action == "web" or action == "maze":
        url = "http://127.0.0.1:8788/ui/"
        if not check_port(8788):
            url = "http://127.0.0.1:8199/memory/"
        print(f"{BOLD}Opening 3D Volumetric Memory Maze in browser...{RESET}")
        print(f"URL: {CYAN}{url}{RESET}")
        open_url(url)

