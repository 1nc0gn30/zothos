        if tmpl_root.exists():
            for cat_dir in sorted(tmpl_root.iterdir()):
                if cat_dir.is_dir() and not cat_dir.name.startswith("."):
                    items = [d.name for d in cat_dir.iterdir() if d.is_dir()]
                    print(f"  {GOLD}{BOLD}{cat_dir.name}{RESET} ({len(items)} templates)")
                    for it in items[:4]:
                        print(f"    • {CYAN}{it}{RESET}")
                    if len(items) > 4:
                        print(f"    {GRAY}↳ and {len(items)-4} more...{RESET}")
                    print()
        print(f"{GRAY}Usage: zoth site export <name> [framework] | zoth site web{RESET}\n")

    elif action == "export":
        template_name = getattr(args, "template", "")
        framework = getattr(args, "framework", "astro") or "astro"
        exporter_script = WORKSPACE_ROOT / "tools-and-automation" / "site_framework_exporter.py"
        if exporter_script.exists():
            subprocess.run([sys.executable, str(exporter_script), "--template", template_name, "--framework", framework])
        else:
            print(f"{RED}Exporter script not found: {exporter_script}{RESET}\n")

    elif action == "web":
        url = "http://127.0.0.1:8199/studio/webgen.html"
        print(f"{BOLD}Opening Website Generator & Foundry in browser...{RESET}")
        print(f"URL: {CYAN}{url}{RESET}")
