# 🤖 AI Agent Chat, Knowledge Search & Interactive REPL
# ═══════════════════════════════════════════════════════════════

def search_local_docs(query: str) -> List[Tuple[float, str, str]]:
    """Search workspace documentation files for grounded answers."""
    results = []
    doc_paths = []
    if DOCS_DIR.exists():
        doc_paths.extend(list(DOCS_DIR.glob("*.md")))
    for root_md in [WORKSPACE_ROOT / "README.md", WORKSPACE_ROOT / "memory-daemon" / "NEUROSCIENCE.md", WORKSPACE_ROOT / "vault-daemon" / "README.md"]:
        if root_md.exists():
            doc_paths.append(root_md)

    words = [w.lower() for w in query.split() if len(w) >= 3]
    for p in doc_paths:
        try:
            content = p.read_text(encoding="utf-8", errors="ignore")
            paras = content.split("\n\n")
            for para in paras:
                para_clean = para.strip()
                if len(para_clean) < 40:
                    continue
                para_lower = para_clean.lower()
                score = 0.0
                if query.lower() in para_lower:
                    score += 5.0
                for w in words:
                    if w in para_lower:
                        score += 1.5
                if score > 0:
                    results.append((score, p.name, para_clean))
        except Exception:
            pass

    results.sort(key=lambda x: x[0], reverse=True)
    return results

def answer_query(prompt: str, agent_id: str = "azoth"):
    agent = next((a for a in PANTHEON_AGENTS if a["id"] == agent_id.lower()), PANTHEON_AGENTS[0])
    print(f"\n{GOLD}🤖 Querying {BOLD}{agent['name']}{RESET} ({CYAN}@{agent['id']}{RESET})...\n")

    # 1. Fetch relevant vector memories
    mem_context = []
    try:
        url = f"http://127.0.0.1:8788/v1/memories/prompt-context?q={urllib.parse.quote(prompt)}&limit=3"
        with urllib.request.urlopen(url, timeout=0.6) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            mem_context = [m.get("text", "") for m in data.get("memories", [])]
    except Exception:
        pass

    # 2. Fetch grounded docs
    doc_matches = search_local_docs(prompt)

    if mem_context:
        print(f"  {PURPLE}🧠 Memory Matrix:{RESET} Retrieved {len(mem_context)} episodic engrams.")
    if doc_matches:
        print(f"  {BLUE}📚 Grounded Docs:{RESET} Found {len(doc_matches[:3])} architectural references in {doc_matches[0][1]}.")

    # 3. Query Local Model / Ollama / Fallback persona synthesis
    full_prompt = prompt
    context_blocks = []
    if mem_context:
        context_blocks.append("Episodic Memory:\n" + "\n".join(f"- {c}" for c in mem_context))
    if doc_matches:
        context_blocks.append("Architectural Context:\n" + "\n".join(f"[{doc[1]}]: {doc[2][:250]}..." for doc in doc_matches[:2]))
    
    if context_blocks:
        full_prompt = "\n\n".join(context_blocks) + f"\n\nUser Question: {prompt}"

    print(f"\n{CYAN}{BOLD}@{agent['id'].upper()}:{RESET}")
    print(f"{CYAN}────────────────────────────────────────────────────────────────────────{RESET}")
    
    # Try Ollama (:11434) if online
    answered = False
    if check_port(11434):
        try:
            req_data = json.dumps({
                "model": "qwen2.5-coder:latest",
                "prompt": f"You are {agent['name']} ({agent['archetype']}) in Zoth Studio. Persona quote: '{agent.get('quote')}'. {full_prompt}",
                "stream": True
            }).encode("utf-8")
            req = urllib.request.Request("http://127.0.0.1:11434/api/generate", data=req_data, headers={"Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=12.0) as resp:
                for line in resp:
                    if line:
                        chunk = json.loads(line.decode("utf-8"))
                        sys.stdout.write(chunk.get("response", ""))
                        sys.stdout.flush()
                print()
                answered = True
        except Exception:
            pass

    if not answered:
        # High-intelligence local persona synthesis with grounded docs
        print(f"I am {agent['name']}, guardian of the {agent['archetype']}.\n")
        print(f"{BOLD}Analysis & Synthesis:{RESET}")
        if doc_matches:
            top_doc = doc_matches[0]
            print(f"According to verified documentation [{CYAN}{top_doc[1]}{RESET}]:")
            print(f"{GRAY}{top_doc[2][:450]}...{RESET}\n")
        elif mem_context:
            print(f"From episodic memory engrams:")
            print(f"{GRAY}{mem_context[0][:300]}...{RESET}\n")
        else:
            print(f"Executing sovereign loopback query for: \"{prompt}\". All modules online on port matrix.")

        print(f"\n{GOLD}Alchemical Stance:{RESET} \"{agent.get('quote', 'Solve et coagula.')}\"")
    
    print(f"{CYAN}────────────────────────────────────────────────────────────────────────{RESET}\n")

def run_interactive_chat_repl(initial_agent: str = "azoth"):
    current_agent = initial_agent
    print_banner()
    print(f"{GOLD}{BOLD}⚡ ZOTH SOVEREIGN AGENT REPL INTERFACE ⚡{RESET}")
    print(f"  Active Persona: {CYAN}@{current_agent}{RESET} · Type {GOLD}/help{RESET} for slash commands or {GOLD}/exit{RESET} to quit.\n")

    while True:
        try:
            prompt = input(f"{CYAN}[@{current_agent}]{RESET} ➔ ").strip()
            if not prompt:
                continue
            if prompt.lower() in ["/exit", "/quit", "exit", "quit", ":q"]:
                print(f"{GREEN}Exiting agent REPL.{RESET}\n")
                break
            elif prompt.lower().startswith("/agent"):
                parts = prompt.split()
                if len(parts) > 1:
                    new_agent = parts[1].lstrip("@").lower()
                    if any(a["id"] == new_agent for a in PANTHEON_AGENTS):
                        current_agent = new_agent
                        print(f"{GREEN}Switched active agent to @{current_agent}.{RESET}\n")
                    else:
                        print(f"{RED}Agent '{new_agent}' not found. Run '/agents' or 'zoth agent list'.{RESET}\n")
                else:
                    print(f"{BOLD}Available Agents:{RESET} " + ", ".join(f"@{a['id']}" for a in PANTHEON_AGENTS[:10]) + "...")
                continue
            elif prompt.lower().startswith("/pet"):
                parts = prompt.split()
                if len(parts) > 1:
                    spirit = set_active_spirit(parts[1])
                    if spirit:
                        print(f"{GREEN}Summoned {spirit['emoji']} {spirit['name']} ({spirit['archetype']}).{RESET}\n")
                    else:
                        print(f"{RED}Pet '{parts[1]}' not found.{RESET}\n")
                else:
                    s = get_active_spirit()
                    print(f"Active Mascot Companion: {s['emoji']} {BOLD}{s['name']}{RESET} ({s['archetype']})\n")
                continue
            elif prompt.lower().startswith("/mem"):
                parts = prompt.split(maxsplit=1)
                q = parts[1] if len(parts) > 1 else ""
                class MemArgs:
                    mem_action = "search" if q else "status"
                    query = q
                    limit = 5
                    category = None
                cmd_memory(MemArgs)
                continue
            elif prompt.lower().startswith("/swarm"):
                parts = prompt.split(maxsplit=1)
                goal = parts[1] if len(parts) > 1 else "Audit loopback security boundaries"
                class SwarmArgs:
                    swarm_action = "run"
                    goal = goal
                cmd_swarm(SwarmArgs)
                continue
            elif prompt.lower() == "/matrix":
                class MatrixArgs: pass
                cmd_matrix(MatrixArgs)
                continue
            elif prompt.lower() == "/status":
                class StatArgs: pass
                cmd_status(StatArgs)
                continue
            elif prompt.lower() == "/clear":
                sys.stdout.write("\033[H\033[J")
                sys.stdout.flush()
                continue
            elif prompt.lower() == "/help":
                print(f"\n{BOLD}Zoth REPL Slash Commands:{RESET}")
                print(f"  {CYAN}/agent <name>{RESET}   Switch active persona (azoth, grok, hermes, draco, etc.)")
                print(f"  {CYAN}/pet [name]{RESET}     View or summon active mascot spirit")
                print(f"  {CYAN}/mem [query]{RESET}    Search episodic vector memory (:8788)")
                print(f"  {CYAN}/swarm <goal>{RESET}   Trigger 4-stage multi-agent consensus pipeline")
                print(f"  {CYAN}/matrix{RESET}         Launch digital rain screensaver")
                print(f"  {CYAN}/status{RESET}         Check 8-port loopback matrix")
                print(f"  {CYAN}/clear{RESET}          Clear terminal buffer")
                print(f"  {CYAN}/exit{RESET}           Return to shell\n")
                continue

            answer_query(prompt, current_agent)
        except (KeyboardInterrupt, EOFError):
            print(f"\n{GREEN}Exiting agent REPL.{RESET}\n")
            break

def cmd_ask(args):
    prompt = getattr(args, "prompt", "").strip()
    agent_id = getattr(args, "agent", "azoth") or "azoth"
    if not prompt:
        run_interactive_chat_repl(agent_id)
        return 0
    answer_query(prompt, agent_id)

