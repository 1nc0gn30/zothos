# ═══════════════════════════════════════════════════════════════
# 📌 Live Visual Notes & Annotations
# ═══════════════════════════════════════════════════════════════

def cmd_note(args):
    action = getattr(args, "note_action", "list") or "list"
    print_banner()

    if action == "list":
        filter_st = getattr(args, "status", "open")
        notes = []
        if NOTES_FILE.exists():
            try:
                notes = json.loads(NOTES_FILE.read_text(encoding="utf-8"))
            except Exception:
                pass
        
        if filter_st == "open":
            display_notes = [n for n in notes if n.get("status") == "open"]
        elif filter_st == "resolved":
            display_notes = [n for n in notes if n.get("status") == "resolved"]
        else:
            display_notes = notes

        print(f"{BOLD}📌 Zoth Studio Live Visual Notes & Annotator Board ({len(display_notes)} {filter_st}):{RESET}\n")
        if not display_notes:
            print(f"  {GRAY}No {filter_st} annotations found.{RESET}\n")
            return 0

        for n in display_notes:
            st_color = RED if n.get("status") == "open" else GREEN
            st_badge = f"{st_color}[{n.get('status','open').upper()}]{RESET}"
            nid = n.get("id", "")
            page = n.get("pathname", "/")
            cat = n.get("category", "UI")
            text = n.get("text", "")
            agents = ", ".join(f"@{a}" for a in n.get("tagged_agents", [])) or "@azoth"
            print(f"  {st_badge} {CYAN}{nid}{RESET}  {GOLD}{cat:<14}{RESET} {GRAY}Page:{RESET} {page}")
            print(f"       {BOLD}{text}{RESET}")
            print(f"       {GRAY}↳ Assigned to: {agents}{RESET}\n")

    elif action == "add":
        text = getattr(args, "text", "")
        if not text:
            print(f"{RED}Error: Note text required.{RESET}\n")
            return 1
        page = getattr(args, "page", "/") or "/"
        cat = getattr(args, "category", "UI / Visual") or "UI / Visual"
        agent = getattr(args, "agent", "azoth") or "azoth"
        
        nid = f"zn-{int(time.time()*1000)}-{uuid.uuid4().hex[:4]}"
        new_note = {
            "id": nid,
            "created_at": datetime.now(timezone.utc).isoformat(),
            "status": "open",
            "text": text,
            "category": cat,
            "priority": "Normal",
            "tagged_agents": [agent] if agent else [],
            "pathname": page,
            "page_url": f"http://127.0.0.1:8199{page}"
        }
        
        notes = []
        if NOTES_FILE.exists():
            try:
                notes = json.loads(NOTES_FILE.read_text(encoding="utf-8"))
            except Exception:
                pass
        notes.insert(0, new_note)
        NOTES_FILE.parent.mkdir(parents=True, exist_ok=True)
        NOTES_FILE.write_text(json.dumps(notes, indent=2), encoding="utf-8")
        print(f"  {GREEN}✔ Created Visual Annotation:{RESET} {CYAN}{nid}{RESET}")
        print(f"  Assigned: @{agent} | Page: {page}\n")

