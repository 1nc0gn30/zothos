# ═══════════════════════════════════════════════════════════════════════════════
# ANSI Color Constants (for headless/status mode)
# ═══════════════════════════════════════════════════════════════════════════════
ANSI_RESET = "\033[0m"
ANSI_BOLD = "\033[1m"
ANSI_DIM = "\033[2m"
ANSI_GREEN = "\033[38;2;0;255;157m"   # Emerald phosphor (#00ff9d)
ANSI_GOLD = "\033[38;2;251;191;36m"   # Cyber gold (#fbbf24)
ANSI_CYAN = "\033[38;2;56;189;248m"   # Neon cyan (#38bdf8)
