# ═══════════════════════════════════════════════════════════════════════════════
# System Metrics & Telemetry Engine
# ═══════════════════════════════════════════════════════════════════════════════

class SystemMetrics:
    def __init__(self) -> None:
        self.prev_cpu_idle: float = 0.0
        self.prev_cpu_total: float = 0.0
        self._init_cpu()

    def _init_cpu(self) -> None:
        try:
            with open("/proc/stat", "r") as f:
                fields = [float(x) for x in f.readline().split()[1:8]]
                self.prev_cpu_idle = fields[3] + fields[4]
                self.prev_cpu_total = sum(fields)
        except Exception:
            self.prev_cpu_idle = 0.0
            self.prev_cpu_total = 1.0

    def get_cpu(self) -> Tuple[float, List[float]]:
        """Returns (cpu_percentage, [load1, load5, load15])."""
        cpu_pct = 0.0
        try:
            with open("/proc/stat", "r") as f:
                fields = [float(x) for x in f.readline().split()[1:8]]
                idle = fields[3] + fields[4]
                total = sum(fields)
                idle_delta = idle - self.prev_cpu_idle
                total_delta = total - self.prev_cpu_total
                self.prev_cpu_idle = idle
                self.prev_cpu_total = total
                if total_delta > 0:
                    cpu_pct = max(0.0, min(100.0, 100.0 * (1.0 - idle_delta / total_delta)))
        except Exception:
            cpu_pct = 0.0

        loads = [0.0, 0.0, 0.0]
        try:
            loads = list(os.getloadavg())
        except Exception:
            pass

        return cpu_pct, loads

    @staticmethod
    def get_ram() -> Tuple[float, float, float]:
        """Returns (used_gb, total_gb, percentage)."""
        try:
            mem = {}
            with open("/proc/meminfo", "r") as f:
                for line in f:
                    parts = line.split(":")
                    if len(parts) == 2:
                        mem[parts[0].strip()] = int(parts[1].split()[0])
            total_kb = mem.get("MemTotal", 1024)
            avail_kb = mem.get("MemAvailable", mem.get("MemFree", 0))
            used_kb = total_kb - avail_kb
            pct = max(0.0, min(100.0, (used_kb / total_kb) * 100.0))
            return used_kb / (1024.0 ** 2), total_kb / (1024.0 ** 2), pct
        except Exception:
            return 0.0, 1.0, 0.0

    @staticmethod
    def get_disk(path: str = "/") -> Tuple[float, float, float]:
        """Returns (used_gb, total_gb, percentage)."""
        try:
            usage = shutil.disk_usage(path)
            total_gb = usage.total / (1024.0 ** 3)
            used_gb = usage.used / (1024.0 ** 3)
            pct = (usage.used / usage.total) * 100.0 if usage.total > 0 else 0.0
            return used_gb, total_gb, pct
        except Exception:
            return 0.0, 1.0, 0.0

    @staticmethod
    def get_uptime() -> str:
        """Returns human-readable uptime."""
        try:
            with open("/proc/uptime", "r") as f:
                up_sec = float(f.readline().split()[0])
            days = int(up_sec // 86400)
            hours = int((up_sec % 86400) // 3600)
            mins = int((up_sec % 3600) // 60)
            if days > 0:
                return f"{days}d {hours:02d}h {mins:02d}m"
            return f"{hours:02d}h {mins:02d}m"
        except Exception:
            return "unknown"

    @staticmethod
    def get_tor_route() -> Tuple[str, bool]:
        """Returns (status_text, is_cloaked)."""
        # 1. Check ghostmode state file
        if os.path.exists("/run/zoth_ghostmode.state"):
            return "CLOAKED (Ghostmode Active)", True

        # 2. Check SOCKS5 Tor port 9050
        if check_port(9050):
            return "ACTIVE (Tor SOCKS5 :9050)", True

        # 3. Check Tor service state
        try:
            res = subprocess.run(
                ["systemctl", "is-active", "tor"],
                capture_output=True,
                text=True,
                timeout=0.25,
            )
            if res.returncode == 0 and res.stdout.strip() == "active":
                return "ONLINE (Tor Daemon)", True
        except Exception:
            pass

        return "CLEAN (Direct Clearnet Route)", False

    @staticmethod
    def get_active_mode() -> str:
        """Returns 'matrix', 'ghost', or 'incognito'."""
        if os.path.exists("/run/zoth_ghostmode.state"):
            return "ghost"
        state_file = os.path.expanduser("~/.config/zothos/current_mode")
        if os.path.exists(state_file):
            try:
                with open(state_file, "r") as f:
                    mode = f.read().strip().lower()
                    if mode in ["matrix", "ghost", "incognito"]:
                        return mode
            except Exception:
                pass
        undercover_state = os.path.expanduser("~/.config/zothos/undercover.state")
        if os.path.exists(undercover_state):
            return "incognito"
        return "matrix"


# ═══════════════════════════════════════════════════════════════════════════════
# Port & Binary Inspection Helpers
# ═══════════════════════════════════════════════════════════════════════════════

def check_port(port: int, host: str = "127.0.0.1", timeout: float = 0.15) -> bool:
    """Check if TCP port is bound."""
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.settimeout(timeout)
            return s.connect_ex((host, port)) == 0
    except Exception:
        return False

def tool_available(cmd: str) -> bool:
    """Check if CLI tool exists in PATH."""
    return shutil.which(cmd) is not None

def python_pkg_available(pkg: str) -> bool:
    """Check if a Python package can be imported."""
    try:
        res = subprocess.run(
            [sys.executable, "-c", f"import {pkg}"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=0.4,
        )
        return res.returncode == 0
    except Exception:
        return False


