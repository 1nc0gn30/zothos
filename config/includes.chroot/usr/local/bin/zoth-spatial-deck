#!/usr/bin/env bash
# ==============================================================================
#  ZOTHOS 3D Spatial Desktop Deck Launcher
# ==============================================================================

SPATIAL_HTML="/usr/share/zothos/3d-desktop/index.html"

echo -e "\e[1;32m[*] Engaging ZOTHOS 3D Spatial Desktop Deck...\e[0m"
echo -e "\e[1;33m[*] Press ESC to return to 2D standard desktop anytime.\e[0m"

if command -v chromium >/dev/null 2>&1; then
    chromium --app="file://$SPATIAL_HTML" --window-size=1920,1080 --start-maximized >/dev/null 2>&1 &
elif command -v firefox-esr >/dev/null 2>&1; then
    firefox-esr --new-window "file://$SPATIAL_HTML" >/dev/null 2>&1 &
elif command -v firefox >/dev/null 2>&1; then
    firefox --new-window "file://$SPATIAL_HTML" >/dev/null 2>&1 &
else
    xdg-open "file://$SPATIAL_HTML" 2>/dev/null || true
fi
